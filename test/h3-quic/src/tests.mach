# http/3 driven over the real mach-quic connection driver

use std.runtime;

use h3quic.adapter;
use h3quic.loopback;
use h3quic.session;

use h3: http.h3.connection;
use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.status;
use qt: quic.transport;

use std.io.lifecycle;
use std.sync.cancel;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.view;

val SLOTS: usize = 6;
val EXCHANGES: usize = 12;
val REQUEST_BYTES: usize = 96;
val RESPONSE_BYTES: usize = 128;

rec Slot {
    id: u64;
    generation: u64;
    received: usize;
    active: bool;
    body_pending: bool;
    released: bool;
}

rec App {
    fabric: *session.Fabric;
    exchanges: [12]session.ExchangeMemory;
    used: usize;
    client_slots: [6]Slot;
    server_slots: [6]Slot;
    payload: [128]u8;
    request_bytes: usize;
    response_bytes: usize;
    mismatches: usize;
    client_ends: usize;
    server_ends: usize;
    responses: usize;
    respond_with_body: bool;
    release_streams: bool;
    extra_field: bool;
    withhold_response: bool;
    hold_body: bool;
    skip_dispatch: bool;
    credit_checks: usize;
    failures: usize;
    last_reset_code: u64;
    last_goaway: u64;
    generations: [12]u64;
    started: usize;
}

fun pattern(index: usize) u8 {
    ret ('a'::u8 + (index % 26)::u8)::u8;
}

fun init_app(app: *App, fabric: *session.Fabric) {
    app.fabric = fabric;
    var i: usize = 0;
    for (i < 128) { app.payload[i] = pattern(i); i = i + 1; }
    app.release_streams = true;
}

fun find_slot(slots: *Slot, id: u64) *Slot {
    var i: usize = 0;
    for (i < SLOTS) {
        if (slots[i].active && slots[i].id == id) { ret ?slots[i]; }
        i = i + 1;
    }
    ret nil;
}

fun claim_slot(slots: *Slot, id: u64, generation: u64) *Slot {
    var i: usize = 0;
    for (i < SLOTS) {
        if (!slots[i].active) {
            slots[i] = Slot{id: id, generation: generation, received: 0,
                active: true, body_pending: false, released: false};
            ret ?slots[i];
        }
        i = i + 1;
    }
    ret nil;
}

# borrowed DATA must still be holding its quic credit, and consuming it must
# return exactly those bytes
fun absorb(app: *App, slot: *Slot, event: h3.Event, engine: *h3.Engine[adapter.Adapter],
           io: *adapter.Adapter) bool {
    var i: usize = 0;
    for (i < event.data_length) {
        if (event.data[i] != pattern(slot.received + i)) {
            app.mismatches = app.mismatches + 1;
        }
        i = i + 1;
    }
    slot.received = slot.received + event.data_length;
    val stream: *h3.Stream = h3.stream_for[adapter.Adapter](engine, event.stream_id);
    if (stream == nil) { app.failures = app.failures + 1; ret false; }
    val before: qt.StreamSnapshot = adapter.stream_snapshot(io,
        stream.transport_stream);
    if (!h3.consume_data[adapter.Adapter](engine, event.stream_id, event.data_length)) {
        ret false;
    }
    val after: qt.StreamSnapshot = adapter.stream_snapshot(io,
        stream.transport_stream);
    if (before.status != qt.STATUS_OK || after.status != qt.STATUS_OK
     || before.receive_uncredited < event.data_length::u64
     || after.receive_uncredited
        != before.receive_uncredited - event.data_length::u64) {
        app.failures = app.failures + 1;
        ret false;
    }
    app.credit_checks = app.credit_checks + 1;
    ret true;
}

fun respond(context: ptr, served: *exchange.Exchange) exchange.ServiceStatus {
    val configured: message.Limits = message.limits_default();
    if (message.set_status(served.response, status.OK) != message.RESPONSE_OK
     || exchange.commit(served, configured) != message.RESPONSE_OK
     || exchange.finish(served) != exchange.FINISH_OK) {
        ret exchange.SERVICE_FAILED;
    }
    ret exchange.SERVICE_COMPLETE;
}

fun serve(context: ptr, event: h3.Event) bool {
    val app: *App = context::*App;
    val engine: *h3.Engine[adapter.Adapter] = ?app.fabric.server.engine;
    if (event.kind == h3.EVENT_REQUEST_HEADERS) {
        if (app.used >= EXCHANGES) { app.failures = app.failures + 1; ret false; }
        val memory: *session.ExchangeMemory = ?app.exchanges[app.used];
        app.used = app.used + 1;
        if (!session.make_exchange(memory, event.generation, event.stream_id)
         || !h3.bind_exchange[adapter.Adapter](engine, event.stream_id, ?memory.exchange)
         || !h3.release_event[adapter.Adapter](engine, event.stream_id, event.generation)
         || claim_slot(?app.server_slots[0], event.stream_id,
            event.generation) == nil) {
            app.failures = app.failures + 1;
            ret false;
        }
        if (app.skip_dispatch) { ret true; }
        val service: exchange.Service = exchange.Service{ctx: nil, serve: respond};
        if (h3.dispatch[adapter.Adapter](engine, event.stream_id, ?service)
            != exchange.SERVICE_COMPLETE) {
            app.failures = app.failures + 1;
            ret false;
        }
        ret true;
    }
    if (event.kind == h3.EVENT_DATA) {
        val slot: *Slot = find_slot(?app.server_slots[0], event.stream_id);
        if (slot == nil) { app.failures = app.failures + 1; ret false; }
        app.request_bytes = app.request_bytes + event.data_length;
        ret absorb(app, slot, event, engine, ?app.fabric.server.io);
    }
    if (event.kind == h3.EVENT_STREAM_END) {
        val slot: *Slot = find_slot(?app.server_slots[0], event.stream_id);
        if (slot == nil) { ret true; }
        app.server_ends = app.server_ends + 1;
        if (app.withhold_response) { ret true; }
        var items: [1]field.Field;
        session.response_fields(?items[0], view.view("200", 3));
        val offered: h3.Offer = h3.send_headers[adapter.Adapter](engine, event.stream_id,
            ?items[0], 1, !app.respond_with_body, false);
        if (offered.status != h3.OFFER_OUTPUT) {
            app.failures = app.failures + 1;
            ret false;
        }
        app.responses = app.responses + 1;
        slot.body_pending = app.respond_with_body;
        ret true;
    }
    if (event.kind == h3.EVENT_STREAM_RESET
     || event.kind == h3.EVENT_STREAM_ERROR) {
        app.last_reset_code = event.code;
        val slot: *Slot = find_slot(?app.server_slots[0], event.stream_id);
        if (slot != nil) { slot.body_pending = false; }
        ret true;
    }
    ret true;
}

fun consume(context: ptr, event: h3.Event) bool {
    val app: *App = context::*App;
    val engine: *h3.Engine[adapter.Adapter] = ?app.fabric.client.engine;
    if (event.kind == h3.EVENT_RESPONSE_HEADERS) {
        ret h3.release_event[adapter.Adapter](engine, event.stream_id, event.generation);
    }
    if (event.kind == h3.EVENT_DATA) {
        val slot: *Slot = find_slot(?app.client_slots[0], event.stream_id);
        if (slot == nil) { app.failures = app.failures + 1; ret false; }
        app.response_bytes = app.response_bytes + event.data_length;
        ret absorb(app, slot, event, engine, ?app.fabric.client.io);
    }
    if (event.kind == h3.EVENT_STREAM_END) {
        app.client_ends = app.client_ends + 1;
        ret true;
    }
    if (event.kind == h3.EVENT_STREAM_RESET
     || event.kind == h3.EVENT_STREAM_ERROR) {
        app.last_reset_code = event.code;
        ret true;
    }
    if (event.kind == h3.EVENT_GOAWAY) {
        app.last_goaway = event.goaway_id;
        ret true;
    }
    ret true;
}

fun start_request(app: *App, with_body: bool) u64 {
    val engine: *h3.Engine[adapter.Adapter] = ?app.fabric.client.engine;
    val id: u64 = h3.open_request[adapter.Adapter](engine, nil);
    if (id == h3.NO_STREAM) { ret h3.NO_STREAM; }
    val stream: *h3.Stream = h3.stream_for[adapter.Adapter](engine, id);
    if (stream == nil) { ret h3.NO_STREAM; }
    var items: [5]field.Field;
    var count: usize = session.request_fields(?items[0], view.view("/", 1));
    if (app.extra_field) {
        items[count] = field.Field{name: view.view("x-tag", 5),
            value: view.view("hold", 4), sensitive: false};
        count = count + 1;
    }
    if (h3.send_headers[adapter.Adapter](engine, id, ?items[0], count, !with_body,
        false).status != h3.OFFER_OUTPUT) {
        app.failures = app.failures + 1;
        ret h3.NO_STREAM;
    }
    val slot: *Slot = claim_slot(?app.client_slots[0], id, stream.generation);
    if (slot == nil) { app.failures = app.failures + 1; ret h3.NO_STREAM; }
    slot.body_pending = with_body;
    if (app.started < 12) { app.generations[app.started] = stream.generation; }
    app.started = app.started + 1;
    ret id;
}

fun push_bodies(app: *App, slots: *Slot, engine: *h3.Engine[adapter.Adapter], length: usize) {
    if (app.hold_body) { ret; }
    var i: usize = 0;
    for (i < SLOTS) {
        val slot: *Slot = ?slots[i];
        if (slot.active && slot.body_pending) {
            val stream: *h3.Stream = h3.stream_for[adapter.Adapter](engine, slot.id);
            if (stream != nil && stream.output_length == 0) {
                if (h3.offer_data[adapter.Adapter](engine, slot.id, ?app.payload[0], length,
                    true).status == h3.OFFER_DONE) { slot.body_pending = false; }
            }
        }
        i = i + 1;
    }
}

fun reap(app: *App, slots: *Slot, engine: *h3.Engine[adapter.Adapter]) {
    var i: usize = 0;
    for (i < SLOTS) {
        val slot: *Slot = ?slots[i];
        if (slot.active && !slot.body_pending
         && h3.release_stream[adapter.Adapter](engine, slot.id, slot.generation)) {
            slot.active = false;
            slot.released = true;
        }
        i = i + 1;
    }
}

fun advance(app: *App) {
    push_bodies(app, ?app.client_slots[0], ?app.fabric.client.engine,
        REQUEST_BYTES);
    push_bodies(app, ?app.server_slots[0], ?app.fabric.server.engine,
        RESPONSE_BYTES);
    if (!app.release_streams) { ret; }
    reap(app, ?app.client_slots[0], ?app.fabric.client.engine);
    reap(app, ?app.server_slots[0], ?app.fabric.server.engine);
}

fun cycle(app: *App, rounds: usize) {
    var i: usize = 0;
    for (i < rounds) {
        session.tick(?app.fabric.client);
        session.tick(?app.fabric.server);
        session.turn(app.fabric);
        advance(app);
        i = i + 1;
    }
}

fun quiet(app: *App) bool {
    ret session.count_of(?app.fabric.client, h3.EVENT_ERROR) == 0
        && session.count_of(?app.fabric.server, h3.EVENT_ERROR) == 0
        && session.count_of(?app.fabric.client, h3.EVENT_CANCELLED) == 0
        && session.count_of(?app.fabric.server, h3.EVENT_CANCELLED) == 0
        && app.failures == 0 && app.mismatches == 0
        && app.fabric.link.errors == 0
        && app.fabric.client.rejected == 0 && app.fabric.server.rejected == 0;
}

# every connection ends the same way a pool ends one: the engines give up what
# they hold, then both drivers settle their close. a test that leaves the
# engines mid-exchange still closes the drivers, which is what the transport
# guarantees regardless of the http/3 state above it.
fun teardown(fabric: *session.Fabric) bool {
    ret session.close_fabric(fabric, false, h3.H3_NO_ERROR)
        && session.fabric_closed(fabric);
}

fun attach(app: *App, fabric: *session.Fabric) {
    fabric.client.handler = consume;
    fabric.client.context = app::ptr;
    fabric.server.handler = serve;
    fabric.server.context = app::ptr;
}

test "h3quic: settings and critical streams cross two real quic drivers" {
    var fabric: session.Fabric;
    val ready: usize = session.make_fabric(?fabric, session.session_config(), 512);
    if (ready != 0) { ret (100 + ready)::i32; }
    if (!session.handshake(?fabric, 64)) { ret 2; }
    if (session.count_of(?fabric.client, h3.EVENT_SETTINGS) != 1
     || session.count_of(?fabric.server, h3.EVENT_SETTINGS) != 1) { ret 3; }
    if (session.count_of(?fabric.client, h3.EVENT_ERROR) != 0
     || session.count_of(?fabric.server, h3.EVENT_ERROR) != 0) { ret 4; }
    if (fabric.link.transfers == 0) { ret 5; }
    if (!teardown(?fabric)) { ret 6; }
    ret 0;
}

test "h3quic: a request and response body cross the driver pair intact" {
    var fabric: session.Fabric;
    var app: App;
    val ready: usize = session.make_fabric(?fabric, session.session_config(), 512);
    if (ready != 0) { ret (100 + ready)::i32; }
    init_app(?app, ?fabric);
    attach(?app, ?fabric);
    app.respond_with_body = true;
    if (!session.handshake(?fabric, 64)) { ret 2; }
    val id: u64 = start_request(?app, true);
    if (id != 0) { ret 3; }
    cycle(?app, 96);
    if (app.request_bytes != REQUEST_BYTES) { ret 4; }
    if (app.response_bytes != RESPONSE_BYTES) { ret 5; }
    if (app.server_ends != 1 || app.client_ends != 1 || app.responses != 1) { ret 6; }
    if (!quiet(?app)) { ret 7; }
    if (app.credit_checks < 2) { ret 8; }
    if (!app.client_slots[0].released) { ret 9; }
    if (!app.server_slots[0].released) { ret 10; }
    if (!teardown(?fabric)) { ret 11; }
    ret 0;
}

test "h3quic: sustained multiplexing reuses quic stream slots and generations" {
    var fabric: session.Fabric;
    var app: App;
    val ready: usize = session.make_fabric(?fabric, session.session_config(), 512);
    if (ready != 0) { ret (100 + ready)::i32; }
    init_app(?app, ?fabric);
    attach(?app, ?fabric);
    app.respond_with_body = true;
    if (!session.handshake(?fabric, 64)) { ret 2; }
    var wanted: usize = 0;
    var guard: usize = 0;
    for (wanted < 12 && guard < 512) {
        if (start_request(?app, true) != h3.NO_STREAM) { wanted = wanted + 1; }
        or { cycle(?app, 4); }
        cycle(?app, 2);
        guard = guard + 1;
    }
    if (wanted != 12) { ret 3; }
    cycle(?app, 256);
    if (app.server_ends != 12 || app.client_ends != 12
     || app.responses != 12) { ret 4; }
    if (app.request_bytes != REQUEST_BYTES * 12
     || app.response_bytes != RESPONSE_BYTES * 12) { ret 5; }
    if (!quiet(?app)) { ret 6; }
    var previous: u64 = 0;
    var i: usize = 0;
    for (i < 12) {
        if (app.generations[i] <= previous) { ret 7; }
        previous = app.generations[i];
        i = i + 1;
    }
    if (fabric.client_wire.manager.local_bidirectional_opened != 12) { ret 8; }
    if (fabric.client_wire.manager.config.local_bidirectional_limit <= 4) { ret 9; }
    var reused: usize = 0;
    i = 0;
    for (i < loopback.STREAM_CAPACITY) {
        if (fabric.client_wire.stream_records[i].generation > 1) {
            reused = reused + 1;
        }
        i = i + 1;
    }
    if (reused == 0) { ret 10; }
    if (fabric.client_wire.manager.active_streams > 6) { ret 11; }
    if (!teardown(?fabric)) { ret 12; }
    ret 0;
}

test "h3quic: a qpack-blocked section holds quic credit while other requests run" {
    var fabric: session.Fabric;
    var app: App;
    val ready: usize = session.make_fabric(?fabric, session.session_config(), 512);
    if (ready != 0) { ret (100 + ready)::i32; }
    init_app(?app, ?fabric);
    attach(?app, ?fabric);
    app.release_streams = false;
    if (!session.handshake(?fabric, 64)) { ret 2; }
    var scratch: [128]u8;
    if (!h3.set_qpack_capacity[adapter.Adapter](?fabric.client.engine, 128)
     || !h3.insert_qpack[adapter.Adapter](?fabric.client.engine, view.view("x-tag", 5),
        view.view("hold", 4), false, ?scratch[0], 128)) { ret 3; }
    fabric.link.hold_id = fabric.client.engine.local_encoder.stream.id;
    app.extra_field = true;
    val blocked_id: u64 = start_request(?app, false);
    if (blocked_id != 0) { ret 4; }
    cycle(?app, 32);
    if (fabric.link.reordered == 0) { ret 5; }
    if (fabric.server.engine.inbound_sections.blocked_count != 1) { ret 6; }
    if (session.count_of(?fabric.server, h3.EVENT_REQUEST_HEADERS) != 0) { ret 7; }
    val blocked: *h3.Stream = h3.stream_for[adapter.Adapter](?fabric.server.engine, blocked_id);
    if (blocked == nil) { ret 8; }
    val held: qt.StreamSnapshot = adapter.stream_snapshot(?fabric.server.io,
        blocked.transport_stream);
    if (held.status != qt.STATUS_OK || held.receive_uncredited == 0) { ret 9; }
    app.extra_field = false;
    val open_id: u64 = start_request(?app, false);
    if (open_id != 4) { ret 10; }
    cycle(?app, 32);
    if (session.count_of(?fabric.server, h3.EVENT_REQUEST_HEADERS) != 1) { ret 11; }
    if (app.responses != 1) { ret 12; }
    if (fabric.server.engine.inbound_sections.blocked_count != 1) { ret 13; }
    val still: qt.StreamSnapshot = adapter.stream_snapshot(?fabric.server.io,
        blocked.transport_stream);
    if (still.status != qt.STATUS_OK || still.receive_uncredited == 0) { ret 14; }
    if (!loopback.release_held(?fabric.link, ?fabric.server_wire)) { ret 15; }
    cycle(?app, 64);
    if (session.count_of(?fabric.server, h3.EVENT_REQUEST_HEADERS) != 2) { ret 16; }
    if (fabric.server.engine.inbound_sections.blocked_count != 0) { ret 17; }
    val released: qt.StreamSnapshot = adapter.stream_snapshot(?fabric.server.io,
        blocked.transport_stream);
    if (released.status != qt.STATUS_OK || released.receive_uncredited != 0) { ret 18; }
    if (app.responses != 2 || app.client_ends != 2) { ret 19; }
    if (!quiet(?app)) { ret 20; }
    if (!teardown(?fabric)) { ret 21; }
    ret 0;
}

test "h3quic: stream reset and application cancellation settle exactly once" {
    var fabric: session.Fabric;
    var app: App;
    val ready: usize = session.make_fabric(?fabric, session.session_config(), 512);
    if (ready != 0) { ret (100 + ready)::i32; }
    init_app(?app, ?fabric);
    attach(?app, ?fabric);
    app.release_streams = false;
    app.withhold_response = true;
    app.hold_body = true;
    if (!session.handshake(?fabric, 64)) { ret 2; }
    val id: u64 = start_request(?app, true);
    if (id != 0) { ret 3; }
    cycle(?app, 16);
    if (session.count_of(?fabric.server, h3.EVENT_REQUEST_HEADERS) != 1) { ret 4; }
    if (!h3.cancel_stream[adapter.Adapter](?fabric.client.engine, id, h3.H3_REQUEST_CANCELLED)) {
        ret 5;
    }
    cycle(?app, 48);
    if (session.count_of(?fabric.server, h3.EVENT_STREAM_RESET) != 1) { ret 6; }
    if (app.last_reset_code != h3.H3_REQUEST_CANCELLED) { ret 7; }
    cycle(?app, 32);
    if (session.count_of(?fabric.server, h3.EVENT_STREAM_RESET) != 1) { ret 8; }
    if (fabric.client.engine.state != h3.OPEN
     || fabric.server.engine.state != h3.OPEN) { ret 9; }
    if (session.count_of(?fabric.client, h3.EVENT_ERROR) != 0
     || session.count_of(?fabric.server, h3.EVENT_ERROR) != 0) { ret 10; }

    var second: session.Fabric;
    var other: App;
    val ready_again: usize = session.make_fabric(?second,
        session.session_config(), 512);
    if (ready_again != 0) { ret (120 + ready_again)::i32; }
    init_app(?other, ?second);
    attach(?other, ?second);
    other.release_streams = false;
    other.withhold_response = true;
    other.hold_body = true;
    other.skip_dispatch = true;
    if (!session.handshake(?second, 64)) { ret 11; }
    if (start_request(?other, true) != 0) { ret 12; }
    cycle(?other, 16);
    if (other.used != 1) { ret 13; }
    if (!cancel.cancel(?other.exchanges[0].scope)) { ret 14; }
    cycle(?other, 48);
    if (session.count_of(?second.server, h3.EVENT_STREAM_RESET) != 1) { ret 15; }
    if (session.count_of(?second.client, h3.EVENT_STREAM_RESET) != 1) { ret 16; }
    if (other.last_reset_code != h3.H3_REQUEST_CANCELLED) { ret 17; }
    if (other.exchanges[0].exchange.state != exchange.CANCELLED_STATE) { ret 18; }
    cycle(?other, 32);
    if (session.count_of(?second.server, h3.EVENT_STREAM_RESET) != 1
     || session.count_of(?second.client, h3.EVENT_STREAM_RESET) != 1) { ret 19; }
    if (second.client.engine.state != h3.OPEN
     || second.server.engine.state != h3.OPEN) { ret 20; }
    if (!teardown(?fabric)) { ret 21; }
    if (!teardown(?second)) { ret 22; }
    ret 0;
}

test "h3quic: goaway and two-stage graceful close settle over the driver pair" {
    var fabric: session.Fabric;
    var app: App;
    val ready: usize = session.make_fabric(?fabric, session.session_config(), 512);
    if (ready != 0) { ret (100 + ready)::i32; }
    init_app(?app, ?fabric);
    attach(?app, ?fabric);
    app.respond_with_body = true;
    if (!session.handshake(?fabric, 64)) { ret 2; }
    if (start_request(?app, true) != 0) { ret 3; }
    cycle(?app, 96);
    if (app.responses != 1 || app.client_ends != 1) { ret 4; }
    if (!h3.begin_graceful[adapter.Adapter](?fabric.server.engine)) { ret 5; }
    cycle(?app, 32);
    if (session.count_of(?fabric.client, h3.EVENT_GOAWAY) != 1) { ret 6; }
    if (app.last_goaway == 0) { ret 7; }
    if (h3.open_request[adapter.Adapter](?fabric.client.engine, nil) != h3.NO_STREAM) { ret 8; }
    val first_boundary: u64 = app.last_goaway;
    if (!h3.finish_graceful[adapter.Adapter](?fabric.server.engine)) { ret 9; }
    cycle(?app, 64);
    if (session.count_of(?fabric.client, h3.EVENT_GOAWAY) != 2) { ret 10; }
    if (app.last_goaway >= first_boundary) { ret 11; }
    var guard: usize = 0;
    for (guard < 64 && fabric.server.engine.state != h3.CLOSED) {
        cycle(?app, 2);
        h3.progress_close[adapter.Adapter](?fabric.server.engine);
        guard = guard + 1;
    }
    if (fabric.server.engine.active_requests != 0
     || fabric.server.engine.control.count != 0
     || fabric.server.engine.decoder.count != 0) { ret 12; }
    if (fabric.server.engine.state != h3.CLOSED) { ret 13; }
    if (fabric.server.io.close_calls == 0
     || fabric.server.io.close_error != h3.H3_NO_ERROR) { ret 14; }
    if (qt.snapshot[loopback.Core](?fabric.server_wire.driver).state
        != qt.DRAINING) { ret 15; }
    if (app.failures != 0 || app.mismatches != 0) { ret 16; }
    if (session.count_of(?fabric.client, h3.EVENT_ERROR) != 0
     || session.count_of(?fabric.server, h3.EVENT_ERROR) != 0) { ret 17; }
    if (!teardown(?fabric)) { ret 18; }
    ret 0;
}

test "h3quic: partial writes and short reads keep retained output intact" {
    var fabric: session.Fabric;
    var app: App;
    val ready: usize = session.make_fabric(?fabric, session.session_config(), 64);
    if (ready != 0) { ret (100 + ready)::i32; }
    init_app(?app, ?fabric);
    attach(?app, ?fabric);
    app.respond_with_body = true;
    if (!session.handshake(?fabric, 256)) { ret 2; }
    if (start_request(?app, true) != 0) { ret 3; }
    cycle(?app, 512);
    if (app.request_bytes != REQUEST_BYTES) { ret 4; }
    if (app.response_bytes != RESPONSE_BYTES) { ret 5; }
    if (app.responses != 1 || app.client_ends != 1) { ret 6; }
    if (!quiet(?app)) { ret 7; }
    if (fabric.client.io.partial_writes == 0) { ret 8; }
    if (fabric.server.io.partial_writes == 0) { ret 9; }
    if (fabric.client.io.short_reads == 0
     || fabric.server.io.short_reads == 0) { ret 10; }
    if (!teardown(?fabric)) { ret 11; }
    ret 0;
}

test "h3quic: lost datagrams are retransmitted without disturbing the exchange" {
    var fabric: session.Fabric;
    var app: App;
    val ready: usize = session.make_fabric(?fabric, session.session_config(), 512);
    if (ready != 0) { ret (100 + ready)::i32; }
    init_app(?app, ?fabric);
    attach(?app, ?fabric);
    app.respond_with_body = true;
    if (!session.handshake(?fabric, 64)) { ret 2; }
    fabric.link.drop_next = 6;
    if (start_request(?app, true) != 0) { ret 3; }
    cycle(?app, 256);
    if (fabric.link.dropped != 6) { ret 4; }
    if (fabric.client_wire.core.lost + fabric.server_wire.core.lost < 6) { ret 5; }
    if (fabric.client_wire.core.delivered == 0
     || fabric.server_wire.core.delivered == 0) { ret 10; }
    if (app.request_bytes != REQUEST_BYTES) { ret 6; }
    if (app.response_bytes != RESPONSE_BYTES) { ret 7; }
    if (app.responses != 1 || app.client_ends != 1) { ret 8; }
    if (!quiet(?app)) { ret 9; }
    if (!teardown(?fabric)) { ret 11; }
    ret 0;
}

test "h3quic: a request past the server budget is rejected without closing the connection" {
    var fabric: session.Fabric;
    var app: App;
    var server_config: h3.Config = session.session_config();
    server_config.max_requests = 1;
    val ready: usize = session.make_fabric_with(?fabric,
        session.session_config(), server_config, 512);
    if (ready != 0) { ret (100 + ready)::i32; }
    init_app(?app, ?fabric);
    attach(?app, ?fabric);
    app.release_streams = false;
    app.withhold_response = true;
    app.hold_body = true;
    if (!session.handshake(?fabric, 64)) { ret 2; }
    if (start_request(?app, true) != 0) { ret 3; }
    if (start_request(?app, true) != 4) { ret 4; }
    cycle(?app, 96);
    if (fabric.server.engine.state != h3.OPEN
     || fabric.client.engine.state != h3.OPEN) { ret 5; }
    if (session.count_of(?fabric.server, h3.EVENT_ERROR) != 0
     || session.count_of(?fabric.client, h3.EVENT_ERROR) != 0) { ret 6; }
    if (session.count_of(?fabric.server, h3.EVENT_REQUEST_HEADERS) != 1) { ret 7; }
    if (session.count_of(?fabric.server, h3.EVENT_STREAM_ERROR) != 1) { ret 8; }
    if (app.last_reset_code != h3.H3_REQUEST_REJECTED) { ret 9; }
    if (fabric.server.io.blocked_releases == 0) { ret 10; }
    if (fabric.server.engine.pending_release_count != 0) { ret 11; }
    if (fabric.server.io.close_calls != 0) { ret 12; }
    if (!teardown(?fabric)) { ret 13; }
    ret 0;
}

test "h3quic: a drained unknown unidirectional stream releases over the driver" {
    var fabric: session.Fabric;
    var app: App;
    var server_config: h3.Config = session.session_config();
    server_config.max_peer_unidirectional = 4;
    val ready: usize = session.make_fabric_with(?fabric,
        session.session_config(), server_config, 512);
    if (ready != 0) { ret (100 + ready)::i32; }
    init_app(?app, ?fabric);
    attach(?app, ?fabric);
    if (!session.handshake(?fabric, 64)) { ret 2; }
    if (fabric.server.engine.active_peer_unidirectional != 3) { ret 3; }
    val opened: qt.OpenResult = qt.open_stream[loopback.Core](
        ?fabric.client_wire.driver, qt.UNIDIRECTIONAL);
    if (opened.status != qt.STATUS_OK) { ret 4; }
    var bytes: [2]u8; bytes[0] = 0x21; bytes[1] = 'x';
    if (qt.write_stream[loopback.Core](?fabric.client_wire.driver,
        opened.stream, ?bytes[0], 2).count != 2) { ret 5; }
    if (qt.finish_stream[loopback.Core](?fabric.client_wire.driver,
        opened.stream).status != qt.STATUS_OK) { ret 6; }
    cycle(?app, 64);
    if (fabric.server.engine.state != h3.OPEN) { ret 7; }
    if (session.count_of(?fabric.server, h3.EVENT_ERROR) != 0) { ret 8; }
    if (fabric.server.engine.pending_release_count != 0) { ret 9; }
    if (fabric.server.engine.active_peer_unidirectional != 3) { ret 10; }
    # a peer unidirectional stream has no send side and its receive side is
    # already closed at fin, so this release never has to be retried
    if (fabric.server.io.blocked_releases != 0) { ret 11; }
    if (!teardown(?fabric)) { ret 12; }
    ret 0;
}

test "h3quic: a destroyed engine pair carries a second connection over new drivers" {
    var fabric: session.Fabric;
    var app: App;
    val ready: usize = session.make_fabric(?fabric, session.session_config(), 512);
    if (ready != 0) { ret (100 + ready)::i32; }
    init_app(?app, ?fabric);
    attach(?app, ?fabric);
    app.respond_with_body = true;
    if (!session.handshake(?fabric, 64)) { ret 2; }
    if (start_request(?app, true) != 0) { ret 3; }
    cycle(?app, 96);
    if (app.request_bytes != REQUEST_BYTES
     || app.response_bytes != RESPONSE_BYTES
     || app.responses != 1 || app.client_ends != 1) { ret 4; }
    if (!quiet(?app)) { ret 5; }
    if (!app.client_slots[0].released || !app.server_slots[0].released) { ret 6; }
    val recycled: usize = session.recycle(?fabric, session.session_config(), 512);
    if (recycled != 0) { ret (120 + recycled)::i32; }
    if (fabric.client.engine.state != h3.STARTING
     || fabric.server.engine.state != h3.STARTING
     || fabric.client.engine.peer_settings_received
     || fabric.server.engine.peer_settings_received
     || fabric.server.engine.inbound_table.insert_count != 0) { ret 7; }
    var second: App;
    init_app(?second, ?fabric);
    attach(?second, ?fabric);
    second.respond_with_body = true;
    if (!session.handshake(?fabric, 64)) { ret 8; }
    if (start_request(?second, true) != 0) { ret 9; }
    cycle(?second, 96);
    if (second.request_bytes != REQUEST_BYTES
     || second.response_bytes != RESPONSE_BYTES
     || second.responses != 1 || second.client_ends != 1) { ret 10; }
    if (!quiet(?second)) { ret 11; }
    if (!second.client_slots[0].released
     || !second.server_slots[0].released) { ret 12; }
    if (!teardown(?fabric)) { ret 13; }
    ret 0;
}

test "h3quic: a graceful close ends the six critical streams on both drivers" {
    var fabric: session.Fabric;
    var app: App;
    val ready: usize = session.make_fabric(?fabric, session.session_config(), 512);
    if (ready != 0) { ret (100 + ready)::i32; }
    init_app(?app, ?fabric);
    attach(?app, ?fabric);
    app.respond_with_body = true;
    if (!session.handshake(?fabric, 64)) { ret 2; }
    if (start_request(?app, true) != 0) { ret 3; }
    cycle(?app, 96);
    if (app.responses != 1 || app.client_ends != 1) { ret 4; }
    if (!quiet(?app)) { ret 5; }
    if (!app.client_slots[0].released || !app.server_slots[0].released) { ret 6; }
    # the request stream is gone, but each endpoint still holds three critical
    # streams of its own and three the peer opened, and only the transport
    # close ends them
    if (fabric.client_wire.manager.active_streams != 6
     || fabric.server_wire.manager.active_streams != 6) { ret 7; }
    if (!h3.begin_graceful[adapter.Adapter](?fabric.server.engine)
     || !h3.finish_graceful[adapter.Adapter](?fabric.server.engine)) { ret 8; }
    var guard: usize = 0;
    for (guard < 64 && fabric.server.engine.state != h3.CLOSED) {
        cycle(?app, 2);
        h3.progress_close[adapter.Adapter](?fabric.server.engine);
        guard = guard + 1;
    }
    if (fabric.server.engine.state != h3.CLOSED) { ret 9; }
    # the engine's own close reached the transport, so the server driver is
    # already draining when the harness closes it
    if (qt.snapshot[loopback.Core](?fabric.server_wire.driver).state
        != qt.DRAINING) { ret 10; }
    if (fabric.client_wire.manager.active_streams != 6
     || fabric.server_wire.manager.active_streams != 6) { ret 11; }
    if (!h3.destroy[adapter.Adapter](?fabric.client.engine)
     || !h3.destroy[adapter.Adapter](?fabric.server.engine)) { ret 12; }
    if (!session.close_fabric(?fabric, false, h3.H3_NO_ERROR)) { ret 13; }
    if (!session.fabric_closed(?fabric)) { ret 14; }
    # nothing was left owing, so both ends settle on the first attempt and the
    # connection never enters a drain the harness has to wait out
    if (fabric.link.close_rounds != 1) { ret 15; }
    if (fabric.client_wire.core.abortive
     || fabric.server_wire.core.abortive) { ret 16; }
    if (fabric.client_wire.core.close_error != h3.H3_NO_ERROR
     || fabric.server_wire.core.close_error != h3.H3_NO_ERROR) { ret 17; }
    val settled: qt.Snapshot = qt.snapshot[loopback.Core](
        ?fabric.server_wire.driver);
    if (settled.close_mode != lifecycle.GRACEFUL
     || settled.close_cause != lifecycle.EXPLICIT
     || settled.pending_sends != 0
     || settled.queued_datagrams != 0) { ret 18; }
    if (fabric.link.errors != 0) { ret 19; }
    ret 0;
}

test "h3quic: an abortive close settles with a request still live on both ends" {
    var fabric: session.Fabric;
    var app: App;
    val ready: usize = session.make_fabric(?fabric, session.session_config(), 512);
    if (ready != 0) { ret (100 + ready)::i32; }
    init_app(?app, ?fabric);
    attach(?app, ?fabric);
    app.release_streams = false;
    app.withhold_response = true;
    app.hold_body = true;
    if (!session.handshake(?fabric, 64)) { ret 2; }
    if (start_request(?app, true) != 0) { ret 3; }
    cycle(?app, 16);
    if (session.count_of(?fabric.server, h3.EVENT_REQUEST_HEADERS) != 1) { ret 4; }
    # six critical streams plus the request neither side has finished, which the
    # engines still hold: an abortive close does not wait for them
    if (fabric.client_wire.manager.active_streams != 7
     || fabric.server_wire.manager.active_streams != 7) { ret 5; }
    if (fabric.client.engine.active_requests != 1
     || fabric.server.engine.active_requests != 1) { ret 6; }
    if (!session.close_fabric(?fabric, true, h3.H3_REQUEST_CANCELLED)) { ret 7; }
    if (!session.fabric_closed(?fabric)) { ret 8; }
    if (fabric.link.close_rounds != 1) { ret 9; }
    if (!fabric.client_wire.core.abortive
     || !fabric.server_wire.core.abortive) { ret 10; }
    # the driver publishes no abortive entry, so the harness escalates a
    # graceful close by cancelling the operation scope. the error the close
    # began with survives the escalation; the cancellation carries none.
    if (fabric.client_wire.core.close_error != h3.H3_REQUEST_CANCELLED
     || fabric.server_wire.core.close_error != h3.H3_REQUEST_CANCELLED) {
        ret 11;
    }
    val settled: qt.Snapshot = qt.snapshot[loopback.Core](
        ?fabric.client_wire.driver);
    if (settled.close_mode != lifecycle.ABORTIVE
     || settled.close_cause != lifecycle.EXPLICIT
     || settled.terminal_cause != lifecycle.CANCELLATION
     || settled.cancellation_reason != cancel.CANCELLED
     || settled.application_error != h3.H3_REQUEST_CANCELLED) { ret 12; }
    # the engines were never told, and the closed drivers own no stream storage
    # for them to reach
    if (fabric.client.engine.state != h3.OPEN
     || fabric.server.engine.state != h3.OPEN) { ret 13; }
    if (fabric.client_wire.manager.valid
     || fabric.server_wire.manager.valid) { ret 14; }
    ret 0;
}
