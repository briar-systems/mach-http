# bounded http/3 connection and request-stream engine

use http.core.body;
use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.method;
use http.core.records;
use http.core.section;
use http.core.status;
use http.core.target;
use http.h3.frame;
use http.h3.qpack;
use std.allocator;
use std.allocator.page;
use std.chrono.time;
use std.memory;
use std.memory.buffers;
use std.sync.cancel;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.view;

fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

fun transition_ok(outcome: cancel.Transition) bool {
    ret (sel outcome.ok) && outcome.ok;
}

fun scope_active(scope: *cancel.Scope) bool {
    val reason: cancel.Reason = cancel.reason(scope);
    ret sel reason.active;
}

pub def Role: u8;
pub val SERVER: Role = 1;
pub val CLIENT: Role = 2;

pub def State: u8;
pub val STARTING: State = 1;
pub val OPEN:     State = 2;
pub val DRAINING: State = 3;
pub val CLOSING:  State = 4;
pub val CLOSED:   State = 5;
pub val FAILED:   State = 6;

pub def StreamState: u8;
pub val STREAM_OPEN:               StreamState = 1;
pub val STREAM_HALF_CLOSED_LOCAL:  StreamState = 2;
pub val STREAM_HALF_CLOSED_REMOTE: StreamState = 3;
pub val STREAM_CLOSED:             StreamState = 4;

pub def StreamKind: u8;
pub val STREAM_UNKNOWN:       StreamKind = 0;
pub val STREAM_REQUEST:       StreamKind = 1;
pub val STREAM_CONTROL:       StreamKind = 2;
pub val STREAM_QPACK_ENCODER: StreamKind = 3;
pub val STREAM_QPACK_DECODER: StreamKind = 4;
pub val STREAM_IGNORED:       StreamKind = 5;

pub val H3_NO_ERROR:                u64 = 0x100;
pub val H3_GENERAL_PROTOCOL_ERROR:  u64 = 0x101;
pub val H3_INTERNAL_ERROR:          u64 = 0x102;
pub val H3_STREAM_CREATION_ERROR:   u64 = 0x103;
pub val H3_CLOSED_CRITICAL_STREAM:  u64 = 0x104;
pub val H3_FRAME_UNEXPECTED:        u64 = 0x105;
pub val H3_FRAME_ERROR:             u64 = 0x106;
pub val H3_EXCESSIVE_LOAD:          u64 = 0x107;
pub val H3_ID_ERROR:                u64 = 0x108;
pub val H3_SETTINGS_ERROR:          u64 = 0x109;
pub val H3_MISSING_SETTINGS:        u64 = 0x10a;
pub val H3_REQUEST_REJECTED:        u64 = 0x10b;
pub val H3_REQUEST_CANCELLED:       u64 = 0x10c;
pub val H3_REQUEST_INCOMPLETE:      u64 = 0x10d;
pub val H3_MESSAGE_ERROR:           u64 = 0x10e;
pub val H3_CONNECT_ERROR:           u64 = 0x10f;
pub val H3_VERSION_FALLBACK:        u64 = 0x110;
pub val QPACK_DECOMPRESSION_FAILED: u64 = 0x200;
pub val QPACK_ENCODER_STREAM_ERROR: u64 = 0x201;
pub val QPACK_DECODER_STREAM_ERROR: u64 = 0x202;

pub def Error: u8;
pub val ERROR_NONE:        Error = 0;
pub val ERROR_STATE:       Error = 1;
pub val ERROR_LIMIT:       Error = 2;
pub val ERROR_PROTOCOL:    Error = 3;
pub val ERROR_FRAME:       Error = 4;
pub val ERROR_QPACK:       Error = 5;
pub val ERROR_TRANSPORT:   Error = 6;
pub val ERROR_CANCELLED:   Error = 7;
pub val ERROR_NO_PROGRESS: Error = 8;
pub val ERROR_MEMORY:      Error = 9;

pub def EventKind: u8;
pub val EVENT_NONE:             EventKind = 0;
pub val EVENT_BLOCKED:          EventKind = 1;
pub val EVENT_SETTINGS:         EventKind = 2;
pub val EVENT_REQUEST_HEADERS:  EventKind = 3;
pub val EVENT_RESPONSE_HEADERS: EventKind = 4;
pub val EVENT_INFORMATIONAL:    EventKind = 5;
pub val EVENT_TRAILERS:         EventKind = 6;
pub val EVENT_DATA:             EventKind = 7;
pub val EVENT_STREAM_END:       EventKind = 8;
pub val EVENT_STREAM_RESET:     EventKind = 9;
pub val EVENT_STREAM_RETRY:     EventKind = 10;
pub val EVENT_GOAWAY:           EventKind = 11;
pub val EVENT_CLOSED:           EventKind = 12;
pub val EVENT_CANCELLED:        EventKind = 13;
pub val EVENT_STREAM_ERROR:     EventKind = 14;
pub val EVENT_ERROR:            EventKind = 15;
pub val EVENT_PENDING:          EventKind = 16;
pub val EVENT_MEMORY_BLOCKED:   EventKind = 17;

pub def OfferStatus: u8;
pub val OFFER_OUTPUT:  OfferStatus = 1;
pub val OFFER_PARTIAL: OfferStatus = 2;
pub val OFFER_DONE:    OfferStatus = 3;
pub val OFFER_BLOCKED: OfferStatus = 4;
pub val OFFER_ERROR:   OfferStatus = 5;

pub def TransportStatus: u8;
pub val TRANSPORT_OK:        TransportStatus = 1;
pub val TRANSPORT_EMPTY:     TransportStatus = 2;
pub val TRANSPORT_BLOCKED:   TransportStatus = 3;
pub val TRANSPORT_STALE:     TransportStatus = 4;
pub val TRANSPORT_CANCELLED: TransportStatus = 5;
pub val TRANSPORT_CLOSED:    TransportStatus = 6;
pub val TRANSPORT_ERROR:     TransportStatus = 7;

pub val BIDIRECTIONAL:  u8    = 1;
pub val UNIDIRECTIONAL: u8    = 2;
pub val NO_SLOT:        usize = (-1)::usize;
pub val NO_STREAM:      u64   = (-1)::u64;
val     MAX_STREAM_ID:  u64   = 0x3fffffffffffffff;
val     MAX_REQUEST_ID: u64   = 0x3ffffffffffffffc;

pub rec StreamHandle { source: u64; index: usize; generation: u64; id: u64; }

pub rec TransportOpen {
    status:               TransportStatus;
    stream:               StreamHandle;
    stream_limit_blocked: bool;
    storage_blocked:      bool;
    error:                u64;
}

# read advances delivery but grants no receive flow-control credit
pub rec TransportRead {
    status:            TransportStatus;
    count:             usize;
    final_size:        u64;
    application_error: u64;
    fin:               bool;
    error:             u64;
}

# write copies accepted bytes before returning
pub rec TransportWrite {
    status:             TransportStatus;
    count:              usize;
    connection_blocked: bool;
    stream_blocked:     bool;
    storage_blocked:    bool;
    error:              u64;
}

pub rec TransportOperation { status: TransportStatus; error: u64; }

# the next stream whose transport state changed, or TRANSPORT_EMPTY when none is
# waiting. a report may repeat or carry no news, but none may be dropped.
# ---
# status:   TRANSPORT_OK with a stream, or TRANSPORT_EMPTY
# handle:   the stream whose state changed
# readable: data or a FIN arrived since a read returned EMPTY or BLOCKED
# writable: send capacity opened since a write or finish returned BLOCKED
# reset:    the peer reset the stream or asked it to stop sending
pub rec TransportReady {
    status:   TransportStatus;
    handle:   StreamHandle;
    readable: bool;
    writable: bool;
    reset:    bool;
}

pub rec Transport[T] {
    context:        *T;
    open:           fun(*T, u8) TransportOpen;
    accept:         fun(*T) TransportOpen;
    ready:          fun(*T) TransportReady;
    read:           fun(*T, StreamHandle, *u8, usize) TransportRead;
    credit:         fun(*T, StreamHandle, usize) TransportOperation;
    write:          fun(*T, StreamHandle, *u8, usize) TransportWrite;
    finish:         fun(*T, StreamHandle) TransportOperation;
    cancel_send:    fun(*T, StreamHandle, u64) TransportOperation;
    cancel_receive: fun(*T, StreamHandle, u64) TransportOperation;
    release:        fun(*T, StreamHandle) TransportOperation;
    close:          fun(*T, u64) TransportOperation;
}

pub rec Settings {
    qpack_max_table_capacity: usize;
    max_field_section_size:   usize;
    qpack_blocked_streams:    usize;
    enable_connect_protocol:  bool;
    h3_datagram:              bool;
}

# stream records and request buffers are borrowed from the connection's
# std.memory.buffers account
# ---
# read_bytes:      a request stream's read buffer
# output_bytes:    a request stream's output buffer, at least the outbound encoded section plus 16
# initial_streams: stream records in the first chunk, taken at init
# stream_lane:     the budget lane of request buffers
# connection_lane: the budget lane of stream records and the index
pub rec Config {
    local:                   Settings;
    frames:                  frame.Limits;
    inbound_qpack:           qpack.Limits;
    outbound_qpack:          qpack.Limits;
    messages:                message.Limits;
    max_requests:            usize;
    max_peer_unidirectional: usize;
    max_pending_release:     usize;
    read_bytes:              usize;
    output_bytes:            usize;
    initial_streams:         usize;
    stream_lane:             u8;
    connection_lane:         u8;
}

# the buffers a stream reads, decodes and writes through. a request stream
# borrows every one; a critical stream uses only the ones its kind needs
pub rec StreamMemory {
    read:               *u8;
    read_capacity:      usize;
    settings:           *frame.Setting;
    setting_capacity:   usize;
    encoded:            *u8;
    encoded_capacity:   usize;
    fields:             *field.Field;
    field_capacity:     usize;
    strings:            *u8;
    string_capacity:    usize;
    scratch:            *u8;
    scratch_capacity:   usize;
    output:             *u8;
    output_capacity:    usize;
    references:         *u64;
    reference_capacity: usize;
}

# caller storage for the peer's three critical streams, which live for the whole
# connection and are never borrowed
# ---
# control: read, and settings for at least frames.max_settings
# encoder: read, encoded for an inbound instruction, scratch for twice an inbound field
# decoder: read, and encoded for an outbound instruction
pub rec CriticalMemory {
    control: StreamMemory;
    encoder: StreamMemory;
    decoder: StreamMemory;
}

pub rec ByteQueue { data: *u8; capacity: usize; head: usize; count: usize; }

# one open-addressed slot of the stream id index
pub rec StreamIndexEntry { id: u64; slot: usize; }

# source:  the buffer source, which must outlive the engine
# account: the connection's open account on `source`, which must outlive the engine
pub rec Storage {
    source:                      *buffers.Source;
    account:                     *buffers.Account;
    critical:                    CriticalMemory;
    pending_release:             *StreamHandle;
    pending_release_capacity:    usize;
    inbound_entries:             *qpack.Entry;
    inbound_entry_capacity:      usize;
    inbound_storage:             *u8;
    inbound_storage_capacity:    usize;
    inbound_scratch:             *u8;
    inbound_scratch_capacity:    usize;
    inbound_sections:            *qpack.Section;
    inbound_section_capacity:    usize;
    inbound_references:          *qpack.Reference;
    inbound_reference_capacity:  usize;
    outbound_entries:            *qpack.Entry;
    outbound_entry_capacity:     usize;
    outbound_storage:            *u8;
    outbound_storage_capacity:   usize;
    outbound_scratch:            *u8;
    outbound_scratch_capacity:   usize;
    outbound_sections:           *qpack.Section;
    outbound_section_capacity:   usize;
    outbound_references:         *qpack.Reference;
    outbound_reference_capacity: usize;
    control_queue:               *u8;
    control_queue_capacity:      usize;
    encoder_queue:               *u8;
    encoder_queue_capacity:      usize;
    decoder_queue:               *u8;
    decoder_queue_capacity:      usize;
}

pub def HeaderBlock: section.Block;

pub rec Event {
    kind:        EventKind;
    stream_id:   u64;
    generation:  u64;
    headers:     HeaderBlock;
    data:        *u8;
    data_length: usize;
    end_stream:  bool;
    code:        u64;
    goaway_id:   u64;
    error:       Error;
}

pub rec Offer {
    status:    OfferStatus;
    consumed:  usize;
    produced:  usize;
    stream_id: u64;
    error:     Error;
}

pub rec LocalStream { stream: StreamHandle; kind: StreamKind; opened: bool; }

pub rec Stream {
    transport_stream:         StreamHandle;
    generation:               u64;
    state:                    StreamState;
    kind:                     StreamKind;
    local:                    bool;
    critical:                 bool;
    live:                     bool;
    classifier:               frame.StreamParser;
    parser:                   frame.Parser;
    decoder:                  qpack.FieldDecoder;
    encoder_stream:           qpack.EncoderStreamDecoder;
    decoder_stream:           qpack.DecoderStreamDecoder;
    memory:                   StreamMemory;
    input_length:             usize;
    input_offset:             usize;
    input_fin:                bool;
    received_bytes:           u64;
    uncredited:               usize;
    qpack_credit:             usize;
    current_frame:            frame.Header;
    frame_started:            bool;
    initial_headers_received: bool;
    initial_headers_sent:     bool;
    final_headers_received:   bool;
    inbound_informational:    usize;
    outbound_informational:   usize;
    trailers_received:        bool;
    trailers_sent:            bool;
    inbound_has_length:       bool;
    inbound_declared_length:  u64;
    inbound_body_bytes:       u64;
    inbound_body_chunks:      usize;
    inbound_body_forbidden:   bool;
    outbound_has_length:      bool;
    outbound_declared_length: u64;
    outbound_body_bytes:      u64;
    outbound_body_chunks:     usize;
    outbound_body_forbidden:  bool;
    qpack_blocked:            bool;
    retry_pending:            bool;
    remote_end_reported:      bool;
    held:                     bool;
    held_kind:                EventKind;
    held_data:                *u8;
    held_length:              usize;
    held_headers:             HeaderBlock;
    held_end_stream:          bool;
    output_length:            usize;
    output_offset:            usize;
    output_end_stream:        bool;
    exchange:                 *exchange.Exchange;
    reset_code:               u64;
    slot:                     usize;
    next_free:                usize;
    index_position:           usize;
    ready_next:               usize;
    queued:                   bool;
    read_parked:              bool;
    write_parked:             bool;
    probe_pending:            bool;
    blocked_listed:           bool;
    blocked_required:         u64;
    blocked_next:             usize;
    blocked_prev:             usize;
    exchange_listed:          bool;
    exchange_next:            usize;
    exchange_prev:            usize;
    probe:                    u8;
    chunks:                   [7]buffers.Chunk;
    memory_held:              bool;
}

pub rec Engine[T] {
    role:                        Role;
    state:                       State;
    configured:                  Config;
    peer:                        Settings;
    transport:                   Transport[T];
    scope:                       *cancel.Scope;
    source:                      *buffers.Source;
    account:                     *buffers.Account;
    records:                     records.Records;
    stream_capacity:             usize;
    stream_index:                *StreamIndexEntry;
    index_capacity:              usize;
    index_chunk:                 buffers.Chunk;
    critical_memory:             CriticalMemory;
    discard:                     [64]u8;
    request_sets:                usize;
    parked_stream:               StreamHandle;
    accept_parked:               bool;
    accept_blocked:              bool;
    index_tombstones:            usize;
    index_rebuilds:              usize;
    free_head:                   usize;
    ready_head:                  usize;
    ready_tail:                  usize;
    ready_count:                 usize;
    blocked_head:                usize;
    exchange_head:               usize;
    output_streams:              usize;
    peer_decoder:                usize;
    slot_visits:                 usize;
    pending_release:             *StreamHandle;
    pending_release_capacity:    usize;
    pending_release_count:       usize;
    active_requests:             usize;
    active_peer_unidirectional:  usize;
    next_generation:             u64;
    critical:                    frame.CriticalStreams;
    local_control:               LocalStream;
    local_encoder:               LocalStream;
    local_decoder:               LocalStream;
    control:                     ByteQueue;
    encoder:                     ByteQueue;
    decoder:                     ByteQueue;
    inbound_table:               qpack.DynamicTable;
    outbound_table:              qpack.DynamicTable;
    inbound_sections:            qpack.Sections;
    outbound_sections:           qpack.Sections;
    outbound_section_items:      *qpack.Section;
    outbound_section_capacity:   usize;
    outbound_reference_items:    *qpack.Reference;
    outbound_reference_capacity: usize;
    outbound_limits:             qpack.Limits;
    peer_settings_received:      bool;
    local_settings_sent:         bool;
    inbound_reported:            u64;
    pending_increment:           u64;
    last_remote_request:         u64;
    remote_goaway:               u64;
    local_goaway:                u64;
    goaway_received:             bool;
    goaway_sent:                 bool;
    final_goaway_sent:           bool;
    graceful:                    bool;
    close_started:               bool;
    error:                       Error;
    h3_error:                    u64;
    initialized:                 bool;
}

val HEADER_REQUEST:       u8 = section.REQUEST;
val HEADER_RESPONSE:      u8 = section.RESPONSE;
val HEADER_INFORMATIONAL: u8 = section.INFORMATIONAL;
val HEADER_TRAILERS:      u8 = section.TRAILERS;

val INDEX_EMPTY:     usize = (-1)::usize;
val INDEX_TOMBSTONE: usize = (-2)::usize;

# the buffers a request stream borrows, all or nothing
# the chunks of one request set, see `request_requests`
pub val REQUEST_BUFFERS: usize = 7;

# transport reports and queued stream services one process call may take
val READY_BUDGET:   usize = 64;
val SERVICE_BUDGET: usize = 64;

pub fun settings_default() Settings {
    ret Settings{qpack_max_table_capacity: 4096,
        max_field_section_size:  32768, qpack_blocked_streams: 16,
        enable_connect_protocol: false, h3_datagram: false};
}

pub fun config_default() Config {
    var inbound:  qpack.Limits = qpack.limits_default();
    var outbound: qpack.Limits = qpack.limits_default();
    val local:    Settings     = settings_default();
    inbound.max_table_capacity      = local.qpack_max_table_capacity;
    inbound.max_field_section_bytes = local.max_field_section_size;
    inbound.max_blocked_streams     = local.qpack_blocked_streams;
    outbound.max_table_capacity     = local.qpack_max_table_capacity;
    ret Config{local: local, frames: frame.limits_default(),
        inbound_qpack:           inbound, outbound_qpack: outbound,
        messages:                message.limits_default(), max_requests: 100,
        max_peer_unidirectional: 32, max_pending_release: 32,
        read_bytes:              16384,
        output_bytes:            outbound.max_encoded_section_bytes + 16,
        initial_streams:         8, stream_lane: 0, connection_lane: 0};
}

fun transport_valid[T](value: *Transport[T]) bool {
    ret value != nil && value.open != nil && value.accept != nil
        && value.ready != nil && value.read != nil && value.credit != nil
        && value.write != nil && value.finish != nil
        && value.cancel_send != nil && value.cancel_receive != nil
        && value.release != nil && value.close != nil;
}

fun qpack_limits_valid(limits: qpack.Limits) bool {
    ret limits.max_instruction_bytes != 0
        && limits.max_encoded_section_bytes >= 24
        && limits.max_field_count != 0 && limits.max_field_bytes != 0
        && limits.max_field_bytes <= (-1)::usize / 2
        && limits.max_field_section_bytes != 0
        && limits.max_outstanding_sections != 0 && limits.max_references != 0;
}

# every request and peer unidirectional stream the configuration admits
fun max_streams(configured: Config) usize {
    ret configured.max_requests + configured.max_peer_unidirectional;
}

# the first chunk never holds more records than the configuration admits
fun first_streams(configured: Config) usize {
    if (configured.initial_streams > max_streams(configured)) { ret max_streams(configured); }
    ret configured.initial_streams;
}

fun config_valid(configured: Config) bool {
    ret configured.max_requests != 0
        && configured.max_peer_unidirectional >= 3
        && configured.max_requests <= (-1)::usize / 4 - configured.max_peer_unidirectional
        && configured.initial_streams != 0
        && max_streams(configured) <= records.limit(first_streams(configured))
        && configured.read_bytes != 0
        && configured.output_bytes >= 16
        && configured.output_bytes - 16 >= configured.outbound_qpack.max_encoded_section_bytes
        && configured.inbound_qpack.max_field_count <= (-1)::usize / $size_of(field.Field)
        && configured.outbound_qpack.max_field_count <= (-1)::usize / $size_of(u64)
        && configured.max_pending_release != 0
        && configured.frames.max_frame_payload != 0
        && configured.frames.max_settings >= 5
        && configured.inbound_qpack.max_encoded_section_bytes <= (-1)::usize - 16
        && configured.outbound_qpack.max_encoded_section_bytes <= (-1)::usize - 16
        && qpack_limits_valid(configured.inbound_qpack)
        && qpack_limits_valid(configured.outbound_qpack)
        && configured.local.qpack_max_table_capacity
        == configured.inbound_qpack.max_table_capacity
        && configured.local.max_field_section_size
        == configured.inbound_qpack.max_field_section_bytes
        && configured.local.qpack_blocked_streams
        == configured.inbound_qpack.max_blocked_streams
        && !configured.local.h3_datagram
        && configured.local.qpack_max_table_capacity <= qpack.MAX_INTEGER::usize
        && configured.local.max_field_section_size != 0;
}

# the caller storage a valid config needs
fun storage_valid(configured: Config, storage: *Storage) bool {
    ret storage != nil
        && storage.source != nil && storage.account != nil && storage.account.open
        && storage.pending_release != nil
        && storage.pending_release_capacity >= configured.max_pending_release
        && storage.outbound_sections != nil
        && storage.outbound_section_capacity
        >= configured.outbound_qpack.max_outstanding_sections
        && storage.outbound_references != nil
        && storage.outbound_reference_capacity
        >= configured.outbound_qpack.max_references
        && storage.inbound_sections != nil
        && storage.inbound_section_capacity
        >= configured.inbound_qpack.max_outstanding_sections
        && storage.inbound_references != nil
        && storage.inbound_reference_capacity
        >= configured.inbound_qpack.max_references
        && configured.inbound_qpack.max_table_capacity
        <= storage.inbound_storage_capacity
        && configured.inbound_qpack.max_table_capacity
        <= storage.inbound_scratch_capacity
        && configured.outbound_qpack.max_table_capacity
        <= storage.outbound_storage_capacity
        && configured.outbound_qpack.max_table_capacity
        <= storage.outbound_scratch_capacity
        && (configured.inbound_qpack.max_table_capacity == 0
        || (storage.inbound_entries != nil
        && storage.inbound_entry_capacity != 0
        && storage.inbound_storage != nil
        && storage.inbound_scratch != nil))
        && (configured.outbound_qpack.max_table_capacity == 0
        || (storage.outbound_entries != nil
        && storage.outbound_entry_capacity != 0
        && storage.outbound_storage != nil
        && storage.outbound_scratch != nil));
}

# the size of each request buffer, in StreamMemory order: read, encoded,
# fields, strings, scratch, output, references
fun request_bytes(configured: Config, index: usize) usize {
    val inbound:  qpack.Limits = configured.inbound_qpack;
    val outbound: qpack.Limits = configured.outbound_qpack;
    if (index == 0) { ret configured.read_bytes; }
    if (index == 1) { ret inbound.max_encoded_section_bytes; }
    if (index == 2) { ret inbound.max_field_count * $size_of(field.Field); }
    if (index == 3) { ret inbound.max_field_section_bytes; }
    if (index == 4) { ret inbound.max_field_bytes * 2; }
    if (index == 5) { ret configured.output_bytes; }
    ret outbound.max_field_count * $size_of(u64);
}

fun critical_valid(value: CriticalMemory, configured: Config) bool {
    val inbound:  qpack.Limits = configured.inbound_qpack;
    val outbound: qpack.Limits = configured.outbound_qpack;
    ret value.control.read != nil && value.control.read_capacity != 0
        && value.control.settings != nil
        && value.control.setting_capacity >= configured.frames.max_settings
        && value.encoder.read != nil && value.encoder.read_capacity != 0
        && value.encoder.encoded != nil
        && value.encoder.encoded_capacity >= inbound.max_instruction_bytes
        && value.encoder.scratch != nil
        && value.encoder.scratch_capacity / 2 >= inbound.max_field_bytes
        && value.decoder.read != nil && value.decoder.read_capacity != 0
        && value.decoder.encoded != nil
        && value.decoder.encoded_capacity >= outbound.max_instruction_bytes;
}

fun queue_init(queue: *ByteQueue, data: *u8, capacity: usize) bool {
    if (queue == nil || data == nil || capacity < 32) { ret false; }
    queue.data     = data;
    queue.capacity = capacity;
    queue.head     = 0;
    queue.count    = 0;
    ret true;
}

fun queue_space(queue: *ByteQueue) usize {
    ret queue.capacity - queue.count;
}

fun ring_add(start: usize, offset: usize, capacity: usize) usize {
    val until_end: usize = capacity - start;
    if (offset >= until_end) { ret offset - until_end; }
    ret start + offset;
}

fun queue_push(queue: *ByteQueue, input: *u8, length: usize) bool {
    if (queue == nil || queue.data == nil || (input == nil && length != 0)
        || length > queue_space(queue)) { ret false; }
    var index: usize = ring_add(queue.head, queue.count, queue.capacity);
    var i:     usize = 0;
    for (i < length) {
        queue.data[index] = input[i];
        index             = ring_add(index, 1, queue.capacity);
        i                 = i + 1;
    }
    queue.count = queue.count + length;
    ret true;
}

fun queue_contiguous(queue: *ByteQueue) usize {
    var length: usize = queue.count;
    if (length > queue.capacity - queue.head) { length = queue.capacity - queue.head; }
    ret length;
}

fun queue_pop(queue: *ByteQueue, length: usize) bool {
    if (queue == nil || length > queue.count) { ret false; }
    queue.head  = ring_add(queue.head, length, queue.capacity);
    queue.count = queue.count - length;
    ret true;
}

fun empty_headers() HeaderBlock {
    ret section.empty();
}

fun base_event[T](engine: *Engine[T], kind: EventKind) Event {
    ret Event{kind: kind, stream_id: NO_STREAM, generation: 0,
        headers:    empty_headers(), data: nil, data_length: 0,
        end_stream: false, code: 0, goaway_id: 0, error: engine.error};
}

fun invalid_event() Event {
    ret Event{kind: EVENT_ERROR, stream_id: NO_STREAM, generation: 0,
        headers:    empty_headers(), data: nil, data_length: 0,
        end_stream: false, code: H3_INTERNAL_ERROR, goaway_id: 0,
        error:      ERROR_STATE};
}

fun stream_event[T](engine: *Engine[T], kind: EventKind, stream: *Stream) Event {
    var result: Event = base_event[T](engine, kind);
    if (stream != nil) {
        result.stream_id  = stream.transport_stream.id;
        result.generation = stream.generation;
    }
    ret result;
}

# the slot, free link and ready-queue link survive, so callers unlink every
# other list first
fun reset_stream(stream: *Stream, memory_value: StreamMemory) {
    var classifier:     frame.StreamParser;
    var parser:         frame.Parser;
    var decoder:        qpack.FieldDecoder;
    var encoder_stream: qpack.EncoderStreamDecoder;
    var decoder_stream: qpack.DecoderStreamDecoder;
    stream.transport_stream         = StreamHandle{source: 0, index: 0, generation: 0, id: 0};
    stream.generation               = 0;
    stream.state                    = STREAM_CLOSED;
    stream.kind                     = STREAM_UNKNOWN;
    stream.local                    = false;
    stream.critical                 = false;
    stream.live                     = false;
    stream.classifier               = classifier;
    stream.parser                   = parser;
    stream.decoder                  = decoder;
    stream.encoder_stream           = encoder_stream;
    stream.decoder_stream           = decoder_stream;
    stream.memory                   = memory_value;
    stream.input_length             = 0;
    stream.input_offset             = 0;
    stream.input_fin                = false;
    stream.received_bytes           = 0;
    stream.uncredited               = 0;
    stream.qpack_credit             = 0;
    stream.current_frame            = frame.Header{typ: 0, length: 0};
    stream.frame_started            = false;
    stream.initial_headers_received = false;
    stream.initial_headers_sent     = false;
    stream.final_headers_received   = false;
    stream.inbound_informational    = 0;
    stream.outbound_informational   = 0;
    stream.trailers_received        = false;
    stream.trailers_sent            = false;
    stream.inbound_has_length       = false;
    stream.inbound_declared_length  = 0;
    stream.inbound_body_bytes       = 0;
    stream.inbound_body_chunks      = 0;
    stream.inbound_body_forbidden   = false;
    stream.outbound_has_length      = false;
    stream.outbound_declared_length = 0;
    stream.outbound_body_bytes      = 0;
    stream.outbound_body_chunks     = 0;
    stream.outbound_body_forbidden  = false;
    stream.qpack_blocked            = false;
    stream.retry_pending            = false;
    stream.remote_end_reported      = false;
    stream.held                     = false;
    stream.held_kind                = EVENT_NONE;
    stream.held_data                = nil;
    stream.held_length              = 0;
    stream.held_headers             = empty_headers();
    stream.held_end_stream          = false;
    stream.output_length            = 0;
    stream.output_offset            = 0;
    stream.output_end_stream        = false;
    stream.exchange                 = nil;
    stream.reset_code               = H3_NO_ERROR;
    stream.index_position           = NO_SLOT;
    stream.read_parked              = false;
    stream.write_parked             = false;
    stream.probe_pending            = false;
    stream.blocked_listed           = false;
    stream.blocked_required         = 0;
    stream.blocked_next             = NO_SLOT;
    stream.blocked_prev             = NO_SLOT;
    stream.exchange_listed          = false;
    stream.exchange_next            = NO_SLOT;
    stream.exchange_prev            = NO_SLOT;
}

fun next_generation[T](engine: *Engine[T]) u64 {
    val result: u64 = engine.next_generation;
    if (result == (-1)::u64) { engine.next_generation = 0; }
    or                       { engine.next_generation = result + 1; }
    ret result;
}

fun local_initiated[T](engine: *Engine[T], id: u64) bool {
    if (engine.role == CLIENT) { ret (id & 1) == 0; }
    ret (id & 1) == 1;
}

fun unidirectional(id: u64) bool {
    ret (id & 2) != 0;
}

fun request_id(id: u64) bool {
    ret (id & 3) == 0;
}

fun slot_stream[T](engine: *Engine[T], slot: usize) *Stream {
    ret records.at(?engine.records, slot)::*Stream;
}

# fmix64, so sequential stream ids spread across the whole index
fun index_hash(id: u64) u64 {
    var x: u64 = id;
    x = x ^ (x >> 33);
    x = x * 0xff51afd7ed558ccd;
    x = x ^ (x >> 33);
    x = x * 0xc4ceb9fe1a85ec53;
    ret x ^ (x >> 33);
}

fun index_find[T](engine: *Engine[T], id: u64) usize {
    val mask:     usize = engine.index_capacity - 1;
    var position: usize = index_hash(id)::usize & mask;
    var probes:   usize = 0;
    for (probes < engine.index_capacity) {
        val entry: StreamIndexEntry = engine.stream_index[position];
        if (entry.slot == INDEX_EMPTY)                       { ret NO_SLOT; }
        if (entry.slot != INDEX_TOMBSTONE && entry.id == id) { ret entry.slot; }
        position = (position + 1) & mask;
        probes   = probes + 1;
    }
    ret NO_SLOT;
}

# the caller has checked the id is absent
fun index_insert[T](engine: *Engine[T], stream: *Stream) {
    val mask:      usize = engine.index_capacity - 1;
    var position:  usize = index_hash(stream.transport_stream.id)::usize & mask;
    var tombstone: usize = NO_SLOT;
    var probes:    usize = 0;
    for (probes < engine.index_capacity
        && engine.stream_index[position].slot != INDEX_EMPTY) {
        if (tombstone == NO_SLOT
            && engine.stream_index[position].slot == INDEX_TOMBSTONE) { tombstone = position; }
        position = (position + 1) & mask;
        probes   = probes + 1;
    }
    if (tombstone != NO_SLOT) {
        position                = tombstone;
        engine.index_tombstones = engine.index_tombstones - 1;
    }
    engine.stream_index[position] = StreamIndexEntry{id: stream.transport_stream.id,
        slot: stream.slot};
    stream.index_position = position;
}

fun index_rebuild[T](engine: *Engine[T]) {
    var i: usize = 0;
    for (i < engine.index_capacity) {
        engine.stream_index[i] = StreamIndexEntry{id: 0, slot: INDEX_EMPTY};
        i                      = i + 1;
    }
    engine.index_tombstones = 0;
    engine.index_rebuilds   = engine.index_rebuilds + 1;
    i                       = 0;
    for (i < engine.stream_capacity) {
        val stream: *Stream = slot_stream[T](engine, i);
        if (stream.index_position != NO_SLOT) { index_insert[T](engine, stream); }
        i = i + 1;
    }
}

# a rebuild follows at least a quarter capacity of removals, so removal stays
# amortized constant
fun index_remove[T](engine: *Engine[T], stream: *Stream) {
    if (stream.index_position == NO_SLOT) { ret; }
    engine.stream_index[stream.index_position].slot = INDEX_TOMBSTONE;
    stream.index_position                           = NO_SLOT;
    engine.index_tombstones                         = engine.index_tombstones + 1;
    if (engine.index_tombstones > engine.index_capacity / 4) { index_rebuild[T](engine); }
}

pub fun stream_for[T](engine: *Engine[T], id: u64) *Stream {
    if (engine == nil || !engine.initialized || id > MAX_STREAM_ID) { ret nil; }
    val slot: usize = index_find[T](engine, id);
    if (slot == NO_SLOT) { ret nil; }
    ret slot_stream[T](engine, slot);
}

fun ready_push[T](engine: *Engine[T], stream: *Stream) {
    if (stream.queued) { ret; }
    stream.queued     = true;
    stream.ready_next = NO_SLOT;
    if (engine.ready_tail == NO_SLOT) { engine.ready_head = stream.slot; }
    or                                { slot_stream[T](engine, engine.ready_tail).ready_next = stream.slot; }
    engine.ready_tail  = stream.slot;
    engine.ready_count = engine.ready_count + 1;
}

fun ready_pop[T](engine: *Engine[T]) *Stream {
    if (engine.ready_head == NO_SLOT) { ret nil; }
    val stream: *Stream = slot_stream[T](engine, engine.ready_head);
    engine.ready_head = stream.ready_next;
    if (engine.ready_head == NO_SLOT) { engine.ready_tail = NO_SLOT; }
    engine.ready_count = engine.ready_count - 1;
    stream.queued      = false;
    stream.ready_next  = NO_SLOT;
    ret stream;
}

fun wake_stream[T](engine: *Engine[T], stream: *Stream) {
    if (stream_has_work[T](engine, stream)) { ready_push[T](engine, stream); }
}

fun blocked_unlink[T](engine: *Engine[T], stream: *Stream) {
    if (!stream.blocked_listed)         { ret; }
    if (stream.blocked_prev == NO_SLOT) { engine.blocked_head = stream.blocked_next; }
    or                                  { slot_stream[T](engine, stream.blocked_prev).blocked_next = stream.blocked_next; }
    if (stream.blocked_next != NO_SLOT) {
        slot_stream[T](engine, stream.blocked_next).blocked_prev = stream.blocked_prev;
    }
    stream.blocked_listed = false;
    stream.blocked_next   = NO_SLOT;
    stream.blocked_prev   = NO_SLOT;
}

# ordered by required insert count, so an insert wakes exactly a prefix
fun blocked_link[T](engine: *Engine[T], stream: *Stream, required: u64) {
    if (stream.blocked_listed) { ret; }
    var previous: usize = NO_SLOT;
    var next:     usize = engine.blocked_head;
    for (next != NO_SLOT && slot_stream[T](engine, next).blocked_required <= required) {
        previous = next;
        next     = slot_stream[T](engine, next).blocked_next;
    }
    stream.blocked_required = required;
    stream.blocked_prev     = previous;
    stream.blocked_next     = next;
    stream.blocked_listed   = true;
    if (previous == NO_SLOT) { engine.blocked_head = stream.slot; }
    or                       { slot_stream[T](engine, previous).blocked_next = stream.slot; }
    if (next != NO_SLOT)     { slot_stream[T](engine, next).blocked_prev = stream.slot; }
}

fun set_blocked[T](engine: *Engine[T], stream: *Stream) {
    stream.qpack_blocked = true;
    blocked_link[T](engine, stream, stream.decoder.required_insert_count);
}

fun clear_blocked[T](engine: *Engine[T], stream: *Stream) {
    stream.qpack_blocked = false;
    stream.probe_pending = false;
    blocked_unlink[T](engine, stream);
}

fun wake_unblocked[T](engine: *Engine[T]) {
    for (engine.blocked_head != NO_SLOT) {
        val stream: *Stream = slot_stream[T](engine, engine.blocked_head);
        if (stream.blocked_required > engine.inbound_table.insert_count) { brk; }
        blocked_unlink[T](engine, stream);
        ready_push[T](engine, stream);
    }
}

fun exchange_link[T](engine: *Engine[T], stream: *Stream) {
    if (stream.exchange_listed) { ret; }
    stream.exchange_prev   = NO_SLOT;
    stream.exchange_next   = engine.exchange_head;
    stream.exchange_listed = true;
    if (engine.exchange_head != NO_SLOT) {
        slot_stream[T](engine, engine.exchange_head).exchange_prev = stream.slot;
    }
    engine.exchange_head = stream.slot;
}

fun exchange_unlink[T](engine: *Engine[T], stream: *Stream) {
    if (!stream.exchange_listed)         { ret; }
    if (stream.exchange_prev == NO_SLOT) { engine.exchange_head = stream.exchange_next; }
    or                                   { slot_stream[T](engine, stream.exchange_prev).exchange_next = stream.exchange_next; }
    if (stream.exchange_next != NO_SLOT) {
        slot_stream[T](engine, stream.exchange_next).exchange_prev = stream.exchange_prev;
    }
    stream.exchange_listed = false;
    stream.exchange_next   = NO_SLOT;
    stream.exchange_prev   = NO_SLOT;
}

fun output_pending(stream: *Stream) bool {
    ret stream.output_length != 0 || stream.output_end_stream;
}

fun unbound_memory() StreamMemory {
    ret StreamMemory{read: nil, read_capacity: 0, settings: nil, setting_capacity: 0,
        encoded: nil, encoded_capacity: 0, fields: nil, field_capacity: 0,
        strings: nil, string_capacity: 0, scratch: nil, scratch_capacity: 0,
        output:  nil, output_capacity: 0, references: nil, reference_capacity: 0};
}

# an unclassified peer stream reads one byte at a time into its own record, so
# the type is known before a byte of the stream's frames arrives
fun probe_memory(stream: *Stream) StreamMemory {
    var value: StreamMemory = unbound_memory();
    value.read          = ?stream.probe;
    value.read_capacity = 1;
    ret value;
}

# an ignored stream's bytes are credited in the call that reads them
fun discard_memory[T](engine: *Engine[T]) StreamMemory {
    var value: StreamMemory = unbound_memory();
    value.read          = ?engine.discard[0];
    value.read_capacity = 64;
    ret value;
}

fun granted(got: buffers.Acquired) bool {
    ret sel got.status.ok;
}

fun buffer_request(bytes: usize, align: usize, lane: u8) buffers.Request {
    ret buffers.Request{bytes: bytes, align: align, lane: lane, secret: false};
}

fun release_chunk[T](engine: *Engine[T], chunk: buffers.Chunk) {
    buffers.source_release(engine.source, engine.account, chunk);
}

fun index_bytes(capacity: usize) usize {
    ret capacity * $size_of(StreamIndexEntry);
}

# the index holds every slot at most half full
fun index_size(slots: usize) usize {
    var size: usize = 8;
    for (size < 2 * slots) { size = size * 2; }
    ret size;
}

# a record fresh from a chunk, unbound and on no list
fun prepare_slot[T](engine: *Engine[T], slot: usize) {
    val stream: *Stream = slot_stream[T](engine, slot);
    reset_stream(stream, unbound_memory());
    stream.slot        = slot;
    stream.next_free   = NO_SLOT;
    stream.ready_next  = NO_SLOT;
    stream.queued      = false;
    stream.probe       = 0;
    stream.memory_held = false;
}

# the new records go on the free list lowest slot first
fun attach_records[T](engine: *Engine[T], records_chunk: buffers.Chunk) {
    val previous: usize = engine.stream_capacity;
    records.attach(?engine.records, records_chunk);
    engine.stream_capacity = engine.records.capacity;
    var slot: usize = engine.stream_capacity;
    for (slot > previous) {
        slot = slot - 1;
        prepare_slot[T](engine, slot);
        slot_stream[T](engine, slot).next_free = engine.free_head;
        engine.free_head                       = slot;
    }
}

# one more record chunk and an index sized for it, all or nothing. the table
# never shrinks while the connection lives and stops growing at max_streams
fun grow_streams[T](engine: *Engine[T], register: bool) bool {
    if (engine.stream_capacity >= max_streams(engine.configured)) { ret false; }
    val lane:    u8              = engine.configured.connection_lane;
    val request: buffers.Request = records.next_request(?engine.records, lane);
    if (request.bytes == 0) { ret false; }
    val size: usize = index_size(engine.stream_capacity
        + request.bytes / engine.records.element_size);
    var requests: [2]buffers.Request = [2]buffers.Request{
        request, buffer_request(index_bytes(size), 0, lane),
    };
    var chunks: [2]buffers.Chunk;
    val got:    buffers.Acquired = buffers.source_acquire_n(engine.source, engine.account,
        ?requests[0], 2, ?chunks[0], register);
    if (!granted(got)) { ret false; }
    attach_records[T](engine, chunks[0]);
    val old: buffers.Chunk = engine.index_chunk;
    engine.index_chunk    = chunks[1];
    engine.stream_index   = chunks[1].data::*StreamIndexEntry;
    engine.index_capacity = size;
    index_rebuild[T](engine);
    release_chunk[T](engine, old);
    ret true;
}

fun take_slot[T](engine: *Engine[T], register: bool) usize {
    if (engine.free_head == NO_SLOT && !grow_streams[T](engine, register)) { ret NO_SLOT; }
    val slot:   usize   = engine.free_head;
    val stream: *Stream = slot_stream[T](engine, slot);
    engine.free_head = stream.next_free;
    stream.next_free = NO_SLOT;
    ret slot;
}

fun give_slot[T](engine: *Engine[T], stream: *Stream) {
    stream.next_free = engine.free_head;
    engine.free_head = stream.slot;
}

# a request stream's buffers, all or nothing. a refusal refuses only the stream
# and registers nothing, since a refused stream gets no wake-up
# the requests one request set is acquired with, REQUEST_BUFFERS of them into
# `out`. this is the one table `acquire_request_memory` reads, so a host that
# funds requests from the same table can never fall out of step with the engine
pub fun request_requests(configured: Config, out: *buffers.Request) bool {
    if (out == nil || !config_valid(configured)) { ret false; }
    var i: usize = 0;
    for (i < REQUEST_BUFFERS) {
        out[i] = buffer_request(request_bytes(configured, i), 0, configured.stream_lane);
        i      = i + 1;
    }
    ret true;
}

fun acquire_request_memory[T](engine: *Engine[T], stream: *Stream) bool {
    var requests: [REQUEST_BUFFERS]buffers.Request;
    request_requests(engine.configured, ?requests[0]);
    val got: buffers.Acquired = buffers.source_acquire_n(engine.source, engine.account,
        ?requests[0], REQUEST_BUFFERS, ?stream.chunks[0], false);
    if (!granted(got)) { ret false; }
    val inbound:  qpack.Limits = engine.configured.inbound_qpack;
    val outbound: qpack.Limits = engine.configured.outbound_qpack;
    var value:    StreamMemory = unbound_memory();
    value.read               = stream.chunks[0].data;
    value.read_capacity      = engine.configured.read_bytes;
    value.encoded            = stream.chunks[1].data;
    value.encoded_capacity   = inbound.max_encoded_section_bytes;
    value.fields             = stream.chunks[2].data::*field.Field;
    value.field_capacity     = inbound.max_field_count;
    value.strings            = stream.chunks[3].data;
    value.string_capacity    = inbound.max_field_section_bytes;
    value.scratch            = stream.chunks[4].data;
    value.scratch_capacity   = inbound.max_field_bytes * 2;
    value.output             = stream.chunks[5].data;
    value.output_capacity    = engine.configured.output_bytes;
    value.references         = stream.chunks[6].data::*u64;
    value.reference_capacity = outbound.max_field_count;
    stream.memory            = value;
    stream.memory_held       = true;
    engine.request_sets      = engine.request_sets + 1;
    ret true;
}

fun release_request_memory[T](engine: *Engine[T], stream: *Stream) {
    if (!stream.memory_held) { ret; }
    var i: usize = REQUEST_BUFFERS;
    for (i != 0) {
        i = i - 1;
        release_chunk[T](engine, stream.chunks[i]);
    }
    stream.memory_held  = false;
    stream.memory       = unbound_memory();
    engine.request_sets = engine.request_sets - 1;
}

# a record and, for a request, its buffers, not yet bound to a transport stream.
# a request holds its record until released, closed or not, so at most
# max_requests of them keep max_peer_unidirectional records under the cap
fun prepare_stream[T](engine: *Engine[T], kind: StreamKind) *Stream {
    if (engine.next_generation == 0 || (kind == STREAM_REQUEST
        && engine.request_sets >= engine.configured.max_requests)) { ret nil; }
    val slot: usize = take_slot[T](engine, false);
    if (slot == NO_SLOT) { ret nil; }
    val stream: *Stream = slot_stream[T](engine, slot);
    reset_stream(stream, probe_memory(stream));
    if (kind == STREAM_REQUEST && !acquire_request_memory[T](engine, stream)) {
        reset_stream(stream, unbound_memory());
        give_slot[T](engine, stream);
        ret nil;
    }
    ret stream;
}

fun unprepare_stream[T](engine: *Engine[T], stream: *Stream) {
    release_request_memory[T](engine, stream);
    reset_stream(stream, unbound_memory());
    give_slot[T](engine, stream);
}

fun start_stream[T](engine: *Engine[T], stream: *Stream, value: StreamHandle,
    local: bool, kind: StreamKind) *Stream {
    stream.transport_stream = value;
    stream.generation       = next_generation[T](engine);
    stream.state            = STREAM_OPEN;
    stream.kind             = kind;
    stream.local            = local;
    stream.live             = true;
    if (kind == STREAM_REQUEST) { engine.active_requests = engine.active_requests + 1; }
    if (!local && unidirectional(value.id)) {
        engine.active_peer_unidirectional = engine.active_peer_unidirectional + 1;
    }
    index_insert[T](engine, stream);
    ready_push[T](engine, stream);
    ret stream;
}

fun stream_admissible[T](engine: *Engine[T], value: StreamHandle) bool {
    ret engine.next_generation != 0 && value.generation != 0
        && value.id <= MAX_STREAM_ID && index_find[T](engine, value.id) == NO_SLOT;
}

fun allocate_stream[T](engine: *Engine[T], value: StreamHandle,
    local: bool, kind: StreamKind) *Stream {
    if (!stream_admissible[T](engine, value)) { ret nil; }
    val stream: *Stream = prepare_stream[T](engine, kind);
    if (stream == nil) { ret nil; }
    ret start_stream[T](engine, stream, value, local, kind);
}

# returns a slot and its buffers. a still-queued slot stays queued and is
# skipped when popped, or serviced as its successor if reused first.
fun free_stream[T](engine: *Engine[T], stream: *Stream) {
    if (!stream.live) { ret; }
    index_remove[T](engine, stream);
    blocked_unlink[T](engine, stream);
    exchange_unlink[T](engine, stream);
    if (output_pending(stream) && engine.output_streams != 0) {
        engine.output_streams = engine.output_streams - 1;
    }
    release_request_memory[T](engine, stream);
    reset_stream(stream, unbound_memory());
    give_slot[T](engine, stream);
}

fun stream_terminal(stream: *Stream) bool {
    ret stream.state == STREAM_CLOSED;
}

fun stream_readable(stream: *Stream) bool {
    ret stream != nil && (stream.state == STREAM_OPEN
        || stream.state == STREAM_HALF_CLOSED_LOCAL);
}

fun stream_writable(stream: *Stream) bool {
    ret stream != nil && (stream.state == STREAM_OPEN
        || stream.state == STREAM_HALF_CLOSED_REMOTE);
}

fun transport_status(value: TransportStatus) bool {
    ret value >= TRANSPORT_OK && value <= TRANSPORT_ERROR;
}

fun encode_settings(settings: Settings, output: *u8, capacity: usize) usize {
    var payload: [80]u8;
    var length:  usize = 0;
    var written: usize = 0;
    written = frame.encode_setting(frame.Setting{
        identifier: frame.SETTING_QPACK_MAX_TABLE_CAPACITY,
        value:      settings.qpack_max_table_capacity::u64
    }, ?payload[length], 80 - length);
    if (written == 0) { ret 0; }
    length  = length + written;
    written = frame.encode_setting(frame.Setting{
        identifier: frame.SETTING_MAX_FIELD_SECTION_SIZE,
        value:      settings.max_field_section_size::u64
    }, ?payload[length], 80 - length);
    if (written == 0) { ret 0; }
    length  = length + written;
    written = frame.encode_setting(frame.Setting{
        identifier: frame.SETTING_QPACK_BLOCKED_STREAMS,
        value:      settings.qpack_blocked_streams::u64
    }, ?payload[length], 80 - length);
    if (written == 0) { ret 0; }
    length = length + written;
    if (settings.enable_connect_protocol) {
        written = frame.encode_setting(frame.Setting{
            identifier: frame.SETTING_ENABLE_CONNECT_PROTOCOL, value: 1
        },
            ?payload[length], 80 - length);
        if (written == 0) { ret 0; }
        length = length + written;
    }
    if (settings.h3_datagram) {
        written = frame.encode_setting(frame.Setting{
            identifier: frame.SETTING_H3_DATAGRAM, value: 1
        },
            ?payload[length], 80 - length);
        if (written == 0) { ret 0; }
        length = length + written;
    }
    val first: usize = frame.encode_varint(frame.FRAME_SETTINGS, output, capacity);
    if (first == 0) { ret 0; }
    val second: usize = frame.encode_varint(length::u64,
        ?output[first], capacity - first);
    if (second == 0 || length > capacity - first - second) { ret 0; }
    memory.raw_copy(?output[first + second], ?payload[0], length);
    ret first + second + length;
}

fun queue_stream_prefix(queue: *ByteQueue, stream_type: u64) bool {
    var bytes:  [8]u8;
    val length: usize = frame.encode_varint(stream_type, ?bytes[0], 8);
    ret length != 0 && queue_push(queue, ?bytes[0], length);
}

fun init_tables[T](engine: *Engine[T], storage: *Storage, configured: Config) bool {
    if (!qpack.table_init(?engine.inbound_table, storage.inbound_entries,
        storage.inbound_entry_capacity, storage.inbound_storage,
        storage.inbound_storage_capacity, storage.inbound_scratch,
        storage.inbound_scratch_capacity, configured.inbound_qpack.max_table_capacity)
        || !qpack.table_init(?engine.outbound_table, storage.outbound_entries,
        storage.outbound_entry_capacity, storage.outbound_storage,
        storage.outbound_storage_capacity, storage.outbound_scratch,
        storage.outbound_scratch_capacity, configured.outbound_qpack.max_table_capacity)
        || !qpack.sections_init(?engine.inbound_sections,
        storage.inbound_sections, storage.inbound_section_capacity,
        storage.inbound_references, storage.inbound_reference_capacity,
        ?engine.inbound_table, configured.inbound_qpack)) { ret false; }
    engine.outbound_section_items      = storage.outbound_sections;
    engine.outbound_section_capacity   = storage.outbound_section_capacity;
    engine.outbound_reference_items    = storage.outbound_references;
    engine.outbound_reference_capacity = storage.outbound_reference_capacity;
    ret true;
}

pub fun init[T](engine: *Engine[T], role: Role, transport: Transport[T],
    scope: *cancel.Scope, storage: Storage, configured: Config) bool {
    if (engine == nil || engine.initialized || (role != SERVER && role != CLIENT)
        || !transport_valid[T](?transport) || scope == nil
        || !scope_active(scope) || !config_valid(configured) || !storage_valid(configured, ?storage)
        || !critical_valid(storage.critical, configured)
        || storage.control_queue == nil || storage.encoder_queue == nil
        || storage.decoder_queue == nil
        || storage.control_queue_capacity < 64
        || storage.encoder_queue_capacity < 32
        || storage.decoder_queue_capacity < 32) { ret false; }
    var settings_bytes:  [96]u8;
    val settings_length: usize = encode_settings(configured.local,
        ?settings_bytes[0], 96);
    if (settings_length == 0
        || settings_length >= storage.control_queue_capacity) { ret false; }
    if (!queue_init(?engine.control, storage.control_queue,
        storage.control_queue_capacity)
        || !queue_init(?engine.encoder, storage.encoder_queue,
        storage.encoder_queue_capacity)
        || !queue_init(?engine.decoder, storage.decoder_queue,
        storage.decoder_queue_capacity)
        || !frame.critical_init(?engine.critical)) { ret false; }
    if (!init_tables[T](engine, ?storage, configured)
        || !records.make(?engine.records, $size_of(Stream), first_streams(configured))) {
        ret false;
    }
    # the first record chunk and its index are taken here, and a refusal fails init
    val lane:     u8                 = configured.connection_lane;
    val first:    buffers.Request    = records.next_request(?engine.records, lane);
    val size:     usize              = index_size(first.bytes / engine.records.element_size);
    var requests: [2]buffers.Request = [2]buffers.Request{
        first, buffer_request(index_bytes(size), 0, lane),
    };
    var chunks: [2]buffers.Chunk;
    if (!granted(buffers.source_acquire_n(storage.source, storage.account,
        ?requests[0], 2, ?chunks[0], false))) { ret false; }
    engine.source          = storage.source;
    engine.account         = storage.account;
    engine.stream_capacity = 0;
    engine.free_head       = NO_SLOT;
    attach_records[T](engine, chunks[0]);
    engine.index_chunk    = chunks[1];
    engine.stream_index   = chunks[1].data::*StreamIndexEntry;
    engine.index_capacity = size;
    engine.index_rebuilds = 0;
    index_rebuild[T](engine);
    engine.critical_memory = storage.critical;
    engine.request_sets    = 0;
    engine.accept_parked   = false;
    engine.accept_blocked  = false;
    engine.role            = role;
    engine.state           = STARTING;
    engine.configured      = configured;
    engine.peer            = Settings{qpack_max_table_capacity: 0,
        max_field_section_size: (-1)::usize, qpack_blocked_streams: 0,
        enable_connect_protocol:                                    false, h3_datagram: false};
    engine.transport                  = transport;
    engine.scope                      = scope;
    engine.index_tombstones           = 0;
    engine.index_rebuilds             = 0;
    engine.ready_head                 = NO_SLOT;
    engine.ready_tail                 = NO_SLOT;
    engine.ready_count                = 0;
    engine.blocked_head               = NO_SLOT;
    engine.exchange_head              = NO_SLOT;
    engine.output_streams             = 0;
    engine.peer_decoder               = NO_SLOT;
    engine.slot_visits                = 0;
    engine.pending_release            = storage.pending_release;
    engine.pending_release_capacity   = configured.max_pending_release;
    engine.pending_release_count      = 0;
    engine.active_requests            = 0;
    engine.active_peer_unidirectional = 0;
    engine.next_generation            = 1;
    engine.local_control.kind         = STREAM_CONTROL;
    engine.local_encoder.kind         = STREAM_QPACK_ENCODER;
    engine.local_decoder.kind         = STREAM_QPACK_DECODER;
    engine.local_control.opened       = false;
    engine.local_encoder.opened       = false;
    engine.local_decoder.opened       = false;
    engine.peer_settings_received     = false;
    engine.local_settings_sent        = false;
    engine.inbound_reported           = 0;
    engine.pending_increment          = 0;
    engine.last_remote_request        = NO_STREAM;
    engine.remote_goaway              = MAX_STREAM_ID;
    engine.local_goaway               = MAX_STREAM_ID;
    engine.goaway_received            = false;
    engine.goaway_sent                = false;
    engine.final_goaway_sent          = false;
    engine.graceful                   = false;
    engine.close_started              = false;
    engine.error                      = ERROR_NONE;
    engine.h3_error                   = H3_NO_ERROR;
    engine.outbound_limits            = configured.outbound_qpack;
    engine.initialized                = true;
    if (!queue_stream_prefix(?engine.control, frame.STREAM_CONTROL)
        || !queue_stream_prefix(?engine.encoder, frame.STREAM_QPACK_ENCODER)
        || !queue_stream_prefix(?engine.decoder, frame.STREAM_QPACK_DECODER)
        || !queue_push(?engine.control, ?settings_bytes[0], settings_length)) {
        release_all[T](engine);
        engine.initialized = false;
        ret false;
    }
    ret true;
}

pub fun exchange_for[T](engine: *Engine[T], id: u64) *exchange.Exchange {
    val stream: *Stream = stream_for[T](engine, id);
    if (stream == nil) { ret nil; }
    ret stream.exchange;
}

pub fun bind_exchange[T](engine: *Engine[T], id: u64,
    bound: *exchange.Exchange) bool {
    val stream: *Stream = stream_for[T](engine, id);
    if (stream == nil || stream.kind != STREAM_REQUEST || bound == nil
        || !bound.valid || stream.exchange != nil || bound.generation != stream.generation
        || bound.request.metadata.version.wire != message.WIRE_H3
        || bound.request.metadata.request_index != id
        || bound.scope == nil || !scope_active(bound.scope)) { ret false; }
    stream.exchange = bound;
    exchange_link[T](engine, stream);
    ret true;
}

pub fun dispatch[T](engine: *Engine[T], id: u64,
    service: *exchange.Service) exchange.ServiceStatus {
    val stream: *Stream = stream_for[T](engine, id);
    if (stream == nil || stream.exchange == nil
        || !exchange.begin(stream.exchange)) { ret exchange.SERVICE_FAILED; }
    ret exchange.dispatch(service, stream.exchange);
}

fun configured_field_limits[T](engine: *Engine[T], kind: u8,
    outbound: bool) field.Limits {
    if (kind == HEADER_REQUEST)  { ret engine.configured.messages.request_fields; }
    if (kind == HEADER_RESPONSE) { ret engine.configured.messages.response_fields; }
    if (kind == HEADER_INFORMATIONAL) {
        ret engine.configured.messages.informational_fields;
    }
    if ((outbound && engine.role == CLIENT)
        || (!outbound && engine.role == SERVER)) {
        ret engine.configured.messages.request_trailers;
    }
    ret engine.configured.messages.response_trailers;
}

fun regular_fields_within(items: *field.Field, count: usize,
    offset: usize, configured: field.Limits, trailers: bool) bool {
    if (offset > count || count - offset > configured.max_count) { ret false; }
    var bytes: usize = 0;
    var i:     usize = offset;
    for (i < count) {
        val item: field.Field = items[i];
        if (item.name.len > configured.max_name_bytes
            || item.value.len > configured.max_value_bytes
            || (trailers && !field.allowed_trailer_name(item.name))
            || item.name.len > configured.max_bytes
            || item.value.len > configured.max_bytes - item.name.len) { ret false; }
        val added: usize = item.name.len + item.value.len;
        if (bytes > configured.max_bytes - added) { ret false; }
        bytes = bytes + added;
        i     = i + 1;
    }
    ret true;
}

fun header_fields_within[T](engine: *Engine[T], block: HeaderBlock,
    kind: u8, outbound: bool) bool {
    ret regular_fields_within(block.fields, block.count,
        block.regular_offset, configured_field_limits[T](engine, kind, outbound),
        kind == HEADER_TRAILERS);
}

fun request_target_within[T](engine: *Engine[T], block: HeaderBlock) bool {
    val configured: target.Limits = engine.configured.messages.target;
    if (block.method.len > engine.configured.messages.max_method_bytes
        || block.protocol.len > engine.configured.messages.max_method_bytes
        || block.scheme.len > configured.max_scheme_bytes
        || block.authority.len > configured.max_authority_bytes) { ret false; }
    if (block.path.len == 0) {
        ret block.authority.len <= configured.max_raw_bytes;
    }
    if (block.path.len > configured.max_raw_bytes) { ret false; }
    var path_length:  usize = block.path.len;
    var query_length: usize = 0;
    var i:            usize = 0;
    for (i < block.path.len) {
        if (block.path.data[i] == '?') {
            path_length  = i;
            query_length = block.path.len - i - 1;
            i            = block.path.len;
        }
        or { i = i + 1; }
    }
    ret path_length <= configured.max_path_bytes
        && query_length <= configured.max_query_bytes;
}

fun inbound_body_limits[T](engine: *Engine[T]) body.Limits {
    if (engine.role == SERVER) { ret engine.configured.messages.request_body; }
    ret engine.configured.messages.response_body;
}

fun outbound_body_limits[T](engine: *Engine[T]) body.Limits {
    if (engine.role == CLIENT) { ret engine.configured.messages.request_body; }
    ret engine.configured.messages.response_body;
}

fun qpack_error_code(error: qpack.Error, encoder_stream: bool) u64 {
    if (encoder_stream || error == qpack.ERROR_ENCODER_STREAM) {
        ret QPACK_ENCODER_STREAM_ERROR;
    }
    if (error == qpack.ERROR_DECODER_STREAM) { ret QPACK_DECODER_STREAM_ERROR; }
    ret QPACK_DECOMPRESSION_FAILED;
}

fun frame_error_code(error: frame.Error) u64 {
    if (error == frame.ERROR_SETTINGS)         { ret H3_SETTINGS_ERROR; }
    if (error == frame.ERROR_MISSING_SETTINGS) { ret H3_MISSING_SETTINGS; }
    if (error == frame.ERROR_STREAM_CREATION)  { ret H3_STREAM_CREATION_ERROR; }
    if (error == frame.ERROR_EXCESSIVE_LOAD)   { ret H3_EXCESSIVE_LOAD; }
    if (error == frame.ERROR_FRAME_UNEXPECTED) { ret H3_FRAME_UNEXPECTED; }
    ret H3_FRAME_ERROR;
}

fun cancel_all_streams[T](engine: *Engine[T], code: u64) {
    var i: usize = 0;
    for (i < engine.stream_capacity) {
        val stream: *Stream = slot_stream[T](engine, i);
        if (stream.live && !stream_terminal(stream)) {
            if (stream.exchange != nil) { exchange.cancel_exchange(stream.exchange); }
            if (stream_readable(stream)) {
                engine.transport.cancel_receive(engine.transport.context,
                    stream.transport_stream, code);
            }
            if (stream_writable(stream)) {
                engine.transport.cancel_send(engine.transport.context,
                    stream.transport_stream, code);
            }
            mark_closed[T](engine, stream);
            stream.reset_code = code;
        }
        i = i + 1;
    }
}

fun fail_connection[T](engine: *Engine[T], error: Error, code: u64) Event {
    if (engine.state != FAILED && engine.state != CLOSED) {
        engine.error    = error;
        engine.h3_error = code;
        engine.state    = FAILED;
        cancel_all_streams[T](engine, code);
        if (!engine.close_started) {
            val closed: TransportOperation = engine.transport.close(
                engine.transport.context, code);
            engine.close_started = closed.status == TRANSPORT_OK
                || closed.status == TRANSPORT_CLOSED;
        }
    }
    var result: Event = base_event[T](engine, EVENT_ERROR);
    result.code = code;
    if (error == ERROR_CANCELLED) { result.kind = EVENT_CANCELLED; }
    ret result;
}

fun queue_cancel[T](engine: *Engine[T], id: u64) bool {
    var bytes:  [8]u8;
    val length: usize = qpack.encode_stream_cancel(id, ?bytes[0], 8);
    ret length != 0 && queue_push(?engine.decoder, ?bytes[0], length);
}

fun stream_failure[T](engine: *Engine[T], stream: *Stream, code: u64) Event {
    if (stream == nil || stream.critical) {
        ret fail_connection[T](engine, ERROR_PROTOCOL, H3_CLOSED_CRITICAL_STREAM);
    }
    if (!stream_terminal(stream)) {
        val receive: TransportOperation = engine.transport.cancel_receive(
            engine.transport.context, stream.transport_stream, code);
        val send: TransportOperation = engine.transport.cancel_send(
            engine.transport.context, stream.transport_stream, code);
        if (receive.status != TRANSPORT_OK || send.status != TRANSPORT_OK) {
            ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
        }
        if (stream.qpack_blocked) {
            qpack.field_decoder_cancel(?stream.decoder);
            clear_blocked[T](engine, stream);
            if (!queue_cancel[T](engine, stream.transport_stream.id)) {
                ret fail_connection[T](engine, ERROR_LIMIT, H3_EXCESSIVE_LOAD);
            }
        }
        if (stream.exchange != nil) { exchange.cancel_exchange(stream.exchange); }
        mark_closed[T](engine, stream);
        stream.reset_code = code;
    }
    var result: Event = stream_event[T](engine, EVENT_STREAM_ERROR, stream);
    result.code = code;
    ret result;
}

val RELEASE_DONE:   u8 = 1;
val RELEASE_PARKED: u8 = 2;
val RELEASE_FULL:   u8 = 3;
val RELEASE_FAILED: u8 = 4;

fun park_release[T](engine: *Engine[T], value: StreamHandle) u8 {
    if (engine.pending_release_count >= engine.pending_release_capacity) {
        ret RELEASE_FULL;
    }
    engine.pending_release[engine.pending_release_count] = value;
    engine.pending_release_count                         = engine.pending_release_count + 1;
    ret RELEASE_PARKED;
}

# a cancelled stream is not settled until the peer has acknowledged the reset
# and stop, so a blocked release is retried rather than failing the connection
fun release_or_park[T](engine: *Engine[T], value: StreamHandle) u8 {
    val released: TransportOperation = engine.transport.release(
        engine.transport.context, value);
    if (released.status == TRANSPORT_OK)      { ret RELEASE_DONE; }
    if (released.status != TRANSPORT_BLOCKED) { ret RELEASE_FAILED; }
    ret park_release[T](engine, value);
}

fun release_outcome[T](engine: *Engine[T], outcome: u8) Event {
    if (outcome == RELEASE_FULL) {
        ret fail_connection[T](engine, ERROR_LIMIT, H3_EXCESSIVE_LOAD);
    }
    if (outcome == RELEASE_FAILED) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    ret base_event[T](engine, EVENT_NONE);
}

fun drain_releases[T](engine: *Engine[T]) Event {
    var i: usize = 0;
    for (i < engine.pending_release_count) {
        val released: TransportOperation = engine.transport.release(
            engine.transport.context, engine.pending_release[i]);
        if (released.status == TRANSPORT_BLOCKED) { i = i + 1; }
        or (released.status != TRANSPORT_OK) {
            ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
        }
        or {
            engine.pending_release_count = engine.pending_release_count - 1;
            engine.pending_release[i]    =
                engine.pending_release[engine.pending_release_count];
        }
    }
    ret base_event[T](engine, EVENT_NONE);
}

fun credit[T](engine: *Engine[T], stream: *Stream, count: usize) bool {
    if (count == 0)                                 { ret true; }
    if (stream == nil || count > stream.uncredited) { ret false; }
    # a failed or closed connection grants no more credit, so a held borrow can still end
    if (engine.state == FAILED || engine.state == CLOSED) {
        stream.uncredited = stream.uncredited - count;
        ret true;
    }
    val result: TransportOperation = engine.transport.credit(
        engine.transport.context, stream.transport_stream, count);
    if (result.status != TRANSPORT_OK) { ret false; }
    stream.uncredited = stream.uncredited - count;
    ret true;
}

fun input_available(stream: *Stream) usize {
    ret stream.input_length - stream.input_offset;
}

fun read_stream[T](engine: *Engine[T], stream: *Stream) Event {
    if (stream.input_offset != stream.input_length || stream.input_fin
        || stream.held || stream.qpack_blocked) { ret base_event[T](engine, EVENT_NONE); }
    stream.input_offset = 0;
    stream.input_length = 0;
    val result: TransportRead = engine.transport.read(engine.transport.context,
        stream.transport_stream, stream.memory.read, stream.memory.read_capacity);
    if (!transport_status(result.status)
        || (result.count != 0 && result.status != TRANSPORT_OK)
        || result.count > stream.memory.read_capacity
        || (result.fin && result.status != TRANSPORT_OK)
        || (result.status == TRANSPORT_OK && result.count == 0 && !result.fin)) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    if (result.status == TRANSPORT_CANCELLED) {
        if (result.final_size < stream.received_bytes) {
            ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
        }
        if (stream.critical) {
            ret fail_connection[T](engine, ERROR_PROTOCOL, H3_CLOSED_CRITICAL_STREAM);
        }
        val cancelled: TransportOperation = engine.transport.cancel_send(
            engine.transport.context, stream.transport_stream,
            H3_REQUEST_CANCELLED);
        if (cancelled.status != TRANSPORT_OK) {
            ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
        }
        if (stream.exchange != nil) { exchange.cancel_exchange(stream.exchange); }
        mark_closed[T](engine, stream);
        stream.reset_code = result.application_error;
        var reset: Event = stream_event[T](engine, EVENT_STREAM_RESET, stream);
        reset.code = result.application_error;
        ret reset;
    }
    if (result.status == TRANSPORT_CLOSED) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    if (result.status == TRANSPORT_EMPTY || result.status == TRANSPORT_BLOCKED) {
        stream.read_parked = true;
        ret base_event[T](engine, EVENT_NONE);
    }
    if (result.status != TRANSPORT_OK
        || stream.received_bytes > (-1)::u64 - result.count::u64) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    val received: u64 = stream.received_bytes + result.count::u64;
    if (result.fin && result.final_size != received) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    if (stream.uncredited > (-1)::usize - result.count) {
        ret fail_connection[T](engine, ERROR_LIMIT, H3_EXCESSIVE_LOAD);
    }
    stream.input_length   = result.count;
    stream.input_fin      = result.fin;
    stream.received_bytes = received;
    stream.uncredited     = stream.uncredited + result.count;
    ret base_event[T](engine, EVENT_NONE);
}

fun apply_peer_settings[T](engine: *Engine[T], stream: *Stream) Event {
    if (engine.peer_settings_received) {
        ret fail_connection[T](engine, ERROR_PROTOCOL, H3_SETTINGS_ERROR);
    }
    var peer: Settings = Settings{qpack_max_table_capacity: 0,
        max_field_section_size: (-1)::usize, qpack_blocked_streams: 0,
        enable_connect_protocol:                                    false, h3_datagram: false};
    var i: usize = 0;
    for (i < stream.parser.settings_count) {
        val item: frame.Setting = stream.parser.settings[i];
        if (item.identifier == frame.SETTING_QPACK_MAX_TABLE_CAPACITY) {
            if (item.value > ((-1)::usize)::u64) {
                peer.qpack_max_table_capacity = (-1)::usize;
            }
            or { peer.qpack_max_table_capacity = item.value::usize; }
        }
        or (item.identifier == frame.SETTING_MAX_FIELD_SECTION_SIZE) {
            if (item.value > ((-1)::usize)::u64) {
                ret fail_connection[T](engine, ERROR_LIMIT, H3_SETTINGS_ERROR);
            }
            peer.max_field_section_size = item.value::usize;
        }
        or (item.identifier == frame.SETTING_QPACK_BLOCKED_STREAMS) {
            if (item.value > ((-1)::usize)::u64) {
                peer.qpack_blocked_streams = (-1)::usize;
            }
            or { peer.qpack_blocked_streams = item.value::usize; }
        }
        or (item.identifier == frame.SETTING_ENABLE_CONNECT_PROTOCOL) {
            peer.enable_connect_protocol = item.value == 1;
        }
        or (item.identifier == frame.SETTING_H3_DATAGRAM) {
            peer.h3_datagram = item.value == 1;
        }
        i = i + 1;
    }
    engine.outbound_limits                     = engine.configured.outbound_qpack;
    engine.outbound_limits.max_blocked_streams = peer.qpack_blocked_streams;
    if (engine.outbound_limits.max_blocked_streams
        > engine.configured.outbound_qpack.max_blocked_streams) {
        engine.outbound_limits.max_blocked_streams
            = engine.configured.outbound_qpack.max_blocked_streams;
    }
    if (peer.max_field_section_size < engine.outbound_limits.max_field_section_bytes) {
        engine.outbound_limits.max_field_section_bytes = peer.max_field_section_size;
    }
    if (!qpack.sections_init(?engine.outbound_sections,
        engine.outbound_section_items, engine.outbound_section_capacity,
        engine.outbound_reference_items, engine.outbound_reference_capacity,
        ?engine.outbound_table, engine.outbound_limits)) {
        ret fail_connection[T](engine, ERROR_LIMIT, H3_INTERNAL_ERROR);
    }
    engine.peer                   = peer;
    engine.peer_settings_received = true;
    if (engine.local_settings_sent) { engine.state = OPEN; }
    # decoder instructions that arrived before SETTINGS can now be applied
    if (engine.peer_decoder != NO_SLOT) {
        wake_stream[T](engine, slot_stream[T](engine, engine.peer_decoder));
    }
    ret base_event[T](engine, EVENT_SETTINGS);
}

fun local_stream_valid[T](engine: *Engine[T], value: StreamHandle, direction: u8) bool {
    ret value.generation != 0 && value.id <= MAX_STREAM_ID
        && local_initiated[T](engine, value.id)
        && (unidirectional(value.id) == (direction == UNIDIRECTIONAL));
}

fun local_stream_unused[T](engine: *Engine[T], value: StreamHandle) bool {
    if (stream_for[T](engine, value.id) != nil) { ret false; }
    if (engine.local_control.opened
        && engine.local_control.stream.id == value.id) { ret false; }
    if (engine.local_encoder.opened
        && engine.local_encoder.stream.id == value.id) { ret false; }
    if (engine.local_decoder.opened
        && engine.local_decoder.stream.id == value.id) { ret false; }
    ret true;
}

fun open_critical[T](engine: *Engine[T], local: *LocalStream) Event {
    if (local.opened) { ret base_event[T](engine, EVENT_NONE); }
    val opened: TransportOpen = engine.transport.open(
        engine.transport.context, UNIDIRECTIONAL);
    if (!transport_status(opened.status)) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    if (opened.status == TRANSPORT_BLOCKED || opened.status == TRANSPORT_EMPTY) {
        ret base_event[T](engine, EVENT_BLOCKED);
    }
    if (opened.status != TRANSPORT_OK
        || !local_stream_valid[T](engine, opened.stream, UNIDIRECTIONAL)
        || !local_stream_unused[T](engine, opened.stream)) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    local.stream = opened.stream;
    local.opened = true;
    ret base_event[T](engine, EVENT_NONE);
}

fun write_queue[T](engine: *Engine[T], local: *LocalStream,
    queue: *ByteQueue) Event {
    if (!local.opened || queue.count == 0) { ret base_event[T](engine, EVENT_NONE); }
    val available: usize          = queue_contiguous(queue);
    val written:   TransportWrite = engine.transport.write(engine.transport.context,
        local.stream, ?queue.data[queue.head], available);
    if (!transport_status(written.status) || written.count > available
        || (written.count != 0 && written.status != TRANSPORT_OK)
        || (written.status == TRANSPORT_OK && written.count == 0)) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    if (written.status == TRANSPORT_BLOCKED || written.status == TRANSPORT_EMPTY) {
        ret base_event[T](engine, EVENT_BLOCKED);
    }
    if (written.status != TRANSPORT_OK) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    queue_pop(queue, written.count);
    ret base_event[T](engine, EVENT_NONE);
}

fun progress_critical_output[T](engine: *Engine[T]) Event {
    var result: Event = open_critical[T](engine, ?engine.local_control);
    if (result.kind != EVENT_NONE) { ret result; }
    result = open_critical[T](engine, ?engine.local_encoder);
    if (result.kind != EVENT_NONE) { ret result; }
    result = open_critical[T](engine, ?engine.local_decoder);
    if (result.kind != EVENT_NONE) { ret result; }
    result = write_queue[T](engine, ?engine.local_control, ?engine.control);
    if (result.kind != EVENT_NONE) { ret result; }
    if (engine.control.count == 0 && !engine.local_settings_sent) {
        engine.local_settings_sent = true;
        if (engine.peer_settings_received) { engine.state = OPEN; }
    }
    result = write_queue[T](engine, ?engine.local_encoder, ?engine.encoder);
    if (result.kind != EVENT_NONE) { ret result; }
    ret write_queue[T](engine, ?engine.local_decoder, ?engine.decoder);
}

fun accepted_shape[T](engine: *Engine[T], opened: TransportOpen) bool {
    ret opened.status == TRANSPORT_OK && opened.stream.generation != 0
        && opened.stream.id <= MAX_STREAM_ID
        && !local_initiated[T](engine, opened.stream.id)
        && stream_for[T](engine, opened.stream.id) == nil;
}

fun reject_request[T](engine: *Engine[T], opened: TransportOpen) Event {
    if (!queue_cancel[T](engine, opened.stream.id)) {
        ret fail_connection[T](engine, ERROR_LIMIT, H3_EXCESSIVE_LOAD);
    }
    val receive: TransportOperation = engine.transport.cancel_receive(
        engine.transport.context, opened.stream, H3_REQUEST_REJECTED);
    val send: TransportOperation = engine.transport.cancel_send(
        engine.transport.context, opened.stream, H3_REQUEST_REJECTED);
    if (receive.status != TRANSPORT_OK || send.status != TRANSPORT_OK) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    val outcome: Event = release_outcome[T](engine,
        release_or_park[T](engine, opened.stream));
    if (outcome.kind != EVENT_NONE) { ret outcome; }
    var result: Event = base_event[T](engine, EVENT_STREAM_ERROR);
    result.stream_id = opened.stream.id;
    result.code      = H3_REQUEST_REJECTED;
    ret result;
}

# a peer unidirectional stream may be critical, so a refused record parks it
# unread in the transport rather than refusing it. the account is registered for
# a wake-up and a released stream frees a record too. at the cap a record is
# always free, since requests never hold more than max_requests of them
fun place_unidirectional[T](engine: *Engine[T], value: StreamHandle) Event {
    if (engine.free_head == NO_SLOT && !grow_streams[T](engine, true)) {
        engine.parked_stream  = value;
        engine.accept_parked  = true;
        engine.accept_blocked = true;
        ret base_event[T](engine, EVENT_NONE);
    }
    engine.accept_parked = false;
    val incoming: *Stream = allocate_stream[T](engine, value, false, STREAM_UNKNOWN);
    if (incoming == nil || !frame.stream_parser_init(?incoming.classifier,
        ?engine.critical, engine.role == SERVER)) {
        ret fail_connection[T](engine, ERROR_LIMIT, H3_EXCESSIVE_LOAD);
    }
    ret base_event[T](engine, EVENT_PENDING);
}

# EVENT_PENDING when a stream was taken, since another may be waiting. nothing
# more is accepted while a parked stream waits for its record
fun accept_peer[T](engine: *Engine[T]) Event {
    engine.accept_blocked = false;
    if (engine.accept_parked) { ret place_unidirectional[T](engine, engine.parked_stream); }
    val opened: TransportOpen = engine.transport.accept(engine.transport.context);
    if (!transport_status(opened.status)) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    if (opened.status == TRANSPORT_EMPTY || opened.status == TRANSPORT_BLOCKED) {
        ret base_event[T](engine, EVENT_NONE);
    }
    if (opened.status != TRANSPORT_OK) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    if (!accepted_shape[T](engine, opened)) {
        ret fail_connection[T](engine, ERROR_PROTOCOL, H3_STREAM_CREATION_ERROR);
    }
    if (!unidirectional(opened.stream.id)) {
        if (engine.role != SERVER || !request_id(opened.stream.id)) {
            ret fail_connection[T](engine, ERROR_PROTOCOL, H3_STREAM_CREATION_ERROR);
        }
        if (engine.graceful && engine.final_goaway_sent
            && opened.stream.id >= engine.local_goaway) {
            ret reject_request[T](engine, opened);
        }
        if (engine.active_requests >= engine.configured.max_requests) {
            ret reject_request[T](engine, opened);
        }
        # a request whose buffers the source refused is rejected like one over budget
        val request: *Stream = allocate_stream[T](engine, opened.stream,
            false, STREAM_REQUEST);
        if (request == nil) { ret reject_request[T](engine, opened); }
        if (!frame.parser_init(?request.parser, frame.KIND_REQUEST, nil, 0,
            engine.configured.frames)) {
            ret fail_connection[T](engine, ERROR_LIMIT, H3_INTERNAL_ERROR);
        }
        if (engine.last_remote_request == NO_STREAM
            || opened.stream.id > engine.last_remote_request) {
            engine.last_remote_request = opened.stream.id;
        }
        ret base_event[T](engine, EVENT_PENDING);
    }
    if (engine.active_peer_unidirectional
        >= engine.configured.max_peer_unidirectional) {
        ret fail_connection[T](engine, ERROR_LIMIT, H3_EXCESSIVE_LOAD);
    }
    ret place_unidirectional[T](engine, opened.stream);
}

fun discard_opened[T](engine: *Engine[T], opened: StreamHandle, code: u64) u8 {
    val send: TransportOperation = engine.transport.cancel_send(
        engine.transport.context, opened, code);
    val receive: TransportOperation = engine.transport.cancel_receive(
        engine.transport.context, opened, code);
    if (send.status != TRANSPORT_OK || receive.status != TRANSPORT_OK) {
        ret RELEASE_FAILED;
    }
    ret release_or_park[T](engine, opened);
}

pub fun open_request[T](engine: *Engine[T], bound: *exchange.Exchange) u64 {
    if (engine == nil || !engine.initialized || engine.role != CLIENT
        || (engine.state != STARTING && engine.state != OPEN)
        || engine.graceful || engine.goaway_received
        || engine.active_requests >= engine.configured.max_requests) { ret NO_STREAM; }
    # the record and buffers come first, so a refusal never opens a transport stream
    val prepared: *Stream = prepare_stream[T](engine, STREAM_REQUEST);
    if (prepared == nil) { ret NO_STREAM; }
    val opened: TransportOpen = engine.transport.open(
        engine.transport.context, BIDIRECTIONAL);
    if (opened.status == TRANSPORT_EMPTY || opened.status == TRANSPORT_BLOCKED) {
        unprepare_stream[T](engine, prepared);
        ret NO_STREAM;
    }
    if (opened.status != TRANSPORT_OK
        || !local_stream_valid[T](engine, opened.stream, BIDIRECTIONAL)
        || !request_id(opened.stream.id)
        || (engine.goaway_received && opened.stream.id >= engine.remote_goaway)) {
        unprepare_stream[T](engine, prepared);
        fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
        ret NO_STREAM;
    }
    if (!stream_admissible[T](engine, opened.stream)) {
        unprepare_stream[T](engine, prepared);
        release_outcome[T](engine,
            discard_opened[T](engine, opened.stream, H3_REQUEST_CANCELLED));
        ret NO_STREAM;
    }
    val stream: *Stream = start_stream[T](engine, prepared, opened.stream,
        true, STREAM_REQUEST);
    if (!frame.parser_init(?stream.parser, frame.KIND_REQUEST, nil, 0,
        engine.configured.frames)) {
        mark_closed[T](engine, stream);
        free_stream[T](engine, stream);
        release_outcome[T](engine,
            discard_opened[T](engine, opened.stream, H3_REQUEST_CANCELLED));
        ret NO_STREAM;
    }
    if (bound != nil && !bind_exchange[T](engine, opened.stream.id, bound)) {
        mark_closed[T](engine, stream);
        free_stream[T](engine, stream);
        release_outcome[T](engine,
            discard_opened[T](engine, opened.stream, H3_REQUEST_CANCELLED));
        ret NO_STREAM;
    }
    ret opened.stream.id;
}

fun classify_stream[T](engine: *Engine[T], stream: *Stream) Event {
    var input: *u8 = nil;
    if (input_available(stream) != 0) { input = ?stream.memory.read[stream.input_offset]; }
    val parsed: frame.StreamEvent = frame.stream_feed(?stream.classifier,
        input, input_available(stream), stream.input_fin);
    stream.input_offset = stream.input_offset + parsed.consumed;
    if (!credit[T](engine, stream, parsed.consumed)) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    if (parsed.kind == frame.STREAM_EVENT_ERROR) {
        ret fail_connection[T](engine, ERROR_FRAME, frame_error_code(parsed.error));
    }
    if (parsed.kind == frame.STREAM_EVENT_NEED_INPUT) {
        ret base_event[T](engine, EVENT_NONE);
    }
    if (parsed.kind == frame.STREAM_EVENT_TYPE
        && parsed.stream_type == frame.STREAM_PUSH) {
        ret base_event[T](engine, EVENT_NONE);
    }
    if (parsed.kind == frame.STREAM_EVENT_PUSH_ID) {
        ret fail_connection[T](engine, ERROR_PROTOCOL, H3_ID_ERROR);
    }
    if (parsed.stream_type == frame.STREAM_CONTROL) {
        stream.kind     = STREAM_CONTROL;
        stream.critical = true;
        stream.memory   = engine.critical_memory.control;
        if (!frame.parser_init(?stream.parser, frame.KIND_CONTROL,
            stream.memory.settings, stream.memory.setting_capacity,
            engine.configured.frames)) {
            ret fail_connection[T](engine, ERROR_LIMIT, H3_INTERNAL_ERROR);
        }
    }
    or (parsed.stream_type == frame.STREAM_QPACK_ENCODER) {
        stream.kind     = STREAM_QPACK_ENCODER;
        stream.critical = true;
        stream.memory   = engine.critical_memory.encoder;
        if (!qpack.encoder_stream_decoder_init(?stream.encoder_stream,
            ?engine.inbound_table, stream.memory.encoded,
            stream.memory.encoded_capacity, stream.memory.scratch,
            stream.memory.scratch_capacity, engine.configured.inbound_qpack)) {
            ret fail_connection[T](engine, ERROR_LIMIT, H3_INTERNAL_ERROR);
        }
    }
    or (parsed.stream_type == frame.STREAM_QPACK_DECODER) {
        stream.kind         = STREAM_QPACK_DECODER;
        stream.critical     = true;
        stream.memory       = engine.critical_memory.decoder;
        engine.peer_decoder = stream.slot;
    }
    or {
        stream.kind   = STREAM_IGNORED;
        stream.memory = discard_memory[T](engine);
    }
    ret base_event[T](engine, EVENT_NONE);
}

fun queue_increment[T](engine: *Engine[T]) bool {
    if (engine.pending_increment == 0) { ret true; }
    var bytes:  [8]u8;
    val length: usize = qpack.encode_insert_count_increment(
        engine.pending_increment, ?bytes[0], 8);
    if (length == 0 || length > queue_space(?engine.decoder)) { ret false; }
    if (!queue_push(?engine.decoder, ?bytes[0], length))      { ret false; }
    engine.inbound_reported  = engine.inbound_reported + engine.pending_increment;
    engine.pending_increment = 0;
    ret true;
}

fun note_inserts[T](engine: *Engine[T]) bool {
    if (engine.inbound_table.insert_count < engine.inbound_reported) { ret false; }
    engine.pending_increment = engine.inbound_table.insert_count
        - engine.inbound_reported;
    ret queue_increment[T](engine) || engine.pending_increment != 0;
}

fun process_encoder_stream[T](engine: *Engine[T], stream: *Stream) Event {
    var input: *u8 = nil;
    if (input_available(stream) != 0) { input = ?stream.memory.read[stream.input_offset]; }
    val instruction: qpack.Instruction = qpack.encoder_stream_feed(
        ?stream.encoder_stream, input, input_available(stream), stream.input_fin);
    stream.input_offset = stream.input_offset + instruction.consumed;
    if (!credit[T](engine, stream, instruction.consumed)) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    if (instruction.status == qpack.INSTRUCTION_ERROR) {
        ret fail_connection[T](engine, ERROR_QPACK,
            qpack_error_code(instruction.error, true));
    }
    if (instruction.status == qpack.INSTRUCTION_COMPLETE) {
        if (!note_inserts[T](engine)) {
            ret fail_connection[T](engine, ERROR_LIMIT, H3_EXCESSIVE_LOAD);
        }
        wake_unblocked[T](engine);
    }
    ret base_event[T](engine, EVENT_NONE);
}

fun process_decoder_stream[T](engine: *Engine[T], stream: *Stream) Event {
    if (!decoder_stream_usable[T](engine, stream)) { ret base_event[T](engine, EVENT_NONE); }
    # a usable stream that cannot start would otherwise stay queued forever
    if (!stream.decoder_stream.initialized
        && !qpack.decoder_stream_decoder_init(?stream.decoder_stream,
        ?engine.outbound_table, ?engine.outbound_sections,
        stream.memory.encoded, stream.memory.encoded_capacity,
        engine.outbound_limits)) {
        ret fail_connection[T](engine, ERROR_LIMIT, H3_INTERNAL_ERROR);
    }
    var input: *u8 = nil;
    if (input_available(stream) != 0) { input = ?stream.memory.read[stream.input_offset]; }
    val instruction: qpack.Instruction = qpack.decoder_stream_feed(
        ?stream.decoder_stream, input, input_available(stream), stream.input_fin);
    stream.input_offset = stream.input_offset + instruction.consumed;
    if (!credit[T](engine, stream, instruction.consumed)) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    if (instruction.status == qpack.INSTRUCTION_ERROR) {
        ret fail_connection[T](engine, ERROR_QPACK,
            qpack_error_code(instruction.error, false));
    }
    ret base_event[T](engine, EVENT_NONE);
}

fun start_field_decoder[T](engine: *Engine[T], stream: *Stream) bool {
    var decoder: qpack.FieldDecoder;
    stream.decoder = decoder;
    ret qpack.field_decoder_init(?stream.decoder, ?engine.inbound_table,
        ?engine.inbound_sections, stream.transport_stream.id,
        stream.memory.encoded, stream.memory.encoded_capacity,
        stream.memory.fields, stream.memory.field_capacity,
        stream.memory.strings, stream.memory.string_capacity,
        stream.memory.scratch, stream.memory.scratch_capacity,
        engine.configured.inbound_qpack);
}

fun queue_ack[T](engine: *Engine[T], stream: *Stream, required: u64) bool {
    if (required == 0) { ret true; }
    var bytes:  [8]u8;
    val length: usize = qpack.encode_section_ack(stream.transport_stream.id,
        ?bytes[0], 8);
    ret length != 0 && queue_push(?engine.decoder, ?bytes[0], length);
}

fun header_kind[T](engine: *Engine[T], stream: *Stream,
    decoded: qpack.Decode) u8 {
    if (engine.role == SERVER && !stream.local
        && !stream.initial_headers_received) { ret HEADER_REQUEST; }
    if (!stream.final_headers_received) {
        if (section.informational(stream.memory.fields, decoded.count, true)) {
            ret HEADER_INFORMATIONAL;
        }
        ret HEADER_RESPONSE;
    }
    ret HEADER_TRAILERS;
}

fun finish_headers[T](engine: *Engine[T], stream: *Stream,
    decoded: qpack.Decode) Event {
    if (!credit[T](engine, stream, stream.qpack_credit)) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    stream.qpack_credit = 0;
    clear_blocked[T](engine, stream);
    if (!queue_ack[T](engine, stream, decoded.required_insert_count)) {
        ret fail_connection[T](engine, ERROR_LIMIT, H3_EXCESSIVE_LOAD);
    }
    val kind:  u8 = header_kind[T](engine, stream, decoded);
    var block: HeaderBlock;
    if (!section.validate(stream.memory.fields, decoded.count, kind,
        engine.configured.local.enable_connect_protocol,
        engine.configured.inbound_qpack.max_field_section_bytes, true, ?block)) {
        ret stream_failure[T](engine, stream, H3_MESSAGE_ERROR);
    }
    val inbound_limits: body.Limits = inbound_body_limits[T](engine);
    if (!header_fields_within[T](engine, block, kind, false)
        || (kind == HEADER_REQUEST && !request_target_within[T](engine, block))
        || ((kind == HEADER_REQUEST || kind == HEADER_RESPONSE)
        && block.has_content_length
        && block.content_length > inbound_limits.max_bytes)
        || (kind == HEADER_INFORMATIONAL && stream.inbound_informational
        >= engine.configured.messages.max_informational)) {
        ret stream_failure[T](engine, stream, H3_EXCESSIVE_LOAD);
    }
    var event_kind: EventKind = EVENT_TRAILERS;
    if (kind == HEADER_REQUEST)       { event_kind = EVENT_REQUEST_HEADERS; }
    or (kind == HEADER_RESPONSE)      { event_kind = EVENT_RESPONSE_HEADERS; }
    or (kind == HEADER_INFORMATIONAL) { event_kind = EVENT_INFORMATIONAL; }
    if (kind == HEADER_INFORMATIONAL) {
        stream.inbound_informational = stream.inbound_informational + 1;
    }
    or (kind == HEADER_TRAILERS) {
        if (stream.trailers_received || (stream.inbound_has_length
            && stream.inbound_body_bytes != stream.inbound_declared_length)) {
            ret stream_failure[T](engine, stream, H3_MESSAGE_ERROR);
        }
        stream.trailers_received = true;
    }
    or (kind != HEADER_INFORMATIONAL) {
        stream.initial_headers_received = true;
        stream.final_headers_received   = true;
        stream.inbound_has_length       = block.has_content_length;
        stream.inbound_declared_length  = block.content_length;
        stream.inbound_body_forbidden   = kind == HEADER_RESPONSE
            && (block.status == status.NO_CONTENT || block.status == status.NOT_MODIFIED
            || (stream.exchange != nil
            && stream.exchange.request.method.kind == method.HEAD));
    }
    stream.held            = true;
    stream.held_kind       = event_kind;
    stream.held_headers    = block;
    stream.held_end_stream = false;
    var result: Event = stream_event[T](engine, event_kind, stream);
    result.headers = block;
    ret result;
}

fun complete_field_section[T](engine: *Engine[T], stream: *Stream,
    decoded: qpack.Decode) Event {
    if (decoded.status == qpack.DECODE_ERROR) {
        ret fail_connection[T](engine, ERROR_QPACK,
            qpack_error_code(decoded.error, false));
    }
    if (decoded.status == qpack.DECODE_BLOCKED) {
        set_blocked[T](engine, stream);
        ret base_event[T](engine, EVENT_BLOCKED);
    }
    if (decoded.status != qpack.DECODE_COMPLETE) {
        ret fail_connection[T](engine, ERROR_QPACK, QPACK_DECOMPRESSION_FAILED);
    }
    ret finish_headers[T](engine, stream, decoded);
}

fun handle_goaway[T](engine: *Engine[T], value: u64) Event {
    if (engine.role == CLIENT && (!request_id(value) || value > MAX_REQUEST_ID)) {
        ret fail_connection[T](engine, ERROR_PROTOCOL, H3_ID_ERROR);
    }
    if (engine.goaway_received && value > engine.remote_goaway) {
        ret fail_connection[T](engine, ERROR_PROTOCOL, H3_ID_ERROR);
    }
    engine.goaway_received = true;
    engine.remote_goaway   = value;
    if (engine.state == OPEN || engine.state == STARTING) { engine.state = DRAINING; }
    if (engine.role == CLIENT) {
        var i: usize = 0;
        for (i < engine.stream_capacity) {
            val stream: *Stream = slot_stream[T](engine, i);
            if (stream.live && stream.kind == STREAM_REQUEST && stream.local
                && stream.transport_stream.id >= value && !stream_terminal(stream)) {
                val send: TransportOperation = engine.transport.cancel_send(
                    engine.transport.context, stream.transport_stream,
                    H3_REQUEST_REJECTED);
                val receive: TransportOperation = engine.transport.cancel_receive(
                    engine.transport.context, stream.transport_stream,
                    H3_REQUEST_REJECTED);
                if (send.status != TRANSPORT_OK || receive.status != TRANSPORT_OK) {
                    ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
                }
                if (stream.exchange != nil) { exchange.cancel_exchange(stream.exchange); }
                mark_closed[T](engine, stream);
                stream.retry_pending = true;
                stream.reset_code    = H3_REQUEST_REJECTED;
                ready_push[T](engine, stream);
            }
            i = i + 1;
        }
    }
    var result: Event = base_event[T](engine, EVENT_GOAWAY);
    result.goaway_id = value;
    ret result;
}

fun handle_frame_end[T](engine: *Engine[T], stream: *Stream,
    parsed: frame.Event) Event {
    if (parsed.header.typ == frame.FRAME_SETTINGS) {
        ret apply_peer_settings[T](engine, stream);
    }
    if (parsed.header.typ == frame.FRAME_GOAWAY) {
        ret handle_goaway[T](engine, parsed.value);
    }
    if (parsed.header.typ == frame.FRAME_CANCEL_PUSH
        || parsed.header.typ == frame.FRAME_MAX_PUSH_ID) {
        ret fail_connection[T](engine, ERROR_PROTOCOL, H3_ID_ERROR);
    }
    if (parsed.header.typ == frame.FRAME_HEADERS
        && parsed.header.length == 0) {
        val decoded: qpack.Decode = qpack.field_decoder_feed(
            ?stream.decoder, nil, 0, true);
        ret complete_field_section[T](engine, stream, decoded);
    }
    ret base_event[T](engine, EVENT_NONE);
}

fun request_header_allowed(stream: *Stream, header: frame.Header) bool {
    if (!stream.initial_headers_received) { ret header.typ != frame.FRAME_DATA; }
    if (stream.trailers_received) {
        ret header.typ != frame.FRAME_HEADERS && header.typ != frame.FRAME_DATA;
    }
    ret true;
}

fun process_request_frame[T](engine: *Engine[T], stream: *Stream) Event {
    var input: *u8 = nil;
    if (input_available(stream) != 0) { input = ?stream.memory.read[stream.input_offset]; }
    val parsed: frame.Event = frame.feed(?stream.parser, input,
        input_available(stream), stream.input_fin);
    stream.input_offset = stream.input_offset + parsed.consumed;
    if (parsed.kind == frame.EVENT_ERROR) {
        ret fail_connection[T](engine, ERROR_FRAME, frame_error_code(parsed.error));
    }
    if (parsed.kind == frame.EVENT_NEED_INPUT) {
        if (!credit[T](engine, stream, parsed.consumed)) {
            ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
        }
        ret base_event[T](engine, EVENT_NONE);
    }
    if (parsed.kind == frame.EVENT_HEADER) {
        if (!credit[T](engine, stream, parsed.consumed)) {
            ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
        }
        stream.current_frame = parsed.header;
        stream.frame_started = true;
        if (stream.kind == STREAM_REQUEST) {
            if (!request_header_allowed(stream, parsed.header)) {
                ret fail_connection[T](engine, ERROR_FRAME, H3_FRAME_UNEXPECTED);
            }
            if (parsed.header.typ == frame.FRAME_PUSH_PROMISE) {
                ret fail_connection[T](engine, ERROR_PROTOCOL, H3_ID_ERROR);
            }
        }
        if (parsed.header.typ == frame.FRAME_DATA) {
            val limits: body.Limits = inbound_body_limits[T](engine);
            # the declared length streams through reads the body reader bounds
            # itself, so only the frame count is policed here
            if (stream.inbound_body_chunks >= limits.max_chunks) {
                ret stream_failure[T](engine, stream, H3_EXCESSIVE_LOAD);
            }
            stream.inbound_body_chunks = stream.inbound_body_chunks + 1;
        }
        if (parsed.header.typ == frame.FRAME_HEADERS
            && !start_field_decoder[T](engine, stream)) {
            ret fail_connection[T](engine, ERROR_LIMIT, H3_INTERNAL_ERROR);
        }
        ret base_event[T](engine, EVENT_NONE);
    }
    if (parsed.kind == frame.EVENT_PAYLOAD) {
        if (parsed.header.typ == frame.FRAME_HEADERS) {
            if (stream.qpack_credit > (-1)::usize - parsed.consumed) {
                frame.release(?stream.parser);
                ret fail_connection[T](engine, ERROR_LIMIT, H3_EXCESSIVE_LOAD);
            }
            stream.qpack_credit = stream.qpack_credit + parsed.consumed;
            val decoded: qpack.Decode = qpack.field_decoder_feed(?stream.decoder,
                parsed.data, parsed.data_length, parsed.frame_final);
            frame.release(?stream.parser);
            if (parsed.frame_final) { ret complete_field_section[T](engine, stream, decoded); }
            if (decoded.status != qpack.DECODE_NEED_INPUT) {
                ret fail_connection[T](engine, ERROR_QPACK, QPACK_DECOMPRESSION_FAILED);
            }
            ret base_event[T](engine, EVENT_NONE);
        }
        if (parsed.header.typ == frame.FRAME_DATA) {
            val limits: body.Limits = inbound_body_limits[T](engine);
            if (!stream.final_headers_received || stream.trailers_received
                || (stream.inbound_body_forbidden && parsed.data_length != 0)
                || parsed.data_length::u64 > limits.max_bytes
                || stream.inbound_body_bytes
                > limits.max_bytes - parsed.data_length::u64) {
                frame.release(?stream.parser);
                ret stream_failure[T](engine, stream, H3_MESSAGE_ERROR);
            }
            stream.inbound_body_bytes = stream.inbound_body_bytes
                + parsed.data_length::u64;
            if (stream.inbound_has_length
                && stream.inbound_body_bytes > stream.inbound_declared_length) {
                frame.release(?stream.parser);
                ret stream_failure[T](engine, stream, H3_MESSAGE_ERROR);
            }
            if (parsed.data_length == 0) {
                frame.release(?stream.parser);
                ret base_event[T](engine, EVENT_NONE);
            }
            stream.held        = true;
            stream.held_kind   = EVENT_DATA;
            stream.held_data   = parsed.data;
            stream.held_length = parsed.data_length;
            var data_event: Event = stream_event[T](engine, EVENT_DATA, stream);
            data_event.data        = parsed.data;
            data_event.data_length = parsed.data_length;
            ret data_event;
        }
        if (!credit[T](engine, stream, parsed.consumed)) {
            frame.release(?stream.parser);
            ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
        }
        frame.release(?stream.parser);
        ret base_event[T](engine, EVENT_NONE);
    }
    stream.frame_started = false;
    ret handle_frame_end[T](engine, stream, parsed);
}

fun encode_frame_header(typ: u64, length: usize,
    output: *u8, capacity: usize) usize {
    val first: usize = frame.encode_varint(typ, output, capacity);
    if (first == 0) { ret 0; }
    val second: usize = frame.encode_varint(length::u64,
        ?output[first], capacity - first);
    if (second == 0) { ret 0; }
    ret first + second;
}

fun outbound_header_kind[T](engine: *Engine[T], stream: *Stream,
    items: *field.Field, count: usize) u8 {
    if (stream.initial_headers_sent)           { ret HEADER_TRAILERS; }
    if (engine.role == CLIENT && stream.local) { ret HEADER_REQUEST; }
    if (engine.role == SERVER && !stream.local) {
        if (section.informational(items, count, false)) { ret HEADER_INFORMATIONAL; }
        ret HEADER_RESPONSE;
    }
    ret 0;
}

pub fun send_headers[T](engine: *Engine[T], id: u64, items: *field.Field,
    count: usize, end_stream: bool, huffman_strings: bool) Offer {
    val stream: *Stream = stream_for[T](engine, id);
    if (engine == nil || !engine.initialized || !engine.peer_settings_received
        || stream == nil || stream.kind != STREAM_REQUEST || !stream_writable(stream)
        || stream.output_length != 0 || stream.output_end_stream
        || (items == nil && count != 0) || stream.trailers_sent) {
        ret Offer{status: OFFER_BLOCKED, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_STATE};
    }
    val kind:    u8    = outbound_header_kind[T](engine, stream, items, count);
    var block:   HeaderBlock;
    var maximum: usize = engine.configured.outbound_qpack.max_field_section_bytes;
    if (engine.peer.max_field_section_size < maximum) {
        maximum = engine.peer.max_field_section_size;
    }
    if (kind == 0 || !section.validate(items, count, kind,
        engine.peer.enable_connect_protocol, maximum, false, ?block)
        || (kind == HEADER_INFORMATIONAL && end_stream)
        || (kind == HEADER_TRAILERS && !end_stream)
        || (end_stream && block.has_content_length && block.content_length != 0
        && !(kind == HEADER_RESPONSE && stream.exchange != nil
        && stream.exchange.request.method.kind == method.HEAD)
        && !(kind == HEADER_RESPONSE && block.status == status.NOT_MODIFIED))
        || (kind == HEADER_TRAILERS && stream.outbound_has_length
        && stream.outbound_body_bytes != stream.outbound_declared_length)) {
        ret Offer{status: OFFER_ERROR, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_PROTOCOL};
    }
    val body_limits: body.Limits = outbound_body_limits[T](engine);
    if (!header_fields_within[T](engine, block, kind, true)
        || (kind == HEADER_REQUEST && !request_target_within[T](engine, block))
        || ((kind == HEADER_REQUEST || kind == HEADER_RESPONSE)
        && block.has_content_length
        && block.content_length > body_limits.max_bytes)
        || (kind == HEADER_INFORMATIONAL && stream.outbound_informational
        >= engine.configured.messages.max_informational)) {
        ret Offer{status: OFFER_ERROR, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_LIMIT};
    }
    var encoder:          qpack.FieldEncoder;
    val encoded_output:   *u8   = ?stream.memory.output[16];
    val encoded_capacity: usize = stream.memory.output_capacity - 16;
    if (!qpack.field_encoder_init(?encoder, ?engine.outbound_table,
        ?engine.outbound_sections, id, encoded_output, encoded_capacity,
        stream.memory.references, stream.memory.reference_capacity,
        engine.outbound_limits)) {
        ret Offer{status: OFFER_ERROR, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_QPACK};
    }
    var i: usize = 0;
    for (i < count) {
        if (!qpack.field_encoder_field(?encoder, items[i], huffman_strings).ok) {
            qpack.field_encoder_abort(?encoder);
            ret Offer{status: OFFER_ERROR, consumed: 0, produced: 0,
                stream_id: id, error: ERROR_QPACK};
        }
        i = i + 1;
    }
    val encoded: qpack.Encode = qpack.field_encoder_finish(?encoder);
    if (!encoded.ok) {
        ret Offer{status: OFFER_ERROR, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_QPACK};
    }
    var prefix:        [16]u8;
    val prefix_length: usize = encode_frame_header(frame.FRAME_HEADERS,
        encoded.written, ?prefix[0], 16);
    if (prefix_length == 0
        || encoded.written > stream.memory.output_capacity - prefix_length) {
        ret Offer{status: OFFER_ERROR, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_LIMIT};
    }
    memory.raw_move(?stream.memory.output[prefix_length], encoded_output,
        encoded.written);
    memory.raw_copy(stream.memory.output, ?prefix[0], prefix_length);
    stream.output_length     = prefix_length + encoded.written;
    stream.output_offset     = 0;
    stream.output_end_stream = end_stream;
    if (kind == HEADER_INFORMATIONAL) {
        stream.outbound_informational = stream.outbound_informational + 1;
    }
    or (kind == HEADER_TRAILERS) { stream.trailers_sent = true; }
    or (kind != HEADER_INFORMATIONAL) {
        stream.initial_headers_sent     = true;
        stream.outbound_has_length      = block.has_content_length;
        stream.outbound_declared_length = block.content_length;
        stream.outbound_body_forbidden  = kind == HEADER_RESPONSE
            && (block.status == status.NO_CONTENT || block.status == status.NOT_MODIFIED
            || (stream.exchange != nil
            && stream.exchange.request.method.kind == method.HEAD));
    }
    engine.output_streams = engine.output_streams + 1;
    wake_stream[T](engine, stream);
    ret Offer{status: OFFER_OUTPUT, consumed: count,
        produced: stream.output_length, stream_id: id, error: ERROR_NONE};
}

pub fun offer_data[T](engine: *Engine[T], id: u64, input: *u8,
    length: usize, end_stream: bool) Offer {
    val stream: *Stream = stream_for[T](engine, id);
    if (engine == nil || !engine.initialized || stream == nil
        || (input == nil && length != 0) || (length == 0 && !end_stream)
        || !stream_writable(stream) || !stream.initial_headers_sent
        || stream.trailers_sent || stream.output_length != 0
        || stream.output_end_stream) {
        ret Offer{status: OFFER_BLOCKED, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_STATE};
    }
    var take:   usize       = length;
    val limits: body.Limits = outbound_body_limits[T](engine);
    if (take > stream.memory.output_capacity - 16) {
        take = stream.memory.output_capacity - 16;
    }
    if (engine.configured.frames.max_frame_payload < take::u64) {
        take = engine.configured.frames.max_frame_payload::usize;
    }
    if (take > limits.max_chunk_bytes) { take = limits.max_chunk_bytes; }
    val final: bool = end_stream && take == length;
    if (stream.outbound_body_forbidden && take != 0) {
        ret Offer{status: OFFER_ERROR, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_PROTOCOL};
    }
    if (stream.outbound_body_chunks >= limits.max_chunks
        || take::u64 > limits.max_bytes
        || stream.outbound_body_bytes > limits.max_bytes - take::u64) {
        ret Offer{status: OFFER_ERROR, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_LIMIT};
    }
    if (stream.outbound_has_length
        && (stream.outbound_body_bytes + take::u64 > stream.outbound_declared_length
        || (final && stream.outbound_body_bytes + take::u64
        != stream.outbound_declared_length))) {
        ret Offer{status: OFFER_ERROR, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_PROTOCOL};
    }
    if (take == 0 && length != 0) {
        ret Offer{status: OFFER_BLOCKED, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_LIMIT};
    }
    var prefix:        [16]u8;
    val prefix_length: usize = encode_frame_header(frame.FRAME_DATA,
        take, ?prefix[0], 16);
    if (prefix_length == 0 || take > stream.memory.output_capacity - prefix_length) {
        ret Offer{status: OFFER_ERROR, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_LIMIT};
    }
    memory.raw_copy(stream.memory.output, ?prefix[0], prefix_length);
    if (take != 0) {
        memory.raw_copy(?stream.memory.output[prefix_length], input, take);
    }
    stream.output_length        = prefix_length + take;
    stream.output_offset        = 0;
    stream.output_end_stream    = final;
    stream.outbound_body_bytes  = stream.outbound_body_bytes + take::u64;
    stream.outbound_body_chunks = stream.outbound_body_chunks + 1;
    engine.output_streams       = engine.output_streams + 1;
    wake_stream[T](engine, stream);
    var status_value: OfferStatus = OFFER_PARTIAL;
    if (take == length && final) { status_value = OFFER_DONE; }
    or (take == length)          { status_value = OFFER_OUTPUT; }
    ret Offer{status: status_value, consumed: take,
        produced: stream.output_length, stream_id: id, error: ERROR_NONE};
}

# a blocked write parks the output until the transport reports the stream writable
fun flush_request_output[T](engine: *Engine[T], stream: *Stream) Event {
    if (!stream.live || stream.kind != STREAM_REQUEST || stream_terminal(stream)
        || stream.write_parked || !output_pending(stream)) {
        ret base_event[T](engine, EVENT_NONE);
    }
    if (stream.output_offset < stream.output_length) {
        val available: usize          = stream.output_length - stream.output_offset;
        val written:   TransportWrite = engine.transport.write(engine.transport.context,
            stream.transport_stream, ?stream.memory.output[stream.output_offset],
            available);
        if (!transport_status(written.status) || written.count > available
            || (written.count != 0 && written.status != TRANSPORT_OK)
            || (written.status == TRANSPORT_OK && written.count == 0)) {
            ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
        }
        if (written.status == TRANSPORT_BLOCKED || written.status == TRANSPORT_EMPTY) {
            stream.write_parked = true;
            ret base_event[T](engine, EVENT_BLOCKED);
        }
        if (written.status != TRANSPORT_OK) {
            ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
        }
        stream.output_offset = stream.output_offset + written.count;
        if (stream.output_offset != stream.output_length) {
            ret base_event[T](engine, EVENT_NONE);
        }
        stream.output_length = 0;
        stream.output_offset = 0;
    }
    if (stream.output_end_stream) {
        val finished: TransportOperation = engine.transport.finish(
            engine.transport.context, stream.transport_stream);
        if (finished.status == TRANSPORT_BLOCKED) {
            stream.write_parked = true;
            ret base_event[T](engine, EVENT_BLOCKED);
        }
        if (finished.status != TRANSPORT_OK) {
            ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
        }
        stream.output_end_stream = false;
        close_local_side[T](engine, stream);
    }
    if (engine.output_streams != 0) { engine.output_streams = engine.output_streams - 1; }
    ret base_event[T](engine, EVENT_NONE);
}

fun mark_closed[T](engine: *Engine[T], stream: *Stream) {
    if (stream == nil || stream.state == STREAM_CLOSED) { ret; }
    stream.state = STREAM_CLOSED;
    if (stream.kind == STREAM_REQUEST && engine.active_requests != 0) {
        engine.active_requests = engine.active_requests - 1;
    }
}

fun close_local_side[T](engine: *Engine[T], stream: *Stream) {
    if (stream.state == STREAM_OPEN)               { stream.state = STREAM_HALF_CLOSED_LOCAL; }
    or (stream.state == STREAM_HALF_CLOSED_REMOTE) { mark_closed[T](engine, stream); }
}

fun close_remote_side[T](engine: *Engine[T], stream: *Stream) {
    if (stream.state == STREAM_OPEN)              { stream.state = STREAM_HALF_CLOSED_REMOTE; }
    or (stream.state == STREAM_HALF_CLOSED_LOCAL) { mark_closed[T](engine, stream); }
}

fun handle_fin[T](engine: *Engine[T], stream: *Stream) Event {
    if (stream.remote_end_reported) { ret base_event[T](engine, EVENT_NONE); }
    if (stream.critical) {
        ret fail_connection[T](engine, ERROR_PROTOCOL, H3_CLOSED_CRITICAL_STREAM);
    }
    if (stream.kind == STREAM_UNKNOWN) {
        ret fail_connection[T](engine, ERROR_FRAME, H3_STREAM_CREATION_ERROR);
    }
    if (stream.kind == STREAM_IGNORED) {
        mark_closed[T](engine, stream);
        val outcome: Event = release_outcome[T](engine,
            release_or_park[T](engine, stream.transport_stream));
        if (outcome.kind != EVENT_NONE) { ret outcome; }
        free_stream[T](engine, stream);
        if (engine.active_peer_unidirectional != 0) {
            engine.active_peer_unidirectional = engine.active_peer_unidirectional - 1;
        }
        ret base_event[T](engine, EVENT_NONE);
    }
    if (!stream.final_headers_received || stream.qpack_blocked
        || (stream.inbound_has_length
        && stream.inbound_body_bytes != stream.inbound_declared_length)) {
        ret stream_failure[T](engine, stream, H3_REQUEST_INCOMPLETE);
    }
    close_remote_side[T](engine, stream);
    stream.remote_end_reported = true;
    var ended: Event = stream_event[T](engine, EVENT_STREAM_END, stream);
    ended.end_stream = true;
    ret ended;
}

fun retry_blocked[T](engine: *Engine[T], stream: *Stream) Event {
    if (!stream.qpack_blocked) { ret base_event[T](engine, EVENT_NONE); }
    val decoded: qpack.Decode = qpack.field_decoder_retry(?stream.decoder);
    if (decoded.status == qpack.DECODE_BLOCKED) { ret base_event[T](engine, EVENT_BLOCKED); }
    ret complete_field_section[T](engine, stream, decoded);
}

# a blocked stream reads nothing, so it probes for a reset only when the
# transport reported one and otherwise just retries after an insert
fun poll_blocked_reset[T](engine: *Engine[T], stream: *Stream) Event {
    if (!stream.probe_pending) { ret retry_blocked[T](engine, stream); }
    stream.probe_pending = false;
    val result: TransportRead = engine.transport.read(engine.transport.context,
        stream.transport_stream, nil, 0);
    if (!transport_status(result.status) || result.count != 0) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    if (result.status == TRANSPORT_CANCELLED) {
        if (result.final_size < stream.received_bytes) {
            ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
        }
        qpack.field_decoder_cancel(?stream.decoder);
        if (!queue_cancel[T](engine, stream.transport_stream.id)) {
            ret fail_connection[T](engine, ERROR_LIMIT, H3_EXCESSIVE_LOAD);
        }
        val cancelled: TransportOperation = engine.transport.cancel_send(
            engine.transport.context, stream.transport_stream,
            H3_REQUEST_CANCELLED);
        if (cancelled.status != TRANSPORT_OK) {
            ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
        }
        if (stream.exchange != nil) { exchange.cancel_exchange(stream.exchange); }
        stream.uncredited   = 0;
        stream.qpack_credit = 0;
        clear_blocked[T](engine, stream);
        mark_closed[T](engine, stream);
        stream.reset_code = result.application_error;
        var reset: Event = stream_event[T](engine, EVENT_STREAM_RESET, stream);
        reset.code = result.application_error;
        ret reset;
    }
    if (result.status == TRANSPORT_OK && result.fin) {
        if (result.final_size != stream.received_bytes) {
            ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
        }
        stream.input_fin = true;
    }
    if (result.status == TRANSPORT_OK && !result.fin) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    if (result.status != TRANSPORT_EMPTY && result.status != TRANSPORT_BLOCKED
        && result.status != TRANSPORT_OK) {
        ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
    }
    ret retry_blocked[T](engine, stream);
}

fun held_event[T](engine: *Engine[T], stream: *Stream) Event {
    var result: Event = stream_event[T](engine, stream.held_kind, stream);
    result.headers     = stream.held_headers;
    result.data        = stream.held_data;
    result.data_length = stream.held_length;
    result.end_stream  = stream.held_end_stream;
    ret result;
}

fun process_one_stream[T](engine: *Engine[T], stream: *Stream) Event {
    if (!stream.live || stream_terminal(stream)) { ret base_event[T](engine, EVENT_NONE); }
    if (stream.held)                             { ret held_event[T](engine, stream); }
    if (stream.qpack_blocked)                    { ret poll_blocked_reset[T](engine, stream); }
    if ((stream.kind == STREAM_REQUEST || stream.kind == STREAM_CONTROL)
        && stream.frame_started && stream.parser.remaining == 0) {
        ret process_request_frame[T](engine, stream);
    }
    if (stream.input_offset == stream.input_length) {
        if (stream.input_fin)   { ret handle_fin[T](engine, stream); }
        if (stream.read_parked) { ret base_event[T](engine, EVENT_NONE); }
        val read_event: Event = read_stream[T](engine, stream);
        if (read_event.kind != EVENT_NONE) { ret read_event; }
        if (stream.input_offset == stream.input_length) {
            ret base_event[T](engine, EVENT_NONE);
        }
    }
    if (stream.kind == STREAM_UNKNOWN) { ret classify_stream[T](engine, stream); }
    if (stream.kind == STREAM_QPACK_ENCODER) {
        ret process_encoder_stream[T](engine, stream);
    }
    if (stream.kind == STREAM_QPACK_DECODER) {
        ret process_decoder_stream[T](engine, stream);
    }
    if (stream.kind == STREAM_IGNORED) {
        val length: usize = input_available(stream);
        stream.input_offset = stream.input_length;
        if (!credit[T](engine, stream, length)) {
            ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
        }
        ret base_event[T](engine, EVENT_NONE);
    }
    ret process_request_frame[T](engine, stream);
}

fun decoder_stream_usable[T](engine: *Engine[T], stream: *Stream) bool {
    ret stream.decoder_stream.initialized
        || (engine.peer_settings_received && engine.outbound_sections.valid);
}

# true exactly when servicing the stream can make progress without news from
# the transport or the application
fun stream_has_work[T](engine: *Engine[T], stream: *Stream) bool {
    if (!stream.live)            { ret false; }
    if (stream.retry_pending)    { ret true; }
    if (stream_terminal(stream)) { ret false; }
    if (stream.held)             { ret true; }
    if (stream.kind == STREAM_REQUEST && !stream.write_parked
        && output_pending(stream)) { ret true; }
    if (stream.qpack_blocked) { ret !stream.blocked_listed || stream.probe_pending; }
    if ((stream.kind == STREAM_REQUEST || stream.kind == STREAM_CONTROL)
        && stream.frame_started && stream.parser.remaining == 0) { ret true; }
    if (stream.input_offset != stream.input_length) {
        if (stream.kind == STREAM_QPACK_DECODER) {
            ret decoder_stream_usable[T](engine, stream);
        }
        ret true;
    }
    if (stream.input_fin) { ret !stream.remote_end_reported; }
    ret stream_readable(stream) && !stream.read_parked;
}

fun note_ready[T](engine: *Engine[T], report: TransportReady) {
    if (report.handle.id > MAX_STREAM_ID) { ret; }
    val slot: usize = index_find[T](engine, report.handle.id);
    if (slot == NO_SLOT) { ret; }
    val stream: *Stream = slot_stream[T](engine, slot);
    if (stream.transport_stream.source != report.handle.source
        || stream.transport_stream.index != report.handle.index
        || stream.transport_stream.generation != report.handle.generation) { ret; }
    if (report.readable || report.reset) {
        stream.read_parked = false;
        if (stream.qpack_blocked) { stream.probe_pending = true; }
    }
    if (report.writable || report.reset) { stream.write_parked = false; }
    wake_stream[T](engine, stream);
}

# EVENT_NONE once the transport answered EMPTY, EVENT_PENDING when the budget
# ran out first
fun drain_ready[T](engine: *Engine[T]) Event {
    var taken: usize = 0;
    for (taken < READY_BUDGET) {
        val report: TransportReady = engine.transport.ready(engine.transport.context);
        if (report.status == TRANSPORT_EMPTY) { ret base_event[T](engine, EVENT_NONE); }
        if (report.status != TRANSPORT_OK) {
            ret fail_connection[T](engine, ERROR_TRANSPORT, H3_INTERNAL_ERROR);
        }
        note_ready[T](engine, report);
        taken = taken + 1;
    }
    ret base_event[T](engine, EVENT_PENDING);
}

fun service_stream[T](engine: *Engine[T], stream: *Stream) Event {
    if (!stream.live) { ret base_event[T](engine, EVENT_NONE); }
    if (stream.retry_pending) {
        stream.retry_pending = false;
        var retry: Event = stream_event[T](engine, EVENT_STREAM_RETRY, stream);
        retry.code = H3_REQUEST_REJECTED;
        ret retry;
    }
    val flushed: Event = flush_request_output[T](engine, stream);
    if (flushed.kind != EVENT_NONE && flushed.kind != EVENT_BLOCKED) { ret flushed; }
    val result: Event = process_one_stream[T](engine, stream);
    if (result.kind == EVENT_NONE) { ret flushed; }
    ret result;
}

# each queued stream is serviced at most once per call and requeued at the
# tail while it still has work, which keeps the order round-robin
fun service_ready[T](engine: *Engine[T], blocked: bool, pending: bool) Event {
    var output_blocked: bool  = blocked;
    var budget:         usize = engine.ready_count;
    if (budget > SERVICE_BUDGET) { budget = SERVICE_BUDGET; }
    for (budget != 0) {
        budget = budget - 1;
        val stream: *Stream = ready_pop[T](engine);
        if (stream == nil) { brk; }
        engine.slot_visits = engine.slot_visits + 1;
        val result: Event = service_stream[T](engine, stream);
        if (result.kind == EVENT_ERROR || result.kind == EVENT_CANCELLED) { ret result; }
        wake_stream[T](engine, stream);
        if (result.kind == EVENT_BLOCKED) { output_blocked = true; }
        or (result.kind != EVENT_NONE)    { ret result; }
    }
    if (pending || engine.ready_count != 0) { ret base_event[T](engine, EVENT_PENDING); }
    if (engine.accept_blocked)              { ret base_event[T](engine, EVENT_MEMORY_BLOCKED); }
    if (output_blocked)                     { ret base_event[T](engine, EVENT_BLOCKED); }
    ret base_event[T](engine, EVENT_NONE);
}

# advances the connection and returns at most one event. EVENT_PENDING means
# work remains that this call's budget did not reach, so call again at once.
# EVENT_NONE means the transport has no unreported news, no peer stream is
# waiting to be accepted and no stream is queued, so the host may wait for
# transport or application news. EVENT_MEMORY_BLOCKED means a peer stream
# waits for a stream record the source refused, which the account's wake-up or
# a released stream provides. EVENT_BLOCKED means only output is stalled on
# the transport. PENDING wins over both, since work remains.
pub fun process[T](engine: *Engine[T]) Event {
    if (engine == nil || !engine.initialized) {
        ret invalid_event();
    }
    if (engine.state == CLOSED) { ret base_event[T](engine, EVENT_CLOSED); }
    if (engine.state == FAILED) { ret base_event[T](engine, EVENT_ERROR); }
    if (!scope_active(engine.scope)) {
        ret fail_connection[T](engine, ERROR_CANCELLED, H3_REQUEST_CANCELLED);
    }
    queue_increment[T](engine);
    val drained: Event = drain_releases[T](engine);
    if (drained.kind != EVENT_NONE) { ret drained; }
    val output: Event = progress_critical_output[T](engine);
    if (output.kind == EVENT_ERROR || output.kind == EVENT_CANCELLED) { ret output; }
    val accepted: Event = accept_peer[T](engine);
    if (accepted.kind != EVENT_NONE && accepted.kind != EVENT_PENDING) { ret accepted; }
    val reported: Event = drain_ready[T](engine);
    if (reported.kind != EVENT_NONE && reported.kind != EVENT_PENDING) { ret reported; }
    ret service_ready[T](engine, output.kind == EVENT_BLOCKED,
        accepted.kind == EVENT_PENDING || reported.kind == EVENT_PENDING);
}

pub fun consume_data[T](engine: *Engine[T], id: u64, count: usize) bool {
    val stream: *Stream = stream_for[T](engine, id);
    if (stream == nil || !stream.held || stream.held_kind != EVENT_DATA
        || count == 0 || count > stream.held_length || !credit[T](engine, stream, count)) {
        ret false;
    }
    stream.held_data   = ?stream.held_data[count];
    stream.held_length = stream.held_length - count;
    if (stream.held_length == 0) {
        stream.held      = false;
        stream.held_kind = EVENT_NONE;
        stream.held_data = nil;
        frame.release(?stream.parser);
    }
    wake_stream[T](engine, stream);
    ret true;
}

pub fun release_event[T](engine: *Engine[T], id: u64, generation: u64) bool {
    val stream: *Stream = stream_for[T](engine, id);
    if (stream == nil || !stream.held || stream.held_kind == EVENT_DATA
        || stream.generation != generation
        || (stream.held_kind == EVENT_REQUEST_HEADERS && stream.exchange == nil
        && !stream_terminal(stream))) {
        ret false;
    }
    stream.held            = false;
    stream.held_kind       = EVENT_NONE;
    stream.held_headers    = empty_headers();
    stream.held_end_stream = false;
    wake_stream[T](engine, stream);
    ret true;
}

pub fun release_stream[T](engine: *Engine[T], id: u64, generation: u64) bool {
    val stream: *Stream = stream_for[T](engine, id);
    if (stream == nil || stream.generation != generation || !stream_terminal(stream)
        || stream.held || stream.retry_pending
        || (stream.exchange != nil && stream.exchange.state != exchange.COMPLETE_STATE
        && stream.exchange.state != exchange.CANCELLED_STATE
        && stream.exchange.state != exchange.TIMED_OUT_STATE
        && stream.exchange.state != exchange.FAILED_STATE)) { ret false; }
    val released: TransportOperation = engine.transport.release(
        engine.transport.context, stream.transport_stream);
    if (released.status != TRANSPORT_OK) { ret false; }
    if (!stream.local && unidirectional(stream.transport_stream.id)
        && engine.active_peer_unidirectional != 0) {
        engine.active_peer_unidirectional = engine.active_peer_unidirectional - 1;
    }
    free_stream[T](engine, stream);
    ret true;
}

# every borrowed buffer, record and the index go back to the account. linear
# once per connection
fun release_all[T](engine: *Engine[T]) {
    var i: usize = 0;
    for (i < engine.stream_capacity) {
        release_request_memory[T](engine, slot_stream[T](engine, i));
        i = i + 1;
    }
    records.destroy(?engine.records, engine.source, engine.account);
    release_chunk[T](engine, engine.index_chunk);
    engine.stream_capacity = 0;
    engine.stream_index    = nil;
    engine.index_capacity  = 0;
    engine.free_head       = NO_SLOT;
}

# returns every borrowed record and buffer to the account and the engine to the
# state `init` accepts, so caller-owned storage can carry a second connection.
# zeroing is deliberate: the guards on both QPACK tables, the inbound and
# outbound section sets, and the critical-stream record all live inside this
# record, as does the pending-release count, and a field added later must not
# silently survive a reuse.
#
# the peer's control and QPACK streams stay live for the whole connection and
# are reclaimed by the transport close, so they do not block teardown; an
# application borrow or a release the transport still owes does. closed request
# streams the host never released give their buffers back here.
pub fun destroy[T](engine: *Engine[T]) bool {
    if (engine == nil || !engine.initialized) { ret false; }
    # the transport close reclaims every handle whose release is still owed
    if (engine.active_requests != 0
        || (engine.state != CLOSED && engine.pending_release_count != 0)) {
        ret false;
    }
    var i: usize = 0;
    for (i < engine.stream_capacity) {
        if (slot_stream[T](engine, i).live && slot_stream[T](engine, i).held) { ret false; }
        i = i + 1;
    }
    release_all[T](engine);
    var cleared: Engine[T];
    @engine = cleared;
    ret true;
}

pub fun detach_exchange[T](engine: *Engine[T], id: u64,
    generation: u64) *exchange.Exchange {
    val stream: *Stream = stream_for[T](engine, id);
    if (stream == nil || stream.generation != generation
        || !stream_terminal(stream) || stream.reset_code != H3_REQUEST_REJECTED) {
        ret nil;
    }
    val detached: *exchange.Exchange = stream.exchange;
    stream.exchange = nil;
    exchange_unlink[T](engine, stream);
    ret detached;
}

pub fun cancel_stream[T](engine: *Engine[T], id: u64, code: u64) bool {
    val stream: *Stream = stream_for[T](engine, id);
    if (stream == nil || stream_terminal(stream) || code > MAX_STREAM_ID
        || code == H3_NO_ERROR) { ret false; }
    val result: Event = stream_failure[T](engine, stream, code);
    ret result.kind == EVENT_STREAM_ERROR;
}

# the fallback for exchange scopes cancelled without `cancel_stream`. it walks
# only the exchange-bound request streams, so it is not called per event.
pub fun tick[T](engine: *Engine[T]) Event {
    if (engine == nil || !engine.initialized) {
        ret invalid_event();
    }
    if (!scope_active(engine.scope)) {
        ret fail_connection[T](engine, ERROR_CANCELLED, H3_REQUEST_CANCELLED);
    }
    var slot: usize = engine.exchange_head;
    for (slot != NO_SLOT) {
        val stream: *Stream = slot_stream[T](engine, slot);
        slot = stream.exchange_next;
        if (!stream_terminal(stream) && !scope_active(stream.exchange.scope)) {
            exchange.settle_cancellation(stream.exchange);
            val result: Event = stream_failure[T](engine, stream, H3_REQUEST_CANCELLED);
            var reset:  Event = result;
            reset.kind = EVENT_STREAM_RESET;
            ret reset;
        }
    }
    ret base_event[T](engine, EVENT_NONE);
}

pub fun set_qpack_capacity[T](engine: *Engine[T], capacity: usize) bool {
    if (engine == nil || !engine.initialized || !engine.peer_settings_received
        || capacity > engine.peer.qpack_max_table_capacity
        || queue_space(?engine.encoder) < 8) { ret false; }
    var bytes:   [8]u8;
    val encoded: qpack.Encode = qpack.encode_set_capacity(
        ?engine.outbound_table, capacity, ?bytes[0], 8);
    ret encoded.ok && queue_push(?engine.encoder, ?bytes[0], encoded.written);
}

pub fun insert_qpack[T](engine: *Engine[T], name: view.View, value: view.View,
    huffman_strings: bool, output: *u8, capacity: usize) bool {
    if (engine == nil || !engine.initialized || !engine.peer_settings_received
        || output == nil
        || (name.len != 0 && name.data == nil) || (value.len != 0 && value.data == nil)
        || name.len > engine.outbound_limits.max_field_bytes
        || value.len > engine.outbound_limits.max_field_bytes
        || name.len > (-1)::usize - value.len
        || capacity < engine.outbound_limits.max_instruction_bytes
        || queue_space(?engine.encoder)
        < engine.outbound_limits.max_instruction_bytes) { ret false; }
    val encoded: qpack.Encode = qpack.encode_insert_literal_name(
        ?engine.outbound_table, name, value, huffman_strings,
        output, engine.outbound_limits.max_instruction_bytes);
    ret encoded.ok && queue_push(?engine.encoder, output, encoded.written);
}

fun queue_goaway[T](engine: *Engine[T], id: u64) bool {
    var payload:        [8]u8;
    var output:         [24]u8;
    val payload_length: usize = frame.encode_varint(id, ?payload[0], 8);
    if (payload_length == 0) { ret false; }
    val prefix_length: usize = encode_frame_header(frame.FRAME_GOAWAY,
        payload_length, ?output[0], 24);
    if (prefix_length == 0 || prefix_length + payload_length > 24
        || prefix_length + payload_length > queue_space(?engine.control)) { ret false; }
    memory.raw_copy(?output[prefix_length], ?payload[0], payload_length);
    if (!queue_push(?engine.control, ?output[0], prefix_length + payload_length)) {
        ret false;
    }
    engine.goaway_sent  = true;
    engine.local_goaway = id;
    ret true;
}

pub fun begin_graceful[T](engine: *Engine[T]) bool {
    if (engine == nil || !engine.initialized || engine.state != OPEN
        || engine.graceful || !engine.local_settings_sent) { ret false; }
    var id: u64 = 0;
    if (engine.role == SERVER)        { id = MAX_REQUEST_ID; }
    if (!queue_goaway[T](engine, id)) { ret false; }
    engine.graceful = true;
    engine.state    = DRAINING;
    ret true;
}

pub fun finish_graceful[T](engine: *Engine[T]) bool {
    if (engine == nil || !engine.initialized || !engine.graceful
        || engine.final_goaway_sent) { ret false; }
    var id: u64 = 0;
    if (engine.role == SERVER && engine.last_remote_request != NO_STREAM) {
        if (engine.last_remote_request > MAX_REQUEST_ID - 4) { ret false; }
        id = engine.last_remote_request + 4;
    }
    if (id > engine.local_goaway || !queue_goaway[T](engine, id)) { ret false; }
    engine.final_goaway_sent = true;
    ret true;
}

fun pending_request_output[T](engine: *Engine[T]) bool {
    ret engine.output_streams != 0;
}

pub fun progress_close[T](engine: *Engine[T]) bool {
    if (engine == nil || !engine.initialized || engine.state == CLOSED) { ret false; }
    if (engine.close_started) {
        if (engine.state == FAILED) {
            engine.state = CLOSED;
            ret true;
        }
        ret false;
    }
    if (engine.state != FAILED && (!engine.graceful || !engine.final_goaway_sent
        || engine.active_requests != 0)) { ret false; }
    if (engine.control.count != 0 || engine.encoder.count != 0
        || engine.decoder.count != 0 || pending_request_output[T](engine)) { ret false; }
    engine.state = CLOSING;
    val code:   u64                = engine.h3_error;
    val closed: TransportOperation = engine.transport.close(
        engine.transport.context, code);
    if (closed.status == TRANSPORT_BLOCKED) { ret false; }
    # a transport the peer already closed has satisfied the close
    if (closed.status != TRANSPORT_OK && closed.status != TRANSPORT_CLOSED) {
        engine.error    = ERROR_TRANSPORT;
        engine.h3_error = H3_INTERNAL_ERROR;
        engine.state    = FAILED;
        ret false;
    }
    engine.close_started = true;
    engine.state         = CLOSED;
    ret true;
}

pub fun cancel_connection[T](engine: *Engine[T]) bool {
    if (engine == nil || !engine.initialized || engine.state == CLOSED
        || engine.state == FAILED) { ret false; }
    fail_connection[T](engine, ERROR_CANCELLED, H3_REQUEST_CANCELLED);
    ret true;
}

rec TestWire {
    handle:            StreamHandle;
    input:             *u8;
    input_length:      usize;
    input_offset:      usize;
    output:            *u8;
    output_capacity:   usize;
    output_length:     usize;
    delivered:         usize;
    credited:          usize;
    application_error: u64;
    live:              bool;
    local:             bool;
    pending_accept:    bool;
    fin:               bool;
    reset:             bool;
    finished:          bool;
    send_cancelled:    bool;
    receive_cancelled: bool;
    reset_acked:       bool;
    stop_acked:        bool;
    released:          bool;
    write_blocked:     bool;
}

val TEST_SIGNALS: usize = 256;

rec TestTransport {
    secret:         ^u64;
    wires:          *TestWire;
    capacity:       usize;
    role:           Role;
    source:         u64;
    next_bidi:      u64;
    next_uni:       u64;
    read_limit:     usize;
    write_limit:    usize;
    opens:          usize;
    accepts:        usize;
    close_calls:    usize;
    close_code:     u64;
    close_override: bool;
    close_status:   TransportStatus;
    calls:          usize;
    reads:          usize;
    signals:        [256]TransportReady;
    signal_head:    usize;
    signal_count:   usize;
    signal_dropped: bool;
}

fun test_call(io: *TestTransport) {
    io.calls = io.calls + 1;
}

# the fake's transport state changes only through the test, so every change is
# reported here, exactly as a real adapter must
fun test_signal(io: *TestTransport, value: StreamHandle, readable: bool,
    writable: bool, reset: bool) {
    if (io.signal_count == TEST_SIGNALS) {
        io.signal_dropped = true;
        ret;
    }
    io.signals[(io.signal_head + io.signal_count) % TEST_SIGNALS] = TransportReady{
        status:   TRANSPORT_OK, handle: value, readable: readable,
        writable: writable, reset: reset
    };
    io.signal_count = io.signal_count + 1;
}

fun test_ready(context: *TestTransport) TransportReady {
    val io: *TestTransport = context;
    test_call(io);
    if (io.signal_count == 0) {
        ret TransportReady{status: TRANSPORT_EMPTY, handle: no_handle(),
            readable: false, writable: false, reset: false};
    }
    val report: TransportReady = io.signals[io.signal_head];
    io.signal_head  = (io.signal_head + 1) % TEST_SIGNALS;
    io.signal_count = io.signal_count - 1;
    ret report;
}

fun wire_feed(io: *TestTransport, wire: *TestWire, input: *u8, length: usize,
    fin: bool) {
    wire.input        = input;
    wire.input_length = length;
    wire.input_offset = 0;
    wire.fin          = fin;
    test_signal(io, wire.handle, true, false, false);
}

fun wire_reset(io: *TestTransport, wire: *TestWire, code: u64) {
    wire.reset             = true;
    wire.application_error = code;
    test_signal(io, wire.handle, false, false, true);
}

fun wire_unblock(io: *TestTransport, wire: *TestWire) {
    wire.write_blocked = false;
    test_signal(io, wire.handle, false, true, false);
}

fun no_handle() StreamHandle {
    ret StreamHandle{source: 0, index: 0, generation: 0, id: 0};
}

fun test_wire(io: *TestTransport, value: StreamHandle) *TestWire {
    if (io == nil || value.source != io.source || value.index >= io.capacity) { ret nil; }
    val wire: *TestWire = ?io.wires[value.index];
    if (!wire.live || wire.handle.generation != value.generation
        || wire.handle.id != value.id) { ret nil; }
    ret wire;
}

fun test_claim(io: *TestTransport, id: u64) *TestWire {
    var i: usize = 0;
    for (i < io.capacity) {
        val wire: *TestWire = ?io.wires[i];
        if (!wire.live) {
            var generation: u64 = wire.handle.generation + 1;
            if (generation == 0) { generation = 1; }
            wire.handle = StreamHandle{source: io.source, index: i,
                generation: generation, id: id};
            wire.input             = nil;
            wire.input_length      = 0;
            wire.input_offset      = 0;
            wire.output_length     = 0;
            wire.delivered         = 0;
            wire.credited          = 0;
            wire.application_error = 0;
            wire.live              = true;
            wire.pending_accept    = false;
            wire.fin               = false;
            wire.reset             = false;
            wire.finished          = false;
            wire.send_cancelled    = false;
            wire.receive_cancelled = false;
            wire.reset_acked       = false;
            wire.stop_acked        = false;
            wire.local             = false;
            wire.released          = false;
            wire.write_blocked     = false;
            ret wire;
        }
        i = i + 1;
    }
    ret nil;
}

fun test_open(context: *TestTransport, direction: u8) TransportOpen {
    val io: *TestTransport = context;
    test_call(io);
    var id: u64 = io.next_bidi;
    if (direction == UNIDIRECTIONAL) { id = io.next_uni; }
    val wire: *TestWire = test_claim(io, id);
    if (wire == nil) {
        ret TransportOpen{status: TRANSPORT_BLOCKED, stream: no_handle(),
            stream_limit_blocked: false, storage_blocked: true, error: 0};
    }
    if (direction == UNIDIRECTIONAL) { io.next_uni = io.next_uni + 4; }
    or                               { io.next_bidi = io.next_bidi + 4; }
    wire.local = true;
    io.opens   = io.opens + 1;
    ret TransportOpen{status: TRANSPORT_OK, stream: wire.handle,
        stream_limit_blocked: false, storage_blocked: false, error: 0};
}

fun test_accept(context: *TestTransport) TransportOpen {
    val io: *TestTransport = context;
    test_call(io);
    var i: usize = 0;
    for (i < io.capacity) {
        if (io.wires[i].live && io.wires[i].pending_accept) {
            io.wires[i].pending_accept = false;
            io.accepts                 = io.accepts + 1;
            ret TransportOpen{status: TRANSPORT_OK, stream: io.wires[i].handle,
                stream_limit_blocked: false, storage_blocked: false, error: 0};
        }
        i = i + 1;
    }
    ret TransportOpen{status: TRANSPORT_EMPTY, stream: no_handle(),
        stream_limit_blocked: false, storage_blocked: false, error: 0};
}

fun test_read(context: *TestTransport, value: StreamHandle,
    output: *u8, capacity: usize) TransportRead {
    val io:   *TestTransport = context;
    val wire: *TestWire      = test_wire(io, value);
    test_call(io);
    io.reads = io.reads + 1;
    if (wire == nil || (output == nil && capacity != 0)) {
        ret TransportRead{status: TRANSPORT_ERROR, count: 0, final_size: 0,
            application_error: 0, fin: false, error: 1};
    }
    if (wire.reset) {
        ret TransportRead{status: TRANSPORT_CANCELLED, count: 0,
            final_size:        wire.input_length::u64,
            application_error: wire.application_error, fin: false, error: 0};
    }
    var count: usize = wire.input_length - wire.input_offset;
    if (count > capacity)                            { count = capacity; }
    if (io.read_limit != 0 && count > io.read_limit) { count = io.read_limit; }
    if (count != 0) {
        memory.raw_copy(output, ?wire.input[wire.input_offset], count);
        wire.input_offset = wire.input_offset + count;
        wire.delivered    = wire.delivered + count;
    }
    val fin: bool = wire.fin && wire.input_offset == wire.input_length;
    if (count == 0 && !fin) {
        ret TransportRead{status: TRANSPORT_EMPTY, count: 0,
            final_size:        wire.input_length::u64,
            application_error: 0, fin: false, error: 0};
    }
    ret TransportRead{status: TRANSPORT_OK, count: count,
        final_size: wire.input_length::u64, application_error: 0,
        fin:        fin, error: 0};
}

fun test_credit(context: *TestTransport, value: StreamHandle,
    count: usize) TransportOperation {
    val wire: *TestWire = test_wire(context, value);
    test_call(context);
    # a closed connection grants no more credit
    if (wire == nil || context.close_calls != 0 || count > wire.delivered - wire.credited) {
        ret TransportOperation{status: TRANSPORT_ERROR, error: 1};
    }
    wire.credited = wire.credited + count;
    ret TransportOperation{status: TRANSPORT_OK, error: 0};
}

fun test_write(context: *TestTransport, value: StreamHandle,
    input: *u8, length: usize) TransportWrite {
    val io:   *TestTransport = context;
    val wire: *TestWire      = test_wire(io, value);
    test_call(io);
    if (wire == nil || (input == nil && length != 0)
        || wire.output_length > wire.output_capacity
        || length > wire.output_capacity - wire.output_length) {
        ret TransportWrite{status: TRANSPORT_ERROR, count: 0,
            connection_blocked: false, stream_blocked: false,
            storage_blocked:    false, error: 1};
    }
    if (wire.write_blocked) {
        ret TransportWrite{status: TRANSPORT_BLOCKED, count: 0,
            connection_blocked: false, stream_blocked: true,
            storage_blocked:    false, error: 0};
    }
    var count: usize = length;
    if (io.write_limit != 0 && count > io.write_limit) { count = io.write_limit; }
    if (count != 0) {
        memory.raw_copy(?wire.output[wire.output_length], input, count);
        wire.output_length = wire.output_length + count;
    }
    ret TransportWrite{status: TRANSPORT_OK, count: count,
        connection_blocked: false, stream_blocked: false,
        storage_blocked:    false, error: 0};
}

fun test_finish(context: *TestTransport, value: StreamHandle) TransportOperation {
    val wire: *TestWire = test_wire(context, value);
    test_call(context);
    if (wire != nil && wire.write_blocked) {
        ret TransportOperation{status: TRANSPORT_BLOCKED, error: 0};
    }
    if (wire == nil) { ret TransportOperation{status: TRANSPORT_ERROR, error: 1}; }
    wire.finished = true;
    ret TransportOperation{status: TRANSPORT_OK, error: 0};
}

fun test_cancel_send(context: *TestTransport, value: StreamHandle,
    code: u64) TransportOperation {
    val wire: *TestWire = test_wire(context, value);
    test_call(context);
    if (wire == nil) { ret TransportOperation{status: TRANSPORT_ERROR, error: 1}; }
    wire.send_cancelled    = true;
    wire.application_error = code;
    ret TransportOperation{status: TRANSPORT_OK, error: 0};
}

fun test_cancel_receive(context: *TestTransport, value: StreamHandle,
    code: u64) TransportOperation {
    val wire: *TestWire = test_wire(context, value);
    test_call(context);
    if (wire == nil) { ret TransportOperation{status: TRANSPORT_ERROR, error: 1}; }
    wire.receive_cancelled = true;
    wire.application_error = code;
    ret TransportOperation{status: TRANSPORT_OK, error: 0};
}

# release means settled on the wire: both directions closed and any reset or
# stop this side sent acknowledged by the peer
fun test_settled(wire: *TestWire) bool {
    val uni:         bool = (wire.handle.id & 2) != 0;
    val can_send:    bool = !uni || wire.local;
    val can_receive: bool = !uni || !wire.local;
    var send_done:   bool = true;
    if (can_send) {
        if (wire.send_cancelled) { send_done = wire.reset_acked; }
        or                       { send_done = wire.finished; }
    }
    var receive_done: bool = true;
    if (can_receive) {
        if (wire.reset)             { receive_done = true; }
        or (wire.receive_cancelled) { receive_done = wire.stop_acked; }
        or                          { receive_done = wire.fin && wire.input_offset == wire.input_length; }
    }
    ret send_done && receive_done;
}

fun test_release(context: *TestTransport, value: StreamHandle) TransportOperation {
    val wire: *TestWire = test_wire(context, value);
    test_call(context);
    if (wire == nil) { ret TransportOperation{status: TRANSPORT_ERROR, error: 1}; }
    if (!test_settled(wire)) {
        ret TransportOperation{status: TRANSPORT_BLOCKED, error: 0};
    }
    wire.released = true;
    ret TransportOperation{status: TRANSPORT_OK, error: 0};
}

fun test_close(context: *TestTransport, code: u64) TransportOperation {
    val io: *TestTransport = context;
    test_call(io);
    io.close_calls = io.close_calls + 1;
    io.close_code  = code;
    if (io.close_override) { ret TransportOperation{status: io.close_status, error: 0}; }
    ret TransportOperation{status: TRANSPORT_OK, error: 0};
}

test "http.h3.connection: typed transport accepts a secret-welded context" {
    var io: TestTransport;
    io.secret = 7;
    val transport: Transport[TestTransport] = Transport[TestTransport]{
        context:     ?io, open: test_open, accept: test_accept, ready: test_ready,
        read:        test_read,
        credit:      test_credit, write: test_write, finish: test_finish,
        cancel_send: test_cancel_send, cancel_receive: test_cancel_receive,
        release:     test_release, close: test_close
    };
    val closed: TransportOperation = transport.close(transport.context, 42);
    if (closed.status != TRANSPORT_OK || io.close_calls != 1
        || io.close_code != 42 || io.secret:>u64 != 7) { ret 1; }
    ret 0;
}

val FIXTURE_WIRES: usize = 112;

rec Fixture {
    scope:               cancel.Scope;
    io:                  TestTransport;
    wires:               [112]TestWire;
    wire_output:         [112][1024]u8;
    backing:             allocator.Allocator;
    pool:                buffers.Pool;
    source:              buffers.Source;
    account:             buffers.Account;
    pending:             [4]StreamHandle;
    control_read:        [128]u8;
    control_settings:    [5]frame.Setting;
    encoder_read:        [128]u8;
    encoder_encoded:     [128]u8;
    encoder_scratch:     [256]u8;
    decoder_read:        [128]u8;
    decoder_encoded:     [128]u8;
    inbound_entries:     [8]qpack.Entry;
    inbound_storage:     [256]u8;
    inbound_scratch:     [256]u8;
    inbound_sections:    [8]qpack.Section;
    inbound_references:  [64]qpack.Reference;
    outbound_entries:    [8]qpack.Entry;
    outbound_storage:    [256]u8;
    outbound_scratch:    [256]u8;
    outbound_sections:   [8]qpack.Section;
    outbound_references: [64]qpack.Reference;
    control_queue:       [256]u8;
    encoder_queue:       [256]u8;
    decoder_queue:       [256]u8;
    engine:              Engine[TestTransport];
}

fun test_config() Config {
    var configured: Config = config_default();
    configured.max_requests                            = 3;
    configured.max_peer_unidirectional                 = 3;
    configured.max_pending_release                     = 4;
    configured.frames.max_frame_payload                = 256;
    configured.frames.max_settings                     = 5;
    configured.local.qpack_max_table_capacity          = 128;
    configured.local.max_field_section_size            = 512;
    configured.local.qpack_blocked_streams             = 2;
    configured.inbound_qpack.max_table_capacity        = 128;
    configured.inbound_qpack.max_blocked_streams       = 2;
    configured.inbound_qpack.max_field_bytes           = 128;
    configured.inbound_qpack.max_field_count           = 16;
    configured.inbound_qpack.max_field_section_bytes   = 512;
    configured.inbound_qpack.max_encoded_section_bytes = 256;
    configured.inbound_qpack.max_instruction_bytes     = 128;
    configured.inbound_qpack.max_outstanding_sections  = 8;
    configured.inbound_qpack.max_references            = 64;
    configured.outbound_qpack                          = configured.inbound_qpack;
    configured.read_bytes                              = 128;
    configured.output_bytes                            = 512;
    configured.initial_streams                         = 6;
    configured.stream_lane                             = 0;
    configured.connection_lane                         = 1;
    ret configured;
}

# a std pool with no size classes, so every chunk is exactly its request rounded
# to 16 bytes and the account's `used` counts bytes exactly
fun make_buffers(fixture: *Fixture) bool {
    val backed: err[allocator.Error] = page.make(?fixture.backing);
    if (sel backed.err) { ret false; }
    var config: buffers.Config;
    config.class_count   = 0;
    config.lanes         = 2;
    config.global_budget = 1 << 26;
    config.initial_slots = 16;
    if (!buffers.make(?fixture.pool, config, ?fixture.backing)) { ret false; }
    fixture.source = buffers.source(?fixture.pool);
    var budgets: [2]usize       = [2]usize{1 << 25, 1 << 25};
    val opened:  buffers.Reason = buffers.source_open_account(?fixture.source,
        ?fixture.account, 1, ?budgets[0], 0);
    ret sel opened.none;
}

# a fresh transport, as a pooled engine gets for its next connection
fun reset_io(fixture: *Fixture, role: Role) {
    fixture.io.wires    = ?fixture.wires[0];
    fixture.io.capacity = FIXTURE_WIRES;
    fixture.io.role     = role;
    fixture.io.source   = 77;
    if (role == CLIENT) {
        fixture.io.next_bidi = 0;
        fixture.io.next_uni  = 2;
    }
    or {
        fixture.io.next_bidi = 1;
        fixture.io.next_uni  = 3;
    }
    fixture.io.read_limit     = 0;
    fixture.io.write_limit    = 0;
    fixture.io.opens          = 0;
    fixture.io.accepts        = 0;
    fixture.io.close_calls    = 0;
    fixture.io.close_code     = 0;
    fixture.io.calls          = 0;
    fixture.io.reads          = 0;
    fixture.io.signal_head    = 0;
    fixture.io.signal_count   = 0;
    fixture.io.signal_dropped = false;
    var i: usize = 0;
    for (i < FIXTURE_WIRES) {
        fixture.wires[i].live              = false;
        fixture.wires[i].handle.generation = 0;
        fixture.wires[i].output            = ?fixture.wire_output[i][0];
        fixture.wires[i].output_capacity   = 1024;
        i                                  = i + 1;
    }
}

fun make_fixture(fixture: *Fixture, role: Role, configured: Config) bool {
    if (!operation_ok(cancel.make_root(?fixture.scope, opt[time.Instant].none{}))
        || !make_buffers(fixture)) { ret false; }
    reset_io(fixture, role);
    ret start_engine(fixture, role, configured);
}

fun fixture_critical(fixture: *Fixture) CriticalMemory {
    var control: StreamMemory = unbound_memory();
    control.read             = ?fixture.control_read[0];
    control.read_capacity    = 128;
    control.settings         = ?fixture.control_settings[0];
    control.setting_capacity = 5;
    var encoder: StreamMemory = unbound_memory();
    encoder.read             = ?fixture.encoder_read[0];
    encoder.read_capacity    = 128;
    encoder.encoded          = ?fixture.encoder_encoded[0];
    encoder.encoded_capacity = 128;
    encoder.scratch          = ?fixture.encoder_scratch[0];
    encoder.scratch_capacity = 256;
    var decoder: StreamMemory = unbound_memory();
    decoder.read             = ?fixture.decoder_read[0];
    decoder.read_capacity    = 128;
    decoder.encoded          = ?fixture.decoder_encoded[0];
    decoder.encoded_capacity = 128;
    ret CriticalMemory{control: control, encoder: encoder, decoder: decoder};
}

# every argument is the fixture's own storage, so calling this a second time is
# exactly what a pool does with a recycled engine
fun start_engine(fixture: *Fixture, role: Role, configured: Config) bool {
    val transport: Transport[TestTransport] = Transport[TestTransport]{
        context:     ?fixture.io,
        open:        test_open, accept: test_accept, ready: test_ready, read: test_read,
        credit:      test_credit, write: test_write, finish: test_finish,
        cancel_send: test_cancel_send, cancel_receive: test_cancel_receive,
        release:     test_release, close: test_close
    };
    val storage: Storage = Storage{
        source:                      ?fixture.source, account: ?fixture.account,
        critical:                    fixture_critical(fixture),
        pending_release:             ?fixture.pending[0], pending_release_capacity: 4,
        inbound_entries:             ?fixture.inbound_entries[0], inbound_entry_capacity: 8,
        inbound_storage:             ?fixture.inbound_storage[0], inbound_storage_capacity: 256,
        inbound_scratch:             ?fixture.inbound_scratch[0], inbound_scratch_capacity: 256,
        inbound_sections:            ?fixture.inbound_sections[0], inbound_section_capacity: 8,
        inbound_references:          ?fixture.inbound_references[0],
        inbound_reference_capacity:  64,
        outbound_entries:            ?fixture.outbound_entries[0], outbound_entry_capacity: 8,
        outbound_storage:            ?fixture.outbound_storage[0], outbound_storage_capacity: 256,
        outbound_scratch:            ?fixture.outbound_scratch[0], outbound_scratch_capacity: 256,
        outbound_sections:           ?fixture.outbound_sections[0], outbound_section_capacity: 8,
        outbound_references:         ?fixture.outbound_references[0],
        outbound_reference_capacity: 64,
        control_queue:               ?fixture.control_queue[0], control_queue_capacity: 256,
        encoder_queue:               ?fixture.encoder_queue[0], encoder_queue_capacity: 256,
        decoder_queue:               ?fixture.decoder_queue[0], decoder_queue_capacity: 256,
    };
    ret init[TestTransport](?fixture.engine, role, transport, ?fixture.scope, storage, configured);
}

fun peer_stream(fixture: *Fixture, id: u64, input: *u8,
    length: usize, fin: bool) *TestWire {
    if ((input == nil && length != 0) || local_initiated[TestTransport](?fixture.engine, id)) {
        ret nil;
    }
    val wire: *TestWire = test_claim(?fixture.io, id);
    if (wire == nil) { ret nil; }
    wire.input          = input;
    wire.input_length   = length;
    wire.input_offset   = 0;
    wire.fin            = fin;
    wire.pending_accept = true;
    ret wire;
}

fun drive(fixture: *Fixture, kind: EventKind, maximum: usize) Event {
    var i: usize = 0;
    for (i < maximum) {
        val result: Event = process[TestTransport](?fixture.engine);
        if (result.kind == kind || result.kind == EVENT_ERROR
            || result.kind == EVENT_CANCELLED) { ret result; }
        i = i + 1;
    }
    ret base_event[TestTransport](?fixture.engine, EVENT_NONE);
}

fun server_handshake(fixture: *Fixture) Event {
    process[TestTransport](?fixture.engine);
    var control: [3]u8;
    control[0] = frame.STREAM_CONTROL::u8;
    control[1] = frame.FRAME_SETTINGS::u8;
    control[2] = 0;
    if (peer_stream(fixture, 2, ?control[0], 3, false) == nil) {
        ret base_event[TestTransport](?fixture.engine, EVENT_ERROR);
    }
    ret drive(fixture, EVENT_SETTINGS, 64);
}

fun client_handshake(fixture: *Fixture) Event {
    process[TestTransport](?fixture.engine);
    var control: [3]u8;
    control[0] = frame.STREAM_CONTROL::u8;
    control[1] = frame.FRAME_SETTINGS::u8;
    control[2] = 0;
    if (peer_stream(fixture, 3, ?control[0], 3, false) == nil) {
        ret base_event[TestTransport](?fixture.engine, EVENT_ERROR);
    }
    ret drive(fixture, EVENT_SETTINGS, 64);
}

fun append_frame(output: *u8, capacity: usize, typ: u64,
    payload: *u8, length: usize) usize {
    val prefix: usize = encode_frame_header(typ, length, output, capacity);
    if (prefix == 0 || length > capacity - prefix
        || (payload == nil && length != 0)) { ret 0; }
    if (length != 0) { memory.raw_copy(?output[prefix], payload, length); }
    ret prefix + length;
}

fun static_request(output: *u8, capacity: usize) usize {
    var block: [8]u8;
    block[0] = 0;
    block[1] = 0;
    block[2] = 0xd1;
    block[3] = 0xd7;
    block[4] = 0xc1;
    block[5] = 0x50;
    block[6] = 1;
    block[7] = 'x';
    ret append_frame(output, capacity, frame.FRAME_HEADERS, ?block[0], 8);
}

fun regular_request(output: *u8, capacity: usize) usize {
    var block: [9]u8;
    block[0] = 0;
    block[1] = 0;
    block[2] = 0xd1;
    block[3] = 0xd7;
    block[4] = 0xc1;
    block[5] = 0x50;
    block[6] = 1;
    block[7] = 'x';
    block[8] = 0xdd;
    ret append_frame(output, capacity, frame.FRAME_HEADERS, ?block[0], 9);
}

fun informational_response(output: *u8, capacity: usize) usize {
    var block: [3]u8;
    block[0] = 0;
    block[1] = 0;
    block[2] = 0xd8;
    ret append_frame(output, capacity, frame.FRAME_HEADERS, ?block[0], 3);
}

fun blocked_request(output: *u8, capacity: usize) usize {
    ret blocked_request_at(output, capacity, 2);
}

# the encoded required insert count 2 needs one insert, 3 needs two, and the
# section references the newest entry it requires
fun blocked_request_at(output: *u8, capacity: usize, encoded_required: u8) usize {
    var block: [6]u8;
    block[0] = encoded_required;
    block[1] = 0;
    block[2] = 0xd1;
    block[3] = 0xd7;
    block[4] = 0xc1;
    block[5] = 0x80;
    ret append_frame(output, capacity, frame.FRAME_HEADERS, ?block[0], 6);
}

rec ExchangeMemory {
    scope:             cancel.Scope;
    request:           message.Request;
    response:          message.Response;
    reader:            body.Reader;
    response_fields:   [16]field.Field;
    response_trailers: [8]field.Field;
    informationals:    [4]message.Informational;
    exchange:          exchange.Exchange;
}

fun make_exchange(storage: *ExchangeMemory, generation: u64, id: u64) bool {
    val configured: message.Limits = message.limits_default();
    val none:       time.Instant   = time.Instant{sec: 0, nsec: 0};
    if (!operation_ok(cancel.make_root(?storage.scope, opt[time.Instant].none{}))) { ret false; }
    var fields:   field.Fields = field.init(nil, 0, field.limits(0, 0, 0, 0));
    var trailers: field.Fields = field.init(nil, 0, field.limits(0, 0, 0, 0));
    storage.reader = body.empty_reader(generation);
    val metadata: message.Metadata = message.Metadata{
        version:     message.version_h3(), secure: true, early_data: false,
        peer:        message.unspecified_endpoint(), local: message.unspecified_endpoint(),
        received_at: time.Time{sec: 1, nsec: 0},
        deadline:    opt[time.Instant].none{}, request_index: id
    };
    if (!message.init_request(?storage.request, method.from_kind(method.GET),
        target.origin(view.view("/", 1), view.view("/", 1),
        view.view(nil, 0)), metadata, fields, trailers,
        ?storage.reader, generation, configured)
        || !message.init_response(?storage.response, ?storage.response_fields[0], 16,
        ?storage.response_trailers[0], 8, generation, configured)
        || !exchange.init(?storage.exchange, ?storage.request, ?storage.response,
        ?storage.informationals[0], 4, ?storage.scope, generation, configured)) {
        ret false;
    }
    ret true;
}

fun test_service(context: ptr, served: *exchange.Exchange) exchange.ServiceStatus {
    val configured: message.Limits = message.limits_default();
    if (message.set_status(served.response, status.NO_CONTENT) != message.RESPONSE_OK
        || exchange.commit(served, configured) != message.RESPONSE_OK
        || exchange.finish(served) != exchange.FINISH_OK) {
        ret exchange.SERVICE_FAILED;
    }
    ret exchange.SERVICE_COMPLETE;
}

# one complete server exchange over a request stream that the caller releases
fun pooled_exchange(fixture: *Fixture, storage: *ExchangeMemory) bool {
    var request_bytes:  [16]u8;
    val request_length: usize     = static_request(?request_bytes[0], 16);
    val wire:           *TestWire = peer_stream(fixture, 0, ?request_bytes[0],
        request_length, true);
    if (wire == nil) { ret false; }
    val request: Event = drive(fixture, EVENT_REQUEST_HEADERS, 128);
    if (request.kind != EVENT_REQUEST_HEADERS || request.stream_id != 0) {
        ret false;
    }
    # a live request refuses teardown
    if (destroy[TestTransport](?fixture.engine)) { ret false; }
    val service: exchange.Service = exchange.Service{ctx: nil, serve: test_service};
    if (!make_exchange(storage, request.generation, 0)
        || !bind_exchange[TestTransport](?fixture.engine, 0, ?storage.exchange)
        || !release_event[TestTransport](?fixture.engine, 0, request.generation)
        || dispatch[TestTransport](?fixture.engine, 0, ?service) != exchange.SERVICE_COMPLETE
        || drive(fixture, EVENT_STREAM_END, 64).stream_id != 0) { ret false; }
    var response: [1]field.Field;
    response[0] = field.Field{name: view.view(":status", 7),
        value: view.view("204", 3), sensitive: false};
    if (send_headers[TestTransport](?fixture.engine, 0, ?response[0], 1, true,
        false).status != OFFER_OUTPUT) { ret false; }
    var i: usize = 0;
    for (i < 128 && !wire.finished) {
        process[TestTransport](?fixture.engine);
        i = i + 1;
    }
    if (!wire.finished) { ret false; }
    ret release_stream[TestTransport](?fixture.engine, 0, request.generation);
}

fun insert_peer_entry(fixture: *Fixture, id: u64) bool {
    var instructions: [6]u8;
    instructions[0] = frame.STREAM_QPACK_ENCODER::u8;
    instructions[1] = 0x3f;
    instructions[2] = 0x61;
    instructions[3] = 0xc0;
    instructions[4] = 1;
    instructions[5] = 'x';
    if (peer_stream(fixture, id, ?instructions[0], 6, false) == nil) { ret false; }
    var i: usize = 0;
    for (i < 64 && fixture.engine.inbound_table.insert_count == 0) {
        process[TestTransport](?fixture.engine);
        i = i + 1;
    }
    ret fixture.engine.inbound_table.insert_count == 1;
}

test "http.h3.connection: destroy returns pooled storage for a second connection" {
    var fixture: Fixture;
    var first:   ExchangeMemory;
    var second:  ExchangeMemory;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    if (!insert_peer_entry(?fixture, 6))     { ret 2; }
    if (!pooled_exchange(?fixture, ?first))  { ret 3; }
    if (fixture.engine.active_requests != 0) { ret 4; }
    if (!begin_graceful[TestTransport](?fixture.engine)
        || !finish_graceful[TestTransport](?fixture.engine)) { ret 5; }
    var guard: usize = 0;
    for (guard < 128 && fixture.engine.state != CLOSED) {
        process[TestTransport](?fixture.engine);
        progress_close[TestTransport](?fixture.engine);
        guard = guard + 1;
    }
    if (fixture.engine.state != CLOSED || fixture.io.close_calls != 1) { ret 6; }
    if (!destroy[TestTransport](?fixture.engine))                      { ret 7; }
    if (fixture.engine.initialized || fixture.engine.inbound_table.valid
        || fixture.engine.outbound_table.valid
        || fixture.engine.inbound_sections.valid
        || fixture.engine.outbound_sections.valid
        || fixture.engine.critical.initialized
        || fixture.engine.inbound_table.insert_count != 0
        || fixture.engine.pending_release_count != 0) { ret 8; }
    if (destroy[TestTransport](?fixture.engine)) { ret 9; }
    reset_io(?fixture, SERVER);
    if (!start_engine(?fixture, SERVER, test_config())) { ret 10; }
    if (fixture.engine.state != STARTING
        || fixture.engine.inbound_table.insert_count != 0
        || fixture.engine.active_peer_unidirectional != 0
        || fixture.engine.peer_settings_received) { ret 11; }
    if (server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 12; }
    if (!insert_peer_entry(?fixture, 6))                   { ret 13; }
    if (!pooled_exchange(?fixture, ?second))               { ret 14; }
    if (fixture.engine.active_requests != 0 || fixture.io.close_calls != 0) {
        ret 15;
    }
    if (!destroy[TestTransport](?fixture.engine)) { ret 16; }
    ret 0;
}

test "http.h3.connection: settings and critical streams survive every-byte fragmentation" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())) { ret 1; }
    fixture.io.read_limit  = 1;
    fixture.io.write_limit = 1;
    val settings:       Event   = server_handshake(?fixture);
    val control_stream: *Stream = stream_for[TestTransport](?fixture.engine, 2);
    if (control_stream == nil) { ret 2; }
    val control: *TestWire = test_wire(?fixture.io, control_stream.transport_stream);
    if (settings.kind != EVENT_SETTINGS) { ret 3; }
    var progress: usize = 0;
    for (fixture.engine.state != OPEN && progress < 128) {
        process[TestTransport](?fixture.engine);
        progress = progress + 1;
    }
    if (fixture.engine.state != OPEN)            { ret 32; }
    if (fixture.io.opens != 3)                   { ret 33; }
    if (!fixture.engine.outbound_sections.valid) { ret 34; }
    if (control == nil || control.credited != 3) { ret 35; }
    if (!fixture.engine.local_control.opened
        || !fixture.engine.local_encoder.opened
        || !fixture.engine.local_decoder.opened) { ret 36; }
    ret 0;
}

test "http.h3.connection: duplicate and closed critical streams fail the connection" {
    var duplicate: Fixture;
    if (!make_fixture(?duplicate, SERVER, test_config())
        || server_handshake(?duplicate).kind != EVENT_SETTINGS) { ret 1; }
    var control: [1]u8;
    control[0] = frame.STREAM_CONTROL::u8;
    if (peer_stream(?duplicate, 6, ?control[0], 1, false) == nil) { ret 2; }
    val failed: Event = drive(?duplicate, EVENT_ERROR, 32);
    if (failed.code != H3_STREAM_CREATION_ERROR
        || duplicate.io.close_code != H3_STREAM_CREATION_ERROR) { ret 3; }
    var closed: Fixture;
    if (!make_fixture(?closed, SERVER, test_config())) { ret 4; }
    process[TestTransport](?closed.engine);
    var empty_control: [3]u8;
    empty_control[0] = frame.STREAM_CONTROL::u8;
    empty_control[1] = frame.FRAME_SETTINGS::u8;
    empty_control[2] = 0;
    if (peer_stream(?closed, 2, ?empty_control[0], 3, true) == nil
        || drive(?closed, EVENT_SETTINGS, 32).kind != EVENT_SETTINGS) { ret 5; }
    val terminal: Event = drive(?closed, EVENT_ERROR, 16);
    if (terminal.code != H3_CLOSED_CRITICAL_STREAM) { ret 6; }
    ret 0;
}

test "http.h3.connection: request headers bind one exchange and data credit follows consumption" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    fixture.io.read_limit = 2;
    var wire_bytes:     [32]u8;
    val headers_length: usize = static_request(?wire_bytes[0], 32);
    var data:           [3]u8;
    data[0] = 'a';
    data[1] = 'b';
    data[2] = 'c';
    val data_length: usize = append_frame(?wire_bytes[headers_length],
        32 - headers_length, frame.FRAME_DATA, ?data[0], 3);
    val wire: *TestWire = peer_stream(?fixture, 0, ?wire_bytes[0],
        headers_length + data_length, true);
    if (wire == nil) { ret 2; }
    val headers: Event = drive(?fixture, EVENT_REQUEST_HEADERS, 128);
    if (headers.stream_id != 0 || headers.headers.count != 4
        || headers.headers.regular_offset != 4 || wire.credited != headers_length) { ret 3; }
    var storage: ExchangeMemory;
    if (!make_exchange(?storage, headers.generation, 0)
        || !bind_exchange[TestTransport](?fixture.engine, 0, ?storage.exchange)
        || exchange_for[TestTransport](?fixture.engine, 0) != ?storage.exchange
        || !release_event[TestTransport](?fixture.engine, 0, headers.generation)) { ret 4; }
    val service: exchange.Service = exchange.Service{ctx: nil, serve: test_service};
    if (dispatch[TestTransport](?fixture.engine, 0, ?service) != exchange.SERVICE_COMPLETE) { ret 5; }
    val body_event: Event = drive(?fixture, EVENT_DATA, 64);
    if (body_event.data_length != 2 || wire.credited != headers_length + 2
        || !consume_data[TestTransport](?fixture.engine, 0, 1)
        || process[TestTransport](?fixture.engine).data_length != 1
        || !consume_data[TestTransport](?fixture.engine, 0, 1)) { ret 6; }
    val second: Event = drive(?fixture, EVENT_DATA, 32);
    if (second.data_length != 1 || !consume_data[TestTransport](?fixture.engine, 0, 1)) { ret 7; }
    val ended: Event = drive(?fixture, EVENT_STREAM_END, 32);
    if (!ended.end_stream || wire.credited != headers_length + data_length
        || process[TestTransport](?fixture.engine).kind != EVENT_NONE) { ret 8; }
    ret 0;
}

test "http.h3.connection: unknown request frames are ignored around header sections" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var input:     [32]u8;
    var extension: [1]u8;
    extension[0] = 'x';
    val extension_length: usize = append_frame(?input[0], 32,
        0x21, ?extension[0], 1);
    val request_length: usize = static_request(?input[extension_length],
        32 - extension_length);
    val wire: *TestWire = peer_stream(?fixture, 0, ?input[0],
        extension_length + request_length, false);
    if (wire == nil) { ret 2; }
    val request: Event = drive(?fixture, EVENT_REQUEST_HEADERS, 32);
    if (request.stream_id != 0 || request.headers.count != 4
        || wire.credited != extension_length + request_length
        || fixture.io.close_calls != 0) { ret 3; }
    ret 0;
}

test "http.h3.connection: qpack blocking preserves credit while unrelated requests progress" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var first_bytes:  [16]u8;
    val first_length: usize     = blocked_request(?first_bytes[0], 16);
    val first_wire:   *TestWire = peer_stream(?fixture, 0,
        ?first_bytes[0], first_length, false);
    if (first_wire == nil
        || drive(?fixture, EVENT_BLOCKED, 64).kind != EVENT_BLOCKED
        || fixture.engine.inbound_sections.blocked_count != 1
        || first_wire.credited != first_length - 6) { ret 2; }
    var second_bytes:  [16]u8;
    val second_length: usize = static_request(?second_bytes[0], 16);
    if (peer_stream(?fixture, 4, ?second_bytes[0], second_length, false) == nil) {
        ret 3;
    }
    val second:          Event = drive(?fixture, EVENT_REQUEST_HEADERS, 64);
    var second_exchange: ExchangeMemory;
    if (second.stream_id != 4
        || !make_exchange(?second_exchange, second.generation, 4)
        || !bind_exchange[TestTransport](?fixture.engine, 4, ?second_exchange.exchange)
        || !release_event[TestTransport](?fixture.engine, 4, second.generation)) { ret 4; }
    var instructions: [6]u8;
    instructions[0] = frame.STREAM_QPACK_ENCODER::u8;
    instructions[1] = 0x3f;
    instructions[2] = 0x61;
    instructions[3] = 0xc0;
    instructions[4] = 1;
    instructions[5] = 'x';
    if (peer_stream(?fixture, 6, ?instructions[0], 6, false) == nil) { ret 5; }
    val first: Event = drive(?fixture, EVENT_REQUEST_HEADERS, 128);
    if (first.stream_id != 0 || first.headers.count != 4
        || fixture.engine.inbound_table.insert_count != 1
        || fixture.engine.inbound_sections.blocked_count != 0
        || first_wire.credited != first_length) { ret 6; }
    ret 0;
}

test "http.h3.connection: blocked-stream budget and malformed frame order fail closed" {
    var configured: Config = test_config();
    configured.local.qpack_blocked_streams       = 1;
    configured.inbound_qpack.max_blocked_streams = 1;
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, configured)
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var one:        [16]u8;
    var two:        [16]u8;
    val one_length: usize = blocked_request(?one[0], 16);
    val two_length: usize = blocked_request(?two[0], 16);
    if (peer_stream(?fixture, 0, ?one[0], one_length, false) == nil
        || drive(?fixture, EVENT_BLOCKED, 64).kind != EVENT_BLOCKED
        || peer_stream(?fixture, 4, ?two[0], two_length, false) == nil) { ret 2; }
    val exceeded: Event = drive(?fixture, EVENT_ERROR, 64);
    if (exceeded.code != QPACK_DECOMPRESSION_FAILED
        || fixture.io.close_code != QPACK_DECOMPRESSION_FAILED) { ret 3; }
    var malformed: Fixture;
    if (!make_fixture(?malformed, SERVER, test_config())
        || server_handshake(?malformed).kind != EVENT_SETTINGS) { ret 4; }
    var data: [3]u8;
    data[0] = frame.FRAME_DATA::u8;
    data[1] = 1;
    data[2] = 'x';
    if (peer_stream(?malformed, 0, ?data[0], 3, false) == nil) { ret 5; }
    val order: Event = drive(?malformed, EVENT_ERROR, 32);
    if (order.code != H3_FRAME_UNEXPECTED
        || malformed.io.close_calls != 1
        || malformed.io.close_code != H3_FRAME_UNEXPECTED) { ret 6; }
    ret 0;
}

test "http.h3.connection: message collections enforce independent regular-field limits" {
    var request_config: Config = test_config();
    request_config.messages.request_fields.max_count = 0;
    var request_fixture: Fixture;
    if (!make_fixture(?request_fixture, SERVER, request_config)
        || server_handshake(?request_fixture).kind != EVENT_SETTINGS) { ret 1; }
    var request_bytes:  [16]u8;
    val request_length: usize = regular_request(?request_bytes[0], 16);
    if (peer_stream(?request_fixture, 0, ?request_bytes[0],
        request_length, false) == nil) { ret 2; }
    val rejected: Event = drive(?request_fixture, EVENT_STREAM_ERROR, 32);
    if (rejected.code != H3_EXCESSIVE_LOAD
        || request_fixture.io.close_calls != 0) { ret 3; }

    var response_config: Config = test_config();
    response_config.messages.response_fields.max_count = 0;
    var response_fixture: Fixture;
    if (!make_fixture(?response_fixture, SERVER, response_config)
        || server_handshake(?response_fixture).kind != EVENT_SETTINGS) { ret 4; }
    var peer_bytes:  [16]u8;
    val peer_length: usize = static_request(?peer_bytes[0], 16);
    if (peer_stream(?response_fixture, 0, ?peer_bytes[0],
        peer_length, false) == nil) { ret 5; }
    val request: Event = drive(?response_fixture, EVENT_REQUEST_HEADERS, 32);
    var storage: ExchangeMemory;
    if (!make_exchange(?storage, request.generation, 0)
        || !bind_exchange[TestTransport](?response_fixture.engine, 0, ?storage.exchange)
        || !release_event[TestTransport](?response_fixture.engine, 0, request.generation)) { ret 6; }
    var response: [2]field.Field;
    response[0] = field.Field{name: view.view(":status", 7),
        value: view.view("200", 3), sensitive: false};
    response[1] = field.Field{name: view.view("accept", 6),
        value: view.view("*/*", 3), sensitive: false};
    val offered: Offer = send_headers[TestTransport](?response_fixture.engine, 0,
        ?response[0], 2, false, false);
    if (offered.status != OFFER_ERROR || offered.error != ERROR_LIMIT) { ret 7; }

    var target_config: Config = test_config();
    target_config.messages.target.max_path_bytes = 0;
    var target_fixture: Fixture;
    if (!make_fixture(?target_fixture, SERVER, target_config)
        || server_handshake(?target_fixture).kind != EVENT_SETTINGS) { ret 8; }
    var target_bytes:  [16]u8;
    val target_length: usize = static_request(?target_bytes[0], 16);
    if (peer_stream(?target_fixture, 0, ?target_bytes[0],
        target_length, false) == nil) { ret 9; }
    val target_rejected: Event = drive(?target_fixture,
        EVENT_STREAM_ERROR, 32);
    if (target_rejected.code != H3_EXCESSIVE_LOAD
        || target_fixture.io.close_calls != 0) { ret 10; }
    ret 0;
}

test "http.h3.connection: informational response counts are bounded in both directions" {
    var client_config: Config = test_config();
    client_config.messages.max_informational = 1;
    var client: Fixture;
    if (!make_fixture(?client, CLIENT, client_config)
        || client_handshake(?client).kind != EVENT_SETTINGS) { ret 1; }
    val id:            u64     = open_request[TestTransport](?client.engine, nil);
    val client_stream: *Stream = stream_for[TestTransport](?client.engine, id);
    if (id != 0 || client_stream == nil) { ret 2; }
    val client_wire: *TestWire = test_wire(?client.io,
        client_stream.transport_stream);
    var response_bytes: [16]u8;
    val first_length:   usize = informational_response(?response_bytes[0], 16);
    val second_length:  usize = informational_response(
        ?response_bytes[first_length], 16 - first_length);
    if (client_wire == nil || first_length == 0 || second_length == 0) { ret 3; }
    wire_feed(?client.io, client_wire, ?response_bytes[0],
        first_length + second_length, false);
    val first: Event = drive(?client, EVENT_INFORMATIONAL, 32);
    if (first.stream_id != 0 || first.headers.status != 103
        || !release_event[TestTransport](?client.engine, 0, first.generation)) { ret 4; }
    val excess: Event = drive(?client, EVENT_STREAM_ERROR, 32);
    if (excess.code != H3_EXCESSIVE_LOAD || client.io.close_calls != 0) { ret 5; }

    var server_config: Config = test_config();
    server_config.messages.max_informational = 1;
    var server: Fixture;
    if (!make_fixture(?server, SERVER, server_config)
        || server_handshake(?server).kind != EVENT_SETTINGS) { ret 6; }
    var request_bytes:  [16]u8;
    val request_length: usize = static_request(?request_bytes[0], 16);
    if (peer_stream(?server, 0, ?request_bytes[0], request_length, false) == nil) {
        ret 7;
    }
    val request: Event = drive(?server, EVENT_REQUEST_HEADERS, 32);
    var storage: ExchangeMemory;
    if (!make_exchange(?storage, request.generation, 0)
        || !bind_exchange[TestTransport](?server.engine, 0, ?storage.exchange)
        || !release_event[TestTransport](?server.engine, 0, request.generation)) { ret 8; }
    var information: [1]field.Field;
    information[0] = field.Field{name: view.view(":status", 7),
        value: view.view("103", 3), sensitive: false};
    if (send_headers[TestTransport](?server.engine, 0, ?information[0], 1,
        false, false).status != OFFER_OUTPUT) { ret 9; }
    process[TestTransport](?server.engine);
    val outbound_excess: Offer = send_headers[TestTransport](?server.engine, 0,
        ?information[0], 1, false, false);
    if (outbound_excess.status != OFFER_ERROR
        || outbound_excess.error != ERROR_LIMIT) { ret 10; }
    ret 0;
}

test "http.h3.connection: body byte chunk and frame budgets are transactional" {
    var inbound_config: Config = test_config();
    inbound_config.messages.request_body.max_chunk_bytes = 2;
    inbound_config.messages.request_body.max_chunks      = 1;
    var inbound: Fixture;
    if (!make_fixture(?inbound, SERVER, inbound_config)
        || server_handshake(?inbound).kind != EVENT_SETTINGS) { ret 1; }
    var input:         [32]u8;
    val header_length: usize = static_request(?input[0], 32);
    var payload:       [3]u8;
    payload[0] = 'a';
    payload[1] = 'b';
    payload[2] = 'c';
    val data_length: usize = append_frame(?input[header_length],
        32 - header_length, frame.FRAME_DATA, ?payload[0], 3);
    val second_length: usize = append_frame(?input[header_length + data_length],
        32 - header_length - data_length, frame.FRAME_DATA, ?payload[0], 1);
    if (peer_stream(?inbound, 0, ?input[0],
        header_length + data_length + second_length, false) == nil) { ret 2; }
    val request:         Event = drive(?inbound, EVENT_REQUEST_HEADERS, 32);
    var inbound_storage: ExchangeMemory;
    if (!make_exchange(?inbound_storage, request.generation, 0)
        || !bind_exchange[TestTransport](?inbound.engine, 0, ?inbound_storage.exchange)
        || !release_event[TestTransport](?inbound.engine, 0, request.generation)) { ret 3; }
    # a data frame longer than the read chunk streams instead of failing
    val inbound_data: Event = drive(?inbound, EVENT_DATA, 32);
    if (inbound_data.data_length != 3
        || stream_for[TestTransport](?inbound.engine, 0).inbound_body_chunks != 1
        || !consume_data[TestTransport](?inbound.engine, 0, 3)) { ret 4; }
    # the frame count is still policed
    val inbound_excess: Event = drive(?inbound, EVENT_STREAM_ERROR, 32);
    if (inbound_excess.code != H3_EXCESSIVE_LOAD || inbound.io.close_calls != 0) { ret 8; }

    var outbound_config: Config = test_config();
    outbound_config.messages.response_body.max_chunk_bytes = 2;
    outbound_config.messages.response_body.max_chunks      = 1;
    var outbound: Fixture;
    if (!make_fixture(?outbound, SERVER, outbound_config)
        || server_handshake(?outbound).kind != EVENT_SETTINGS) { ret 5; }
    var request_bytes:  [16]u8;
    val request_length: usize = static_request(?request_bytes[0], 16);
    if (peer_stream(?outbound, 0, ?request_bytes[0], request_length, false) == nil) {
        ret 6;
    }
    val outbound_request: Event = drive(?outbound, EVENT_REQUEST_HEADERS, 32);
    var outbound_storage: ExchangeMemory;
    if (!make_exchange(?outbound_storage, outbound_request.generation, 0)
        || !bind_exchange[TestTransport](?outbound.engine, 0, ?outbound_storage.exchange)
        || !release_event[TestTransport](?outbound.engine, 0, outbound_request.generation)) { ret 7; }
    var response: [1]field.Field;
    response[0] = field.Field{name: view.view(":status", 7),
        value: view.view("200", 3), sensitive: false};
    if (send_headers[TestTransport](?outbound.engine, 0, ?response[0], 1,
        false, false).status != OFFER_OUTPUT) { ret 8; }
    process[TestTransport](?outbound.engine);
    val partial: Offer = offer_data[TestTransport](?outbound.engine, 0, ?payload[0], 3, false);
    if (partial.status != OFFER_PARTIAL || partial.consumed != 2) { ret 9; }
    process[TestTransport](?outbound.engine);
    val exhausted: Offer = offer_data[TestTransport](?outbound.engine, 0, ?payload[2], 1, true);
    if (exhausted.status != OFFER_ERROR || exhausted.error != ERROR_LIMIT
        || stream_for[TestTransport](?outbound.engine, 0).outbound_body_bytes != 2
        || stream_for[TestTransport](?outbound.engine, 0).outbound_body_chunks != 1) { ret 10; }
    ret 0;
}

test "http.h3.connection: sustained multiplexing reuses bounded stream generations" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    fixture.io.read_limit  = 1;
    fixture.io.write_limit = 1;
    var exchanges:           [6]ExchangeMemory;
    var previous_generation: u64   = 0;
    var i:                   usize = 0;
    for (i < 6) {
        val id:     u64       = i::u64 * 4;
        var input:  [16]u8;
        val length: usize     = static_request(?input[0], 16);
        val wire:   *TestWire = peer_stream(?fixture, id, ?input[0], length, true);
        if (wire == nil) { ret 2; }
        val request: Event = drive(?fixture, EVENT_REQUEST_HEADERS, 128);
        if (request.stream_id != id || request.generation <= previous_generation
            || !make_exchange(?exchanges[i], request.generation, id)
            || !bind_exchange[TestTransport](?fixture.engine, id, ?exchanges[i].exchange)
            || !release_event[TestTransport](?fixture.engine, id, request.generation)) { ret 3; }
        val service: exchange.Service = exchange.Service{ctx: nil, serve: test_service};
        if (dispatch[TestTransport](?fixture.engine, id, ?service) != exchange.SERVICE_COMPLETE
            || drive(?fixture, EVENT_STREAM_END, 128).stream_id != id) { ret 4; }
        var response: [1]field.Field;
        response[0] = field.Field{name: view.view(":status", 7),
            value: view.view("204", 3), sensitive: false};
        if (send_headers[TestTransport](?fixture.engine, id, ?response[0], 1,
            true, false).status != OFFER_OUTPUT) { ret 5; }
        var progress: usize = 0;
        for (!wire.finished && progress < 128) {
            process[TestTransport](?fixture.engine);
            progress = progress + 1;
        }
        if (!wire.finished || !release_stream[TestTransport](?fixture.engine, id,
            request.generation) || stream_for[TestTransport](?fixture.engine, id) != nil) { ret 6; }
        previous_generation = request.generation;
        i                   = i + 1;
    }
    if (fixture.engine.active_requests != 0 || fixture.io.close_calls != 0) { ret 7; }
    ret 0;
}

test "http.h3.connection: graceful goaway drains admitted service work before close" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var request_bytes:  [16]u8;
    val request_length: usize     = static_request(?request_bytes[0], 16);
    val wire:           *TestWire = peer_stream(?fixture, 0, ?request_bytes[0],
        request_length, true);
    if (wire == nil) { ret 2; }
    val request: Event            = drive(?fixture, EVENT_REQUEST_HEADERS, 64);
    var storage: ExchangeMemory;
    val service: exchange.Service = exchange.Service{ctx: nil, serve: test_service};
    if (!make_exchange(?storage, request.generation, 0)
        || !bind_exchange[TestTransport](?fixture.engine, 0, ?storage.exchange)
        || !release_event[TestTransport](?fixture.engine, 0, request.generation)
        || dispatch[TestTransport](?fixture.engine, 0, ?service) != exchange.SERVICE_COMPLETE
        || !begin_graceful[TestTransport](?fixture.engine)) { ret 3; }
    val ended:    Event = drive(?fixture, EVENT_STREAM_END, 32);
    var response: [1]field.Field;
    response[0] = field.Field{name: view.view(":status", 7),
        value: view.view("204", 3), sensitive: false};
    if (ended.stream_id != 0
        || send_headers[TestTransport](?fixture.engine, 0, ?response[0], 1,
        true, false).status != OFFER_OUTPUT
        || !finish_graceful[TestTransport](?fixture.engine)) { ret 4; }
    var i: usize = 0;
    for (i < 64 && (!wire.finished || fixture.engine.control.count != 0)) {
        process[TestTransport](?fixture.engine);
        i = i + 1;
    }
    if (!wire.finished || fixture.engine.active_requests != 0
        || !release_stream[TestTransport](?fixture.engine, 0, request.generation)
        || !progress_close[TestTransport](?fixture.engine) || fixture.engine.state != CLOSED
        || fixture.io.close_calls != 1 || fixture.io.close_code != H3_NO_ERROR) { ret 5; }
    ret 0;
}

test "http.h3.connection: peer goaway retries only requests at or above its boundary" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, CLIENT, test_config())
        || client_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    val first_id:  u64     = open_request[TestTransport](?fixture.engine, nil);
    val second_id: u64     = open_request[TestTransport](?fixture.engine, nil);
    val second:    *Stream = stream_for[TestTransport](?fixture.engine, second_id);
    var storage:   ExchangeMemory;
    if (first_id != 0 || second_id != 4 || second == nil
        || !make_exchange(?storage, second.generation, second_id)
        || !bind_exchange[TestTransport](?fixture.engine, second_id, ?storage.exchange)) { ret 2; }
    val control_stream: *Stream = stream_for[TestTransport](?fixture.engine, 3);
    if (control_stream == nil) { ret 3; }
    val control: *TestWire = test_wire(?fixture.io, control_stream.transport_stream);
    var goaway:  [3]u8;
    goaway[0] = frame.FRAME_GOAWAY::u8;
    goaway[1] = 1;
    goaway[2] = 4;
    wire_feed(?fixture.io, control, ?goaway[0], 3, false);
    val event: Event = drive(?fixture, EVENT_GOAWAY, 32);
    if (event.goaway_id != 4 || stream_for[TestTransport](?fixture.engine, 0) == nil
        || !stream_for[TestTransport](?fixture.engine, 4).retry_pending
        || open_request[TestTransport](?fixture.engine, nil) != NO_STREAM) { ret 4; }
    val retry: Event = drive(?fixture, EVENT_STREAM_RETRY, 8);
    if (retry.stream_id != 4 || retry.code != H3_REQUEST_REJECTED
        || detach_exchange[TestTransport](?fixture.engine, 4, retry.generation) != ?storage.exchange) {
        ret 5;
    }
    ret 0;
}

test "http.h3.connection: request admission rejects overflow without closing peers" {
    var configured: Config = test_config();
    configured.max_requests = 1;
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, configured)
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var first_bytes:   [16]u8;
    var second_bytes:  [16]u8;
    val first_length:  usize = static_request(?first_bytes[0], 16);
    val second_length: usize = static_request(?second_bytes[0], 16);
    if (peer_stream(?fixture, 0, ?first_bytes[0], first_length, false) == nil) {
        ret 2;
    }
    val first:   Event = drive(?fixture, EVENT_REQUEST_HEADERS, 32);
    var storage: ExchangeMemory;
    if (!make_exchange(?storage, first.generation, 0)
        || !bind_exchange[TestTransport](?fixture.engine, 0, ?storage.exchange)
        || !release_event[TestTransport](?fixture.engine, 0, first.generation)
        || peer_stream(?fixture, 4, ?second_bytes[0], second_length, false) == nil) {
        ret 3;
    }
    val rejected: Event     = drive(?fixture, EVENT_STREAM_ERROR, 16);
    var i:        usize     = 0;
    var found:    *TestWire = nil;
    for (i < fixture.io.capacity) {
        if (fixture.wires[i].live && fixture.wires[i].handle.id == 4) {
            found = ?fixture.wires[i];
        }
        i = i + 1;
    }
    if (rejected.stream_id != 4 || rejected.code != H3_REQUEST_REJECTED
        || found == nil || !found.send_cancelled || !found.receive_cancelled
        || fixture.io.close_calls != 0 || fixture.engine.state != OPEN) { ret 4; }
    if (fixture.engine.pending_release_count != 1 || found.released) { ret 5; }
    found.reset_acked = true;
    found.stop_acked  = true;
    var settled: usize = 0;
    for (settled < 16 && fixture.engine.pending_release_count != 0) {
        process[TestTransport](?fixture.engine);
        settled = settled + 1;
    }
    if (fixture.engine.pending_release_count != 0 || !found.released
        || fixture.io.close_calls != 0 || fixture.engine.state != OPEN) { ret 6; }
    ret 0;
}

test "http.h3.connection: a drained unknown unidirectional stream releases its slot" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var bytes: [2]u8;
    bytes[0] = 0x21;
    bytes[1] = 'x';
    val wire: *TestWire = peer_stream(?fixture, 6, ?bytes[0], 2, true);
    if (wire == nil) { ret 2; }
    var i: usize = 0;
    for (i < 64 && !wire.released) {
        process[TestTransport](?fixture.engine);
        i = i + 1;
    }
    if (!wire.released || wire.credited != 2) { ret 3; }
    if (fixture.engine.active_peer_unidirectional != 1
        || fixture.engine.pending_release_count != 0
        || fixture.engine.state != OPEN || fixture.io.close_calls != 0) { ret 4; }
    ret 0;
}

test "http.h3.connection: a refused request binding releases without failing the connection" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, CLIENT, test_config())
        || client_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var storage: ExchangeMemory;
    if (!make_exchange(?storage, 99, 0)) { ret 2; }
    if (open_request[TestTransport](?fixture.engine, ?storage.exchange) != NO_STREAM
        || stream_for[TestTransport](?fixture.engine, 0) != nil) { ret 3; }
    if (fixture.engine.state != OPEN || fixture.io.close_calls != 0
        || fixture.engine.pending_release_count != 1) { ret 4; }
    var i:     usize     = 0;
    var found: *TestWire = nil;
    for (i < fixture.io.capacity) {
        if (fixture.wires[i].live && fixture.wires[i].handle.id == 0) {
            found = ?fixture.wires[i];
        }
        i = i + 1;
    }
    if (found == nil || !found.send_cancelled || !found.receive_cancelled
        || found.released) { ret 5; }
    found.reset_acked = true;
    found.stop_acked  = true;
    var settled: usize = 0;
    for (settled < 16 && fixture.engine.pending_release_count != 0) {
        process[TestTransport](?fixture.engine);
        settled = settled + 1;
    }
    if (fixture.engine.pending_release_count != 0 || !found.released
        || fixture.engine.state != OPEN || fixture.io.close_calls != 0) { ret 6; }
    ret 0;
}

test "http.h3.connection: exhausting the pending release list fails as excessive load" {
    var configured: Config = test_config();
    configured.max_requests        = 1;
    configured.max_pending_release = 1;
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, configured)
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var admitted:        [16]u8;
    var second:          [16]u8;
    var third:           [16]u8;
    val admitted_length: usize = static_request(?admitted[0], 16);
    val second_length:   usize = static_request(?second[0], 16);
    val third_length:    usize = static_request(?third[0], 16);
    if (peer_stream(?fixture, 0, ?admitted[0], admitted_length, false) == nil) {
        ret 2;
    }
    val first:   Event = drive(?fixture, EVENT_REQUEST_HEADERS, 32);
    var storage: ExchangeMemory;
    if (!make_exchange(?storage, first.generation, 0)
        || !bind_exchange[TestTransport](?fixture.engine, 0, ?storage.exchange)
        || !release_event[TestTransport](?fixture.engine, 0, first.generation)
        || peer_stream(?fixture, 4, ?second[0], second_length, false) == nil) {
        ret 3;
    }
    if (drive(?fixture, EVENT_STREAM_ERROR, 16).code != H3_REQUEST_REJECTED
        || fixture.engine.pending_release_count != 1) { ret 4; }
    if (peer_stream(?fixture, 8, ?third[0], third_length, false) == nil) { ret 5; }
    val exhausted: Event = drive(?fixture, EVENT_ERROR, 32);
    if (exhausted.code != H3_EXCESSIVE_LOAD
        || fixture.engine.error != ERROR_LIMIT
        || fixture.io.close_code != H3_EXCESSIVE_LOAD
        || fixture.engine.state != FAILED) { ret 6; }
    ret 0;
}

test "http.h3.connection: blocked reset and application cancellation settle once" {
    var blocked: Fixture;
    if (!make_fixture(?blocked, SERVER, test_config())
        || server_handshake(?blocked).kind != EVENT_SETTINGS) { ret 1; }
    var blocked_bytes:  [16]u8;
    val blocked_length: usize     = blocked_request(?blocked_bytes[0], 16);
    val blocked_wire:   *TestWire = peer_stream(?blocked, 0,
        ?blocked_bytes[0], blocked_length, false);
    if (blocked_wire == nil
        || drive(?blocked, EVENT_BLOCKED, 32).kind != EVENT_BLOCKED) { ret 2; }
    wire_reset(?blocked.io, blocked_wire, H3_REQUEST_CANCELLED);
    val reset: Event = drive(?blocked, EVENT_STREAM_RESET, 16);
    if (reset.code != H3_REQUEST_CANCELLED
        || blocked.engine.inbound_sections.count != 0
        || blocked.engine.decoder.count == 0 || blocked.io.close_calls != 0) { ret 3; }
    var cancelled: Fixture;
    if (!make_fixture(?cancelled, SERVER, test_config())
        || server_handshake(?cancelled).kind != EVENT_SETTINGS) { ret 4; }
    var request_bytes:  [16]u8;
    val request_length: usize     = static_request(?request_bytes[0], 16);
    val wire:           *TestWire = peer_stream(?cancelled, 0,
        ?request_bytes[0], request_length, false);
    val headers:         Event = drive(?cancelled, EVENT_REQUEST_HEADERS, 32);
    var exchange_memory: ExchangeMemory;
    if (wire == nil || !make_exchange(?exchange_memory, headers.generation, 0)
        || !bind_exchange[TestTransport](?cancelled.engine, 0, ?exchange_memory.exchange)
        || !release_event[TestTransport](?cancelled.engine, 0, headers.generation)
        || !transition_ok(cancel.cancel(?exchange_memory.scope))) { ret 5; }
    val event: Event = tick[TestTransport](?cancelled.engine);
    if (event.kind != EVENT_STREAM_RESET || event.code != H3_REQUEST_CANCELLED
        || !wire.send_cancelled || !wire.receive_cancelled
        || exchange_memory.exchange.state != exchange.CANCELLED_STATE) { ret 6; }
    ret 0;
}

test "http.h3.connection: a transport the peer already closed satisfies the close" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())) { ret 1; }
    fixture.io.close_override = true;
    fixture.io.close_status   = TRANSPORT_CLOSED;
    if (!cancel_connection[TestTransport](?fixture.engine) || fixture.engine.state != FAILED
        || !fixture.engine.close_started || fixture.io.close_calls != 1) { ret 2; }
    if (!progress_close[TestTransport](?fixture.engine) || fixture.engine.state != CLOSED
        || fixture.io.close_calls != 1) { ret 3; }
    var failing: Fixture;
    if (!make_fixture(?failing, SERVER, test_config())) { ret 4; }
    failing.io.close_override = true;
    failing.io.close_status   = TRANSPORT_ERROR;
    if (!cancel_connection[TestTransport](?failing.engine) || failing.engine.close_started) { ret 5; }
    if (progress_close[TestTransport](?failing.engine) || failing.engine.state != FAILED
        || failing.engine.close_started) { ret 6; }
    ret 0;
}

# calls process until it stops reporting pending work
fun settle(fixture: *Fixture) bool {
    var i: usize = 0;
    for (i < 16) {
        val kind: EventKind = process[TestTransport](?fixture.engine).kind;
        if (kind == EVENT_NONE)    { ret true; }
        if (kind != EVENT_PENDING) { ret false; }
        i = i + 1;
    }
    ret false;
}

# drains every queued stream until only a memory refusal remains
fun settle_blocked(fixture: *Fixture) bool {
    var i: usize = 0;
    for (i < 16) {
        val kind: EventKind = process[TestTransport](?fixture.engine).kind;
        if (kind == EVENT_MEMORY_BLOCKED) { ret true; }
        if (kind != EVENT_PENDING)        { ret false; }
        i = i + 1;
    }
    ret false;
}

# one process call over idle client requests with no transport news
fun idle_process_cost(requests: usize, calls: *usize, visits: *usize,
    reads: *usize) bool {
    var configured: Config = test_config();
    configured.max_requests = requests;
    var fixture: Fixture;
    if (!make_fixture(?fixture, CLIENT, configured)
        || client_handshake(?fixture).kind != EVENT_SETTINGS) { ret false; }
    var i: usize = 0;
    for (i < requests) {
        if (open_request[TestTransport](?fixture.engine, nil) == NO_STREAM) { ret false; }
        i = i + 1;
    }
    # each new stream reads once, finds nothing and parks
    if (!settle(?fixture)) { ret false; }
    i = 0;
    for (i < 4) {
        if (process[TestTransport](?fixture.engine).kind != EVENT_NONE) { ret false; }
        i = i + 1;
    }
    if (fixture.engine.active_requests != requests || fixture.engine.state != OPEN) {
        ret false;
    }
    val calls_before:  usize = fixture.io.calls;
    val visits_before: usize = fixture.engine.slot_visits;
    val reads_before:  usize = fixture.io.reads;
    if (process[TestTransport](?fixture.engine).kind != EVENT_NONE) { ret false; }
    @calls  = fixture.io.calls - calls_before;
    @visits = fixture.engine.slot_visits - visits_before;
    @reads  = fixture.io.reads - reads_before;
    ret true;
}

test "http.h3.connection: an idle process call costs the same for few and many streams" {
    var few_calls:   usize = 0;
    var few_visits:  usize = 0;
    var few_reads:   usize = 0;
    var many_calls:  usize = 0;
    var many_visits: usize = 0;
    var many_reads:  usize = 0;
    if (!idle_process_cost(3, ?few_calls, ?few_visits, ?few_reads))     { ret 1; }
    if (!idle_process_cost(96, ?many_calls, ?many_visits, ?many_reads)) { ret 2; }
    # one accept and one empty readiness poll, nothing per stream
    if (few_calls != 2 || few_visits != 0 || few_reads != 0)                     { ret 3; }
    if (many_calls != few_calls || many_visits != few_visits || many_reads != 0) { ret 4; }
    ret 0;
}

test "http.h3.connection: the stream index survives tombstone churn and rebuilds" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, CLIENT, test_config())
        || client_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    val anchor: u64 = open_request[TestTransport](?fixture.engine, nil);
    if (anchor == NO_STREAM) { ret 2; }
    var previous: u64   = NO_STREAM;
    var round:    usize = 0;
    for (round < 150) {
        val id:     u64     = open_request[TestTransport](?fixture.engine, nil);
        val stream: *Stream = stream_for[TestTransport](?fixture.engine, id);
        if (id == NO_STREAM || stream == nil || stream.transport_stream.id != id) { ret 3; }
        val generation: u64       = stream.generation;
        val wire:       *TestWire = test_wire(?fixture.io, stream.transport_stream);
        if (wire == nil || !cancel_stream[TestTransport](?fixture.engine, id,
            H3_REQUEST_CANCELLED)) { ret 4; }
        wire.reset_acked = true;
        wire.stop_acked  = true;
        if (!release_stream[TestTransport](?fixture.engine, id, generation)) { ret 5; }
        # the fake recycles its wire as a real transport recycles its slot
        wire.live = false;
        if (stream_for[TestTransport](?fixture.engine, id) != nil
            || (previous != NO_STREAM
            && stream_for[TestTransport](?fixture.engine, previous) != nil)) { ret 6; }
        val kept: *Stream = stream_for[TestTransport](?fixture.engine, anchor);
        if (kept == nil || kept.transport_stream.id != anchor || stream_terminal(kept)) {
            ret 7;
        }
        previous = id;
        round    = round + 1;
    }
    if (fixture.engine.index_rebuilds == 0
        || fixture.engine.index_tombstones > fixture.engine.index_capacity / 4) { ret 8; }
    if (fixture.engine.active_requests != 1 || fixture.io.close_calls != 0) { ret 9; }
    # the free list still hands out every remaining slot
    if (open_request[TestTransport](?fixture.engine, nil) == NO_STREAM
        || open_request[TestTransport](?fixture.engine, nil) == NO_STREAM
        || fixture.engine.active_requests != 3) { ret 10; }
    ret 0;
}

test "http.h3.connection: readiness reports gate reads and tolerate noise" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var input:          [32]u8;
    val headers_length: usize = static_request(?input[0], 32);
    var payload:        [3]u8;
    payload[0] = 'a';
    payload[1] = 'b';
    payload[2] = 'c';
    val data_length: usize = append_frame(?input[headers_length],
        32 - headers_length, frame.FRAME_DATA, ?payload[0], 3);
    val wire: *TestWire = peer_stream(?fixture, 0, ?input[0], headers_length, false);
    if (wire == nil) { ret 2; }
    val request: Event = drive(?fixture, EVENT_REQUEST_HEADERS, 32);
    var storage: ExchangeMemory;
    if (request.stream_id != 0 || !make_exchange(?storage, request.generation, 0)
        || !bind_exchange[TestTransport](?fixture.engine, 0, ?storage.exchange)
        || !release_event[TestTransport](?fixture.engine, 0, request.generation)) { ret 3; }
    var i: usize = 0;
    for (i < 4) {
        process[TestTransport](?fixture.engine);
        i = i + 1;
    }
    # data the transport never reported is never read
    val reads: usize = fixture.io.reads;
    wire.input_length = headers_length + data_length;
    i                 = 0;
    for (i < 8) {
        if (process[TestTransport](?fixture.engine).kind != EVENT_NONE) { ret 4; }
        i = i + 1;
    }
    if (fixture.io.reads != reads || wire.delivered != headers_length) { ret 5; }
    # unknown ids, stale handles and reports without news change nothing
    test_signal(?fixture.io, StreamHandle{source: 77, index: 0, generation: 1, id: 400},
        true, true, true);
    var stale: StreamHandle = wire.handle;
    stale.generation = stale.generation + 1;
    test_signal(?fixture.io, stale, true, true, true);
    test_signal(?fixture.io, wire.handle, false, false, false);
    if (process[TestTransport](?fixture.engine).kind != EVENT_NONE
        || fixture.io.reads != reads) { ret 6; }
    # a duplicated report yields the data once
    test_signal(?fixture.io, wire.handle, true, false, false);
    test_signal(?fixture.io, wire.handle, true, false, false);
    test_signal(?fixture.io, wire.handle, true, false, false);
    val data: Event = drive(?fixture, EVENT_DATA, 8);
    if (data.stream_id != 0 || data.data_length != 3
        || !consume_data[TestTransport](?fixture.engine, 0, 3)) { ret 7; }
    if (!settle(?fixture)) { ret 10; }
    i = 0;
    for (i < 8) {
        if (process[TestTransport](?fixture.engine).kind != EVENT_NONE) { ret 8; }
        i = i + 1;
    }
    if (wire.delivered != headers_length + data_length
        || fixture.io.signal_dropped || fixture.engine.state != OPEN
        || fixture.io.close_calls != 0) { ret 9; }
    ret 0;
}

test "http.h3.connection: blocked output waits for a writable report" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var request_bytes:  [16]u8;
    val request_length: usize     = static_request(?request_bytes[0], 16);
    val wire:           *TestWire = peer_stream(?fixture, 0, ?request_bytes[0],
        request_length, true);
    if (wire == nil) { ret 2; }
    val request: Event            = drive(?fixture, EVENT_REQUEST_HEADERS, 32);
    val service: exchange.Service = exchange.Service{ctx: nil, serve: test_service};
    var storage: ExchangeMemory;
    if (!make_exchange(?storage, request.generation, 0)
        || !bind_exchange[TestTransport](?fixture.engine, 0, ?storage.exchange)
        || !release_event[TestTransport](?fixture.engine, 0, request.generation)
        || dispatch[TestTransport](?fixture.engine, 0, ?service) != exchange.SERVICE_COMPLETE
        || drive(?fixture, EVENT_STREAM_END, 32).stream_id != 0) { ret 3; }
    wire.write_blocked = true;
    var response: [1]field.Field;
    response[0] = field.Field{name: view.view(":status", 7),
        value: view.view("204", 3), sensitive: false};
    if (send_headers[TestTransport](?fixture.engine, 0, ?response[0], 1, true,
        false).status != OFFER_OUTPUT
        || process[TestTransport](?fixture.engine).kind != EVENT_BLOCKED) { ret 4; }
    val calls: usize = fixture.io.calls;
    var i:     usize = 0;
    for (i < 8) {
        if (process[TestTransport](?fixture.engine).kind != EVENT_NONE) { ret 5; }
        i = i + 1;
    }
    # only the accept and readiness polls, never another write
    if (fixture.io.calls != calls + 16 || wire.output_length != 0) { ret 6; }
    wire_unblock(?fixture.io, wire);
    i = 0;
    for (i < 8 && !wire.finished) {
        process[TestTransport](?fixture.engine);
        i = i + 1;
    }
    if (!wire.finished || !release_stream[TestTransport](?fixture.engine, 0,
        request.generation)) { ret 7; }
    ret 0;
}

test "http.h3.connection: a qpack insert wakes only the streams it satisfies" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var one_bytes:  [16]u8;
    var two_bytes:  [16]u8;
    val one_length: usize = blocked_request_at(?one_bytes[0], 16, 2);
    val two_length: usize = blocked_request_at(?two_bytes[0], 16, 3);
    if (peer_stream(?fixture, 0, ?one_bytes[0], one_length, false) == nil
        || drive(?fixture, EVENT_BLOCKED, 32).kind != EVENT_BLOCKED
        || peer_stream(?fixture, 4, ?two_bytes[0], two_length, false) == nil
        || drive(?fixture, EVENT_BLOCKED, 32).kind != EVENT_BLOCKED) { ret 2; }
    val one: *Stream = stream_for[TestTransport](?fixture.engine, 0);
    val two: *Stream = stream_for[TestTransport](?fixture.engine, 4);
    if (one == nil || two == nil || !one.blocked_listed || !two.blocked_listed
        || one.queued || two.queued || fixture.engine.blocked_head != one.slot) { ret 3; }
    var instructions: [6]u8;
    instructions[0] = frame.STREAM_QPACK_ENCODER::u8;
    instructions[1] = 0x3f;
    instructions[2] = 0x61;
    instructions[3] = 0xc0;
    instructions[4] = 1;
    instructions[5] = 'x';
    val encoder: *TestWire = peer_stream(?fixture, 6, ?instructions[0], 6, false);
    if (encoder == nil) { ret 4; }
    var i: usize = 0;
    for (i < 32 && fixture.engine.inbound_table.insert_count == 0) {
        process[TestTransport](?fixture.engine);
        i = i + 1;
    }
    # the satisfied stream is queued, the other stays parked on the blocked list
    if (fixture.engine.inbound_table.insert_count != 1
        || !one.queued || one.blocked_listed
        || two.queued || !two.blocked_listed
        || fixture.engine.blocked_head != two.slot) { ret 5; }
    val first: Event = drive(?fixture, EVENT_REQUEST_HEADERS, 16);
    if (first.stream_id != 0 || first.headers.count != 4
        || !two.qpack_blocked || two.queued) { ret 6; }
    var second_insert: [3]u8;
    second_insert[0] = 0xc0;
    second_insert[1] = 1;
    second_insert[2] = 'y';
    wire_feed(?fixture.io, encoder, ?second_insert[0], 3, false);
    i = 0;
    var second: Event = base_event[TestTransport](?fixture.engine, EVENT_NONE);
    for (i < 32 && second.stream_id != 4) {
        second = process[TestTransport](?fixture.engine);
        i      = i + 1;
    }
    if (second.kind != EVENT_REQUEST_HEADERS || second.headers.count != 4
        || fixture.engine.inbound_table.insert_count != 2
        || fixture.engine.blocked_head != NO_SLOT
        || fixture.engine.inbound_sections.blocked_count != 0) { ret 7; }
    ret 0;
}

test "http.h3.connection: streams with pending work are serviced round-robin" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var inputs:  [3][16]u8;
    var lengths: [3]usize;
    var i:       usize = 0;
    for (i < 3) {
        lengths[i] = static_request(?inputs[i][0], 16);
        if (peer_stream(?fixture, i::u64 * 4, ?inputs[i][0], lengths[i], false) == nil) {
            ret 2;
        }
        i = i + 1;
    }
    # every request holds its header event until released, so each stays queued
    var seen: u64 = 0;
    i = 0;
    for (i < 64 && seen != 7) {
        val event: Event = process[TestTransport](?fixture.engine);
        if (event.kind == EVENT_REQUEST_HEADERS) { seen = seen | (1u64 << (event.stream_id / 4)); }
        i = i + 1;
    }
    if (seen != 7) { ret 3; }
    var order: [9]u64;
    i = 0;
    for (i < 9) {
        val event: Event = process[TestTransport](?fixture.engine);
        if (event.kind != EVENT_REQUEST_HEADERS) { ret 4; }
        order[i] = event.stream_id;
        i        = i + 1;
    }
    i = 0;
    for (i < 9) {
        if ((i != 0 && order[i] == order[i - 1])
            || (i >= 3 && order[i] != order[i - 3])
            || (i < 3 && i != 0 && order[i] == order[0])) { ret 5; }
        i = i + 1;
    }
    if (order[0] + order[1] + order[2] != 12) { ret 6; }
    ret 0;
}

# many client requests with partially written output, which services to NONE
test "http.h3.connection: a budget-limited call reports pending until the queue drains" {
    var configured: Config = test_config();
    configured.max_requests = 96;
    var fixture: Fixture;
    if (!make_fixture(?fixture, CLIENT, configured)
        || client_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var i: usize = 0;
    for (i < 96) {
        if (open_request[TestTransport](?fixture.engine, nil) == NO_STREAM) { ret 2; }
        i = i + 1;
    }
    if (!settle(?fixture) || fixture.engine.ready_count != 0) { ret 3; }
    var request: [4]field.Field;
    request[0] = field.Field{name: view.view(":method", 7), value: view.view("GET", 3),
        sensitive: false};
    request[1] = field.Field{name: view.view(":scheme", 7), value: view.view("https", 5),
        sensitive: false};
    request[2] = field.Field{name: view.view(":authority", 10), value: view.view("x", 1),
        sensitive: false};
    request[3] = field.Field{name: view.view(":path", 5), value: view.view("/", 1),
        sensitive: false};
    i = 0;
    for (i < 96) {
        if (send_headers[TestTransport](?fixture.engine, i::u64 * 4, ?request[0], 4,
            true, false).status != OFFER_OUTPUT) { ret 4; }
        i = i + 1;
    }
    # a byte per write keeps every stream queued with work after its turn
    fixture.io.write_limit = 1;
    if (process[TestTransport](?fixture.engine).kind != EVENT_PENDING) { ret 5; }
    fixture.io.write_limit = 0;
    var calls: usize = 1;
    var last:  Event = base_event[TestTransport](?fixture.engine, EVENT_PENDING);
    for (calls < 16 && last.kind == EVENT_PENDING) {
        last  = process[TestTransport](?fixture.engine);
        calls = calls + 1;
    }
    if (last.kind != EVENT_NONE || fixture.engine.output_streams != 0) { ret 6; }
    i = 0;
    for (i < 96) {
        val stream: *Stream = stream_for[TestTransport](?fixture.engine, i::u64 * 4);
        if (stream == nil || stream.state != STREAM_HALF_CLOSED_LOCAL
            || test_wire(?fixture.io, stream.transport_stream).finished == false) { ret 7; }
        i = i + 1;
    }
    ret 0;
}

test "http.h3.connection: undrained readiness reports keep process pending" {
    var configured: Config = test_config();
    configured.max_requests = 3;
    var fixture: Fixture;
    if (!make_fixture(?fixture, CLIENT, configured)
        || client_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    val id: u64 = open_request[TestTransport](?fixture.engine, nil);
    if (id == NO_STREAM || process[TestTransport](?fixture.engine).kind != EVENT_NONE) {
        ret 2;
    }
    val stream: *Stream = stream_for[TestTransport](?fixture.engine, id);
    # reports without news service to nothing, so only the transport backlog remains
    var i: usize = 0;
    for (i < 200) {
        test_signal(?fixture.io, stream.transport_stream, false, false, false);
        i = i + 1;
    }
    var kinds: [4]EventKind;
    i = 0;
    for (i < 4) {
        kinds[i] = process[TestTransport](?fixture.engine).kind;
        i        = i + 1;
    }
    if (kinds[0] != EVENT_PENDING || kinds[1] != EVENT_PENDING
        || kinds[2] != EVENT_PENDING || kinds[3] != EVENT_NONE
        || fixture.io.signal_count != 0 || fixture.io.signal_dropped) { ret 3; }
    ret 0;
}

fun round16(bytes: usize) usize {
    ret (bytes + 15) & ~(15::usize);
}

# the set one request borrows, summed from the engine's own table. the test pool
# has no classes, so each chunk is charged its request rounded to 16
fun request_set_bytes() usize {
    var requests: [REQUEST_BUFFERS]buffers.Request;
    if (!request_requests(test_config(), ?requests[0])) { ret 0; }
    var total: usize = 0;
    var i:     usize = 0;
    for (i < REQUEST_BUFFERS) {
        if (requests[i].lane != 0) { ret 0; }
        total = total + round16(requests[i].bytes);
        i     = i + 1;
    }
    ret total;
}

test "http.h3.connection: the request table is the set a request acquires" {
    var requests: [REQUEST_BUFFERS]buffers.Request;
    var bad:      Config = test_config();
    bad.max_requests = 0;
    if (request_requests(bad, ?requests[0]) || request_requests(test_config(), nil)) { ret 1; }
    if (!request_requests(test_config(), ?requests[0])
        || requests[0].bytes != 128 || requests[1].bytes != 256
        || requests[2].bytes != 16 * $size_of(field.Field) || requests[3].bytes != 512
        || requests[4].bytes != 256 || requests[5].bytes != 512
        || requests[6].bytes != 16 * $size_of(u64)) { ret 2; }
    ret 0;
}

# the first record chunk and the index an initialized engine holds
fun idle_bytes(records_count: usize, index_count: usize) usize {
    ret round16(records_count * $size_of(Stream))
        + round16(index_count * $size_of(StreamIndexEntry));
}

fun test_request_fields(items: *field.Field) {
    items[0] = field.Field{name: view.view(":method", 7), value: view.view("GET", 3),
        sensitive: false};
    items[1] = field.Field{name: view.view(":scheme", 7), value: view.view("https", 5),
        sensitive: false};
    items[2] = field.Field{name: view.view(":authority", 10), value: view.view("x", 1),
        sensitive: false};
    items[3] = field.Field{name: view.view(":path", 5), value: view.view("/", 1),
        sensitive: false};
}

test "http.h3.connection: an idle engine holds only its first records and a request exactly its set" {
    var configured: Config = test_config();
    configured.max_peer_unidirectional = 4;
    var fixture: Fixture;
    if (!make_fixture(?fixture, CLIENT, configured)
        || fixture.account.used[1] != idle_bytes(8, 16)
        || fixture.account.used[0] != 0 || fixture.engine.stream_capacity != 8) { ret 1; }
    # the peer's critical streams and an ignored one borrow nothing
    if (client_handshake(?fixture).kind != EVENT_SETTINGS) { ret 2; }
    var encoder: [1]u8;
    var decoder: [1]u8;
    var grease:  [3]u8;
    encoder[0] = frame.STREAM_QPACK_ENCODER::u8;
    decoder[0] = frame.STREAM_QPACK_DECODER::u8;
    grease[0]  = 0x21;
    grease[1]  = 'x';
    grease[2]  = 'y';
    if (peer_stream(?fixture, 7, ?encoder[0], 1, false) == nil
        || peer_stream(?fixture, 11, ?decoder[0], 1, false) == nil
        || peer_stream(?fixture, 15, ?grease[0], 3, false) == nil
        || !settle(?fixture)) { ret 3; }
    if (fixture.engine.active_peer_unidirectional != 4
        || fixture.account.used[0] != 0
        || fixture.account.used[1] != idle_bytes(8, 16)) { ret 4; }
    val ignored: *Stream = stream_for[TestTransport](?fixture.engine, 15);
    if (ignored == nil || ignored.kind != STREAM_IGNORED || ignored.memory_held
        || ignored.memory.read != ?fixture.engine.discard[0]) { ret 5; }
    val id: u64 = open_request[TestTransport](?fixture.engine, nil);
    if (id == NO_STREAM || fixture.account.used[0] != request_set_bytes()
        || fixture.account.used[1] != idle_bytes(8, 16)) { ret 6; }
    var request: [4]field.Field;
    test_request_fields(?request[0]);
    if (send_headers[TestTransport](?fixture.engine, id, ?request[0], 4, true, false).status
        != OFFER_OUTPUT || !settle(?fixture)) { ret 7; }
    val stream:     *Stream   = stream_for[TestTransport](?fixture.engine, id);
    val generation: u64       = stream.generation;
    val wire:       *TestWire = test_wire(?fixture.io, stream.transport_stream);
    if (wire == nil || !cancel_stream[TestTransport](?fixture.engine, id,
        H3_REQUEST_CANCELLED)) { ret 8; }
    wire.reset_acked = true;
    wire.stop_acked  = true;
    if (!release_stream[TestTransport](?fixture.engine, id, generation)
        || fixture.account.used[0] != 0
        || fixture.account.used[1] != idle_bytes(8, 16)) { ret 9; }
    # a closed request the host never released gives its set back at destroy
    val kept: u64 = open_request[TestTransport](?fixture.engine, nil);
    if (kept == NO_STREAM
        || !cancel_stream[TestTransport](?fixture.engine, kept, H3_REQUEST_CANCELLED)
        || fixture.account.used[0] != request_set_bytes()) { ret 10; }
    if (!destroy[TestTransport](?fixture.engine) || fixture.account.held != 0
        || fixture.account.chunks != 0) { ret 11; }
    ret 0;
}

test "http.h3.connection: a refused request set rejects only that request" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    fixture.account.budgets[0] = request_set_bytes() - 1;
    var first_bytes:  [16]u8;
    var second_bytes: [16]u8;
    val first_length: usize = static_request(?first_bytes[0], 16);
    if (peer_stream(?fixture, 0, ?first_bytes[0], first_length, false) == nil) { ret 2; }
    val rejected: Event = drive(?fixture, EVENT_STREAM_ERROR, 16);
    if (rejected.stream_id != 0 || rejected.code != H3_REQUEST_REJECTED
        || fixture.engine.state != OPEN || fixture.io.close_calls != 0
        || fixture.engine.active_requests != 0 || fixture.engine.request_sets != 0
        || stream_for[TestTransport](?fixture.engine, 0) != nil
        || fixture.account.used[0] != 0) { ret 3; }
    fixture.account.budgets[0] = 1 << 25;
    val second_length: usize = static_request(?second_bytes[0], 16);
    if (peer_stream(?fixture, 4, ?second_bytes[0], second_length, false) == nil) { ret 4; }
    val admitted: Event = drive(?fixture, EVENT_REQUEST_HEADERS, 32);
    if (admitted.stream_id != 4 || fixture.account.used[0] != request_set_bytes()
        || fixture.engine.state != OPEN) { ret 5; }
    ret 0;
}

test "http.h3.connection: a refused client request opens no transport stream" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, CLIENT, test_config())
        || client_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    val opens: usize = fixture.io.opens;
    fixture.account.budgets[0] = request_set_bytes() - 1;
    if (open_request[TestTransport](?fixture.engine, nil) != NO_STREAM
        || fixture.io.opens != opens || fixture.engine.active_requests != 0
        || fixture.engine.state != OPEN || fixture.account.used[0] != 0) { ret 2; }
    fixture.account.budgets[0] = 1 << 25;
    if (open_request[TestTransport](?fixture.engine, nil) == NO_STREAM
        || fixture.io.opens != opens + 1) { ret 3; }
    # every live request counts against max_requests until it is released
    if (open_request[TestTransport](?fixture.engine, nil) == NO_STREAM
        || open_request[TestTransport](?fixture.engine, nil) == NO_STREAM) { ret 4; }
    if (!cancel_stream[TestTransport](?fixture.engine, 0, H3_REQUEST_CANCELLED)
        || fixture.engine.active_requests != 2
        || open_request[TestTransport](?fixture.engine, nil) != NO_STREAM
        || fixture.io.opens != opens + 3) { ret 5; }
    ret 0;
}

test "http.h3.connection: stream records grow in place and the index follows them" {
    var configured: Config = test_config();
    configured.max_requests    = 40;
    configured.initial_streams = 4;
    var fixture: Fixture;
    if (!make_fixture(?fixture, CLIENT, configured)
        || client_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var ids:   [40]u64;
    var first: [3]*Stream;
    var i:     usize = 0;
    for (i < 40) {
        ids[i] = open_request[TestTransport](?fixture.engine, nil);
        if (ids[i] == NO_STREAM) { ret 2; }
        if (i < 3)               { first[i] = stream_for[TestTransport](?fixture.engine, ids[i]); }
        i = i + 1;
    }
    if (fixture.engine.stream_capacity < 43 || fixture.engine.records.chunk_count < 2
        || fixture.engine.index_capacity < 2 * fixture.engine.stream_capacity
        || fixture.engine.index_rebuilds == 0) { ret 3; }
    val grown: usize = fixture.account.used[1];
    i = 0;
    for (i < 3) {
        if (stream_for[TestTransport](?fixture.engine, ids[i]) != first[i]
            || first[i].transport_stream.id != ids[i]) { ret 4; }
        i = i + 1;
    }
    var round: usize = 0;
    for (round < 3) {
        i = round;
        for (i < 40) {
            val stream:     *Stream   = stream_for[TestTransport](?fixture.engine, ids[i]);
            val generation: u64       = stream.generation;
            val wire:       *TestWire = test_wire(?fixture.io, stream.transport_stream);
            if (wire == nil || !cancel_stream[TestTransport](?fixture.engine, ids[i],
                H3_REQUEST_CANCELLED)) { ret 5; }
            wire.reset_acked = true;
            wire.stop_acked  = true;
            if (!release_stream[TestTransport](?fixture.engine, ids[i], generation)) { ret 6; }
            wire.live = false;
            i         = i + 3;
        }
        i = round;
        for (i < 40) {
            ids[i] = open_request[TestTransport](?fixture.engine, nil);
            if (ids[i] == NO_STREAM
                || stream_for[TestTransport](?fixture.engine, ids[i]).transport_stream.id
                != ids[i]) { ret 7; }
            i = i + 3;
        }
        if (fixture.account.used[1] != grown
            || fixture.account.used[0] != 40 * request_set_bytes()) { ret 8; }
        round = round + 1;
    }
    ret 0;
}

test "http.h3.connection: a refused record rejects a request and parks a unidirectional stream" {
    var configured: Config = test_config();
    configured.initial_streams = 1;
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, configured)
        || fixture.engine.stream_capacity != 1
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    fixture.account.budgets[1] = fixture.account.used[1];
    var request_bytes:  [16]u8;
    val request_length: usize = static_request(?request_bytes[0], 16);
    if (peer_stream(?fixture, 0, ?request_bytes[0], request_length, false) == nil) { ret 2; }
    val rejected: Event = drive(?fixture, EVENT_STREAM_ERROR, 16);
    if (rejected.stream_id != 0 || rejected.code != H3_REQUEST_REJECTED
        || fixture.engine.stream_capacity != 1 || fixture.account.used[0] != 0) { ret 3; }
    var encoder: [1]u8;
    encoder[0] = frame.STREAM_QPACK_ENCODER::u8;
    if (peer_stream(?fixture, 6, ?encoder[0], 1, false) == nil
        || !settle_blocked(?fixture)) { ret 4; }
    val accepts: usize = fixture.io.accepts;
    if (process[TestTransport](?fixture.engine).kind != EVENT_MEMORY_BLOCKED
        || fixture.io.accepts != accepts || !fixture.engine.accept_parked
        || stream_for[TestTransport](?fixture.engine, 6) != nil
        || fixture.engine.state != OPEN || fixture.io.close_calls != 0) { ret 5; }
    fixture.account.budgets[1] = 1 << 25;
    if (!settle(?fixture) || fixture.engine.accept_parked
        || fixture.engine.stream_capacity != 2 || fixture.io.accepts != accepts) { ret 6; }
    val placed: *Stream = stream_for[TestTransport](?fixture.engine, 6);
    if (placed == nil || placed.kind != STREAM_QPACK_ENCODER
        || fixture.engine.active_peer_unidirectional != 2) { ret 7; }
    ret 0;
}

test "http.h3.connection: an exhausted pool registers a parked stream for a wake-up" {
    var configured: Config = test_config();
    configured.initial_streams = 1;
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, configured)
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var other:        buffers.Account;
    var budgets:      [2]usize       = [2]usize{1 << 20, 1 << 20};
    val other_opened: buffers.Reason = buffers.source_open_account(?fixture.source, ?other,
        2, ?budgets[0], 0);
    if (!(sel other_opened.none)) { ret 2; }
    val parked: buffers.Acquired = buffers.source_acquire(?fixture.source, ?other,
        buffers.Request{bytes: 4096, align: 0, lane: 0, secret: false}, false);
    if (!(sel parked.status.ok)) { ret 3; }
    # the shared remainder is gone, so the record is refused as exhausted
    fixture.pool.global_budget = fixture.pool.overflow_used;
    var encoder: [1]u8;
    encoder[0] = frame.STREAM_QPACK_ENCODER::u8;
    var woken: [4]u64;
    if (peer_stream(?fixture, 6, ?encoder[0], 1, false) == nil
        || !settle_blocked(?fixture) || !fixture.engine.accept_parked
        || !fixture.account.waiting
        || buffers.source_ready(?fixture.source, ?woken[0], 4) != 0) { ret 4; }
    val returned: buffers.Reason = buffers.source_release(?fixture.source, ?other, parked.chunk);
    if (!(sel returned.none) || buffers.source_ready(?fixture.source, ?woken[0], 4) != 1
        || woken[0] != 1) { ret 5; }
    if (!settle(?fixture) || fixture.engine.accept_parked
        || stream_for[TestTransport](?fixture.engine, 6) == nil) { ret 6; }
    ret 0;
}

test "http.h3.connection: held data is consumed after the connection closes" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var wire_bytes:     [32]u8;
    val headers_length: usize = static_request(?wire_bytes[0], 32);
    var data:           [3]u8;
    data[0] = 'a';
    data[1] = 'b';
    data[2] = 'c';
    val data_length: usize = append_frame(?wire_bytes[headers_length],
        32 - headers_length, frame.FRAME_DATA, ?data[0], 3);
    val wire: *TestWire = peer_stream(?fixture, 0, ?wire_bytes[0],
        headers_length + data_length, false);
    if (wire == nil) { ret 2; }
    val headers: Event = drive(?fixture, EVENT_REQUEST_HEADERS, 128);
    var storage: ExchangeMemory;
    if (!make_exchange(?storage, headers.generation, 0)
        || !bind_exchange[TestTransport](?fixture.engine, 0, ?storage.exchange)
        || !release_event[TestTransport](?fixture.engine, 0, headers.generation)) { ret 3; }
    val service: exchange.Service = exchange.Service{ctx: nil, serve: test_service};
    if (dispatch[TestTransport](?fixture.engine, 0, ?service) != exchange.SERVICE_COMPLETE
        || drive(?fixture, EVENT_DATA, 64).data_length != 3) { ret 4; }
    val credited: usize = wire.credited;
    if (!cancel_connection[TestTransport](?fixture.engine)
        || fixture.io.close_calls == 0) { ret 5; }
    if (!consume_data[TestTransport](?fixture.engine, 0, 3)
        || wire.credited != credited) { ret 6; }
    ret 0;
}

test "http.h3.connection: a closed connection destroys with releases the transport still owed" {
    var configured: Config = test_config();
    configured.max_requests = 1;
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, configured)
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var first_bytes:   [16]u8;
    var second_bytes:  [16]u8;
    val first_length:  usize = static_request(?first_bytes[0], 16);
    val second_length: usize = static_request(?second_bytes[0], 16);
    if (peer_stream(?fixture, 0, ?first_bytes[0], first_length, false) == nil
        || drive(?fixture, EVENT_REQUEST_HEADERS, 16).kind != EVENT_REQUEST_HEADERS
        || peer_stream(?fixture, 4, ?second_bytes[0], second_length, false) == nil
        || drive(?fixture, EVENT_STREAM_ERROR, 16).kind != EVENT_STREAM_ERROR) { ret 2; }
    # the peer never acknowledges the rejection, so its release stays owed
    if (fixture.engine.pending_release_count != 1
        || !cancel_connection[TestTransport](?fixture.engine)
        || fixture.engine.active_requests != 0
        || destroy[TestTransport](?fixture.engine)) { ret 3; }
    # the unbound request's borrow still ends, since its stream can never be served
    val held: *Stream = stream_for[TestTransport](?fixture.engine, 0);
    if (held == nil || !held.held
        || !release_event[TestTransport](?fixture.engine, 0, held.generation)) { ret 8; }
    if (!progress_close[TestTransport](?fixture.engine)
        || fixture.engine.state != CLOSED) { ret 4; }
    if (!destroy[TestTransport](?fixture.engine)) { ret 5; }
    if (fixture.account.held != 0)                { ret 6; }
    if (fixture.account.chunks != 0)              { ret 7; }
    ret 0;
}

fun named(name: *u8, length: usize, value: *u8, value_length: usize) field.Field {
    ret field.Field{name: view.view(name, length), value: view.view(value, value_length),
        sensitive: false};
}

fun taken_request(fixture: *Fixture, storage: *ExchangeMemory) *TestWire {
    var request_bytes:  [16]u8;
    val request_length: usize     = static_request(?request_bytes[0], 16);
    val wire:           *TestWire = peer_stream(fixture, 0, ?request_bytes[0], request_length, false);
    if (wire == nil) { ret nil; }
    val request: Event = drive(fixture, EVENT_REQUEST_HEADERS, 32);
    if (request.kind != EVENT_REQUEST_HEADERS
        || !make_exchange(storage, request.generation, 0)
        || !bind_exchange[TestTransport](?fixture.engine, 0, ?storage.exchange)
        || !release_event[TestTransport](?fixture.engine, 0, request.generation)) { ret nil; }
    ret wire;
}

test "http.h3.connection: outgoing names in any case are sent lowercase" {
    var fixture: Fixture;
    var storage: ExchangeMemory;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    val wire: *TestWire = taken_request(?fixture, ?storage);
    if (wire == nil) { ret 2; }
    var response: [2]field.Field;
    response[0] = named(":status", 7, "200", 3);
    response[1] = named("Content-Type", 12, "text/x-demo", 11);
    if (send_headers[TestTransport](?fixture.engine, 0, ?response[0], 2,
        false, false).status != OFFER_OUTPUT) { ret 3; }
    process[TestTransport](?fixture.engine);
    # the static :status 200 entry, then the static content-type name with a literal value
    if (wire.output_length < 8 || wire.output[0] != frame.FRAME_HEADERS::u8
        || wire.output[2] != 0 || wire.output[3] != 0 || wire.output[4] != 0xd9
        || wire.output[5] != 0x5f || wire.output[6] != 0x1d) { ret 4; }
    ret 0;
}

test "http.h3.connection: outgoing connection-specific names are refused in any case" {
    var fixture: Fixture;
    var storage: ExchangeMemory;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS
        || taken_request(?fixture, ?storage) == nil) { ret 1; }
    var response: [2]field.Field;
    response[0] = named(":status", 7, "200", 3);
    response[1] = named("Connection", 10, "close", 5);
    if (send_headers[TestTransport](?fixture.engine, 0, ?response[0], 2,
        false, false).status != OFFER_ERROR) { ret 2; }
    response[1] = named("TE", 2, "gzip", 4);
    if (send_headers[TestTransport](?fixture.engine, 0, ?response[0], 2,
        false, false).status != OFFER_ERROR) { ret 3; }
    response[1] = named("Content-Length", 14, "x", 1);
    if (send_headers[TestTransport](?fixture.engine, 0, ?response[0], 2,
        false, false).status != OFFER_ERROR) { ret 4; }
    # an informational status is recognised whatever the case of its name
    response[0] = named(":Status", 7, "103", 3);
    response[1] = named("Link", 4, "</a>", 4);
    if (send_headers[TestTransport](?fixture.engine, 0, ?response[0], 2,
        true, false).status != OFFER_ERROR) { ret 5; }
    if (send_headers[TestTransport](?fixture.engine, 0, ?response[0], 2,
        false, false).status != OFFER_OUTPUT) { ret 6; }
    ret 0;
}

test "http.h3.connection: a received uppercase name is still malformed" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS) { ret 1; }
    var block: [12]u8;
    block[0]  = 0;
    block[1]  = 0;
    block[2]  = 0xd1;
    block[3]  = 0xd7;
    block[4]  = 0xc1;
    block[5]  = 0x50;
    block[6]  = 1;
    block[7]  = 'x';
    block[8]  = 0x22;
    block[9]  = 'X';
    block[10] = 'a';
    block[11] = 0;
    var bytes:  [24]u8;
    val length: usize = append_frame(?bytes[0], 24, frame.FRAME_HEADERS, ?block[0], 12);
    if (length == 0 || peer_stream(?fixture, 0, ?bytes[0], length, true) == nil) { ret 2; }
    val failed: Event = drive(?fixture, EVENT_STREAM_ERROR, 64);
    if (failed.kind != EVENT_STREAM_ERROR || failed.stream_id != 0) { ret 3; }
    ret 0;
}
