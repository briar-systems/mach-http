# bounded qpack codec with exact table and blocked-section ownership

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view;
use std.memory;
use http.core.field;
use http.h2.hpack;

pub val MAX_INTEGER: u64 = 0x3fffffffffffffff;

pub def Error: u8;
pub val ERROR_NONE: Error = 0;
pub val ERROR_STATE: Error = 1;
pub val ERROR_INPUT: Error = 2;
pub val ERROR_INTEGER: Error = 3;
pub val ERROR_INDEX: Error = 4;
pub val ERROR_HUFFMAN: Error = 5;
pub val ERROR_STRING_LIMIT: Error = 6;
pub val ERROR_FIELD_LIMIT: Error = 7;
pub val ERROR_TABLE_CAPACITY: Error = 8;
pub val ERROR_TABLE_BLOCKED: Error = 9;
pub val ERROR_BLOCKED_STREAMS: Error = 10;
pub val ERROR_ENCODER_STREAM: Error = 11;
pub val ERROR_DECODER_STREAM: Error = 12;
pub val ERROR_DECOMPRESSION: Error = 13;
pub val ERROR_OUTPUT: Error = 14;
pub val ERROR_TRUNCATED: Error = 15;

pub rec Limits {
    max_table_capacity: usize;
    max_blocked_streams: usize;
    max_field_bytes: usize;
    max_field_count: usize;
    max_field_section_bytes: usize;
    max_encoded_section_bytes: usize;
    max_instruction_bytes: usize;
    max_outstanding_sections: usize;
    max_references: usize;
}

pub rec State {
    inserted: u64;
    acknowledged: u64;
    blocked_streams: usize;
    table_bytes: usize;
}

pub rec Entry {
    name: view.View;
    value: view.View;
    size: usize;
    absolute: u64;
    references: usize;
}

pub rec DynamicTable {
    items: *Entry;
    entry_capacity: usize;
    count: usize;
    storage: *u8;
    storage_capacity: usize;
    storage_length: usize;
    scratch: *u8;
    scratch_capacity: usize;
    bytes: usize;
    capacity: usize;
    max_capacity: usize;
    insert_count: u64;
    dropped_count: u64;
    generation: u64;
    valid: bool;
}

pub rec Reference {
    section: usize;
    absolute: u64;
    active: bool;
}

pub rec Section {
    stream_id: u64;
    required_insert_count: u64;
    base: u64;
    sequence: u64;
    blocked: bool;
    active: bool;
}

pub rec Sections {
    items: *Section;
    capacity: usize;
    references: *Reference;
    reference_capacity: usize;
    table: *DynamicTable;
    count: usize;
    blocked_count: usize;
    known_received: u64;
    next_sequence: u64;
    max_blocked_streams: usize;
    valid: bool;
}

pub def DecodeStatus: u8;
pub val DECODE_NEED_INPUT: DecodeStatus = 1;
pub val DECODE_BLOCKED: DecodeStatus = 2;
pub val DECODE_COMPLETE: DecodeStatus = 3;
pub val DECODE_ERROR: DecodeStatus = 4;

pub rec Decode {
    status: DecodeStatus;
    consumed: usize;
    count: usize;
    bytes: usize;
    required_insert_count: u64;
    error: Error;
}

pub rec FieldDecoder {
    limits: Limits;
    table: *DynamicTable;
    sections: *Sections;
    stream_id: u64;
    encoded: *u8;
    encoded_capacity: usize;
    encoded_length: usize;
    fields: *field.Field;
    field_capacity: usize;
    field_count: usize;
    storage: *u8;
    storage_capacity: usize;
    storage_length: usize;
    scratch: *u8;
    scratch_capacity: usize;
    field_bytes: usize;
    required_insert_count: u64;
    base: u64;
    section_slot: usize;
    blocked: bool;
    finished: bool;
    error: Error;
    initialized: bool;
}

pub rec Encode {
    ok: bool;
    written: usize;
    required_insert_count: u64;
    error: Error;
}

pub rec FieldEncoder {
    limits: Limits;
    table: *DynamicTable;
    sections: *Sections;
    stream_id: u64;
    output: *u8;
    output_capacity: usize;
    output_length: usize;
    fields: usize;
    field_bytes: usize;
    base: u64;
    max_reference: u64;
    references: *u64;
    reference_capacity: usize;
    reference_count: usize;
    finished: bool;
    error: Error;
    initialized: bool;
}

pub def InstructionKind: u8;
pub val INSTRUCTION_SET_CAPACITY: InstructionKind = 1;
pub val INSTRUCTION_INSERT_NAME_REFERENCE: InstructionKind = 2;
pub val INSTRUCTION_INSERT_LITERAL_NAME: InstructionKind = 3;
pub val INSTRUCTION_DUPLICATE: InstructionKind = 4;
pub val INSTRUCTION_SECTION_ACK: InstructionKind = 5;
pub val INSTRUCTION_STREAM_CANCEL: InstructionKind = 6;
pub val INSTRUCTION_INSERT_COUNT_INCREMENT: InstructionKind = 7;

pub def InstructionStatus: u8;
pub val INSTRUCTION_NEED_INPUT: InstructionStatus = 1;
pub val INSTRUCTION_COMPLETE: InstructionStatus = 2;
pub val INSTRUCTION_ERROR: InstructionStatus = 3;

pub rec Instruction {
    status: InstructionStatus;
    consumed: usize;
    kind: InstructionKind;
    value: u64;
    absolute: u64;
    error: Error;
}

pub rec EncoderStreamDecoder {
    limits: Limits;
    table: *DynamicTable;
    input: *u8;
    input_capacity: usize;
    input_length: usize;
    scratch: *u8;
    scratch_capacity: usize;
    error: Error;
    initialized: bool;
}

pub rec DecoderStreamDecoder {
    limits: Limits;
    table: *DynamicTable;
    sections: *Sections;
    input: *u8;
    input_capacity: usize;
    input_length: usize;
    error: Error;
    initialized: bool;
}

pub fun limits_default() Limits {
    ret Limits{
        max_table_capacity: 4096,
        max_blocked_streams: 16,
        max_field_bytes: 16384,
        max_field_count: 100,
        max_field_section_bytes: 65536,
        max_encoded_section_bytes: 65536,
        max_instruction_bytes: 32768,
        max_outstanding_sections: 128,
        max_references: 1024,
    };
}

fun limits_valid(limits: Limits) bool {
    ret limits.max_field_bytes != 0 && limits.max_field_count != 0
        && limits.max_field_section_bytes != 0
        && limits.max_encoded_section_bytes != 0
        && limits.max_instruction_bytes != 0
        && limits.max_outstanding_sections != 0 && limits.max_references != 0;
}

fun text(value: str) view.View { ret view.view(value, str_len(value)); }

fun same(a: view.View, b: view.View) bool {
    ret a.len == b.len && (a.len == 0 || (a.data != nil && b.data != nil
        && memory.raw_equal(a.data, b.data, a.len)));
}

fun entry_size(name: view.View, value: view.View) usize {
    if (name.len > (-1)::usize - value.len
     || name.len + value.len > (-1)::usize - 32) { ret (-1)::usize; }
    ret name.len + value.len + 32;
}

fun make_entry(name: str, value: str) Entry {
    val name_view: view.View = text(name);
    val value_view: view.View = text(value);
    ret Entry{name: name_view, value: value_view,
        size: entry_size(name_view, value_view), absolute: 0, references: 0};
}

