use http.core.body;
use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.method;
use http.core.status;
use http.core.target;
use std.encoding.base64;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

pub def Status: u8;
pub val NEGOTIATED:        Status = 1;
pub val INVALID_EXCHANGE:  Status = 2;
pub val INVALID_METHOD:    Status = 3;
pub val INVALID_VERSION:   Status = 4;
pub val INVALID_HEADERS:   Status = 5;
pub val INVALID_KEY:       Status = 6;
pub val INVALID_PROTOCOL:  Status = 7;
pub val RESPONSE_CAPACITY: Status = 8;
pub val COMMIT_FAILED:     Status = 9;

pub rec Handshake {
    status:   Status;
    wire:     message.Wire;
    accept:   view.View;
    protocol: view.View;
}

val GUID: str = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";

fun lower(c: u8) u8 {
    if (c >= 'A' && c <= 'Z') { ret c + 32; }
    ret c;
}

fun insensitive(value: view.View, text: *u8, length: usize) bool {
    if (value.len != length || value.data == nil || text == nil) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (lower(value.data[i]) != lower(text[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun exact(a: view.View, b: view.View) bool {
    if (a.len != b.len || (a.len != 0 && (a.data == nil || b.data == nil))) { ret false; }
    ret a.len == 0 || memory.raw_equal(a.data, b.data, a.len);
}

fun trim(value: view.View) view.View {
    var start:  usize = 0;
    var finish: usize = value.len;
    for (start < finish && (value.data[start] == ' ' || value.data[start] == '\t')) {
        start = start + 1;
    }
    for (finish > start && (value.data[finish - 1] == ' ' || value.data[finish - 1] == '\t')) {
        finish = finish - 1;
    }
    if (finish == start) { ret view.view(nil, 0); }
    ret view.view(?value.data[start], finish - start);
}

fun has_token(value: view.View, token: *u8, length: usize) bool {
    var offset: usize = 0;
    for (offset < value.len) {
        for (offset < value.len && (value.data[offset] == ' '
            || value.data[offset] == '\t' || value.data[offset] == ',')) {
            offset = offset + 1;
        }
        val start: usize = offset;
        for (offset < value.len && value.data[offset] != ',') { offset = offset + 1; }
        val item: view.View = trim(view.view(?value.data[start], offset - start));
        if (insensitive(item, token, length)) { ret true; }
    }
    ret false;
}

fun field_count(fields: *field.Fields, name: *u8, name_length: usize,
    first: *view.View) usize {
    var count: usize = 0;
    var i:     usize = 0;
    for (i < fields.len) {
        if (field.name_equal(fields.items[i].name, view.view(name, name_length))) {
            if (count == 0 && first != nil) { @first = trim(fields.items[i].value); }
            count = count + 1;
        }
        i = i + 1;
    }
    ret count;
}

fun fields_have_token(fields: *field.Fields, name: *u8, name_length: usize,
    token: *u8, token_length: usize) bool {
    var i: usize = 0;
    for (i < fields.len) {
        if (field.name_equal(fields.items[i].name, view.view(name, name_length))
            && has_token(fields.items[i].value, token, token_length)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun offered_protocol(fields: *field.Fields, selected: view.View) bool {
    if (selected.len != 0 && !method.valid_token(selected, 256)) { ret false; }
    var found: bool  = selected.len == 0;
    var i:     usize = 0;
    for (i < fields.len) {
        if (field.name_equal(fields.items[i].name,
            view.view("sec-websocket-protocol", 22))) {
            var offset: usize     = 0;
            val value:  view.View = fields.items[i].value;
            for (offset < value.len) {
                for (offset < value.len && (value.data[offset] == ' '
                    || value.data[offset] == '\t' || value.data[offset] == ',')) {
                    offset = offset + 1;
                }
                val start: usize = offset;
                for (offset < value.len && value.data[offset] != ',') { offset = offset + 1; }
                val item: view.View = trim(view.view(?value.data[start], offset - start));
                if (!method.valid_token(item, 256)) { ret false; }
                if (exact(item, selected))          { found = true; }
            }
        }
        i = i + 1;
    }
    ret found;
}

fun protocol_list_has(protocols: view.View, selected: view.View) bool {
    var found:  bool  = false;
    var offset: usize = 0;
    for (offset < protocols.len) {
        for (offset < protocols.len && (protocols.data[offset] == ' '
            || protocols.data[offset] == '\t' || protocols.data[offset] == ',')) {
            offset = offset + 1;
        }
        val start: usize = offset;
        for (offset < protocols.len && protocols.data[offset] != ',') { offset = offset + 1; }
        val item: view.View = trim(view.view(?protocols.data[start], offset - start));
        if (!method.valid_token(item, 256)) { ret false; }
        if (exact(item, selected))          { found = true; }
    }
    ret found;
}

fun rotate(value: u32, amount: u8) u32 {
    ret (value << amount) | (value >> (32 - amount));
}

rec Sha1State { a: u32; b: u32; c: u32; d: u32; e: u32; }

fun sha1_block(block: *u8, state: *Sha1State) {
    var words: [80]u32;
    var i:     usize = 0;
    for (i < 16) {
        val offset: usize = i * 4;
        words[i] = (block[offset]::u32 << 24) | (block[offset + 1]::u32 << 16)
            | (block[offset + 2]::u32 << 8) | block[offset + 3]::u32;
        i = i + 1;
    }
    for (i < 80) {
        words[i] = rotate(words[i - 3] ^ words[i - 8] ^ words[i - 14] ^ words[i - 16], 1);
        i        = i + 1;
    }
    var a: u32 = state.a;
    var b: u32 = state.b;
    var c: u32 = state.c;
    var d: u32 = state.d;
    var e: u32 = state.e;
    i = 0;
    for (i < 80) {
        var f: u32 = 0;
        var k: u32 = 0;
        if (i < 20) {
            f = (b & c) | ((~b) & d);
            k = 0x5a827999;
        }
        or (i < 40) {
            f = b ^ c ^ d;
            k = 0x6ed9eba1;
        }
        or (i < 60) {
            f = (b & c) | (b & d) | (c & d);
            k = 0x8f1bbcdc;
        }
        or {
            f = b ^ c ^ d;
            k = 0xca62c1d6;
        }
        val next: u32 = rotate(a, 5) + f + e + k + words[i];
        e = d;
        d = c;
        c = rotate(b, 30);
        b = a;
        a = next;
        i = i + 1;
    }
    state.a = state.a + a;
    state.b = state.b + b;
    state.c = state.c + c;
    state.d = state.d + d;
    state.e = state.e + e;
}

fun sha1(input: *u8, length: usize, output: *u8) bool {
    if (input == nil || output == nil || length > 119) { ret false; }
    var padded: [128]u8;
    memory.raw_zero(?padded[0], 128);
    memory.raw_copy(?padded[0], input, length);
    padded[length] = 0x80;
    val blocks: usize = (length + 9 + 63) / 64;
    val bits:   u64   = length::u64 * 8;
    var i:      usize = 0;
    for (i < 8) {
        padded[blocks * 64 - 1 - i] = (bits >> (i * 8)::u8)::u8;
        i                           = i + 1;
    }
    var state: Sha1State = Sha1State{a: 0x67452301, b: 0xefcdab89,
        c: 0x98badcfe, d: 0x10325476, e: 0xc3d2e1f0};
    i = 0;
    for (i < blocks) {
        sha1_block(?padded[i * 64], ?state);
        i = i + 1;
    }
    i = 0;
    for (i < 5) {
        var word: u32 = state.a;
        if (i == 1) { word = state.b; }
        or (i == 2) { word = state.c; }
        or (i == 3) { word = state.d; }
        or (i == 4) { word = state.e; }
        output[i * 4]     = (word >> 24)::u8;
        output[i * 4 + 1] = (word >> 16)::u8;
        output[i * 4 + 2] = (word >> 8)::u8;
        output[i * 4 + 3] = word::u8;
        i                 = i + 1;
    }
    ret true;
}

pub fun client_key(random: *u8, random_length: usize,
    output: *u8, output_capacity: usize) view.View {
    if (random == nil || random_length != 16 || output == nil || output_capacity < 25) {
        ret view.view(nil, 0);
    }
    val written: usize = base64.encode(random, 16, output, output_capacity);
    if (written != 24) { ret view.view(nil, 0); }
    ret view.view(output, written);
}

fun valid_key(key: view.View) bool {
    if (key.data == nil || key.len != 24 || key.data[22] != '=' || key.data[23] != '=') {
        ret false;
    }
    var decoded: [16]u8;
    if (base64.decode(key.data, key.len, ?decoded[0], 16) != 16) { ret false; }
    var encoded:   [25]u8;
    val canonical: view.View = client_key(?decoded[0], 16, ?encoded[0], 25);
    ret exact(key, canonical);
}

pub fun accept_key(key: view.View, output: *u8, output_capacity: usize) view.View {
    if (!valid_key(key) || output == nil || output_capacity < 29) { ret view.view(nil, 0); }
    var joined: [60]u8;
    memory.raw_copy(?joined[0], key.data, key.len);
    memory.raw_copy(?joined[key.len], GUID, 36);
    var digest: [20]u8;
    if (!sha1(?joined[0], 60, ?digest[0])) { ret view.view(nil, 0); }
    val written: usize = base64.encode(?digest[0], 20, output, output_capacity);
    if (written != 28) { ret view.view(nil, 0); }
    ret view.view(output, written);
}

fun response_space(response: *message.Response, extra_count: usize, extra_bytes: usize) bool {
    if (response == nil || !response.fields.valid || response.committed
        || extra_count > response.fields.capacity - response.fields.len
        || extra_count > response.fields.limits.max_count - response.fields.len
        || extra_bytes > response.fields.limits.max_bytes - response.fields.bytes) { ret false; }
    ret true;
}

fun add(response: *message.Response, name: *u8, name_length: usize,
    value: view.View) bool {
    ret message.add_field(response, field.Field{name: view.view(name, name_length),
        value: value, sensitive: false}) == field.ADD_OK;
}

fun failed(status_value: Status) Handshake {
    ret Handshake{status: status_value, wire: 0,
        accept: view.view(nil, 0), protocol: view.view(nil, 0)};
}

pub fun server(exchange_value: *exchange.Exchange, extended_protocol: view.View,
    selected_protocol: view.View, accept_output: *u8, accept_capacity: usize) Handshake {
    if (exchange_value == nil || !exchange_value.valid || exchange_value.state != exchange.HANDLING
        || exchange_value.request == nil || exchange_value.response == nil) {
        ret failed(INVALID_EXCHANGE);
    }
    val request:  *message.Request  = exchange_value.request;
    val response: *message.Response = exchange_value.response;
    val wire:     message.Wire      = request.metadata.version.wire;
    if (wire != message.WIRE_H1 && wire != message.WIRE_H2 && wire != message.WIRE_H3) {
        ret failed(INVALID_VERSION);
    }
    if (!request.body.has_length || request.body.declared_length != 0) {
        ret failed(INVALID_HEADERS);
    }
    var version: view.View;
    if (field_count(?request.fields, "sec-websocket-version", 21, ?version) != 1
        || !exact(version, view.view("13", 2))) { ret failed(INVALID_VERSION); }
    if (!offered_protocol(?request.fields, selected_protocol)) { ret failed(INVALID_PROTOCOL); }
    var accept:          view.View     = view.view(nil, 0);
    var response_status: status.Status = status.OK;
    var extra_count:     usize         = 0;
    var extra_bytes:     usize         = 0;
    if (wire == message.WIRE_H1) {
        if (request.method.kind != method.GET || request.metadata.version.major != 1
            || request.metadata.version.minor != 1) { ret failed(INVALID_METHOD); }
        if (extended_protocol.len != 0
            || !fields_have_token(?request.fields, "connection", 10, "upgrade", 7)
            || !fields_have_token(?request.fields, "upgrade", 7, "websocket", 9)) {
            ret failed(INVALID_HEADERS);
        }
        var key: view.View;
        if (field_count(?request.fields, "sec-websocket-key", 17, ?key) != 1 || !valid_key(key)) {
            ret failed(INVALID_KEY);
        }
        accept = accept_key(key, accept_output, accept_capacity);
        if (accept.len != 28) { ret failed(RESPONSE_CAPACITY); }
        response_status = status.SWITCHING_PROTOCOLS;
        extra_count     = 3;
        extra_bytes     = 10 + 7 + 7 + 9 + 20 + accept.len;
    }
    or {
        if (request.method.kind != method.CONNECT
            || !exact(extended_protocol, view.view("websocket", 9))) {
            ret failed(INVALID_METHOD);
        }
        if (field_count(?request.fields, "connection", 10, nil) != 0
            || field_count(?request.fields, "upgrade", 7, nil) != 0
            || field_count(?request.fields, "sec-websocket-key", 17, nil) != 0) {
            ret failed(INVALID_HEADERS);
        }
    }
    if (selected_protocol.len != 0) {
        extra_count = extra_count + 1;
        extra_bytes = extra_bytes + 22 + selected_protocol.len;
    }
    if (!response_space(response, extra_count, extra_bytes)) { ret failed(RESPONSE_CAPACITY); }
    if (message.set_status(response, response_status) != message.RESPONSE_OK) {
        ret failed(INVALID_EXCHANGE);
    }
    if (wire == message.WIRE_H1
        && (!add(response, "upgrade", 7, view.view("websocket", 9))
        || !add(response, "connection", 10, view.view("Upgrade", 7))
        || !add(response, "sec-websocket-accept", 20, accept))) {
        ret failed(RESPONSE_CAPACITY);
    }
    if (selected_protocol.len != 0
        && !add(response, "sec-websocket-protocol", 22, selected_protocol)) {
        ret failed(RESPONSE_CAPACITY);
    }
    if (exchange.commit(exchange_value, exchange_value.limits) != message.RESPONSE_OK) {
        ret failed(COMMIT_FAILED);
    }
    ret Handshake{status: NEGOTIATED, wire: wire, accept: accept, protocol: selected_protocol};
}

pub fun validate_h1_response(response: *message.Response, key: view.View,
    requested_protocols: view.View, accept_scratch: *u8, accept_capacity: usize) Handshake {
    if (response == nil || response.status != status.SWITCHING_PROTOCOLS
        || !fields_have_token(?response.fields, "connection", 10, "upgrade", 7)
        || !fields_have_token(?response.fields, "upgrade", 7, "websocket", 9)) {
        ret failed(INVALID_HEADERS);
    }
    val expected: view.View = accept_key(key, accept_scratch, accept_capacity);
    var actual:   view.View;
    if (expected.len != 28
        || field_count(?response.fields, "sec-websocket-accept", 20, ?actual) != 1
        || !exact(expected, actual)) { ret failed(INVALID_KEY); }
    var selected:       view.View = view.view(nil, 0);
    val selected_count: usize     = field_count(?response.fields,
        "sec-websocket-protocol", 22, ?selected);
    if (selected_count > 1 || (selected_count == 1
        && (!method.valid_token(selected, 256)
        || !protocol_list_has(requested_protocols, selected)))) {
        ret failed(INVALID_PROTOCOL);
    }
    ret Handshake{status: NEGOTIATED, wire: message.WIRE_H1,
        accept: actual, protocol: selected};
}

pub fun validate_extended_response(response: *message.Response, wire: message.Wire,
    requested_protocols: view.View) Handshake {
    if (response == nil || (wire != message.WIRE_H2 && wire != message.WIRE_H3)
        || response.status != status.OK
        || field_count(?response.fields, "connection", 10, nil) != 0
        || field_count(?response.fields, "upgrade", 7, nil) != 0
        || field_count(?response.fields, "sec-websocket-key", 17, nil) != 0
        || field_count(?response.fields, "sec-websocket-accept", 20, nil) != 0) {
        ret failed(INVALID_HEADERS);
    }
    var selected:       view.View = view.view(nil, 0);
    val selected_count: usize     = field_count(?response.fields,
        "sec-websocket-protocol", 22, ?selected);
    if (selected_count > 1 || (selected_count == 1
        && (!method.valid_token(selected, 256)
        || !protocol_list_has(requested_protocols, selected)))) {
        ret failed(INVALID_PROTOCOL);
    }
    ret Handshake{status: NEGOTIATED, wire: wire,
        accept: view.view(nil, 0), protocol: selected};
}

test "http.websocket.negotiation: rfc accept key vector is exact" {
    var output:   [29]u8;
    val accepted: view.View = accept_key(view.view("dGhlIHNhbXBsZSBub25jZQ==", 24),
        ?output[0], 29);
    if (accepted.len != 28)                                              { ret 1; }
    if (!exact(accepted, view.view("s3pPLMBiTxaQ9kYGzzhZRbK+xOo=", 28))) { ret 2; }
    var random:     [16]u8;
    var key_output: [25]u8;
    if (client_key(?random[0], 16, ?key_output[0], 25).len != 24
        || client_key(?random[0], 15, ?key_output[0], 25).len != 0) { ret 3; }
    ret 0;
}

fun test_metadata(version: message.Version) message.Metadata {
    ret message.Metadata{
        version:       version,
        secure:        true,
        early_data:    false,
        peer:          message.unspecified_endpoint(),
        local:         message.unspecified_endpoint(),
        received_at:   time.Time{sec: 1, nsec: 0},
        deadline:      opt[time.Instant].none{},
        request_index: 1,
    };
}

test "http.websocket.negotiation: h1 upgrade commits common exchange" {
    val configured: message.Limits = message.limits_default();
    var scope:      cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 1; }
    var request_items:  [8]field.Field;
    var request_fields: field.Fields = field.init(?request_items[0], 8,
        configured.request_fields);
    if (field.append(?request_fields, field.Field{name: view.view("connection", 10),
        value: view.view("keep-alive, Upgrade", 19), sensitive: false}) != field.ADD_OK
        || field.append(?request_fields, field.Field{name: view.view("upgrade", 7),
        value: view.view("websocket", 9), sensitive: false}) != field.ADD_OK
        || field.append(?request_fields, field.Field{name: view.view("sec-websocket-version", 21),
        value: view.view("13", 2), sensitive: false}) != field.ADD_OK
        || field.append(?request_fields, field.Field{name: view.view("sec-websocket-key", 17),
        value: view.view("dGhlIHNhbXBsZSBub25jZQ==", 24), sensitive: true}) != field.ADD_OK
        || field.append(?request_fields, field.Field{name: view.view("sec-websocket-protocol", 22),
        value: view.view("chat, superchat", 15), sensitive: false}) != field.ADD_OK) { ret 2; }
    var request_trailers: field.Fields = field.init(nil, 0, configured.request_trailers);
    var reader:           body.Reader  = body.empty_reader(91);
    var request:          message.Request;
    if (!message.init_request(?request, method.from_kind(method.GET),
        target.origin(view.view("/chat", 5), view.view("/chat", 5), view.view(nil, 0)),
        test_metadata(message.version_h1(1, 1)), request_fields, request_trailers,
        ?reader, 91, configured)) { ret 3; }
    var response_items:    [8]field.Field;
    var response_trailers: [1]field.Field;
    var response:          message.Response;
    if (!message.init_response(?response, ?response_items[0], 8,
        ?response_trailers[0], 1, 91, configured)) { ret 4; }
    var informationals: [1]message.Informational;
    var exchange_value: exchange.Exchange;
    if (!exchange.init(?exchange_value, ?request, ?response, ?informationals[0], 1,
        ?scope, 91, configured) || !exchange.begin(?exchange_value)) { ret 5; }
    var accept: [29]u8;
    val result: Handshake = server(?exchange_value, view.view(nil, 0),
        view.view("superchat", 9), ?accept[0], 29);
    if (result.status != NEGOTIATED || result.wire != message.WIRE_H1
        || response.status != status.SWITCHING_PROTOCOLS || !response.committed
        || exchange_value.state != exchange.RESPONDING
        || exchange.finish(?exchange_value) != exchange.FINISH_OK
        || exchange_value.completion.reuse != body.REUSE_FORBIDDEN) { ret 6; }
    if (!operation_ok(cancel.destroy(?scope))) { ret 7; }
    ret 0;
}

fun extended_test(version: message.Version, generation: u64) i32 {
    val configured: message.Limits = message.limits_default();
    var scope:      cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 1; }
    var request_items:  [3]field.Field;
    var request_fields: field.Fields = field.init(?request_items[0], 3,
        configured.request_fields);
    field.append(?request_fields, field.Field{name: view.view("sec-websocket-version", 21),
        value: view.view("13", 2), sensitive: false});
    field.append(?request_fields, field.Field{name: view.view("sec-websocket-protocol", 22),
        value: view.view("mach", 4), sensitive: false});
    var request_trailers: field.Fields = field.init(nil, 0, configured.request_trailers);
    var reader:           body.Reader  = body.empty_reader(generation);
    var request:          message.Request;
    if (!message.init_request(?request, method.from_kind(method.CONNECT),
        target.authority(view.view("example.com", 11)), test_metadata(version), request_fields,
        request_trailers, ?reader, generation, configured)) { ret 2; }
    var response_items:    [2]field.Field;
    var response_trailers: [1]field.Field;
    var response:          message.Response;
    message.init_response(?response, ?response_items[0], 2,
        ?response_trailers[0], 1, generation, configured);
    var informationals: [1]message.Informational;
    var exchange_value: exchange.Exchange;
    exchange.init(?exchange_value, ?request, ?response, ?informationals[0], 1,
        ?scope, generation, configured);
    exchange.begin(?exchange_value);
    val result: Handshake = server(?exchange_value, view.view("websocket", 9),
        view.view("mach", 4), nil, 0);
    if (result.status != NEGOTIATED || result.wire != version.wire
        || response.status != status.OK || !response.committed
        || validate_extended_response(?response, version.wire,
        view.view("chat, mach", 10)).status != NEGOTIATED) { ret 3; }
    if (!operation_ok(cancel.destroy(?scope))) { ret 4; }
    ret 0;
}

test "http.websocket.negotiation: h2 and h3 extended connect share exchange" {
    if (extended_test(message.version_h2(), 92) != 0) { ret 1; }
    if (extended_test(message.version_h3(), 93) != 0) { ret 2; }
    ret 0;
}

use std.chrono.time;
use std.sync.cancel;
