# single-owner production client orchestration

use std.chrono.time;
use std.net.ip;
use resolver: std.net.resolve;
use cancellation: std.sync.cancel;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.view;
use http.client.dns;
use http.client.memory;
use http.client.policy;
use http.client.pool;
use http.core.body;
use common_exchange: http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.method;
use http.core.status;
use http.core.target;

pub def State: u8;
pub val STATE_FREE:             State = 0;
pub val STATE_ROUTING:          State = 1;
pub val STATE_DNS_PUBLISHED:    State = 2;
pub val STATE_CONNECTING:       State = 3;
pub val STATE_SEND_READY:       State = 4;
pub val STATE_EXCHANGING:       State = 5;
pub val STATE_RETRY_WAIT:       State = 6;
pub val STATE_REPLAY_READY:     State = 7;
pub val STATE_REPLAY_PUBLISHED: State = 8;
pub val STATE_TERMINAL:         State = 9;

pub rec Token {
    index:      u32;
    generation: u32;
}

rec StoredOrigin {
    scheme:   policy.Scheme;
    host:     [254]u8;
    host_len: usize;
    port:     u16;
}

rec StoredProxy {
    kind:       policy.ProxyKind;
    host:       [254]u8;
    host_len:   usize;
    port:       u16;
    secure:     bool;
    identity:   u64;
    transports: u8;
}

rec StoredRoute {
    origin: StoredOrigin;
    proxy:  StoredProxy;
}

pub def Outcome: u8;
pub val OUTCOME_OK:        Outcome = 1;
pub val OUTCOME_CANCELLED: Outcome = 2;
pub val OUTCOME_TIMED_OUT: Outcome = 3;
pub val OUTCOME_FAILED:    Outcome = 4;

pub def ErrorKind: u8;
pub val ERROR_NONE:      ErrorKind = 0;
pub val ERROR_DNS:       ErrorKind = 1;
pub val ERROR_CONNECT:   ErrorKind = 2;
pub val ERROR_PROTOCOL:  ErrorKind = 3;
pub val ERROR_TRANSPORT: ErrorKind = 4;
pub val ERROR_RESPONSE:  ErrorKind = 5;
pub val ERROR_REDIRECT:  ErrorKind = 6;
pub val ERROR_DRAINING:  ErrorKind = 7;
pub val ERROR_CANCELLED: ErrorKind = 8;
pub val ERROR_TIMED_OUT: ErrorKind = 9;
pub val ERROR_INTERNAL:  ErrorKind = 10;

pub rec Completion {
    outcome:        Outcome;
    error:          ErrorKind;
    resolver_error: resolver.Error;
    retry_reason:   policy.RetryReason;
    response:       *message.Response;
    attempts:       usize;
    redirects:      usize;
}

pub rec Config {
    max_requests:              usize;
    max_endpoints_per_request: usize;
    message_limits:            message.Limits;
}

pub rec RequestSlot {
    state:              State;
    generation:         u32;
    request:            *message.Request;
    route:              StoredRoute;
    protocols:          policy.ProtocolPolicy;
    replay:             policy.Replay;
    retry_policy:       policy.RetryPolicy;
    redirect_policy:    policy.RedirectPolicy;
    attempts:           usize;
    redirects:          usize;
    endpoint_len:       usize;
    endpoint_cursor:    usize;
    pending_dns:        dns.Token;
    reservation:        pool.Reservation;
    lease:              pool.Lease;
    retry_at:           time.Time;
    retry_needs_replay: bool;
    last_retry_reason:  policy.RetryReason;
    completion:         Completion;
    scope:              cancellation.Scope;
}

pub rec Client {
    cache:                 *dns.Cache;
    connections:           *pool.Pool;
    slots:                 *RequestSlot;
    capacity:              usize;
    endpoints:             *ip.Endpoint;
    endpoint_capacity:     usize;
    configured:            Config;
    next_slot:             usize;
    live_requests:         usize;
    accepting:             bool;
    dependencies_draining: bool;
    initialized:           bool;
}

rec MemoryRegion {
    data: ptr;
    size: usize;
}

pub def SubmitStatus: u8;
pub val SUBMIT_OK:        SubmitStatus = 1;
pub val SUBMIT_SATURATED: SubmitStatus = 2;
pub val SUBMIT_DRAINING:  SubmitStatus = 3;
pub val SUBMIT_INVALID:   SubmitStatus = 4;

pub rec Submission {
    status: SubmitStatus;
    token:  Token;
}

pub def ActionKind: u8;
pub val ACTION_NONE:       ActionKind = 0;
pub val ACTION_RESOLVE:    ActionKind = 1;
pub val ACTION_CONNECT:    ActionKind = 2;
pub val ACTION_EXCHANGE:   ActionKind = 3;
pub val ACTION_WAIT_DNS:   ActionKind = 4;
pub val ACTION_WAIT_POOL:  ActionKind = 5;
pub val ACTION_WAIT_TIMER: ActionKind = 6;
pub val ACTION_REPLAY:     ActionKind = 7;
pub val ACTION_COMPLETE:   ActionKind = 8;

pub rec Action {
    kind:        ActionKind;
    token:       Token;
    scope:       *cancellation.Scope;
    request:     *message.Request;
    route:       policy.Route;
    protocols:   policy.ProtocolPolicy;
    dns_query:   dns.Query;
    reservation: pool.Reservation;
    lease:       pool.Lease;
    ready_at:    time.Time;
    completion:  Completion;
}

pub def ConnectStatus: u8;
pub val CONNECT_ACCEPTED: ConnectStatus = 1;
pub val CONNECT_RETRY:    ConnectStatus = 2;
pub val CONNECT_REJECTED: ConnectStatus = 3;
pub val CONNECT_DRAINED:  ConnectStatus = 4;
pub val CONNECT_INVALID:  ConnectStatus = 5;
pub val CONNECT_CANCELLED: ConnectStatus = 6;

pub rec Connected {
    status:       ConnectStatus;
    close_driver: bool;
}

pub def ExchangeResponseStatus: u8;
pub val EXCHANGE_RESPONSE_RETRY:     ExchangeResponseStatus = 1;
pub val EXCHANGE_RESPONSE_COMPLETE:  ExchangeResponseStatus = 2;
pub val EXCHANGE_RESPONSE_CANCELLED: ExchangeResponseStatus = 3;
pub val EXCHANGE_RESPONSE_INVALID:   ExchangeResponseStatus = 4;

pub def MaintenanceKind: u8;
pub val MAINTENANCE_NONE:           MaintenanceKind = 0;
pub val MAINTENANCE_CANCEL_DNS:     MaintenanceKind = 1;
pub val MAINTENANCE_CANCEL_CONNECT: MaintenanceKind = 2;
pub val MAINTENANCE_CLOSE:          MaintenanceKind = 3;

pub rec Maintenance {
    kind:           MaintenanceKind;
    dns_cancel:     dns.Cancel;
    connect_cancel: pool.ConnectCancel;
    close:          pool.Close;
}

pub fun config_default() Config {
    ret Config{max_requests: 4096, max_endpoints_per_request: 16,
        message_limits: message.limits_default()};
}

fun no_resolver_error() resolver.Error {
    ret resolver.Error{kind: resolver.NO_ERROR, native_code: 0};
}

fun empty_token() Token {
    ret Token{index: 0, generation: 0};
}

fun empty_dns_token() dns.Token {
    ret dns.Token{index: 0, generation: 0};
}

fun empty_connection_token() pool.ConnectionToken {
    ret pool.ConnectionToken{index: 0, generation: 0};
}

fun empty_lease_token() pool.LeaseToken {
    ret pool.LeaseToken{index: 0, generation: 0};
}

fun empty_endpoint() ip.Endpoint {
    var result: ip.Endpoint;
    result.addr.is_v6 = 0;
    var i: usize = 0;
    for (i < 4) {
        result.addr.v4.octets[i] = 0;
        i = i + 1;
    }
    i = 0;
    for (i < 16) {
        result.addr.v6.octets[i] = 0;
        i = i + 1;
    }
    result.port = 0;
    result.scope = 0;
    ret result;
}

fun empty_route() policy.Route {
    ret policy.Route{origin: policy.Origin{scheme: 0,
        host: view.view(nil, 0), port: 0}, proxy: policy.no_proxy()};
}

fun empty_reservation() pool.Reservation {
    ret pool.Reservation{status: pool.RESERVE_INVALID,
        connection: empty_connection_token(), lease: empty_lease_token(),
        endpoint: empty_endpoint(), transport: 0};
}

fun empty_lease() pool.Lease {
    ret pool.Lease{token: empty_lease_token(),
        connection: empty_connection_token(), driver: nil, wire: 0};
}

fun empty_dns_query() dns.Query {
    ret dns.Query{valid: false, token: empty_dns_token(),
        query: resolver.Query{host: nil, service: nil,
            family: resolver.ANY_FAMILY, socket_kind: resolver.ANY_SOCKET,
            protocol: 0, flags: 0}, scope: nil, context: 0};
}

fun empty_completion() Completion {
    ret Completion{outcome: 0, error: ERROR_NONE,
        resolver_error: no_resolver_error(), retry_reason: 0, response: nil,
        attempts: 0, redirects: 0};
}

fun empty_action() Action {
    ret Action{kind: ACTION_NONE, token: empty_token(), scope: nil,
        request: nil, route: empty_route(),
        protocols: policy.ProtocolPolicy{allowed: 0, prior_knowledge: 0,
            require_alpn: false}, dns_query: empty_dns_query(),
        reservation: empty_reservation(), lease: empty_lease(),
        ready_at: time.Time{sec: 0, nsec: 0},
        completion: empty_completion()};
}

fun empty_dns_cancel() dns.Cancel {
    ret dns.Cancel{found: false, token: empty_dns_token(), scope: nil};
}

fun empty_connect_cancel() pool.ConnectCancel {
    ret pool.ConnectCancel{found: false, reservation: empty_reservation()};
}

fun empty_close() pool.Close {
    ret pool.Close{found: false, connection: empty_connection_token(),
        driver: nil, wire: 0};
}

fun empty_maintenance() Maintenance {
    ret Maintenance{kind: MAINTENANCE_NONE, dns_cancel: empty_dns_cancel(),
        connect_cancel: empty_connect_cancel(), close: empty_close()};
}

fun time_valid(value: time.Time) bool {
    ret value.sec >= 0 && value.nsec >= 0 && value.nsec < 1000000000;
}

fun time_before_or_equal(first: time.Time, second: time.Time) bool {
    ret time.time_before(first, second) || time.time_equal(first, second);
}

fun time_add(now: time.Time, duration_ns: u64) time.Time {
    val seconds: u64 = duration_ns / 1000000000;
    val nanoseconds: u64 = duration_ns % 1000000000;
    if (seconds > 0x7fffffffffffffff
        || now.sec > 0x7fffffffffffffff - seconds::i64) {
        ret time.Time{sec: 0x7fffffffffffffff, nsec: 999999999};
    }
    var result: time.Time = time.Time{sec: now.sec + seconds::i64,
        nsec: now.nsec + nanoseconds::i64};
    if (result.nsec >= 1000000000) {
        if (result.sec == 0x7fffffffffffffff) {
            result.nsec = 999999999;
            ret result;
        }
        result.sec = result.sec + 1;
        result.nsec = result.nsec - 1000000000;
    }
    ret result;
}

fun time_until(now: time.Time, future: time.Time) u64 {
    if (time_before_or_equal(future, now)) { ret 0; }
    var seconds: u64 = (future.sec - now.sec)::u64;
    var nanoseconds: i64 = future.nsec - now.nsec;
    if (nanoseconds < 0) {
        seconds = seconds - 1;
        nanoseconds = nanoseconds + 1000000000;
    }
    if (seconds > (~(0::u64) - nanoseconds::u64) / 1000000000) {
        ret ~(0::u64);
    }
    ret seconds * 1000000000 + nanoseconds::u64;
}

fun client_object(client: *Client) bool {
    ret memory.range(client::ptr, $size_of(Client));
}

fun dependencies_representable(cache: *dns.Cache,
    connections: *pool.Pool) bool {
    if (!memory.range(cache::ptr, $size_of(dns.Cache))
        || !memory.range(connections::ptr, $size_of(pool.Pool))) { ret false; }
    ret memory.count(cache.entries::ptr, cache.capacity, $size_of(dns.Entry))
        && memory.count(cache.endpoints::ptr, cache.endpoint_capacity,
            $size_of(ip.Endpoint))
        && memory.count(connections.connections::ptr, connections.capacity,
            $size_of(pool.Connection))
        && memory.count(connections.leases::ptr,
            connections.lease_capacity, $size_of(pool.LeaseSlot));
}

fun client_ready(client: *Client) bool {
    if (!client_object(client) || !client.initialized
        || !memory.count(client.slots::ptr, client.capacity,
            $size_of(RequestSlot))
        || !memory.count(client.endpoints::ptr, client.endpoint_capacity,
            $size_of(ip.Endpoint))) { ret false; }
    ret dependencies_representable(client.cache, client.connections);
}

fun region(data: ptr, count: usize, item_size: usize) MemoryRegion {
    if (!memory.count(data, count, item_size) || count == 0) {
        ret MemoryRegion{data: nil, size: 0};
    }
    ret MemoryRegion{data: data, size: count * item_size};
}

fun regions_disjoint(regions: *MemoryRegion, count: usize) bool {
    if (regions == nil || count == 0) { ret false; }
    var i: usize = 0;
    for (i < count) {
        if (regions[i].data == nil || regions[i].size == 0) { ret false; }
        var j: usize = i + 1;
        for (j < count) {
            if (memory.overlap(regions[i].data, regions[i].size,
                regions[j].data, regions[j].size)) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

fun overlaps_client(client: *Client, value: ptr, size: usize) bool {
    ret memory.overlap(value, size, client::ptr, $size_of(Client))
        || memory.overlap(value, size, client.slots::ptr,
            client.capacity * $size_of(RequestSlot))
        || memory.overlap(value, size, client.endpoints::ptr,
            client.endpoint_capacity * $size_of(ip.Endpoint))
        || memory.overlap(value, size, client.cache::ptr,
            $size_of(dns.Cache))
        || memory.overlap(value, size, client.cache.entries::ptr,
            client.cache.capacity * $size_of(dns.Entry))
        || memory.overlap(value, size, client.cache.endpoints::ptr,
            client.cache.endpoint_capacity * $size_of(ip.Endpoint))
        || memory.overlap(value, size, client.connections::ptr,
            $size_of(pool.Pool))
        || memory.overlap(value, size,
            client.connections.connections::ptr,
            client.connections.capacity * $size_of(pool.Connection))
        || memory.overlap(value, size, client.connections.leases::ptr,
            client.connections.lease_capacity * $size_of(pool.LeaseSlot));
}

fun config_valid(configured: Config, capacity: usize,
    endpoint_capacity: usize, cache: *dns.Cache) bool {
    if (capacity == 0 || capacity > 0xffffffff
        || capacity > ~(0::usize) / $size_of(RequestSlot)
        || endpoint_capacity > ~(0::usize) / $size_of(ip.Endpoint)
        || configured.max_requests == 0
        || configured.max_requests > capacity
        || configured.max_endpoints_per_request == 0
        || configured.max_requests > ~(0::usize)
            / configured.max_endpoints_per_request
        || endpoint_capacity < configured.max_requests
            * configured.max_endpoints_per_request) { ret false; }
    ret configured.max_endpoints_per_request
        >= cache.configured.max_endpoints_per_entry;
}

fun clear_route(route: *StoredRoute) {
    route.origin.scheme = 0;
    route.origin.host_len = 0;
    route.origin.port = 0;
    route.proxy.kind = policy.PROXY_NONE;
    route.proxy.host_len = 0;
    route.proxy.port = 0;
    route.proxy.secure = false;
    route.proxy.identity = 0;
    route.proxy.transports = 0;
    var i: usize = 0;
    for (i < 254) {
        route.origin.host[i] = 0;
        route.proxy.host[i] = 0;
        i = i + 1;
    }
}

fun store_route(output: *StoredRoute, value: policy.Route) {
    clear_route(output);
    output.origin.scheme = value.origin.scheme;
    output.origin.host_len = value.origin.host.len;
    output.origin.port = value.origin.port;
    var i: usize = 0;
    for (i < value.origin.host.len) {
        output.origin.host[i] = value.origin.host.data[i];
        i = i + 1;
    }
    output.origin.host[value.origin.host.len] = 0;
    output.proxy.kind = value.proxy.kind;
    output.proxy.host_len = value.proxy.host.len;
    output.proxy.port = value.proxy.port;
    output.proxy.secure = value.proxy.secure;
    output.proxy.identity = value.proxy.identity;
    output.proxy.transports = value.proxy.transports;
    i = 0;
    for (i < value.proxy.host.len) {
        output.proxy.host[i] = value.proxy.host.data[i];
        i = i + 1;
    }
    if (value.proxy.host.len != 0) {
        output.proxy.host[value.proxy.host.len] = 0;
    }
}

fun route_value(stored: *StoredRoute) policy.Route {
    var proxy_host: view.View = view.view(nil, 0);
    if (stored.proxy.host_len != 0) {
        proxy_host = view.view(?stored.proxy.host[0], stored.proxy.host_len);
    }
    ret policy.Route{origin: policy.Origin{scheme: stored.origin.scheme,
        host: view.view(?stored.origin.host[0], stored.origin.host_len),
        port: stored.origin.port}, proxy: policy.Proxy{
            kind: stored.proxy.kind, host: proxy_host,
            port: stored.proxy.port, secure: stored.proxy.secure,
            identity: stored.proxy.identity,
            transports: stored.proxy.transports}};
}

fun clear_slot(client: *Client, index: usize) {
    val slot: *RequestSlot = ?client.slots[index];
    slot.state = STATE_FREE;
    slot.request = nil;
    clear_route(?slot.route);
    slot.protocols = policy.ProtocolPolicy{allowed: 0, prior_knowledge: 0,
        require_alpn: false};
    slot.replay = policy.Replay{explicit: false, body: 0};
    slot.retry_policy = policy.RetryPolicy{max_attempts: 0,
        retry_request_timeout: false, retry_too_early: false,
        retry_rate_limit: false, retry_server: false};
    slot.redirect_policy = policy.RedirectPolicy{max_redirects: 0,
        allow_http_downgrade: false, legacy_post_to_get: false};
    slot.attempts = 0;
    slot.redirects = 0;
    slot.endpoint_len = 0;
    slot.endpoint_cursor = 0;
    slot.pending_dns = empty_dns_token();
    slot.reservation = empty_reservation();
    slot.lease = empty_lease();
    slot.retry_at = time.Time{sec: 0, nsec: 0};
    slot.retry_needs_replay = false;
    slot.last_retry_reason = 0;
    slot.completion = empty_completion();
    val base: usize = index * client.configured.max_endpoints_per_request;
    var i: usize = 0;
    for (i < client.configured.max_endpoints_per_request) {
        client.endpoints[base + i] = empty_endpoint();
        i = i + 1;
    }
}

pub fun init(client: *Client, cache: *dns.Cache, connections: *pool.Pool,
    slots: *RequestSlot, capacity: usize, endpoints: *ip.Endpoint,
    endpoint_capacity: usize, configured: Config) bool {
    if (!client_object(client)
        || !memory.range(cache::ptr, $size_of(dns.Cache))
        || !memory.range(connections::ptr, $size_of(pool.Pool))
        || !memory.count(slots::ptr, capacity, $size_of(RequestSlot))
        || !memory.count(endpoints::ptr, endpoint_capacity,
            $size_of(ip.Endpoint))) { ret false; }
    if (client.initialized || !cache.initialized || !connections.initialized
        || !dependencies_representable(cache, connections)
        || !config_valid(configured, capacity, endpoint_capacity, cache)) {
        ret false;
    }
    val dns_state: dns.Snapshot = dns.snapshot(cache);
    val pool_state: pool.Snapshot = pool.snapshot(connections);
    if (!dns_state.accepting || !pool_state.accepting) { ret false; }
    var regions: [9]MemoryRegion;
    regions[0] = region(client::ptr, 1, $size_of(Client));
    regions[1] = region(slots::ptr, capacity, $size_of(RequestSlot));
    regions[2] = region(endpoints::ptr, endpoint_capacity,
        $size_of(ip.Endpoint));
    regions[3] = region(cache::ptr, 1, $size_of(dns.Cache));
    regions[4] = region(cache.entries::ptr, cache.capacity,
        $size_of(dns.Entry));
    regions[5] = region(cache.endpoints::ptr, cache.endpoint_capacity,
        $size_of(ip.Endpoint));
    regions[6] = region(connections::ptr, 1, $size_of(pool.Pool));
    regions[7] = region(connections.connections::ptr, connections.capacity,
        $size_of(pool.Connection));
    regions[8] = region(connections.leases::ptr,
        connections.lease_capacity, $size_of(pool.LeaseSlot));
    if (!regions_disjoint(?regions[0], 9)) { ret false; }
    client.cache = cache;
    client.connections = connections;
    client.slots = slots;
    client.capacity = configured.max_requests;
    client.endpoints = endpoints;
    client.endpoint_capacity = endpoint_capacity;
    client.configured = configured;
    client.next_slot = 0;
    client.live_requests = 0;
    client.accepting = true;
    client.dependencies_draining = false;
    var i: usize = 0;
    for (i < client.capacity) {
        slots[i].generation = 0;
        clear_slot(client, i);
        i = i + 1;
    }
    client.initialized = true;
    ret true;
}

fun slot_for(client: *Client, token: Token) *RequestSlot {
    if (token.generation == 0 || token.index::usize >= client.capacity) {
        ret nil;
    }
    val slot: *RequestSlot = ?client.slots[token.index::usize];
    if (slot.state == STATE_FREE || slot.generation != token.generation) {
        ret nil;
    }
    ret slot;
}

fun claim(client: *Client, token: *Token) *RequestSlot {
    if (client.live_requests >= client.configured.max_requests || token == nil) {
        ret nil;
    }
    var checked: usize = 0;
    for (checked < client.capacity) {
        val index: usize = client.next_slot;
        client.next_slot = (client.next_slot + 1) % client.capacity;
        val slot: *RequestSlot = ?client.slots[index];
        if (slot.state == STATE_FREE && slot.generation != 0xffffffff) {
            slot.generation = slot.generation + 1;
            token.index = index::u32;
            token.generation = slot.generation;
            slot.state = STATE_ROUTING;
            client.live_requests = client.live_requests + 1;
            ret slot;
        }
        checked = checked + 1;
    }
    ret nil;
}

fun view_aliases(client: *Client, value: view.View) bool {
    ret value.len != 0 && overlaps_client(client, value.data::ptr, value.len);
}

fun fields_storage_representable(fields: *field.Fields) bool {
    if (!memory.range(fields::ptr, $size_of(field.Fields))
        || fields.len > fields.capacity
        || !memory.count(fields.items::ptr, fields.capacity,
            $size_of(field.Field))) { ret false; }
    ret true;
}

fun fields_representable(fields: *field.Fields) bool {
    if (!fields_storage_representable(fields)) { ret false; }
    var i: usize = 0;
    for (i < fields.len) {
        if (!memory.borrowed(fields.items[i].name)
            || !memory.borrowed(fields.items[i].value)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun reader_representable(reader: *body.Reader) bool {
    if (!memory.range(reader::ptr, $size_of(body.Reader))) { ret false; }
    ret (reader.ctx == nil || memory.range(reader.ctx, 1))
        && (reader.scope == nil || memory.range(reader.scope::ptr,
            $size_of(cancellation.Scope)))
        && (reader.trailers == nil || memory.range(reader.trailers::ptr,
            $size_of(field.Fields)));
}

fun writer_representable(writer: *body.Writer) bool {
    if (!memory.range(writer::ptr, $size_of(body.Writer))) { ret false; }
    ret (writer.ctx == nil || memory.range(writer.ctx, 1))
        && (writer.scope == nil || memory.range(writer.scope::ptr,
            $size_of(cancellation.Scope)))
        && (writer.trailers == nil || memory.range(writer.trailers::ptr,
            $size_of(field.Fields)));
}

fun request_representable(request: *message.Request) bool {
    if (!memory.range(request::ptr, $size_of(message.Request))) { ret false; }
    if (!reader_representable(request.body)
        || !memory.borrowed(request.method.token)
        || !memory.borrowed(request.target.raw)
        || !memory.borrowed(request.target.scheme)
        || !memory.borrowed(request.target.authority)
        || !memory.borrowed(request.target.path)
        || !memory.borrowed(request.target.query)
        || !memory.borrowed(request.metadata.peer.address)
        || !memory.borrowed(request.metadata.local.address)
        || !fields_representable(?request.fields)
        || !fields_representable(?request.trailers)) { ret false; }
    ret true;
}

fun request_storage_representable(request: *message.Request) bool {
    if (!memory.range(request::ptr, $size_of(message.Request))) { ret false; }
    if (!memory.range(request.body::ptr, $size_of(body.Reader))
        || !memory.borrowed(request.method.token)
        || !memory.borrowed(request.target.raw)
        || !memory.borrowed(request.target.scheme)
        || !memory.borrowed(request.target.authority)
        || !memory.borrowed(request.target.path)
        || !memory.borrowed(request.target.query)
        || !memory.borrowed(request.metadata.peer.address)
        || !memory.borrowed(request.metadata.local.address)
        || !fields_storage_representable(?request.fields)
        || !fields_storage_representable(?request.trailers)) { ret false; }
    ret true;
}

fun route_representable(route: policy.Route) bool {
    ret memory.borrowed(route.origin.host)
        && memory.borrowed(route.proxy.host);
}

fun request_aliases(client: *Client, request: *message.Request,
    allowed_scope: *cancellation.Scope) bool {
    if (overlaps_client(client, request::ptr, $size_of(message.Request))
        || reader_alias(client, request.body, allowed_scope)
        || view_aliases(client, request.method.token)
        || view_aliases(client, request.target.raw)
        || view_aliases(client, request.target.scheme)
        || view_aliases(client, request.target.authority)
        || view_aliases(client, request.target.path)
        || view_aliases(client, request.target.query)
        || view_aliases(client, request.metadata.peer.address)
        || view_aliases(client, request.metadata.local.address)) { ret true; }
    if (request.fields.capacity > ~(0::usize) / $size_of(field.Field)
        || request.trailers.capacity > ~(0::usize) / $size_of(field.Field)
        || overlaps_client(client, request.fields.items::ptr,
            request.fields.capacity * $size_of(field.Field))
        || overlaps_client(client, request.trailers.items::ptr,
            request.trailers.capacity * $size_of(field.Field))) { ret true; }
    var i: usize = 0;
    for (i < request.fields.len) {
        if (view_aliases(client, request.fields.items[i].name)
            || view_aliases(client, request.fields.items[i].value)) { ret true; }
        i = i + 1;
    }
    i = 0;
    for (i < request.trailers.len) {
        if (view_aliases(client, request.trailers.items[i].name)
            || view_aliases(client, request.trailers.items[i].value)) {
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun fields_alias(client: *Client, fields: *field.Fields) bool {
    if (fields == nil
        || !memory.range(fields::ptr, $size_of(field.Fields))
        || overlaps_client(client, fields::ptr, $size_of(field.Fields))
        || !fields_storage_representable(fields)
        || overlaps_client(client, fields.items::ptr,
            fields.capacity * $size_of(field.Field))) { ret true; }
    var i: usize = 0;
    for (i < fields.len) {
        if (view_aliases(client, fields.items[i].name)
            || view_aliases(client, fields.items[i].value)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun reader_alias(client: *Client, reader: *body.Reader,
    allowed_scope: *cancellation.Scope) bool {
    ret reader != nil
        && (!memory.range(reader::ptr, $size_of(body.Reader))
            || overlaps_client(client, reader::ptr, $size_of(body.Reader))
            || overlaps_client(client, reader.ctx, 1)
            || (reader.scope != allowed_scope
                && overlaps_client(client, reader.scope::ptr,
                    $size_of(cancellation.Scope)))
            || (reader.trailers != nil
                && fields_alias(client, reader.trailers)));
}

fun writer_alias(client: *Client, writer: *body.Writer,
    allowed_scope: *cancellation.Scope) bool {
    ret writer != nil
        && (!memory.range(writer::ptr, $size_of(body.Writer))
            || overlaps_client(client, writer::ptr, $size_of(body.Writer))
            || overlaps_client(client, writer.ctx, 1)
            || (writer.scope != allowed_scope
                && overlaps_client(client, writer.scope::ptr,
                    $size_of(cancellation.Scope)))
            || (writer.trailers != nil
                && fields_alias(client, writer.trailers)));
}

fun response_aliases(client: *Client, response: *message.Response,
    allowed_scope: *cancellation.Scope) bool {
    if (overlaps_client(client, response::ptr, $size_of(message.Response))
        || fields_alias(client, ?response.fields)
        || fields_alias(client, ?response.trailers)) { ret true; }
    if (response.body_kind == message.BODY_READER) {
        ret reader_alias(client, response.body_reader, allowed_scope);
    }
    if (response.body_kind == message.BODY_WRITER) {
        ret writer_alias(client, response.body_writer, allowed_scope);
    }
    ret false;
}

fun response_representable(response: *message.Response) bool {
    if (!memory.range(response::ptr, $size_of(message.Response))
        || !fields_representable(?response.fields)
        || !fields_representable(?response.trailers)) { ret false; }
    if (response.body_kind == message.BODY_READER) {
        ret reader_representable(response.body_reader);
    }
    if (response.body_kind == message.BODY_WRITER) {
        ret writer_representable(response.body_writer);
    }
    ret true;
}

fun response_storage_representable(response: *message.Response) bool {
    if (!memory.range(response::ptr, $size_of(message.Response))
        || !fields_storage_representable(?response.fields)
        || !fields_storage_representable(?response.trailers)) { ret false; }
    if (response.body_kind == message.BODY_READER) {
        ret memory.range(response.body_reader::ptr, $size_of(body.Reader));
    }
    if (response.body_kind == message.BODY_WRITER) {
        ret memory.range(response.body_writer::ptr, $size_of(body.Writer));
    }
    ret true;
}

fun response_body_collections_representable(
    response: *message.Response) bool {
    if (response.body_kind == message.BODY_READER) {
        ret response.body_reader.trailers == nil
            || fields_representable(response.body_reader.trailers);
    }
    if (response.body_kind == message.BODY_WRITER) {
        ret response.body_writer.trailers == nil
            || fields_representable(response.body_writer.trailers);
    }
    ret true;
}

fun route_aliases(client: *Client, route: policy.Route) bool {
    ret overlaps_client(client, route.origin.host.data::ptr,
        route.origin.host.len)
        || (route.proxy.kind != policy.PROXY_NONE
            && overlaps_client(client, route.proxy.host.data::ptr,
                route.proxy.host.len));
}

fun replay_matches_request(replay: policy.Replay,
    request: *message.Request) bool {
    if (!policy.replay_valid(replay) || request == nil || request.body == nil) {
        ret false;
    }
    if (replay.body == policy.BODY_EMPTY) {
        ret request.body.has_length && request.body.declared_length == 0;
    }
    ret true;
}

fun fold_byte(value: u8) u8 {
    if (value >= 'A' && value <= 'Z') { ret value + 32; }
    ret value;
}

fun view_fold_equal(first: view.View, second: view.View) bool {
    if (first.len != second.len || !memory.borrowed(first)
        || !memory.borrowed(second)) {
        ret false;
    }
    var i: usize = 0;
    for (i < first.len) {
        if (fold_byte(first.data[i]) != fold_byte(second.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun view_at(value: view.View, offset: usize, expected: view.View) bool {
    if (offset > value.len || expected.len > value.len - offset
        || !memory.borrowed(value) || !memory.borrowed(expected)) {
        ret false;
    }
    var i: usize = 0;
    for (i < expected.len) {
        if (value.data[offset + i] != expected.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun parse_authority_port(value: view.View, output: *u16) bool {
    if (value.len == 0 || !memory.borrowed(value)
        || !memory.range(output::ptr, $size_of(u16))) { ret false; }
    var parsed: u32 = 0;
    var i: usize = 0;
    for (i < value.len) {
        val byte: u8 = value.data[i];
        if (byte < '0' || byte > '9') { ret false; }
        val digit: u32 = (byte - '0')::u32;
        if (parsed > (65535 - digit) / 10) { ret false; }
        parsed = parsed * 10 + digit;
        i = i + 1;
    }
    if (parsed == 0) { ret false; }
    @output = parsed::u16;
    ret true;
}

fun authority_matches(value: view.View, origin: policy.Origin) bool {
    if (value.len == 0 || !memory.borrowed(value)
        || !memory.borrowed(origin.host)
        || !policy.origin_valid(origin, 253)) { ret false; }
    var host: view.View;
    var port: u16 = 0;
    var explicit_port: bool = false;
    if (value.data[0] == '[') {
        var close: usize = 1;
        for (close < value.len && value.data[close] != ']') {
            close = close + 1;
        }
        if (close == value.len || close == 1) { ret false; }
        host = view.view(?value.data[1], close - 1);
        if (!policy.ipv6_valid(host)) { ret false; }
        if (close + 1 < value.len) {
            if (value.data[close + 1] != ':' || close + 2 >= value.len
                || !parse_authority_port(view.view(?value.data[close + 2],
                    value.len - close - 2), ?port)) { ret false; }
            explicit_port = true;
        } or (close + 1 != value.len) { ret false; }
    } or {
        var colon: usize = value.len;
        var i: usize = 0;
        for (i < value.len) {
            if (value.data[i] == ':') {
                if (colon != value.len) { ret false; }
                colon = i;
            }
            i = i + 1;
        }
        host = view.view(value.data, colon);
        if (colon != value.len) {
            if (colon == 0 || colon + 1 >= value.len
                || !parse_authority_port(view.view(?value.data[colon + 1],
                    value.len - colon - 1), ?port)) { ret false; }
            explicit_port = true;
        }
    }
    if (!view_fold_equal(host, origin.host)) { ret false; }
    if (explicit_port) { ret port == origin.port; }
    if (origin.scheme == policy.HTTP) { ret origin.port == 80; }
    ret origin.scheme == policy.HTTPS && origin.port == 443;
}

fun scheme_matches(value: view.View, scheme: policy.Scheme) bool {
    if (scheme == policy.HTTP) {
        ret view_fold_equal(value, view.view("http", 4));
    }
    if (scheme == policy.HTTPS) {
        ret view_fold_equal(value, view.view("https", 5));
    }
    ret false;
}

fun authority_has_port(value: view.View) bool {
    if (value.len == 0 || !memory.borrowed(value)) { ret false; }
    if (value.data[0] == '[') {
        var close: usize = 1;
        for (close < value.len && value.data[close] != ']') {
            close = close + 1;
        }
        ret close < value.len && close + 1 < value.len
            && value.data[close + 1] == ':';
    }
    var i: usize = 0;
    for (i < value.len) {
        if (value.data[i] == ':') { ret true; }
        i = i + 1;
    }
    ret false;
}

fun target_consistent(value: target.Target) bool {
    if (value.raw.data == nil || value.raw.len == 0) { ret false; }
    if (value.form == target.ASTERISK) {
        ret value.raw.len == 1 && value.raw.data[0] == '*';
    }
    if (value.form == target.AUTHORITY) {
        ret value.raw.len == value.authority.len
            && view_at(value.raw, 0, value.authority);
    }
    var offset: usize = 0;
    if (value.form == target.ABSOLUTE) {
        if (!view_at(value.raw, offset, value.scheme)) { ret false; }
        offset = value.scheme.len;
        if (value.raw.len - offset < 3 || value.raw.data[offset] != ':'
            || value.raw.data[offset + 1] != '/'
            || value.raw.data[offset + 2] != '/') { ret false; }
        offset = offset + 3;
        if (!view_at(value.raw, offset, value.authority)) { ret false; }
        offset = offset + value.authority.len;
    } or (value.form != target.ORIGIN) { ret false; }
    if (!view_at(value.raw, offset, value.path)) { ret false; }
    offset = offset + value.path.len;
    if (offset == value.raw.len) { ret value.query.len == 0; }
    if (value.raw.data[offset] != '?') { ret false; }
    offset = offset + 1;
    ret value.query.len == value.raw.len - offset
        && view_at(value.raw, offset, value.query);
}

fun request_route_valid(request: *message.Request,
    route: policy.Route) bool {
    if (request == nil || !target_consistent(request.target)) { ret false; }
    if (request.method.kind == method.CONNECT) {
        if (request.target.form != target.AUTHORITY
            || !authority_has_port(request.target.authority)
            || !authority_matches(request.target.authority, route.origin)) {
            ret false;
        }
    } or (route.proxy.kind == policy.PROXY_HTTP_FORWARD) {
        if (request.target.form != target.ABSOLUTE
            || !scheme_matches(request.target.scheme, route.origin.scheme)
            || !authority_matches(request.target.authority, route.origin)) {
            ret false;
        }
    } or (request.target.form != target.ORIGIN
        && request.target.form != target.ASTERISK) { ret false; }
    var host_count: usize = 0;
    var i: usize = 0;
    for (i < request.fields.len) {
        val item: *field.Field = ?request.fields.items[i];
        if (field.name_equal(item.name, view.view(field.HOST, 4))) {
            host_count = host_count + 1;
            if (host_count != 1 || !authority_matches(item.value,
                route.origin)) { ret false; }
        }
        i = i + 1;
    }
    ret true;
}

fun deadline_matches(request: *message.Request,
    scope: *cancellation.Scope) bool {
    var deadline: time.Time;
    var owner: *cancellation.Scope = nil;
    val has_deadline: bool = cancellation.get_deadline(scope, ?deadline, ?owner);
    if (request.metadata.has_deadline != has_deadline) { ret false; }
    ret !has_deadline || (request.metadata.deadline.sec == deadline.sec
        && request.metadata.deadline.nsec == deadline.nsec);
}

fun submission_deadline_matches(request: *message.Request,
    parent: *cancellation.Scope) bool {
    var parent_deadline: time.Time;
    var owner: *cancellation.Scope = nil;
    val inherited: bool = cancellation.get_deadline(parent,
        ?parent_deadline, ?owner);
    if (!request.metadata.has_deadline) { ret !inherited; }
    if (!inherited
        || time.time_before(request.metadata.deadline, parent_deadline)) {
        ret true;
    }
    ret time.time_equal(request.metadata.deadline, parent_deadline);
}

fun request_scope_matches(request: *message.Request,
    scope: *cancellation.Scope) bool {
    ret request.body.scope == nil || request.body.scope == scope;
}

fun bind_request_scope(request: *message.Request,
    scope: *cancellation.Scope) {
    if (request.body.scope != nil) { request.body.scope = scope; }
}

fun protocol_route_valid(route: policy.Route,
    protocols: policy.ProtocolPolicy) bool {
    if (!policy.protocol_valid(protocols)) { ret false; }
    if (route.origin.scheme == policy.HTTP) {
        if (protocols.prior_knowledge == message.WIRE_H3) { ret false; }
        if ((protocols.allowed & (policy.ALLOW_H1 | policy.ALLOW_H2)) == 0) {
            ret false;
        }
    }
    ret true;
}

pub fun submit(client: *Client, parent: *cancellation.Scope,
    request: *message.Request, route: policy.Route,
    protocols: policy.ProtocolPolicy, replay: policy.Replay,
    retry_policy: policy.RetryPolicy,
    redirect_policy: policy.RedirectPolicy) Submission {
    if (!client_ready(client)
        || !memory.range(parent::ptr, $size_of(cancellation.Scope))
        || !request_storage_representable(request)
        || !route_representable(route)
        || overlaps_client(client, parent::ptr, $size_of(cancellation.Scope))
        || request_aliases(client, request, nil)
        || route_aliases(client, route)
        || !request_representable(request)
        || !request_scope_matches(request, parent)
        || !submission_deadline_matches(request, parent)
        || !message.validate_request(request,
            client.configured.message_limits)
        || !policy.route_valid(route, 253)
        || !request_route_valid(request, route)
        || !protocol_route_valid(route, protocols)
        || !replay_matches_request(replay, request)
        || retry_policy.max_attempts == 0
        || cancellation.reason(parent) != cancellation.ACTIVE) {
        ret Submission{status: SUBMIT_INVALID, token: empty_token()};
    }
    if (!client.accepting) {
        ret Submission{status: SUBMIT_DRAINING, token: empty_token()};
    }
    var token: Token;
    val slot: *RequestSlot = claim(client, ?token);
    if (slot == nil) {
        ret Submission{status: SUBMIT_SATURATED, token: empty_token()};
    }
    slot.request = request;
    store_route(?slot.route, route);
    slot.protocols = protocols;
    slot.replay = replay;
    slot.retry_policy = retry_policy;
    slot.redirect_policy = redirect_policy;
    slot.attempts = 1;
    slot.redirects = 0;
    slot.endpoint_len = 0;
    slot.endpoint_cursor = 0;
    slot.pending_dns = empty_dns_token();
    slot.reservation = empty_reservation();
    slot.lease = empty_lease();
    slot.completion = empty_completion();
    val scope_made: bool = cancellation.make_child(?slot.scope, parent,
        request.metadata.has_deadline, request.metadata.deadline);
    if (!scope_made) {
        clear_slot(client, token.index::usize);
        client.live_requests = client.live_requests - 1;
        ret Submission{status: SUBMIT_INVALID, token: empty_token()};
    }
    bind_request_scope(request, ?slot.scope);
    ret Submission{status: SUBMIT_OK, token: token};
}

fun request_action(kind: ActionKind, token: Token,
    slot: *RequestSlot) Action {
    var result: Action = empty_action();
    result.kind = kind;
    result.token = token;
    result.scope = ?slot.scope;
    result.request = slot.request;
    result.route = route_value(?slot.route);
    result.protocols = slot.protocols;
    ret result;
}

fun set_terminal(slot: *RequestSlot, outcome: Outcome, error: ErrorKind,
    resolver_error: resolver.Error, retry_reason: policy.RetryReason,
    response: *message.Response) {
    slot.completion = Completion{outcome: outcome, error: error,
        resolver_error: resolver_error, retry_reason: retry_reason,
        response: response, attempts: slot.attempts,
        redirects: slot.redirects};
    slot.state = STATE_TERMINAL;
}

fun settle_cancel(slot: *RequestSlot) bool {
    val reason: cancellation.Reason = cancellation.reason(?slot.scope);
    if (reason == cancellation.CANCELLED) {
        set_terminal(slot, OUTCOME_CANCELLED, ERROR_CANCELLED,
            no_resolver_error(), 0, nil);
        ret true;
    }
    if (reason == cancellation.TIMED_OUT) {
        set_terminal(slot, OUTCOME_TIMED_OUT, ERROR_TIMED_OUT,
            no_resolver_error(), 0, nil);
        ret true;
    }
    ret false;
}

fun desired_transport(slot: *RequestSlot) policy.TransportKind {
    if (slot.protocols.prior_knowledge == message.WIRE_H3
        || (slot.protocols.allowed & (policy.ALLOW_H1 | policy.ALLOW_H2)) == 0) {
        ret policy.TRANSPORT_QUIC;
    }
    ret policy.TRANSPORT_TCP;
}

fun endpoint_base(client: *Client, index: usize) *ip.Endpoint {
    ret ?client.endpoints[index
        * client.configured.max_endpoints_per_request];
}

fun dns_key(slot: *RequestSlot,
    transport: policy.TransportKind) dns.Key {
    val route: policy.Route = route_value(?slot.route);
    if (route.proxy.kind != policy.PROXY_NONE) {
        ret dns.Key{host: route.proxy.host, port: route.proxy.port,
            transport: transport};
    }
    ret dns.Key{host: route.origin.host, port: route.origin.port,
        transport: transport};
}

fun endpoint_same(first: ip.Endpoint, second: ip.Endpoint) bool {
    if (first.port != second.port || first.scope != second.scope
        || first.addr.is_v6 != second.addr.is_v6) { ret false; }
    var i: usize = 0;
    if (first.addr.is_v6 == 0) {
        for (i < 4) {
            if (first.addr.v4.octets[i] != second.addr.v4.octets[i]) {
                ret false;
            }
            i = i + 1;
        }
        ret true;
    }
    for (i < 16) {
        if (first.addr.v6.octets[i] != second.addr.v6.octets[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun reservation_equal(first: pool.Reservation,
    second: pool.Reservation) bool {
    ret first.status == second.status
        && pool.connection_equal(first.connection, second.connection)
        && pool.lease_equal(first.lease, second.lease)
        && first.transport == second.transport
        && endpoint_same(first.endpoint, second.endpoint);
}

fun exchange_equal(first: pool.Lease, second: pool.Lease) bool {
    ret pool.lease_equal(first.token, second.token)
        && pool.connection_equal(first.connection, second.connection)
        && first.driver == second.driver && first.wire == second.wire;
}

fun version_for(wire: message.Wire) message.Version {
    if (wire == message.WIRE_H1) { ret message.version_h1(1, 1); }
    if (wire == message.WIRE_H2) { ret message.version_h2(); }
    ret message.version_h3();
}

fun route_next(client: *Client, token: Token, slot: *RequestSlot,
    now: time.Time) Action {
    val route: policy.Route = route_value(?slot.route);
    val acquired: pool.Acquire = pool.acquire(client.connections, route,
        slot.protocols, now);
    if (acquired.status == pool.ACQUIRE_OK) {
        slot.lease = acquired.lease;
        slot.state = STATE_SEND_READY;
        ret empty_action();
    }
    if (acquired.status == pool.ACQUIRE_SATURATED) {
        ret request_action(ACTION_WAIT_POOL, token, slot);
    }
    if (acquired.status == pool.ACQUIRE_DRAINING) {
        set_terminal(slot, OUTCOME_FAILED, ERROR_DRAINING,
            no_resolver_error(), 0, nil);
        ret empty_action();
    }
    if (acquired.status != pool.ACQUIRE_MISS) {
        set_terminal(slot, OUTCOME_FAILED, ERROR_INTERNAL,
            no_resolver_error(), 0, nil);
        ret empty_action();
    }
    val transport: policy.TransportKind = desired_transport(slot);
    if (!policy.proxy_supports(route.proxy, transport)) {
        set_terminal(slot, OUTCOME_FAILED, ERROR_PROTOCOL,
            no_resolver_error(), 0, nil);
        ret empty_action();
    }
    if (slot.endpoint_len == 0) {
        val resolved: dns.Lookup = dns.lookup(client.cache,
            dns_key(slot, transport), now,
            endpoint_base(client, token.index::usize),
            client.configured.max_endpoints_per_request);
        if (resolved.status == dns.LOOKUP_HIT
            || resolved.status == dns.LOOKUP_STALE) {
            slot.endpoint_len = resolved.written;
            slot.endpoint_cursor = 0;
        } or (resolved.status == dns.LOOKUP_QUERY
            || resolved.status == dns.LOOKUP_STALE_QUERY) {
            slot.endpoint_len = resolved.written;
            slot.endpoint_cursor = 0;
            slot.pending_dns = resolved.query.token;
            slot.state = STATE_DNS_PUBLISHED;
            var action: Action = request_action(ACTION_RESOLVE, token, slot);
            action.dns_query = resolved.query;
            ret action;
        } or (resolved.status == dns.LOOKUP_PENDING
            || resolved.status == dns.LOOKUP_SATURATED) {
            ret request_action(ACTION_WAIT_DNS, token, slot);
        } or (resolved.status == dns.LOOKUP_FAILED) {
            val failure: policy.Failure = policy.Failure{
                reason: policy.RETRY_DNS_TEMPORARY,
                definitely_unprocessed: true, response_started: false,
                response_complete: false,
                retry_after_ns: time_until(now, resolved.ready_at)};
            if (!dns.error_temporary(resolved.error)
                || !schedule_retry(slot, failure, now, false)) {
                set_terminal(slot, OUTCOME_FAILED, ERROR_DNS, resolved.error,
                    policy.RETRY_DNS_TEMPORARY, nil);
            }
            ret empty_action();
        } or (resolved.status == dns.LOOKUP_DRAINING) {
            set_terminal(slot, OUTCOME_FAILED, ERROR_DRAINING,
                no_resolver_error(), 0, nil);
            ret empty_action();
        } or {
            set_terminal(slot, OUTCOME_FAILED, ERROR_INTERNAL,
                no_resolver_error(), 0, nil);
            ret empty_action();
        }
    }
    if (slot.endpoint_cursor >= slot.endpoint_len) {
        set_terminal(slot, OUTCOME_FAILED, ERROR_CONNECT,
            no_resolver_error(), policy.RETRY_CONNECT, nil);
        ret empty_action();
    }
    val endpoint: ip.Endpoint = endpoint_base(client,
        token.index::usize)[slot.endpoint_cursor];
    val reserved: pool.Reservation = pool.reserve(client.connections, route,
        endpoint, transport, now);
    if (reserved.status == pool.RESERVE_OK) {
        slot.reservation = reserved;
        slot.state = STATE_CONNECTING;
        var action: Action = request_action(ACTION_CONNECT, token, slot);
        action.reservation = reserved;
        ret action;
    }
    if (reserved.status == pool.RESERVE_SATURATED) {
        ret request_action(ACTION_WAIT_POOL, token, slot);
    }
    if (reserved.status == pool.RESERVE_DRAINING) {
        set_terminal(slot, OUTCOME_FAILED, ERROR_DRAINING,
            no_resolver_error(), 0, nil);
    } or {
        set_terminal(slot, OUTCOME_FAILED, ERROR_INTERNAL,
            no_resolver_error(), 0, nil);
    }
    ret empty_action();
}

pub fun next(client: *Client, token: Token, now: time.Time) Action {
    if (!client_ready(client) || !time_valid(now)) {
        ret empty_action();
    }
    val slot: *RequestSlot = slot_for(client, token);
    if (slot == nil) { ret empty_action(); }
    for (true) {
        if (slot.state != STATE_DNS_PUBLISHED
            && slot.state != STATE_CONNECTING && slot.state != STATE_EXCHANGING
            && slot.state != STATE_TERMINAL && settle_cancel(slot)) {
        } or (slot.state == STATE_TERMINAL) {
            var action: Action = request_action(ACTION_COMPLETE, token, slot);
            action.completion = slot.completion;
            ret action;
        } or (slot.state == STATE_ROUTING) {
            val action: Action = route_next(client, token, slot, now);
            if (action.kind != ACTION_NONE) { ret action; }
        } or (slot.state == STATE_SEND_READY) {
            slot.request.metadata.version = version_for(slot.lease.wire);
            slot.request.metadata.secure
                = slot.route.origin.scheme == policy.HTTPS;
            if (!message.validate_request(slot.request,
                client.configured.message_limits)
                || !deadline_matches(slot.request, ?slot.scope)) {
                pool.release(client.connections, slot.lease,
                    body.REUSE_FORBIDDEN, now);
                set_terminal(slot, OUTCOME_FAILED, ERROR_INTERNAL,
                    no_resolver_error(), 0, nil);
            } or {
                slot.state = STATE_EXCHANGING;
                var action: Action = request_action(ACTION_EXCHANGE,
                    token, slot);
                action.lease = slot.lease;
                ret action;
            }
        } or (slot.state == STATE_RETRY_WAIT) {
            if (!time_before_or_equal(slot.retry_at, now)) {
                var action: Action = request_action(ACTION_WAIT_TIMER,
                    token, slot);
                action.ready_at = slot.retry_at;
                ret action;
            }
            if (slot.retry_needs_replay) {
                slot.state = STATE_REPLAY_READY;
            } or {
                slot.state = STATE_ROUTING;
            }
        } or (slot.state == STATE_REPLAY_READY) {
            slot.state = STATE_REPLAY_PUBLISHED;
            ret request_action(ACTION_REPLAY, token, slot);
        } or (slot.state == STATE_DNS_PUBLISHED) {
            ret request_action(ACTION_WAIT_DNS, token, slot);
        } or {
            ret request_action(ACTION_NONE, token, slot);
        }
    }
    ret empty_action();
}

pub fun resolution_submitted(client: *Client, token: Token,
    resolver_token: resolver.Token) bool {
    if (!client_ready(client)) { ret false; }
    val slot: *RequestSlot = slot_for(client, token);
    if (slot == nil || slot.state != STATE_DNS_PUBLISHED
        || !dns.bind(client.cache, slot.pending_dns, resolver_token)) {
        ret false;
    }
    slot.pending_dns = empty_dns_token();
    slot.state = STATE_ROUTING;
    ret true;
}

pub fun resolution_submit_failed(client: *Client, token: Token,
    failure: resolver.Error, now: time.Time) bool {
    if (!client_ready(client) || !time_valid(now)) { ret false; }
    val slot: *RequestSlot = slot_for(client, token);
    if (slot == nil || slot.state != STATE_DNS_PUBLISHED
        || dns.abandon(client.cache, slot.pending_dns, failure, now)
            != dns.COMPLETE_FAILURE) { ret false; }
    slot.pending_dns = empty_dns_token();
    slot.state = STATE_ROUTING;
    ret true;
}

pub fun complete_resolution(client: *Client,
    completion: *resolver.Completion, now: time.Time) dns.CompleteStatus {
    if (!client_ready(client)
        || !memory.range(completion::ptr, $size_of(resolver.Completion))
        || overlaps_client(client, completion::ptr,
            $size_of(resolver.Completion))) {
        ret dns.COMPLETE_INVALID;
    }
    ret dns.complete_bound(client.cache, completion, now);
}

fun close_untransferred_driver(client: *Client, driver: ptr) bool {
    ret memory.range(driver, 1) && !overlaps_client(client, driver, 1)
        && !pool.driver_owned(client.connections, driver);
}

pub fun connected(client: *Client, token: Token,
    reservation: pool.Reservation, secure: bool, negotiated: view.View,
    driver: ptr, max_streams: usize, now: time.Time) Connected {
    if (!client_ready(client)) {
        ret Connected{status: CONNECT_INVALID, close_driver: false};
    }
    if (!memory.range(driver, 1) || !memory.borrowed(negotiated)
        || !time_valid(now) || overlaps_client(client, driver, 1)
        || pool.driver_owned(client.connections, driver)) {
        ret Connected{status: CONNECT_INVALID,
            close_driver: close_untransferred_driver(client, driver)};
    }
    val slot: *RequestSlot = slot_for(client, token);
    if (slot == nil || slot.state != STATE_CONNECTING
        || !reservation_equal(slot.reservation, reservation)) {
        ret Connected{status: CONNECT_INVALID,
            close_driver: close_untransferred_driver(client, driver)};
    }
    if (settle_cancel(slot)) {
        if (!pool.fail_connect(client.connections, reservation)) {
            set_terminal(slot, OUTCOME_FAILED, ERROR_INTERNAL,
                no_resolver_error(), 0, nil);
            ret Connected{status: CONNECT_INVALID,
                close_driver: close_untransferred_driver(client, driver)};
        }
        slot.reservation = empty_reservation();
        ret Connected{status: CONNECT_CANCELLED,
            close_driver: close_untransferred_driver(client, driver)};
    }
    if (secure != (slot.route.origin.scheme == policy.HTTPS)) {
        pool.fail_connect(client.connections, reservation);
        set_terminal(slot, OUTCOME_FAILED, ERROR_PROTOCOL,
            no_resolver_error(), 0, nil);
        ret Connected{status: CONNECT_REJECTED,
            close_driver: close_untransferred_driver(client, driver)};
    }
    val selected: policy.Selection = policy.select(slot.protocols, secure,
        reservation.transport, negotiated);
    if (selected.status != policy.SELECT_OK) {
        pool.fail_connect(client.connections, reservation);
        set_terminal(slot, OUTCOME_FAILED, ERROR_PROTOCOL,
            no_resolver_error(), 0, nil);
        ret Connected{status: CONNECT_REJECTED,
            close_driver: close_untransferred_driver(client, driver)};
    }
    val activated: pool.Activated = pool.activate(client.connections,
        reservation, selected.wire, driver, max_streams, now);
    if (activated.status == pool.ACTIVATE_OK) {
        slot.lease = activated.lease;
        slot.reservation = empty_reservation();
        slot.state = STATE_SEND_READY;
        ret Connected{status: CONNECT_ACCEPTED, close_driver: false};
    }
    if (activated.status == pool.ACTIVATE_WAIT) {
        slot.reservation = empty_reservation();
        slot.state = STATE_ROUTING;
        ret Connected{status: CONNECT_ACCEPTED, close_driver: false};
    }
    if (activated.status == pool.ACTIVATE_CLOSE) {
        slot.reservation = empty_reservation();
        set_terminal(slot, OUTCOME_FAILED, ERROR_DRAINING,
            no_resolver_error(), 0, nil);
        ret Connected{status: CONNECT_DRAINED, close_driver: false};
    }
    pool.fail_connect(client.connections, reservation);
    set_terminal(slot, OUTCOME_FAILED, ERROR_INTERNAL,
        no_resolver_error(), 0, nil);
    ret Connected{status: CONNECT_REJECTED,
        close_driver: close_untransferred_driver(client, driver)};
}

fun schedule_retry(slot: *RequestSlot, failure: policy.Failure,
    now: time.Time, needs_replay: bool) bool {
    val decision: policy.RetryDecision = policy.retry(slot.retry_policy,
        slot.replay, failure, slot.attempts);
    if (decision.status != policy.RETRY_ALLOWED) { ret false; }
    slot.attempts = slot.attempts + 1;
    slot.retry_at = time_add(now, decision.delay_ns);
    slot.retry_needs_replay = needs_replay;
    slot.last_retry_reason = failure.reason;
    slot.endpoint_cursor = 0;
    slot.state = STATE_RETRY_WAIT;
    ret true;
}

pub fun connect_failed(client: *Client, token: Token,
    reservation: pool.Reservation, failure: policy.Failure,
    now: time.Time) ConnectStatus {
    if (!client_ready(client) || !time_valid(now)
        || failure.reason != policy.RETRY_CONNECT
        || !failure.definitely_unprocessed || failure.response_started
        || failure.response_complete
        || !policy.failure_valid(failure)) { ret CONNECT_INVALID; }
    val slot: *RequestSlot = slot_for(client, token);
    if (slot == nil || slot.state != STATE_CONNECTING
        || !reservation_equal(slot.reservation, reservation)
        || !pool.fail_connect(client.connections, reservation)) {
        ret CONNECT_INVALID;
    }
    slot.reservation = empty_reservation();
    if (settle_cancel(slot)) { ret CONNECT_CANCELLED; }
    slot.endpoint_cursor = slot.endpoint_cursor + 1;
    if (slot.endpoint_cursor < slot.endpoint_len) {
        slot.state = STATE_ROUTING;
        ret CONNECT_RETRY;
    }
    if (schedule_retry(slot, failure, now, false)) { ret CONNECT_RETRY; }
    set_terminal(slot, OUTCOME_FAILED, ERROR_CONNECT,
        no_resolver_error(), failure.reason, nil);
    ret CONNECT_REJECTED;
}

fun release_exchange(client: *Client, slot: *RequestSlot,
    reuse: body.Reuse, now: time.Time) bool {
    val released: pool.ReleaseStatus = pool.release(client.connections,
        slot.lease, reuse, now);
    if (released != pool.RELEASE_OK && released != pool.RELEASE_CLOSE) {
        ret false;
    }
    slot.lease = empty_lease();
    ret true;
}

fun response_terminal(response: *message.Response) bool {
    if (response.body_kind == message.BODY_NONE) { ret true; }
    if (response.body_kind == message.BODY_READER) {
        ret body.reader_terminal_state(response.body_reader);
    }
    if (response.body_kind == message.BODY_WRITER) {
        ret body.writer_terminal_state(response.body_writer);
    }
    ret false;
}

fun response_progress(response: *message.Response) body.Progress {
    if (response.body_kind == message.BODY_NONE) {
        ret body.complete(body.REUSE_ALLOWED);
    }
    if (response.body_kind == message.BODY_READER) {
        ret body.reader_result(response.body_reader);
    }
    ret body.writer_result(response.body_writer);
}

fun combine_reuse(request_reuse: body.Reuse,
    response_reuse: body.Reuse) body.Reuse {
    if (request_reuse == body.REUSE_FORBIDDEN
        || response_reuse == body.REUSE_FORBIDDEN) {
        ret body.REUSE_FORBIDDEN;
    }
    if (request_reuse == body.REUSE_ALLOWED
        && response_reuse == body.REUSE_ALLOWED) {
        ret body.REUSE_ALLOWED;
    }
    ret body.REUSE_UNKNOWN;
}

fun exchange_reuse(slot: *RequestSlot, exchange: pool.Lease,
    response: *message.Response, request_result: body.Progress,
    response_result: body.Progress) body.Reuse {
    if (response.status == status.SWITCHING_PROTOCOLS
        || (exchange.wire == message.WIRE_H1
            && slot.request.method.kind == method.CONNECT
            && response.status >= 200 && response.status < 300)) {
        ret body.REUSE_FORBIDDEN;
    }
    ret combine_reuse(request_result.reuse, response_result.reuse);
}

fun settle_body_results(slot: *RequestSlot, request_result: body.Progress,
    response_result: body.Progress, response: *message.Response,
    retry_reason: policy.RetryReason) bool {
    if (request_result.status == body.TIMED_OUT
        || response_result.status == body.TIMED_OUT) {
        set_terminal(slot, OUTCOME_TIMED_OUT, ERROR_TIMED_OUT,
            no_resolver_error(), retry_reason, response);
        ret true;
    }
    if (request_result.status == body.CANCELLED
        || response_result.status == body.CANCELLED) {
        set_terminal(slot, OUTCOME_CANCELLED, ERROR_CANCELLED,
            no_resolver_error(), retry_reason, response);
        ret true;
    }
    if (request_result.status == body.ERROR
        || request_result.status == body.LIMIT_REACHED) {
        set_terminal(slot, OUTCOME_FAILED, ERROR_TRANSPORT,
            no_resolver_error(), retry_reason, response);
        ret true;
    }
    if (response_result.status == body.ERROR
        || response_result.status == body.LIMIT_REACHED) {
        set_terminal(slot, OUTCOME_FAILED, ERROR_RESPONSE,
            no_resolver_error(), retry_reason, response);
        ret true;
    }
    ret false;
}

fun exchange_failure_matches(wire: message.Wire,
    failure: policy.Failure) bool {
    if (failure.reason == policy.RETRY_TRANSPORT) { ret true; }
    if (failure.reason == policy.RETRY_REFUSED_STREAM
        || failure.reason == policy.RETRY_GOAWAY) {
        ret wire == message.WIRE_H2 || wire == message.WIRE_H3;
    }
    ret false;
}

pub fun exchange_complete(client: *Client, token: Token, exchange: pool.Lease,
    response: *message.Response, reuse: body.Reuse,
    now: time.Time) bool {
    if (!client_ready(client) || !response_storage_representable(response)
        || !time_valid(now)
        || (reuse != body.REUSE_ALLOWED && reuse != body.REUSE_FORBIDDEN)) {
        ret false;
    }
    val slot: *RequestSlot = slot_for(client, token);
    if (slot == nil || slot.state != STATE_EXCHANGING
        || !exchange_equal(slot.lease, exchange)
        || response_aliases(client, response, ?slot.scope)
        || !response_representable(response)
        || !response_body_collections_representable(response)
        || !body.reader_terminal_state(slot.request.body)
        || !response_terminal(response)) { ret false; }
    val request_result: body.Progress = body.reader_result(slot.request.body);
    val response_result: body.Progress = response_progress(response);
    val expected_reuse: body.Reuse = exchange_reuse(slot, exchange, response,
        request_result, response_result);
    if (expected_reuse == body.REUSE_UNKNOWN || reuse != expected_reuse) {
        ret false;
    }
    val valid: bool = response.generation == slot.request.generation
        && message.validate_committed_response(response,
            slot.request.method.kind, client.configured.message_limits);
    var connection_reuse: body.Reuse = body.REUSE_FORBIDDEN;
    if (valid) { connection_reuse = reuse; }
    val released: bool = release_exchange(client, slot, connection_reuse, now);
    if (!released) { ret false; }
    if (settle_cancel(slot)) { ret true; }
    if (settle_body_results(slot, request_result, response_result, response,
        0)) { ret true; }
    if (!valid) {
        set_terminal(slot, OUTCOME_FAILED, ERROR_RESPONSE,
            no_resolver_error(), 0, response);
        ret true;
    }
    set_terminal(slot, OUTCOME_OK, ERROR_NONE, no_resolver_error(), 0,
        response);
    ret true;
}

fun response_failure_matches(response: *message.Response,
    failure: policy.Failure) bool {
    if (failure.reason == policy.RETRY_REQUEST_TIMEOUT) {
        ret response.status == status.REQUEST_TIMEOUT;
    }
    if (failure.reason == policy.RETRY_TOO_EARLY) {
        ret response.status == status.TOO_EARLY;
    }
    if (failure.reason == policy.RETRY_RATE_LIMIT) {
        ret response.status == status.TOO_MANY_REQUESTS;
    }
    ret failure.reason == policy.RETRY_SERVER
        && response.status >= 500 && response.status <= 599;
}

pub fun exchange_response_retry(client: *Client, token: Token,
    exchange: pool.Lease, response: *message.Response, reuse: body.Reuse,
    failure: policy.Failure, now: time.Time) ExchangeResponseStatus {
    if (!client_ready(client) || !response_storage_representable(response)
        || !time_valid(now)
        || (reuse != body.REUSE_ALLOWED && reuse != body.REUSE_FORBIDDEN)
        || !policy.failure_valid(failure)
        || !policy.response_retry_reason(failure.reason)) {
        ret EXCHANGE_RESPONSE_INVALID;
    }
    val slot: *RequestSlot = slot_for(client, token);
    if (slot == nil || slot.state != STATE_EXCHANGING
        || !exchange_equal(slot.lease, exchange)
        || response_aliases(client, response, ?slot.scope)
        || !response_representable(response)
        || !response_body_collections_representable(response)
        || response.generation != slot.request.generation
        || !message.validate_committed_response(response,
            slot.request.method.kind, client.configured.message_limits)
        || !response_failure_matches(response, failure)
        || !body.reader_terminal_state(slot.request.body)
        || !response_terminal(response)) { ret EXCHANGE_RESPONSE_INVALID; }
    val request_result: body.Progress = body.reader_result(slot.request.body);
    val response_result: body.Progress = response_progress(response);
    val expected_reuse: body.Reuse = exchange_reuse(slot, exchange, response,
        request_result, response_result);
    if (expected_reuse == body.REUSE_UNKNOWN || reuse != expected_reuse) {
        ret EXCHANGE_RESPONSE_INVALID;
    }
    val decision: policy.RetryDecision = policy.retry(slot.retry_policy,
        slot.replay, failure, slot.attempts);
    if (decision.status == policy.RETRY_INVALID
        || !release_exchange(client, slot, reuse, now)) {
        ret EXCHANGE_RESPONSE_INVALID;
    }
    if (settle_cancel(slot)) { ret EXCHANGE_RESPONSE_CANCELLED; }
    if (settle_body_results(slot, request_result, response_result, response,
        failure.reason)) {
        if (slot.completion.outcome == OUTCOME_CANCELLED) {
            ret EXCHANGE_RESPONSE_CANCELLED;
        }
        ret EXCHANGE_RESPONSE_COMPLETE;
    }
    if (decision.status == policy.RETRY_ALLOWED) {
        if (!schedule_retry(slot, failure, now, true)) {
            set_terminal(slot, OUTCOME_FAILED, ERROR_INTERNAL,
                no_resolver_error(), failure.reason, nil);
            ret EXCHANGE_RESPONSE_INVALID;
        }
        ret EXCHANGE_RESPONSE_RETRY;
    }
    set_terminal(slot, OUTCOME_OK, ERROR_NONE, no_resolver_error(),
        failure.reason, response);
    ret EXCHANGE_RESPONSE_COMPLETE;
}

pub fun exchange_failed(client: *Client, token: Token, exchange: pool.Lease,
    failure: policy.Failure, now: time.Time) bool {
    if (!client_ready(client) || !time_valid(now)
        || !policy.failure_valid(failure)
        || policy.response_retry_reason(failure.reason)) { ret false; }
    val slot: *RequestSlot = slot_for(client, token);
    if (slot == nil || slot.state != STATE_EXCHANGING
        || !exchange_equal(slot.lease, exchange)
        || !exchange_failure_matches(exchange.wire, failure)
        || !body.reader_terminal_state(slot.request.body)) { ret false; }
    val request_result: body.Progress = body.reader_result(slot.request.body);
    val decision: policy.RetryDecision = policy.retry(slot.retry_policy,
        slot.replay, failure, slot.attempts);
    if (decision.status == policy.RETRY_INVALID
        || !release_exchange(client, slot, body.REUSE_FORBIDDEN, now)) { ret false; }
    if (settle_cancel(slot)) { ret true; }
    val no_response: body.Progress = body.complete(body.REUSE_ALLOWED);
    if (settle_body_results(slot, request_result, no_response, nil,
        failure.reason)) { ret true; }
    if (decision.status == policy.RETRY_ALLOWED) {
        if (!schedule_retry(slot, failure, now, true)) {
            set_terminal(slot, OUTCOME_FAILED, ERROR_INTERNAL,
                no_resolver_error(), failure.reason, nil);
        }
        ret true;
    }
    set_terminal(slot, OUTCOME_FAILED, ERROR_TRANSPORT,
        no_resolver_error(), failure.reason, nil);
    ret true;
}

fun views_equal(first: view.View, second: view.View) bool {
    if (first.len != second.len || !memory.borrowed(first)
        || !memory.borrowed(second)) {
        ret false;
    }
    var i: usize = 0;
    for (i < first.len) {
        if (first.data[i] != second.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun methods_equal(first: method.Method, second: method.Method) bool {
    ret first.kind == second.kind && views_equal(first.token, second.token);
}

pub fun replay_ready(client: *Client, token: Token,
    request: *message.Request) bool {
    if (!client_ready(client)
        || !request_storage_representable(request)) { ret false; }
    val slot: *RequestSlot = slot_for(client, token);
    if (slot == nil || slot.state != STATE_REPLAY_PUBLISHED
        || request.generation == slot.request.generation
        || request_aliases(client, request, ?slot.scope)
        || !request_representable(request)
        || !methods_equal(request.method, slot.request.method)
        || !views_equal(request.target.raw, slot.request.target.raw)
        || !message.validate_request(request, client.configured.message_limits)
        || !request_route_valid(request, route_value(?slot.route))
        || !replay_matches_request(slot.replay, request)
        || !deadline_matches(request, ?slot.scope)
        || !request_scope_matches(request, ?slot.scope)) { ret false; }
    bind_request_scope(request, ?slot.scope);
    slot.request = request;
    slot.state = STATE_ROUTING;
    ret true;
}

fun forbidden_redirect_field_set(fields: *field.Fields,
    strip_origin: bool, strip_proxy: bool) bool {
    var i: usize = 0;
    for (i < fields.len) {
        val item: *field.Field = ?fields.items[i];
        if (strip_origin && (item.sensitive
            || field.name_equal(item.name, view.view(field.AUTHORIZATION, 13))
            || field.name_equal(item.name, view.view(field.COOKIE, 6)))) {
            ret true;
        }
        if (strip_proxy && field.name_equal(item.name,
            view.view(field.PROXY_AUTHORIZATION, 19))) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun forbidden_redirect_fields(request: *message.Request,
    strip_origin: bool, strip_proxy: bool) bool {
    ret forbidden_redirect_field_set(?request.fields, strip_origin, strip_proxy)
        || forbidden_redirect_field_set(?request.trailers,
            strip_origin, strip_proxy);
}

pub fun follow_redirect(client: *Client, token: Token, exchange: pool.Lease,
    response: *message.Response, reuse: body.Reuse,
    target_route: policy.Route, next_request: *message.Request,
    now: time.Time) policy.RedirectStatus {
    if (!client_ready(client) || !response_storage_representable(response)
        || !request_storage_representable(next_request)
        || !route_representable(target_route) || !time_valid(now)
        || (reuse != body.REUSE_ALLOWED && reuse != body.REUSE_FORBIDDEN)) {
        ret policy.REDIRECT_INVALID;
    }
    val slot: *RequestSlot = slot_for(client, token);
    if (slot == nil || slot.state != STATE_EXCHANGING
        || !exchange_equal(slot.lease, exchange)
        || response_aliases(client, response, ?slot.scope)
        || !response_representable(response)
        || !response_body_collections_representable(response)
        || response.generation != slot.request.generation
        || !message.validate_committed_response(response,
            slot.request.method.kind, client.configured.message_limits)
        || !body.reader_terminal_state(slot.request.body)
        || !response_terminal(response)) {
        ret policy.REDIRECT_INVALID;
    }
    val request_result: body.Progress = body.reader_result(slot.request.body);
    val response_result: body.Progress = response_progress(response);
    val expected_reuse: body.Reuse = exchange_reuse(slot, exchange, response,
        request_result, response_result);
    if (expected_reuse == body.REUSE_UNKNOWN || reuse != expected_reuse) {
        ret policy.REDIRECT_INVALID;
    }
    val decision: policy.Redirect = policy.redirect(slot.redirect_policy,
        response.status, slot.request.method, slot.replay,
        route_value(?slot.route), target_route, slot.redirects);
    val valid_request: bool = decision.status != policy.REDIRECT_FOLLOW
        || (policy.route_valid(target_route, 253)
        && protocol_route_valid(target_route, slot.protocols)
        && !route_aliases(client, target_route)
        && !request_aliases(client, next_request, ?slot.scope)
        && request_representable(next_request)
        && next_request.generation != slot.request.generation
        && methods_equal(next_request.method, decision.next_method)
        && message.validate_request(next_request,
            client.configured.message_limits)
        && request_route_valid(next_request, target_route)
        && deadline_matches(next_request, ?slot.scope)
        && request_scope_matches(next_request, ?slot.scope)
        && !forbidden_redirect_fields(next_request,
            decision.strip_origin_sensitive,
            decision.strip_proxy_sensitive)
        && (!decision.drop_body || (next_request.body.has_length
            && next_request.body.declared_length == 0))
        && (decision.drop_body
            || replay_matches_request(slot.replay, next_request)));
    if (!release_exchange(client, slot, reuse, now)) {
        ret policy.REDIRECT_INVALID;
    }
    if (settle_cancel(slot)) { ret policy.REDIRECT_CANCELLED; }
    if (settle_body_results(slot, request_result, response_result, response,
        0)) {
        if (slot.completion.outcome == OUTCOME_CANCELLED) {
            ret policy.REDIRECT_CANCELLED;
        }
        ret policy.REDIRECT_INVALID;
    }
    if (decision.status != policy.REDIRECT_FOLLOW) {
        set_terminal(slot, OUTCOME_FAILED, ERROR_REDIRECT,
            no_resolver_error(), 0, response);
        ret decision.status;
    }
    if (!valid_request) {
        set_terminal(slot, OUTCOME_FAILED, ERROR_REDIRECT,
            no_resolver_error(), 0, response);
        ret policy.REDIRECT_INVALID;
    }
    bind_request_scope(next_request, ?slot.scope);
    slot.request = next_request;
    if (decision.drop_body) { slot.replay.body = policy.BODY_EMPTY; }
    store_route(?slot.route, target_route);
    slot.redirects = slot.redirects + 1;
    slot.attempts = 1;
    slot.endpoint_len = 0;
    slot.endpoint_cursor = 0;
    slot.state = STATE_ROUTING;
    ret policy.REDIRECT_FOLLOW;
}

pub fun cancel_request(client: *Client, token: Token) bool {
    if (!client_ready(client)) { ret false; }
    val slot: *RequestSlot = slot_for(client, token);
    ret slot != nil && cancellation.cancel(?slot.scope);
}

pub fun expire_request(client: *Client, token: Token, now: time.Time) bool {
    if (!client_ready(client) || !time_valid(now)) { ret false; }
    val slot: *RequestSlot = slot_for(client, token);
    ret slot != nil && cancellation.expire(?slot.scope, now);
}

pub fun release_request(client: *Client, token: Token) bool {
    if (!client_ready(client)) { ret false; }
    val slot: *RequestSlot = slot_for(client, token);
    if (slot == nil || slot.state != STATE_TERMINAL
        || !cancellation.destroy(?slot.scope)) { ret false; }
    clear_slot(client, token.index::usize);
    client.live_requests = client.live_requests - 1;
    ret true;
}

pub fun drain(client: *Client) bool {
    if (!client_ready(client) || !client.accepting) { ret false; }
    client.accepting = false;
    ret true;
}

pub fun drain_dependencies(client: *Client) bool {
    if (!client_ready(client) || client.accepting
        || client.live_requests != 0 || client.dependencies_draining) {
        ret false;
    }
    val dns_state: dns.Snapshot = dns.snapshot(client.cache);
    val pool_state: pool.Snapshot = pool.snapshot(client.connections);
    val dns_started: bool = !dns_state.accepting || dns.drain(client.cache);
    val pool_started: bool = !pool_state.accepting
        || pool.drain(client.connections);
    if (!dns_started || !pool_started) { ret false; }
    client.dependencies_draining = true;
    ret true;
}

pub fun maintenance(client: *Client, now: time.Time) Maintenance {
    if (!client_ready(client) || !time_valid(now)) {
        ret empty_maintenance();
    }
    if (client.dependencies_draining) {
        val dns_cancelled: dns.Cancel = dns.take_cancel(client.cache);
        if (dns_cancelled.found) {
            var result: Maintenance = empty_maintenance();
            result.kind = MAINTENANCE_CANCEL_DNS;
            result.dns_cancel = dns_cancelled;
            ret result;
        }
        val connect_cancelled: pool.ConnectCancel = pool.take_connect_cancel(
            client.connections);
        if (connect_cancelled.found) {
            var result: Maintenance = empty_maintenance();
            result.kind = MAINTENANCE_CANCEL_CONNECT;
            result.connect_cancel = connect_cancelled;
            ret result;
        }
    }
    val close: pool.Close = pool.take_close(client.connections, now);
    if (close.found) {
        var result: Maintenance = empty_maintenance();
        result.kind = MAINTENANCE_CLOSE;
        result.close = close;
        ret result;
    }
    ret empty_maintenance();
}

pub fun destroy(client: *Client) bool {
    if (!client_ready(client) || client.accepting
        || client.live_requests != 0 || !client.dependencies_draining) {
        ret false;
    }
    val dns_state: dns.Snapshot = dns.snapshot(client.cache);
    val pool_state: pool.Snapshot = pool.snapshot(client.connections);
    if (dns_state.accepting || dns_state.resolving != 0
        || pool_state.accepting || pool_state.live_connections != 0
        || pool_state.live_leases != 0) { ret false; }
    client.cache = nil;
    client.connections = nil;
    client.slots = nil;
    client.capacity = 0;
    client.endpoints = nil;
    client.endpoint_capacity = 0;
    client.configured = Config{max_requests: 0,
        max_endpoints_per_request: 0,
        message_limits: message.limits_default()};
    client.next_slot = 0;
    client.dependencies_draining = false;
    client.initialized = false;
    ret true;
}

fun test_route(host: *u8, host_len: usize) policy.Route {
    ret policy.Route{origin: policy.Origin{scheme: policy.HTTPS,
        host: view.view(host, host_len), port: 443}, proxy: policy.no_proxy()};
}

fun test_request(request: *message.Request, reader: *body.Reader,
    generation: u64, has_deadline: bool, deadline: time.Time,
    configured: message.Limits) bool {
    @reader = body.empty_reader(generation);
    val fields: field.Fields = field.init(nil, 0,
        field.limits(0, 0, 0, 0));
    val trailers: field.Fields = field.init(nil, 0,
        field.limits(0, 0, 0, 0));
    ret message.init_request(request, method.from_kind(method.GET),
        target.origin(view.view("/", 1), view.view("/", 1),
            view.view(nil, 0)),
        message.Metadata{version: message.version_h1(1, 1), secure: false,
            early_data: false, peer: message.unspecified_endpoint(),
            local: message.unspecified_endpoint(),
            received_at: time.Time{sec: 1, nsec: 0},
            has_deadline: has_deadline, deadline: deadline,
            request_index: generation},
        fields, trailers, reader, generation, configured);
}

fun test_response(response: *message.Response, generation: u64,
    code: status.Status, configured: message.Limits) bool {
    ret message.init_response(response, nil, 0, nil, 0, generation,
        configured)
        && message.set_status(response, code) == message.RESPONSE_OK
        && message.commit_response(response, method.GET, configured)
            == message.RESPONSE_OK;
}

fun test_retry_body_read(context: ptr, output: *u8, capacity: usize,
    trailers: *field.Fields) body.Progress {
    ret body.complete(body.REUSE_ALLOWED);
}

fun test_retry_body_write(context: ptr, input: *u8,
    length: usize) body.Progress {
    ret body.data(length);
}

fun test_retry_body_finish(context: ptr, mode: body.Mode,
    trailers: *field.Fields) body.Progress {
    if (mode == body.CANCEL) { ret body.cancelled(body.REUSE_FORBIDDEN); }
    if (mode == body.TIMEOUT) { ret body.timed_out(body.REUSE_FORBIDDEN); }
    if (mode == body.REJECT) { ret body.rejected(body.REUSE_ALLOWED); }
    ret body.complete(body.REUSE_ALLOWED);
}

fun test_retry_body_complete(context: ptr, token: u64,
    trailers: *field.Fields) body.Progress {
    ret body.complete(body.REUSE_ALLOWED);
}

fun test_retry_body_release(context: ptr) {
}

test "http.client.client: authorities replay claims and redirect trailers are exact" {
    val configured: message.Limits = message.limits_default();
    var reader: body.Reader;
    var request: message.Request;
    if (!test_request(?request, ?reader, 91, false,
        time.Time{sec: 0, nsec: 0}, configured)) { ret 1; }
    val route: policy.Route = test_route("example.com", 11);
    var host_item: field.Field;
    request.fields = field.init(?host_item, 1, configured.request_fields);
    if (field.append(?request.fields, field.Field{
            name: view.view(field.HOST, 4),
            value: view.view("other.example", 13), sensitive: false})
            != field.ADD_OK
        || request_route_valid(?request, route)) { ret 2; }
    host_item.value = view.view("EXAMPLE.COM", 11);
    request.fields.bytes = host_item.name.len + host_item.value.len;
    if (!request_route_valid(?request, route)) { ret 3; }
    request.target.path = view.view("/different", 10);
    if (request_route_valid(?request, route)) { ret 4; }
    request.target = target.origin(view.view("/", 1), view.view("/", 1),
        view.view(nil, 0));

    var proxy_route: policy.Route = policy.Route{origin: policy.Origin{
        scheme: policy.HTTP, host: view.view("example.com", 11), port: 80},
        proxy: policy.Proxy{kind: policy.PROXY_HTTP_FORWARD,
            host: view.view("proxy.example", 13), port: 8080, secure: false,
            identity: 4, transports: policy.PROXY_TCP}};
    request.fields = field.init(nil, 0, configured.request_fields);
    if (request_route_valid(?request, proxy_route)) { ret 5; }
    request.target = target.absolute(view.view("http://example.com/a", 20),
        view.view("http", 4), view.view("example.com", 11),
        view.view("/a", 2), view.view(nil, 0));
    if (!request_route_valid(?request, proxy_route)) { ret 6; }
    request.target.authority = view.view("other.example", 13);
    if (request_route_valid(?request, proxy_route)) { ret 7; }

    request.method = method.from_kind(method.CONNECT);
    request.target = target.authority(view.view("example.com", 11));
    if (request_route_valid(?request, proxy_route)) { ret 8; }
    request.target = target.authority(view.view("example.com:80", 14));
    if (!request_route_valid(?request, proxy_route)) { ret 9; }
    request.target = target.authority(view.view("[example.com]:80", 16));
    if (request_route_valid(?request, proxy_route)) { ret 10; }
    val ipv6_route: policy.Route = policy.Route{origin: policy.Origin{
        scheme: policy.HTTPS, host: view.view("2001:db8::1", 11), port: 443},
        proxy: policy.no_proxy()};
    request.target = target.authority(view.view("[2001:db8::1]:443", 17));
    if (!request_route_valid(?request, ipv6_route)
        || policy.host_valid(view.view((~(0::usize))::*u8, 2), 253)) {
        ret 11;
    }
    if (policy.offers(policy.protocols_default(), policy.TRANSPORT_TCP,
        (~(0::usize))::*view.View, 2) != 0) { ret 12; }

    var trailer_item: field.Field;
    request.trailers = field.init(?trailer_item, 1,
        configured.request_trailers);
    if (field.append_trailer(?request.trailers, field.Field{
            name: view.view(field.COOKIE, 6), value: view.view("secret", 6),
            sensitive: true}) != field.ADD_OK
        || !forbidden_redirect_fields(?request, true, false)) { ret 13; }
    reader.has_length = true;
    reader.declared_length = 1;
    if (replay_matches_request(policy.Replay{explicit: true,
        body: policy.BODY_EMPTY}, ?request)) { ret 14; }
    ret 0;
}

test "http.client.client: hostile aliases and capacity overflow are transactional" {
    var bytes: [8]u8;
    if (!memory.overlap((?bytes[0])::ptr, 4,
            (?bytes[3])::ptr, 2)
        || memory.overlap((?bytes[0])::ptr, 4,
            (?bytes[4])::ptr, 2)
        || memory.overlap((~(0::usize))::ptr, 2,
            (?bytes[0])::ptr, 1)) { ret 1; }
    var one_entry: dns.Entry;
    var one_endpoint: ip.Endpoint;
    var overflow_cache: dns.Cache;
    var overflow_dns: dns.Config = dns.config_default();
    overflow_dns.max_entries = ~(0::usize);
    overflow_dns.max_endpoints_per_entry = 1;
    if (dns.init(?overflow_cache, ?one_entry, ~(0::usize), ?one_endpoint,
        ~(0::usize), overflow_dns)) { ret 2; }
    var one_connection: pool.Connection;
    var one_lease: pool.LeaseSlot;
    var overflow_pool: pool.Pool;
    var overflow_pool_config: pool.Config = pool.config_default();
    overflow_pool_config.max_connections = ~(0::usize);
    overflow_pool_config.max_connections_per_route = 1;
    overflow_pool_config.max_leases = 1;
    overflow_pool_config.max_idle = 1;
    overflow_pool_config.max_idle_per_route = 1;
    if (pool.init(?overflow_pool, ?one_connection, ~(0::usize), ?one_lease, 1,
        overflow_pool_config)) { ret 3; }

    var cache_entries: [1]dns.Entry;
    var cache_endpoints: [1]ip.Endpoint;
    var cache: dns.Cache;
    var cache_config: dns.Config = dns.config_default();
    cache_config.max_entries = 1;
    cache_config.max_endpoints_per_entry = 1;
    if (!dns.init(?cache, ?cache_entries[0], 1, ?cache_endpoints[0], 1,
        cache_config)) { ret 4; }
    var pool_connections: [1]pool.Connection;
    var pool_leases: [1]pool.LeaseSlot;
    var connections: pool.Pool;
    var pool_config: pool.Config = pool.config_default();
    pool_config.max_connections = 1;
    pool_config.max_connections_per_route = 1;
    pool_config.max_leases = 1;
    pool_config.max_idle = 1;
    pool_config.max_idle_per_route = 1;
    if (!pool.init(?connections, ?pool_connections[0], 1,
        ?pool_leases[0], 1, pool_config)) { ret 5; }
    var slots: [2]RequestSlot;
    var request_endpoints: [2]ip.Endpoint;
    var client: Client;
    var configured: Config = config_default();
    configured.max_requests = 2;
    configured.max_endpoints_per_request = 1;
    var overflow_client: Client;
    var overflow_client_config: Config = configured;
    overflow_client_config.max_requests = ~(0::usize);
    if (init(?overflow_client, ?cache, ?connections, ?slots[0],
            ~(0::usize), ?request_endpoints[0], ~(0::usize),
            overflow_client_config)
        || init(?client, ?cache, ?connections, ?slots[0], 2,
            (?slots[0])::ptr::*ip.Endpoint, 2, configured)
        || !init(?client, ?cache, ?connections, ?slots[0], 2,
            ?request_endpoints[0], 2, configured)) { ret 6; }
    var parent: cancellation.Scope;
    if (!cancellation.make_root(?parent, false,
        time.Time{sec: 0, nsec: 0})) { ret 7; }
    var reader: body.Reader;
    var request: message.Request;
    if (!test_request(?request, ?reader, 92, false,
        time.Time{sec: 0, nsec: 0}, configured.message_limits)) { ret 8; }
    val alias_route: policy.Route = test_route("alias.example", 13);
    val safe_replay: policy.Replay = policy.Replay{explicit: true,
        body: policy.BODY_EMPTY};
    if (submit(?client, (~(0::usize))::*cancellation.Scope, ?request,
            alias_route, policy.protocols_default(), safe_replay,
            policy.retry_policy_default(), policy.redirect_policy_default()).status
            != SUBMIT_INVALID
        || submit(?client, (?slots[0])::ptr::*cancellation.Scope, ?request,
            alias_route, policy.protocols_default(), safe_replay,
            policy.retry_policy_default(), policy.redirect_policy_default()).status
            != SUBMIT_INVALID
        || submit(?client, ?parent, (~(0::usize))::*message.Request,
            alias_route, policy.protocols_default(), safe_replay,
            policy.retry_policy_default(), policy.redirect_policy_default()).status
            != SUBMIT_INVALID
        || dns.lookup(?cache, dns.Key{host: view.view("range.example", 13),
            port: 443, transport: policy.TRANSPORT_TCP},
            time.Time{sec: 1, nsec: 0},
            (~(0::usize))::*ip.Endpoint, 1).status != dns.LOOKUP_INVALID
        || complete_resolution(?client,
            (~(0::usize))::*resolver.Completion,
            time.Time{sec: 1, nsec: 0}) != dns.COMPLETE_INVALID) { ret 9; }
    reader.ctx = (?slots[0])::ptr;
    if (submit(?client, ?parent, ?request, alias_route,
            policy.protocols_default(), policy.Replay{explicit: true,
                body: policy.BODY_EMPTY}, policy.retry_policy_default(),
            policy.redirect_policy_default()).status != SUBMIT_INVALID) { ret 10; }
    reader.ctx = nil;
    reader.scope = (?slots[0])::ptr::*cancellation.Scope;
    if (submit(?client, ?parent, ?request, test_route("alias.example", 13),
            policy.protocols_default(), policy.Replay{explicit: true,
                body: policy.BODY_EMPTY}, policy.retry_policy_default(),
            policy.redirect_policy_default()).status != SUBMIT_INVALID) { ret 11; }
    reader.scope = nil;

    val aliased_response: *message.Response
        = (?slots[1])::ptr::*message.Response;
    if (!test_response(aliased_response, 92, status.OK,
            configured.message_limits)
        || !response_aliases(?client, aliased_response, nil)) { ret 12; }
    var external_response: message.Response;
    var response_field: field.Field;
    if (!message.init_response(?external_response, ?response_field, 1,
            nil, 0, 92, configured.message_limits)) { ret 13; }
    val endpoint_byte: *u8 = (?request_endpoints[0])::ptr::*u8;
    endpoint_byte[0] = 'x';
    if (field.append(?external_response.fields, field.Field{
            name: view.view("x-test", 6), value: view.view(endpoint_byte, 1),
            sensitive: false}) != field.ADD_OK
        || message.set_status(?external_response, status.OK)
            != message.RESPONSE_OK
        || message.commit_response(?external_response, method.GET,
            configured.message_limits) != message.RESPONSE_OK
        || !response_aliases(?client, ?external_response, nil)) { ret 14; }
    if (!test_shutdown(?client, ?cache, ?connections, ?parent,
        time.Time{sec: 1, nsec: 0})) { ret 15; }
    ret 0;
}

fun test_publish_resolution(client: *Client, token: Token, action: Action,
    endpoint: ip.Endpoint, resolver_token: resolver.Token,
    now: time.Time) bool {
    if (action.kind != ACTION_RESOLVE || !action.dns_query.valid
        || !resolution_submitted(client, token, resolver_token)) { ret false; }
    var resolved: ip.Endpoint = endpoint;
    var completion: resolver.Completion = resolver.Completion{
        token: resolver_token, context: action.dns_query.context,
        resolution: resolver.Resolution{endpoints: ?resolved, len: 1,
            endpoint_capacity: 1, canonical_name: nil, canonical_length: 0,
            canonical_capacity: 0, allocator: nil}, has_error: false,
        error: no_resolver_error()};
    ret complete_resolution(client, ?completion, now) == dns.COMPLETE_OK;
}

fun test_shutdown(client: *Client, cache: *dns.Cache,
    connections: *pool.Pool, parent: *cancellation.Scope,
    now: time.Time) bool {
    if (!drain(client) || !drain_dependencies(client)) { ret false; }
    var checked: usize = 0;
    for (checked <= connections.capacity + cache.capacity) {
        val action: Maintenance = maintenance(client, now);
        if (action.kind == MAINTENANCE_NONE) { brk; }
        if (action.kind != MAINTENANCE_CLOSE
            || !pool.retire(connections, action.close)) { ret false; }
        checked = checked + 1;
    }
    if (maintenance(client, now).kind != MAINTENANCE_NONE) { ret false; }
    if (!destroy(client) || !dns.destroy(cache)
        || !pool.destroy(connections)
        || !cancellation.destroy(parent)) { ret false; }
    ret true;
}

test "http.client.client: dns alpn exchange and graceful drain preserve ownership" {
    var cache_entries: [2]dns.Entry;
    var cache_endpoints: [4]ip.Endpoint;
    var cache: dns.Cache;
    var cache_config: dns.Config = dns.config_default();
    cache_config.max_entries = 2;
    cache_config.max_endpoints_per_entry = 2;
    if (!dns.init(?cache, ?cache_entries[0], 2, ?cache_endpoints[0], 4,
        cache_config)) { ret 1; }

    var pool_connections: [2]pool.Connection;
    var pool_leases: [2]pool.LeaseSlot;
    var connections: pool.Pool;
    var pool_config: pool.Config = pool.config_default();
    pool_config.max_connections = 2;
    pool_config.max_connections_per_route = 2;
    pool_config.max_leases = 2;
    pool_config.max_idle = 2;
    pool_config.max_idle_per_route = 2;
    if (!pool.init(?connections, ?pool_connections[0], 2,
        ?pool_leases[0], 2, pool_config)) { ret 2; }

    var slots: [2]RequestSlot;
    var request_endpoints: [4]ip.Endpoint;
    var client: Client;
    var client_config: Config = config_default();
    client_config.max_requests = 2;
    client_config.max_endpoints_per_request = 2;
    if (!init(?client, ?cache, ?connections, ?slots[0], 2,
        ?request_endpoints[0], 4, client_config)) { ret 3; }

    var parent: cancellation.Scope;
    if (!cancellation.make_root(?parent, false,
        time.Time{sec: 0, nsec: 0})) { ret 4; }
    var reader: body.Reader;
    var request: message.Request;
    if (!test_request(?request, ?reader, 1, false,
        time.Time{sec: 0, nsec: 0}, client_config.message_limits)) { ret 5; }
    val route: policy.Route = test_route("example.com", 11);
    val protocols: policy.ProtocolPolicy = policy.ProtocolPolicy{
        allowed: policy.ALLOW_H1 | policy.ALLOW_H2,
        prior_knowledge: 0, require_alpn: true};
    val submitted: Submission = submit(?client, ?parent, ?request, route,
        protocols, policy.Replay{explicit: true, body: policy.BODY_EMPTY},
        policy.retry_policy_default(), policy.redirect_policy_default());
    val now: time.Time = time.Time{sec: 2, nsec: 0};
    val resolving: Action = next(?client, submitted.token, now);
    if (submitted.status != SUBMIT_OK
        || !test_publish_resolution(?client, submitted.token, resolving,
            ip.endpoint(192, 0, 2, 1, 443),
            resolver.Token{index: 4, generation: 7}, now)) { ret 6; }
    val connecting: Action = next(?client, submitted.token, now);
    val aliased_driver: Connected = connected(?client, submitted.token,
        connecting.reservation, true, view.view("h2", 2),
        (?slots[0])::ptr, 8, now);
    val endpoint_driver: Connected = connected(?client, submitted.token,
        connecting.reservation, true, view.view("h2", 2),
        (?request_endpoints[0])::ptr, 8, now);
    val client_driver: Connected = connected(?client, submitted.token,
        connecting.reservation, true, view.view("h2", 2), (?client)::ptr, 8,
        now);
    val cache_driver: Connected = connected(?client, submitted.token,
        connecting.reservation, true, view.view("h2", 2), (?cache)::ptr, 8,
        now);
    val cache_entry_driver: Connected = connected(?client, submitted.token,
        connecting.reservation, true, view.view("h2", 2),
        (?cache_entries[0])::ptr, 8, now);
    val cache_endpoint_driver: Connected = connected(?client, submitted.token,
        connecting.reservation, true, view.view("h2", 2),
        (?cache_endpoints[0])::ptr, 8, now);
    val pool_driver: Connected = connected(?client, submitted.token,
        connecting.reservation, true, view.view("h2", 2),
        (?connections)::ptr, 8, now);
    val connection_slot_driver: Connected = connected(?client,
        submitted.token, connecting.reservation, true, view.view("h2", 2),
        (?pool_connections[0])::ptr, 8, now);
    val lease_slot_driver: Connected = connected(?client, submitted.token,
        connecting.reservation, true, view.view("h2", 2),
        (?pool_leases[0])::ptr, 8, now);
    var rejected_driver: u8 = 2;
    val wrapping_alpn: Connected = connected(?client, submitted.token,
        connecting.reservation, true,
        view.view((~(0::usize))::*u8, 2), (?rejected_driver)::ptr, 8, now);
    var driver: u8 = 1;
    val connected_result: Connected = connected(?client, submitted.token,
        connecting.reservation, true, view.view("h2", 2), (?driver)::ptr,
        8, now);
    val duplicate: Connected = connected(?client, submitted.token,
        connecting.reservation, true, view.view("h2", 2), (?driver)::ptr,
        8, now);
    var duplicate_driver: u8 = 3;
    val unrelated_duplicate: Connected = connected(?client, submitted.token,
        connecting.reservation, true, view.view("h2", 2),
        (?duplicate_driver)::ptr, 8, now);
    val exchange: Action = next(?client, submitted.token, now);
    if (connecting.kind != ACTION_CONNECT
        || aliased_driver.status != CONNECT_INVALID
        || aliased_driver.close_driver
        || endpoint_driver.status != CONNECT_INVALID
        || endpoint_driver.close_driver
        || client_driver.status != CONNECT_INVALID || client_driver.close_driver
        || cache_driver.status != CONNECT_INVALID || cache_driver.close_driver
        || cache_entry_driver.status != CONNECT_INVALID
        || cache_entry_driver.close_driver
        || cache_endpoint_driver.status != CONNECT_INVALID
        || cache_endpoint_driver.close_driver
        || pool_driver.status != CONNECT_INVALID || pool_driver.close_driver
        || connection_slot_driver.status != CONNECT_INVALID
        || connection_slot_driver.close_driver
        || lease_slot_driver.status != CONNECT_INVALID
        || lease_slot_driver.close_driver
        || wrapping_alpn.status != CONNECT_INVALID
        || !wrapping_alpn.close_driver
        || connected_result.status != CONNECT_ACCEPTED
        || connected_result.close_driver
        || duplicate.status != CONNECT_INVALID || duplicate.close_driver
        || unrelated_duplicate.status != CONNECT_INVALID
        || !unrelated_duplicate.close_driver
        || exchange.kind != ACTION_EXCHANGE
        || exchange.lease.wire != message.WIRE_H2
        || request.metadata.version.wire != message.WIRE_H2
        || !request.metadata.secure) { ret 7; }
    var alias_field: field.Field;
    var alias_response: message.Response;
    val alias_byte: *u8 = (?request_endpoints[0])::ptr::*u8;
    alias_byte[0] = 'x';
    if (!message.init_response(?alias_response, ?alias_field, 1, nil, 0, 1,
            client_config.message_limits)
        || field.append(?alias_response.fields, field.Field{
            name: view.view("x-test", 6), value: view.view(alias_byte, 1),
            sensitive: false}) != field.ADD_OK
        || message.set_status(?alias_response, status.OK) != message.RESPONSE_OK
        || message.commit_response(?alias_response, method.GET,
            client_config.message_limits) != message.RESPONSE_OK
        || exchange_complete(?client, submitted.token, exchange.lease,
            ?alias_response,
            body.REUSE_ALLOWED, now)) { ret 8; }
    var pending_context: u8 = 0;
    var pending_body: body.Reader = body.init_reader(
        (?pending_context)::ptr, test_retry_body_read,
        test_retry_body_finish, test_retry_body_complete,
        test_retry_body_release, body.OWNER_APPLICATION, 1, true, 0,
        client_config.message_limits.response_body, nil, exchange.scope);
    var pending_response: message.Response;
    if (!message.init_response(?pending_response, nil, 0, nil, 0, 1,
            client_config.message_limits)
        || message.set_status(?pending_response, status.OK)
            != message.RESPONSE_OK
        || message.set_body_reader(?pending_response, ?pending_body,
            client_config.message_limits) != message.RESPONSE_OK
        || message.commit_response(?pending_response, method.GET,
            client_config.message_limits) != message.RESPONSE_OK
        || exchange_complete(?client, submitted.token, exchange.lease,
            ?pending_response, body.REUSE_ALLOWED, now)
        || body.drain(?pending_body).status != body.COMPLETE
        || exchange_complete(?client, submitted.token, exchange.lease,
            ?pending_response, body.REUSE_FORBIDDEN, now)
        || !exchange_complete(?client, submitted.token, exchange.lease,
            ?pending_response, body.REUSE_ALLOWED, now)) { ret 9; }
    val completed: Action = next(?client, submitted.token, now);
    if (completed.kind != ACTION_COMPLETE
        || completed.completion.outcome != OUTCOME_OK
        || completed.completion.response != ?pending_response
        || !release_request(?client, submitted.token)) { ret 10; }
    val idle: time.Time = time.Time{sec: 62, nsec: 0};
    val routine: Maintenance = maintenance(?client, idle);
    if (routine.kind != MAINTENANCE_CLOSE
        || !pool.retire(?connections, routine.close)
        || maintenance(?client, idle).kind != MAINTENANCE_NONE) { ret 11; }
    if (!test_shutdown(?client, ?cache, ?connections, ?parent, now)) {
        ret 12;
    }
    ret 0;
}

test "http.client.client: request deadlines settle before transport publication" {
