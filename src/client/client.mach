    if (!test_request(?request, ?reader, 11, true, deadline,
        client_config.message_limits)) { ret 5; }
    val submitted: Submission = submit(?client, ?parent, ?request,
        test_route("deadline.example", 16), policy.protocols_default(),
        policy.Replay{explicit: true, body: policy.BODY_EMPTY},
        policy.retry_policy_default(), policy.redirect_policy_default());
    if (submitted.status != SUBMIT_OK
        || expire_request(?client, submitted.token,
            time.Time{sec: 5, nsec: 9})
        || !expire_request(?client, submitted.token, deadline)) { ret 6; }
    val completed: Action = next(?client, submitted.token, deadline);
    if (completed.kind != ACTION_COMPLETE
        || completed.completion.outcome != OUTCOME_TIMED_OUT
        || completed.completion.error != ERROR_TIMED_OUT
        || !release_request(?client, submitted.token)) { ret 7; }
    if (!test_shutdown(?client, ?cache, ?connections, ?parent, deadline)) {
        ret 8;
    }
    ret 0;
}

test "http.client.client: multi-origin saturation resumes after exact lease release" {
    var cache_entries: [2]dns.Entry;
    var cache_endpoints: [2]ip.Endpoint;
    var cache: dns.Cache;
    var cache_config: dns.Config = dns.config_default();
    cache_config.max_entries = 2;
    cache_config.max_endpoints_per_entry = 1;
    if (!dns.init(?cache, ?cache_entries[0], 2, ?cache_endpoints[0], 2,
        cache_config)) { ret 1; }
    var pool_connections: [1]pool.Connection;
    var pool_leases: [2]pool.LeaseSlot;
    var connections: pool.Pool;
    var pool_config: pool.Config = pool.config_default();
    pool_config.max_connections = 1;
    pool_config.max_connections_per_route = 1;
    pool_config.max_leases = 2;
    pool_config.max_idle = 0;
    pool_config.max_idle_per_route = 0;
    if (!pool.init(?connections, ?pool_connections[0], 1,
        ?pool_leases[0], 2, pool_config)) { ret 2; }
    var slots: [2]RequestSlot;
    var request_endpoints: [2]ip.Endpoint;
    var client: Client;
    var client_config: Config = config_default();
    client_config.max_requests = 2;
    client_config.max_endpoints_per_request = 1;
    if (!init(?client, ?cache, ?connections, ?slots[0], 2,
        ?request_endpoints[0], 2, client_config)) { ret 3; }
    var parent: cancellation.Scope;
    if (!cancellation.make_root(?parent, false,
        time.Time{sec: 0, nsec: 0})) { ret 4; }
    var first_reader: body.Reader;
    var second_reader: body.Reader;
    var first_request: message.Request;
    var second_request: message.Request;
    if (!test_request(?first_request, ?first_reader, 21, false,
            time.Time{sec: 0, nsec: 0}, client_config.message_limits)
        || !test_request(?second_request, ?second_reader, 22, false,
            time.Time{sec: 0, nsec: 0}, client_config.message_limits)) {
        ret 5;
    }
    val retry_once: policy.RetryPolicy = policy.RetryPolicy{
        max_attempts: 1, retry_request_timeout: false,
        retry_too_early: false, retry_rate_limit: false,
        retry_server: false};
    val replay: policy.Replay = policy.Replay{
        explicit: true, body: policy.BODY_EMPTY};
    val first: Submission = submit(?client, ?parent, ?first_request,
        test_route("one.example", 11), policy.protocols_default(), replay,
        retry_once, policy.redirect_policy_default());
    val second: Submission = submit(?client, ?parent, ?second_request,
        test_route("two.example", 11), policy.protocols_default(), replay,
        retry_once, policy.redirect_policy_default());
    val now: time.Time = time.Time{sec: 8, nsec: 0};
    val first_dns: Action = next(?client, first.token, now);
    if (first.status != SUBMIT_OK || second.status != SUBMIT_OK
        || !test_publish_resolution(?client, first.token, first_dns,
            ip.endpoint(192, 0, 2, 21, 443),
            resolver.Token{index: 1, generation: 1}, now)) { ret 6; }
    val first_connect: Action = next(?client, first.token, now);
    val second_dns: Action = next(?client, second.token, now);
    if (first_connect.kind != ACTION_CONNECT
        || !test_publish_resolution(?client, second.token, second_dns,
            ip.endpoint(192, 0, 2, 22, 443),
            resolver.Token{index: 2, generation: 1}, now)) { ret 7; }
    val saturated: Action = next(?client, second.token, now);
    if (saturated.kind != ACTION_WAIT_POOL
        || !policy.origin_equal(saturated.route.origin,
            test_route("two.example", 11).origin)) { ret 8; }
    val connect_failure: policy.Failure = policy.Failure{
        reason: policy.RETRY_CONNECT, definitely_unprocessed: true,
        response_started: false, response_complete: false,
        retry_after_ns: 0};
    if (connect_failed(?client, first.token, first_connect.reservation,
            connect_failure, now) != CONNECT_REJECTED
        || next(?client, first.token, now).kind != ACTION_COMPLETE
        || !release_request(?client, first.token)) { ret 9; }
    val resumed: Action = next(?client, second.token, now);
    if (resumed.kind != ACTION_CONNECT
        || connect_failed(?client, second.token, resumed.reservation,
            connect_failure, now) != CONNECT_REJECTED
        || next(?client, second.token, now).kind != ACTION_COMPLETE
        || !release_request(?client, second.token)) { ret 10; }
    if (!test_shutdown(?client, ?cache, ?connections, ?parent, now)) {
        ret 11;
    }
    ret 0;
}

test "http.client.client: cross-origin redirects require rewritten safe requests" {
    var cache_entries: [2]dns.Entry;
    var cache_endpoints: [2]ip.Endpoint;
    var cache: dns.Cache;
    var cache_config: dns.Config = dns.config_default();
    cache_config.max_entries = 2;
    cache_config.max_endpoints_per_entry = 1;
    if (!dns.init(?cache, ?cache_entries[0], 2, ?cache_endpoints[0], 2,
        cache_config)) { ret 1; }
    var pool_connections: [2]pool.Connection;
    var pool_leases: [2]pool.LeaseSlot;
    var connections: pool.Pool;
    var pool_config: pool.Config = pool.config_default();
    pool_config.max_connections = 2;
    pool_config.max_connections_per_route = 1;
    pool_config.max_leases = 2;
    pool_config.max_idle = 2;
    pool_config.max_idle_per_route = 1;
    if (!pool.init(?connections, ?pool_connections[0], 2,
        ?pool_leases[0], 2, pool_config)) { ret 2; }
    var slots: [1]RequestSlot;
    var request_endpoints: [1]ip.Endpoint;
    var client: Client;
    var client_config: Config = config_default();
    client_config.max_requests = 1;
    client_config.max_endpoints_per_request = 1;
    if (!init(?client, ?cache, ?connections, ?slots[0], 1,
        ?request_endpoints[0], 1, client_config)) { ret 3; }
    var parent: cancellation.Scope;
    if (!cancellation.make_root(?parent, false,
        time.Time{sec: 0, nsec: 0})) { ret 4; }
    var reader: body.Reader;
    var request: message.Request;
    if (!test_request(?request, ?reader, 31, false,
        time.Time{sec: 0, nsec: 0}, client_config.message_limits)) { ret 5; }
    val source: policy.Route = test_route("source.example", 14);
    val h3_only: policy.ProtocolPolicy = policy.ProtocolPolicy{
        allowed: policy.ALLOW_H3, prior_knowledge: message.WIRE_H3,
        require_alpn: true};
    val redirects: policy.RedirectPolicy = policy.RedirectPolicy{
        max_redirects: 8, allow_http_downgrade: true,
        legacy_post_to_get: false};
    val submitted: Submission = submit(?client, ?parent, ?request, source,
        h3_only,
        policy.Replay{explicit: true, body: policy.BODY_STREAMING},
        policy.retry_policy_default(), redirects);
    val now: time.Time = time.Time{sec: 9, nsec: 0};
    val resolving: Action = next(?client, submitted.token, now);
    if (submitted.status != SUBMIT_OK
        || !test_publish_resolution(?client, submitted.token, resolving,
            ip.endpoint(192, 0, 2, 31, 443),
            resolver.Token{index: 3, generation: 1}, now)) { ret 6; }
    val connecting: Action = next(?client, submitted.token, now);
    var driver: u8 = 1;
    val accepted: Connected = connected(?client, submitted.token,
        connecting.reservation, true, view.view("h3", 2), (?driver)::ptr,
        4, now);
    val exchange: Action = next(?client, submitted.token, now);
    if (connecting.kind != ACTION_CONNECT
        || accepted.status != CONNECT_ACCEPTED
        || exchange.kind != ACTION_EXCHANGE) {
        ret 7;
    }
    var response: message.Response;
    if (!test_response(?response, 31, status.SEE_OTHER,
        client_config.message_limits)) { ret 8; }
    var next_reader: body.Reader;
    var next_request: message.Request;
    if (!test_request(?next_request, ?next_reader, 32, false,
        time.Time{sec: 0, nsec: 0}, client_config.message_limits)) { ret 9; }
    val destination: policy.Route = test_route("other.example", 13);
    val index: usize = submitted.token.index::usize;
    val saved_lease: pool.Lease = slots[index].lease;
    var wrong_driver: u8 = 9;
    slots[index].lease.driver = (?wrong_driver)::ptr;
    val corrupted_lease: pool.Lease = slots[index].lease;
    if (follow_redirect(?client, submitted.token, corrupted_lease, ?response,
            body.REUSE_ALLOWED, destination, ?next_request, now)
            != policy.REDIRECT_INVALID
        || slots[index].state != STATE_EXCHANGING
        || slots[index].lease.driver != (?wrong_driver)::ptr) { ret 10; }
    slots[index].lease = saved_lease;
    if (follow_redirect(?client, submitted.token, saved_lease, ?response,
            body.REUSE_ALLOWED, destination, ?next_request, now)
            != policy.REDIRECT_FOLLOW
        || slots[index].replay.body != policy.BODY_EMPTY) { ret 11; }
    val redirected_resolve: Action = next(?client, submitted.token, now);
    if (!test_publish_resolution(?client, submitted.token, redirected_resolve,
            ip.endpoint(192, 0, 2, 32, 443),
            resolver.Token{index: 8, generation: 1}, now)) { ret 12; }
    val redirected_connect: Action = next(?client, submitted.token, now);
    var redirected_driver: u8 = 2;
    val redirected_connected: Connected = connected(?client, submitted.token,
        redirected_connect.reservation, true, view.view("h3", 2),
        (?redirected_driver)::ptr, 4, now);
    val redirected_exchange: Action = next(?client, submitted.token, now);
    if (redirected_connect.kind != ACTION_CONNECT
        || redirected_connected.status != CONNECT_ACCEPTED
        || redirected_exchange.kind != ACTION_EXCHANGE) { ret 13; }
    var second_response: message.Response;
    var clear_reader: body.Reader;
    var clear_request: message.Request;
    var clear_route: policy.Route = test_route("clear.example", 13);
    clear_route.origin.scheme = policy.HTTP;
    clear_route.origin.port = 80;
    if (!test_response(?second_response, 32, status.SEE_OTHER,
            client_config.message_limits)
        || !test_request(?clear_request, ?clear_reader, 33, false,
            time.Time{sec: 0, nsec: 0}, client_config.message_limits)
        || follow_redirect(?client, submitted.token, redirected_exchange.lease,
            ?second_response, body.REUSE_ALLOWED, clear_route, ?clear_request,
            now) != policy.REDIRECT_INVALID) { ret 14; }
    val completed: Action = next(?client, submitted.token, now);
    if (completed.kind != ACTION_COMPLETE
        || completed.completion.outcome != OUTCOME_FAILED
        || completed.completion.error != ERROR_REDIRECT
        || completed.completion.redirects != 1
        || !release_request(?client, submitted.token)) { ret 15; }
    if (!test_shutdown(?client, ?cache, ?connections, ?parent, now)) {
        ret 16;
    }
    ret 0;
}

test "http.client.client: retries publish replay and never buffer streams" {
    var cache_entries: [1]dns.Entry;
    var cache_endpoints: [1]ip.Endpoint;
    var cache: dns.Cache;
    var cache_config: dns.Config = dns.config_default();
    cache_config.max_entries = 1;
    cache_config.max_endpoints_per_entry = 1;
    if (!dns.init(?cache, ?cache_entries[0], 1, ?cache_endpoints[0], 1,
        cache_config)) { ret 1; }
    var pool_connections: [2]pool.Connection;
    var pool_leases: [2]pool.LeaseSlot;
    var connections: pool.Pool;
    var pool_config: pool.Config = pool.config_default();
    pool_config.max_connections = 2;
    pool_config.max_connections_per_route = 2;
    pool_config.max_leases = 2;
    pool_config.max_idle = 2;
    pool_config.max_idle_per_route = 2;
    if (!pool.init(?connections, ?pool_connections[0], 2,
        ?pool_leases[0], 2, pool_config)) { ret 2; }
    var slots: [1]RequestSlot;
    var request_endpoints: [1]ip.Endpoint;
    var client: Client;
    var client_config: Config = config_default();
    client_config.max_requests = 1;
    client_config.max_endpoints_per_request = 1;
    if (!init(?client, ?cache, ?connections, ?slots[0], 1,
        ?request_endpoints[0], 1, client_config)) { ret 3; }
    var parent: cancellation.Scope;
    if (!cancellation.make_root(?parent, false,
        time.Time{sec: 0, nsec: 0})) { ret 4; }
    val route: policy.Route = test_route("retry.example", 13);
    val retry_twice: policy.RetryPolicy = policy.RetryPolicy{
        max_attempts: 2, retry_request_timeout: false,
        retry_too_early: true, retry_rate_limit: false,
        retry_server: false};
    var first_reader: body.Reader;
    var first_request: message.Request;
    if (!test_request(?first_request, ?first_reader, 41, false,
        time.Time{sec: 0, nsec: 0}, client_config.message_limits)) { ret 5; }
    var first_body_context: u8 = 0;
    first_reader = body.init_reader((?first_body_context)::ptr,
        test_retry_body_read, test_retry_body_finish,
        test_retry_body_complete, test_retry_body_release,
        body.OWNER_APPLICATION, 41, true, 0,
        client_config.message_limits.request_body,
        ?first_request.trailers, ?parent);
    first_request.body = ?first_reader;
    val first: Submission = submit(?client, ?parent, ?first_request, route,
        policy.protocols_default(), policy.Replay{explicit: true,
            body: policy.BODY_REWINDABLE}, retry_twice,
        policy.redirect_policy_default());
    val now: time.Time = time.Time{sec: 10, nsec: 0};
    val resolving: Action = next(?client, first.token, now);
    if (first.status != SUBMIT_OK
        || !test_publish_resolution(?client, first.token, resolving,
            ip.endpoint(192, 0, 2, 41, 443),
            resolver.Token{index: 4, generation: 1}, now)) { ret 6; }
    val connecting: Action = next(?client, first.token, now);
    var first_driver: u8 = 1;
    val first_connected: Connected = connected(?client, first.token,
        connecting.reservation, true, view.view("h2", 2),
        (?first_driver)::ptr, 4, now);
    val first_exchange: Action = next(?client, first.token, now);
    var common_response: message.Response;
    var common_value: common_exchange.Exchange;
    if (first_connected.status != CONNECT_ACCEPTED
        || first_exchange.kind != ACTION_EXCHANGE
        || first_reader.scope != first_exchange.scope
        || !message.init_response(?common_response, nil, 0, nil, 0, 41,
            client_config.message_limits)
        || !common_exchange.init(?common_value, ?first_request,
            ?common_response, nil, 0, first_exchange.scope, 41,
            client_config.message_limits)) { ret 7; }
    val refused: policy.Failure = policy.Failure{
        reason: policy.RETRY_REFUSED_STREAM, definitely_unprocessed: true,
        response_started: false, response_complete: false,
        retry_after_ns: 0};
    var wrong_exchange: pool.Lease = first_exchange.lease;
    wrong_exchange.token.generation = wrong_exchange.token.generation + 1;
    if (exchange_failed(?client, first.token, wrong_exchange, refused, now)
        || exchange_failed(?client, first.token, first_exchange.lease,
            refused, now)
        || body.drain(?first_reader).status != body.COMPLETE
        || !exchange_failed(?client, first.token, first_exchange.lease,
            refused, now)) { ret 8; }
    val replay: Action = next(?client, first.token, now);
    if (replay.kind != ACTION_REPLAY
        || next(?client, first.token, now).kind != ACTION_NONE) { ret 9; }
    var replay_reader: body.Reader;
    var replay_request: message.Request;
    if (!test_request(?replay_request, ?replay_reader, 42, false,
        time.Time{sec: 0, nsec: 0}, client_config.message_limits)) { ret 10; }
    var replay_context: u8 = 0;
    replay_reader = body.init_reader((?replay_context)::ptr,
        test_retry_body_read, test_retry_body_finish,
        test_retry_body_complete, test_retry_body_release,
        body.OWNER_APPLICATION, 42, true, 0,
        client_config.message_limits.request_body,
        ?replay_request.trailers, first_exchange.scope);
    replay_request.body = ?replay_reader;
    if (!message.validate_request(?replay_request,
            client_config.message_limits)
        || !replay_ready(?client, first.token, ?replay_request)) { ret 10; }
    val retry_connect: Action = next(?client, first.token, now);
    val connect_failure: policy.Failure = policy.Failure{
        reason: policy.RETRY_CONNECT, definitely_unprocessed: true,
        response_started: false, response_complete: false,
        retry_after_ns: 0};
    if (retry_connect.kind != ACTION_CONNECT
        || connect_failed(?client, first.token, retry_connect.reservation,
            connect_failure, now) != CONNECT_REJECTED) { ret 11; }
    val retry_complete: Action = next(?client, first.token, now);
    if (retry_complete.kind != ACTION_COMPLETE
        || retry_complete.completion.attempts != 2
        || retry_complete.completion.retry_reason != policy.RETRY_CONNECT
        || body.cancel_reader(?replay_reader).status != body.CANCELLED
        || !release_request(?client, first.token)) { ret 12; }

    var stream_reader: body.Reader;
    var stream_request: message.Request;
    if (!test_request(?stream_request, ?stream_reader, 43, false,
        time.Time{sec: 0, nsec: 0}, client_config.message_limits)) { ret 13; }
    val streaming: Submission = submit(?client, ?parent, ?stream_request,
        route, policy.protocols_default(), policy.Replay{explicit: true,
            body: policy.BODY_STREAMING}, policy.retry_policy_default(),
        policy.redirect_policy_default());
    val stream_connect: Action = next(?client, streaming.token, now);
    var stream_driver: u8 = 2;
    val stream_connected: Connected = connected(?client, streaming.token,
        stream_connect.reservation, true, view.view("http/1.1", 8),
        (?stream_driver)::ptr, 1, now);
    val stream_exchange: Action = next(?client, streaming.token, now);
    val transport_failure: policy.Failure = policy.Failure{
        reason: policy.RETRY_TRANSPORT, definitely_unprocessed: false,
        response_started: false, response_complete: false,
        retry_after_ns: 0};
    if (streaming.status != SUBMIT_OK || stream_connect.kind != ACTION_CONNECT
        || stream_connected.status != CONNECT_ACCEPTED
        || stream_exchange.kind != ACTION_EXCHANGE
        || exchange_failed(?client, streaming.token, stream_exchange.lease,
            refused, now)
        || !exchange_failed(?client, streaming.token, stream_exchange.lease,
            transport_failure, now)) { ret 14; }
    val stream_complete: Action = next(?client, streaming.token, now);
    if (stream_complete.kind != ACTION_COMPLETE
        || stream_complete.completion.outcome != OUTCOME_FAILED
        || stream_complete.completion.attempts != 1
        || !release_request(?client, streaming.token)) { ret 15; }
    var closed: usize = 0;
    for (closed < 2) {
        val close_action: Maintenance = maintenance(?client, now);
        if (close_action.kind != MAINTENANCE_CLOSE
            || !pool.retire(?connections, close_action.close)) { ret 16; }
        closed = closed + 1;
    }

    var response_reader: body.Reader;
    var response_request: message.Request;
    if (!test_request(?response_request, ?response_reader, 44, false,
        time.Time{sec: 0, nsec: 0}, client_config.message_limits)) { ret 17; }
    var server_policy: policy.RetryPolicy = policy.retry_policy_default();
    server_policy.max_attempts = 2;
    server_policy.retry_server = true;
    val response_submission: Submission = submit(?client, ?parent,
        ?response_request, route, policy.protocols_default(),
        policy.Replay{explicit: true, body: policy.BODY_REWINDABLE},
        server_policy, policy.redirect_policy_default());
    val response_connect: Action = next(?client, response_submission.token, now);
    var response_driver: u8 = 3;
    val response_connected: Connected = connected(?client,
        response_submission.token, response_connect.reservation, true,
        view.view("h2", 2), (?response_driver)::ptr, 4, now);
    val response_exchange: Action = next(?client,
        response_submission.token, now);
    if (response_submission.status != SUBMIT_OK
        || response_connect.kind != ACTION_CONNECT
        || response_connected.status != CONNECT_ACCEPTED
        || response_exchange.kind != ACTION_EXCHANGE) { ret 18; }
    var first_server_response: message.Response;
    var retry_body_context: u8 = 0;
    var retry_body: body.Reader = body.init_reader(
        (?retry_body_context)::ptr, test_retry_body_read,
        test_retry_body_finish, test_retry_body_complete,
        test_retry_body_release, body.OWNER_APPLICATION, 44, true, 0,
        client_config.message_limits.response_body, nil, ?parent);
    if (!message.init_response(?first_server_response, nil, 0, nil, 0, 44,
            client_config.message_limits)
        || message.set_status(?first_server_response,
            status.SERVICE_UNAVAILABLE) != message.RESPONSE_OK
        || message.set_body_reader(?first_server_response, ?retry_body,
            client_config.message_limits) != message.RESPONSE_OK
        || message.commit_response(?first_server_response, method.GET,
            client_config.message_limits) != message.RESPONSE_OK) { ret 19; }
    val server_failure: policy.Failure = policy.Failure{
        reason: policy.RETRY_SERVER, definitely_unprocessed: false,
        response_started: true, response_complete: true, retry_after_ns: 0};
    val contradictory: policy.Failure = policy.Failure{
        reason: policy.RETRY_SERVER, definitely_unprocessed: true,
        response_started: true, response_complete: true, retry_after_ns: 0};
    val wrong_status: policy.Failure = policy.Failure{
        reason: policy.RETRY_RATE_LIMIT, definitely_unprocessed: false,
        response_started: true, response_complete: true, retry_after_ns: 0};
    if (exchange_response_retry(?client, response_submission.token,
            response_exchange.lease,
            ?first_server_response, body.REUSE_ALLOWED, server_failure, now)
            != EXCHANGE_RESPONSE_INVALID
        || body.drain(?retry_body).status != body.COMPLETE
        || exchange_response_retry(?client, response_submission.token,
            response_exchange.lease, ?first_server_response,
            body.REUSE_FORBIDDEN, server_failure, now)
            != EXCHANGE_RESPONSE_INVALID
        || exchange_response_retry(?client, response_submission.token,
            response_exchange.lease,
            ?first_server_response, body.REUSE_ALLOWED, contradictory, now)
            != EXCHANGE_RESPONSE_INVALID
        || exchange_response_retry(?client, response_submission.token,
            response_exchange.lease,
            ?first_server_response, body.REUSE_ALLOWED, wrong_status, now)
            != EXCHANGE_RESPONSE_INVALID
        || exchange_response_retry(?client, response_submission.token,
            response_exchange.lease,
            ?first_server_response, body.REUSE_ALLOWED, server_failure, now)
            != EXCHANGE_RESPONSE_RETRY
        || next(?client, response_submission.token, now).kind
            != ACTION_REPLAY) { ret 20; }
    var final_reader: body.Reader;
    var final_request: message.Request;
    if (!test_request(?final_request, ?final_reader, 45, false,
            time.Time{sec: 0, nsec: 0}, client_config.message_limits)
        || !replay_ready(?client, response_submission.token,
            ?final_request)) { ret 21; }
    val final_exchange: Action = next(?client,
        response_submission.token, now);
    if (final_exchange.kind != ACTION_EXCHANGE) { ret 21; }
    var final_server_response: message.Response;
    if (!test_response(?final_server_response, 45,
            status.SERVICE_UNAVAILABLE, client_config.message_limits)
        || exchange_response_retry(?client, response_submission.token,
            response_exchange.lease, ?final_server_response,
            body.REUSE_ALLOWED, server_failure, now)
            != EXCHANGE_RESPONSE_INVALID
        || exchange_response_retry(?client, response_submission.token,
            final_exchange.lease,
            ?final_server_response, body.REUSE_ALLOWED, server_failure, now)
            != EXCHANGE_RESPONSE_COMPLETE) { ret 22; }
    val final_action: Action = next(?client, response_submission.token, now);
    if (final_action.kind != ACTION_COMPLETE
        || final_action.completion.outcome != OUTCOME_OK
        || final_action.completion.error != ERROR_NONE
        || final_action.completion.response != ?final_server_response
        || final_action.completion.retry_reason != policy.RETRY_SERVER
        || final_action.completion.attempts != 2
        || !release_request(?client, response_submission.token)) { ret 23; }

    var upgrade_reader: body.Reader;
    var upgrade_request: message.Request;
    if (!test_request(?upgrade_request, ?upgrade_reader, 46, false,
        time.Time{sec: 0, nsec: 0}, client_config.message_limits)) { ret 24; }
    val upgrade_submission: Submission = submit(?client, ?parent,
        ?upgrade_request, route, policy.protocols_default(),
        policy.Replay{explicit: true, body: policy.BODY_EMPTY},
        policy.retry_policy_default(), policy.redirect_policy_default());
    val upgrade_exchange: Action = next(?client, upgrade_submission.token,
        now);
    var upgrade_response: message.Response;
    if (upgrade_submission.status != SUBMIT_OK
        || upgrade_exchange.kind != ACTION_EXCHANGE
        || !test_response(?upgrade_response, 46,
            status.SWITCHING_PROTOCOLS, client_config.message_limits)
        || exchange_complete(?client, upgrade_submission.token,
            upgrade_exchange.lease, ?upgrade_response,
            body.REUSE_ALLOWED, now)
        || !exchange_complete(?client, upgrade_submission.token,
            upgrade_exchange.lease, ?upgrade_response,
            body.REUSE_FORBIDDEN, now)
        || next(?client, upgrade_submission.token, now).kind
            != ACTION_COMPLETE
        || !release_request(?client, upgrade_submission.token)) { ret 25; }
    val upgrade_close: Maintenance = maintenance(?client, now);
    if (upgrade_close.kind != MAINTENANCE_CLOSE
        || !pool.retire(?connections, upgrade_close.close)) { ret 26; }
    if (!test_shutdown(?client, ?cache, ?connections, ?parent, now)) {
        ret 27;
    }
    ret 0;
}

test "http.client.client: temporary dns failures wait for cache retry time" {
    var cache_entries: [1]dns.Entry;
    var cache_endpoints: [1]ip.Endpoint;
    var cache: dns.Cache;
    var cache_config: dns.Config = dns.config_default();
    cache_config.max_entries = 1;
    cache_config.max_endpoints_per_entry = 1;
    cache_config.failure_ns = 10;
    if (!dns.init(?cache, ?cache_entries[0], 1, ?cache_endpoints[0], 1,
        cache_config)) { ret 1; }
    var pool_connections: [1]pool.Connection;
    var pool_leases: [1]pool.LeaseSlot;
    var connections: pool.Pool;
    var pool_config: pool.Config = pool.config_default();
    pool_config.max_connections = 1;
    pool_config.max_connections_per_route = 1;
    pool_config.max_leases = 1;
    pool_config.max_idle = 0;
    pool_config.max_idle_per_route = 0;
    if (!pool.init(?connections, ?pool_connections[0], 1,
        ?pool_leases[0], 1, pool_config)) { ret 2; }
    var slots: [1]RequestSlot;
    var request_endpoints: [1]ip.Endpoint;
    var client: Client;
    var client_config: Config = config_default();
    client_config.max_requests = 1;
    client_config.max_endpoints_per_request = 1;
    if (!init(?client, ?cache, ?connections, ?slots[0], 1,
        ?request_endpoints[0], 1, client_config)) { ret 3; }
    var parent: cancellation.Scope;
    if (!cancellation.make_root(?parent, false,
        time.Time{sec: 0, nsec: 0})) { ret 4; }
    var reader: body.Reader;
    var request: message.Request;
    if (!test_request(?request, ?reader, 51, false,
        time.Time{sec: 0, nsec: 0}, client_config.message_limits)) { ret 5; }
    val submitted: Submission = submit(?client, ?parent, ?request,
        test_route("dns.example", 11), policy.protocols_default(),
        policy.Replay{explicit: true, body: policy.BODY_EMPTY},
        policy.RetryPolicy{max_attempts: 2, retry_request_timeout: false,
            retry_too_early: false, retry_rate_limit: false,
            retry_server: false}, policy.redirect_policy_default());
    val now: time.Time = time.Time{sec: 11, nsec: 20};
    val first_query: Action = next(?client, submitted.token, now);
    if (submitted.status != SUBMIT_OK || first_query.kind != ACTION_RESOLVE
        || !resolution_submit_failed(?client, submitted.token,
            resolver.Error{kind: resolver.TEMPORARY, native_code: 1}, now)) {
        ret 6;
    }
    val waiting: Action = next(?client, submitted.token, now);
    val ready: time.Time = time.Time{sec: 11, nsec: 30};
    if (waiting.kind != ACTION_WAIT_TIMER
        || !time.time_equal(waiting.ready_at, ready)
        || next(?client, submitted.token,
            time.Time{sec: 11, nsec: 29}).kind != ACTION_WAIT_TIMER) { ret 7; }
    val second_query: Action = next(?client, submitted.token, ready);
    if (second_query.kind != ACTION_RESOLVE
        || !resolution_submit_failed(?client, submitted.token,
            resolver.Error{kind: resolver.NO_NAME, native_code: 2}, ready)) {
        ret 8;
    }
    val completed: Action = next(?client, submitted.token, ready);
    if (completed.kind != ACTION_COMPLETE
        || completed.completion.error != ERROR_DNS
        || completed.completion.attempts != 2
        || completed.completion.resolver_error.kind != resolver.NO_NAME
        || !release_request(?client, submitted.token)) { ret 9; }
    if (!test_shutdown(?client, ?cache, ?connections, ?parent, ready)) {
        ret 10;
    }
    ret 0;
}

test "http.client.client: cancellation wins connect and exchange races" {
    var cache_entries: [1]dns.Entry;
    var cache_endpoints: [1]ip.Endpoint;
    var cache: dns.Cache;
    var cache_config: dns.Config = dns.config_default();
    cache_config.max_entries = 1;
    cache_config.max_endpoints_per_entry = 1;
    if (!dns.init(?cache, ?cache_entries[0], 1, ?cache_endpoints[0], 1,
        cache_config)) { ret 1; }
    var pool_connections: [2]pool.Connection;
    var pool_leases: [2]pool.LeaseSlot;
    var connections: pool.Pool;
    var pool_config: pool.Config = pool.config_default();
    pool_config.max_connections = 2;
    pool_config.max_connections_per_route = 2;
    pool_config.max_leases = 2;
    pool_config.max_idle = 2;
    pool_config.max_idle_per_route = 2;
    if (!pool.init(?connections, ?pool_connections[0], 2,
        ?pool_leases[0], 2, pool_config)) { ret 2; }
    var slots: [2]RequestSlot;
    var request_endpoints: [2]ip.Endpoint;
    var client: Client;
    var client_config: Config = config_default();
    client_config.max_requests = 2;
    client_config.max_endpoints_per_request = 1;
    if (!init(?client, ?cache, ?connections, ?slots[0], 2,
        ?request_endpoints[0], 2, client_config)) { ret 3; }
    var parent: cancellation.Scope;
    if (!cancellation.make_root(?parent, false,
        time.Time{sec: 0, nsec: 0})) { ret 4; }
    val route: policy.Route = test_route("race.example", 12);
    val now: time.Time = time.Time{sec: 12, nsec: 0};
    var first_reader: body.Reader;
    var first_request: message.Request;
    if (!test_request(?first_request, ?first_reader, 61, false,
        time.Time{sec: 0, nsec: 0}, client_config.message_limits)) { ret 5; }
    val first: Submission = submit(?client, ?parent, ?first_request, route,
        policy.protocols_default(),
        policy.Replay{explicit: true, body: policy.BODY_EMPTY},
        policy.retry_policy_default(), policy.redirect_policy_default());
    val resolving: Action = next(?client, first.token, now);
    if (first.status != SUBMIT_OK
        || !test_publish_resolution(?client, first.token, resolving,
            ip.endpoint(192, 0, 2, 61, 443),
            resolver.Token{index: 6, generation: 1}, now)) { ret 6; }
    val connecting: Action = next(?client, first.token, now);
    var late_driver: u8 = 1;
    if (!cancel_request(?client, first.token)) { ret 7; }
    val connect_result: Connected = connected(?client, first.token,
        connecting.reservation,
        true, view.view("h2", 2), (?late_driver)::ptr, 4, now);
    if (connect_result.status != CONNECT_CANCELLED
        || !connect_result.close_driver
        || next(?client, first.token, now).completion.outcome
            != OUTCOME_CANCELLED
        || !release_request(?client, first.token)) { ret 8; }

    var second_reader: body.Reader;
    var second_request: message.Request;
    if (!test_request(?second_request, ?second_reader, 62, false,
        time.Time{sec: 0, nsec: 0}, client_config.message_limits)) { ret 9; }
    val second: Submission = submit(?client, ?parent, ?second_request, route,
        policy.protocols_default(),
        policy.Replay{explicit: true, body: policy.BODY_EMPTY},
        policy.retry_policy_default(), policy.redirect_policy_default());
    val second_connect: Action = next(?client, second.token, now);
    var driver: u8 = 2;
    val second_connected: Connected = connected(?client, second.token,
        second_connect.reservation, true, view.view("h2", 2),
        (?driver)::ptr, 0, now);
    val zero_credit: pool.Snapshot = pool.snapshot(?connections);
    if (second.status != SUBMIT_OK || second_connect.kind != ACTION_CONNECT
        || second_connected.status != CONNECT_ACCEPTED
        || zero_credit.live_connections != 1 || zero_credit.live_leases != 0
        || zero_credit.idle != 1
        || !pool.update_max_streams(?connections,
            second_connect.reservation.connection, 4)) { ret 10; }
    val second_exchange: Action = next(?client, second.token, now);
    if (second_exchange.kind != ACTION_EXCHANGE
        || !pool.update_max_streams(?connections,
            second_exchange.lease.connection, 0)) { ret 10; }

    var duplicate_reader: body.Reader;
    var duplicate_request: message.Request;
    if (!test_request(?duplicate_request, ?duplicate_reader, 66, false,
            time.Time{sec: 0, nsec: 0}, client_config.message_limits)) { ret 11; }
    val duplicate_submission: Submission = submit(?client, ?parent,
        ?duplicate_request, route, policy.protocols_default(),
        policy.Replay{explicit: true, body: policy.BODY_EMPTY},
        policy.retry_policy_default(), policy.redirect_policy_default());
    val duplicate_connect: Action = next(?client, duplicate_submission.token,
        now);
    if (duplicate_submission.status != SUBMIT_OK
        || duplicate_connect.kind != ACTION_CONNECT
        || !cancel_request(?client, duplicate_submission.token)) { ret 12; }
    val transferred_driver: Connected = connected(?client,
        duplicate_submission.token, duplicate_connect.reservation, true,
        view.view("h2", 2), (?driver)::ptr, 4, now);
    var duplicate_late_driver: u8 = 3;
    val duplicate_cancelled: Connected = connected(?client,
        duplicate_submission.token, duplicate_connect.reservation, true,
        view.view("h2", 2), (?duplicate_late_driver)::ptr, 4, now);
    if (transferred_driver.status != CONNECT_INVALID
        || transferred_driver.close_driver
        || duplicate_cancelled.status != CONNECT_CANCELLED
        || !duplicate_cancelled.close_driver
        || next(?client, duplicate_submission.token, now).completion.outcome
            != OUTCOME_CANCELLED
        || !release_request(?client, duplicate_submission.token)
        || !cancel_request(?client, second.token)) { ret 13; }
    var response: message.Response;
    var cancelled_redirect_reader: body.Reader;
    var cancelled_redirect_request: message.Request;
    if (!test_response(?response, 62, status.SEE_OTHER,
            client_config.message_limits)
        || !test_request(?cancelled_redirect_request,
            ?cancelled_redirect_reader, 65, false,
            time.Time{sec: 0, nsec: 0}, client_config.message_limits)
        || follow_redirect(?client, second.token, second_exchange.lease,
            ?response, body.REUSE_ALLOWED, route,
            ?cancelled_redirect_request, now) != policy.REDIRECT_CANCELLED) {
        ret 14;
    }
    val completed: Action = next(?client, second.token, now);
    if (completed.kind != ACTION_COMPLETE
        || completed.completion.outcome != OUTCOME_CANCELLED
        || completed.completion.response != nil
        || !release_request(?client, second.token)) { ret 15; }
    val closing: Maintenance = maintenance(?client, now);
    if (closing.kind != MAINTENANCE_NONE) { ret 16; }

    var owner_reader: body.Reader;
    var owner_request: message.Request;
    var waiter_reader: body.Reader;
    var waiter_request: message.Request;
    if (!test_request(?owner_request, ?owner_reader, 63, false,
            time.Time{sec: 0, nsec: 0}, client_config.message_limits)
        || !test_request(?waiter_request, ?waiter_reader, 64, false,
            time.Time{sec: 0, nsec: 0}, client_config.message_limits)) { ret 17; }
    val shared_route: policy.Route = test_route("dns-race.example", 16);
    val owner: Submission = submit(?client, ?parent, ?owner_request,
        shared_route, policy.protocols_default(),
        policy.Replay{explicit: true, body: policy.BODY_EMPTY},
        policy.retry_policy_default(), policy.redirect_policy_default());
    val waiter: Submission = submit(?client, ?parent, ?waiter_request,
        shared_route, policy.protocols_default(),
        policy.Replay{explicit: true, body: policy.BODY_EMPTY},
        policy.retry_policy_default(), policy.redirect_policy_default());
    val shared_query: Action = next(?client, owner.token, now);
    if (owner.status != SUBMIT_OK || waiter.status != SUBMIT_OK
        || shared_query.kind != ACTION_RESOLVE
        || next(?client, waiter.token, now).kind != ACTION_WAIT_DNS
        || !cancel_request(?client, owner.token)
        || next(?client, owner.token, now).kind != ACTION_WAIT_DNS
        || !resolution_submitted(?client, owner.token,
            resolver.Token{index: 9, generation: 1})) { ret 18; }
    var shared_endpoint: ip.Endpoint = ip.endpoint(192, 0, 2, 64, 443);
    var shared_completion: resolver.Completion = resolver.Completion{
        token: resolver.Token{index: 9, generation: 1},
        context: shared_query.dns_query.context,
        resolution: resolver.Resolution{endpoints: ?shared_endpoint, len: 1,
            endpoint_capacity: 1, canonical_name: nil, canonical_length: 0,
            canonical_capacity: 0, allocator: nil}, has_error: false,
        error: no_resolver_error()};
    if (complete_resolution(?client, ?shared_completion, now) != dns.COMPLETE_OK
        || next(?client, owner.token, now).completion.outcome
            != OUTCOME_CANCELLED
        || !release_request(?client, owner.token)) { ret 19; }
    val waiter_connect: Action = next(?client, waiter.token, now);
    val unprocessed: policy.Failure = policy.Failure{
        reason: policy.RETRY_CONNECT, definitely_unprocessed: true,
        response_started: false, response_complete: false, retry_after_ns: 0};
    if (waiter_connect.kind != ACTION_CONNECT
        || !cancel_request(?client, waiter.token)
        || connect_failed(?client, waiter.token, waiter_connect.reservation,
            unprocessed, now) != CONNECT_CANCELLED
        || next(?client, waiter.token, now).completion.outcome
            != OUTCOME_CANCELLED
        || !release_request(?client, waiter.token)) { ret 20; }
    if (!test_shutdown(?client, ?cache, ?connections, ?parent, now)) {
        ret 21;
    }
    ret 0;
}

test "http.client.client: hostile ownership and lifecycle inputs stay transactional" {
    var cache_entries: [1]dns.Entry;
    var cache_endpoints: [1]ip.Endpoint;
    var cache: dns.Cache;
    var cache_config: dns.Config = dns.config_default();
    cache_config.max_entries = 1;
    cache_config.max_endpoints_per_entry = 1;
    var pool_connections: [1]pool.Connection;
    var pool_leases: [1]pool.LeaseSlot;
    var connections: pool.Pool;
    var pool_config: pool.Config = pool.config_default();
    pool_config.max_connections = 1;
    pool_config.max_connections_per_route = 1;
    pool_config.max_leases = 1;
    pool_config.max_idle = 1;
    pool_config.max_idle_per_route = 1;
    var slots: [1]RequestSlot;
    var request_endpoints: [1]ip.Endpoint;
    var client: Client;
    var client_config: Config = config_default();
    client_config.max_requests = 1;
    client_config.max_endpoints_per_request = 1;
    if (!dns.init(?cache, ?cache_entries[0], 1, ?cache_endpoints[0], 1,
            cache_config)
        || !pool.init(?connections, ?pool_connections[0], 1,
            ?pool_leases[0], 1, pool_config)
        || !dns.drain(?cache)
        || init(?client, ?cache, ?connections, ?slots[0], 1,
            ?request_endpoints[0], 1, client_config)
        || !pool.drain(?connections)
        || !dns.destroy(?cache) || !pool.destroy(?connections)) { ret 1; }

    if (!dns.init(?cache, ?cache_entries[0], 1, ?cache_endpoints[0], 1,
            cache_config)
        || !pool.init(?connections, ?pool_connections[0], 1,
            ?pool_leases[0], 1, pool_config)
        || !init(?client, ?cache, ?connections, ?slots[0], 1,
            ?request_endpoints[0], 1, client_config)) { ret 2; }
    if (complete_resolution(?client,
            (?slots[0])::ptr::*resolver.Completion,
            time.Time{sec: 1, nsec: 0}) != dns.COMPLETE_INVALID
        || complete_resolution(?client,
            (?request_endpoints[0])::ptr::*resolver.Completion,
            time.Time{sec: 1, nsec: 0}) != dns.COMPLETE_INVALID) { ret 3; }
    val parent_deadline: time.Time = time.Time{sec: 5, nsec: 0};
    var parent: cancellation.Scope;
    if (!cancellation.make_root(?parent, true, parent_deadline)) { ret 4; }
    var deadline_reader: body.Reader;
    var deadline_request: message.Request;
    if (!test_request(?deadline_request, ?deadline_reader, 71, true,
            time.Time{sec: 10, nsec: 0}, client_config.message_limits)
        || submit(?client, ?parent, ?deadline_request,
            test_route("hostile.example", 15), policy.protocols_default(),
            policy.Replay{explicit: true, body: policy.BODY_EMPTY},
            policy.retry_policy_default(), policy.redirect_policy_default())
            .status != SUBMIT_INVALID
        || parent.first_child != nil || client.live_requests != 0) { ret 5; }

    var alias_reader: body.Reader;
    var alias_request: message.Request;
    if (!test_request(?alias_request, ?alias_reader, 72, true,
            parent_deadline, client_config.message_limits)) { ret 6; }
    alias_request.trailers = field.init(
        (?request_endpoints[0])::ptr::*field.Field, 1,
        client_config.message_limits.request_trailers);
    alias_reader.trailers = ?alias_request.trailers;
    if (submit(?client, ?parent, ?alias_request,
        test_route("hostile.example", 15), policy.protocols_default(),
        policy.Replay{explicit: true, body: policy.BODY_EMPTY},
        policy.retry_policy_default(), policy.redirect_policy_default()).status
        != SUBMIT_INVALID) { ret 7; }

    var nested_fields: field.Fields = field.init(
        (?request_endpoints[0])::ptr::*field.Field, 1,
        client_config.message_limits.response_trailers);
    var nested_context: u8 = 0;
    var nested_reader: body.Reader = body.init_reader(
        (?nested_context)::ptr, test_retry_body_read,
        test_retry_body_finish, test_retry_body_complete,
        test_retry_body_release, body.OWNER_APPLICATION, 73, true, 0,
        client_config.message_limits.response_body, ?nested_fields, ?parent);
    var nested_response: message.Response;
    if (!message.init_response(?nested_response, nil, 0, nil, 0, 73,
        client_config.message_limits)) { ret 7; }
    if (message.set_status(?nested_response, status.OK)
        != message.RESPONSE_OK) { ret 8; }
    if (message.set_body_reader(?nested_response, ?nested_reader,
        client_config.message_limits) != message.RESPONSE_OK) { ret 9; }
    if (message.commit_response(?nested_response, method.GET,
        client_config.message_limits) != message.RESPONSE_OK) { ret 10; }
    nested_reader.trailers = ?nested_fields;
    if (!response_aliases(?client, ?nested_response, nil)
        || body.drain(?nested_reader).status != body.COMPLETE) { ret 11; }

    var writer_fields: field.Fields = field.init(
        (?request_endpoints[0])::ptr::*field.Field, 1,
        client_config.message_limits.response_trailers);
    var writer_context: u8 = 0;
    var nested_writer: body.Writer = body.init_writer(
        (?writer_context)::ptr, test_retry_body_write,
        test_retry_body_finish, test_retry_body_complete,
        test_retry_body_release, body.OWNER_APPLICATION, 74, true, 0,
        client_config.message_limits.response_body, ?writer_fields, ?parent);
    var writer_response: message.Response;
    if (!message.init_response(?writer_response, nil, 0, nil, 0, 74,
            client_config.message_limits)
        || message.set_status(?writer_response, status.OK)
            != message.RESPONSE_OK
        || message.set_body_writer(?writer_response, ?nested_writer,
            client_config.message_limits) != message.RESPONSE_OK
        || message.commit_response(?writer_response, method.GET,
            client_config.message_limits) != message.RESPONSE_OK) { ret 12; }
    nested_writer.trailers = ?writer_fields;
    if (!response_aliases(?client, ?writer_response, nil)
        || body.finish(?nested_writer).status != body.COMPLETE) { ret 13; }

    var connect_request: message.Request;
    connect_request.method = method.from_kind(method.CONNECT);
    var connect_slot: RequestSlot;
    connect_slot.request = ?connect_request;
    var connect_response: message.Response;
    connect_response.status = status.OK;
    val allowed: body.Progress = body.complete(body.REUSE_ALLOWED);
    if (exchange_reuse(?connect_slot, pool.Lease{token: empty_lease_token(),
            connection: empty_connection_token(), driver: nil,
            wire: message.WIRE_H1}, ?connect_response, allowed, allowed)
            != body.REUSE_FORBIDDEN
        || combine_reuse(body.REUSE_FORBIDDEN, body.REUSE_ALLOWED)
            != body.REUSE_FORBIDDEN) { ret 14; }

    if (!test_shutdown(?client, ?cache, ?connections, ?parent,
        parent_deadline)) { ret 15; }
    ret 0;
}
