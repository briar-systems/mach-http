use std.runtime;
use std.types.string.str;

pub val VERSION: str = "0.7.1";

fwd http.core.method;
fwd http.core.status;
fwd http.core.field;
fwd http.core.target;
fwd http.core.body;
fwd http.core.message;
fwd http.core.exchange;
fwd http.core.transport;
fwd http.h1.framing;
fwd http.h1.parser;
fwd http.h1.serializer;
fwd http.h1.connection;
fwd h2_frame: http.h2.frame;
fwd http.h2.hpack;
fwd h2_connection: http.h2.connection;
fwd h3_frame: http.h3.frame;
fwd http.h3.qpack;
fwd h3_connection: http.h3.connection;
fwd http.websocket;
fwd http.websocket.negotiation;
fwd http.server.server;
fwd http.client.policy;
fwd http.client.url;
fwd http.client.pool;
fwd http.client.dns;
fwd http.client.client;
fwd http.router.router;

test "http: exported version is the release version" {
    if (VERSION[0] != '0' || VERSION[1] != '.' || VERSION[2] != '7'
     || VERSION[3] != '.' || VERSION[4] != '1' || VERSION[5] != 0) { ret 1; }
    ret 0;
}
