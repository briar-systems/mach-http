use http.core.body;
use http.core.field;
use http.core.message;
use http.core.method;
use http.core.status;
use http.core.target;
use http.core.transport;
use http.h1.framing;
use http.h1.parser;
use http.h1.serializer;
use std.allocator;
use std.allocator.page;
use std.chrono.time;
use io_error: std.io.error;
use std.io.lifecycle;
use io_runtime: std.io.runtime;
use std.memory;
use std.memory.buffers;
use std.sync.cancel;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view;

fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

fun transition_ok(outcome: cancel.Transition) bool {
    ret (sel outcome.ok) && outcome.ok;
}

fun scope_active(scope: *cancel.Scope) bool {
    val reason: cancel.Reason = cancel.reason(scope);
    ret sel reason.active;
}

pub def Role: u8;
pub val SERVER: Role = 1;
pub val CLIENT: Role = 2;

pub def State: u8;
pub val OPEN:     State = 1;
pub val DRAINING: State = 2;
pub val TUNNEL:   State = 3;
pub val CLOSING:  State = 4;
pub val CLOSED:   State = 5;
pub val FAILED:   State = 6;

pub def SlotState: u8;
pub val SLOT_FREE: SlotState = 1;
pub val SLOT_LIVE: SlotState = 2;

pub def Disposition: u8;
pub val BODY_DELIVER: Disposition = 1;
pub val BODY_DRAIN:   Disposition = 2;
pub val BODY_REJECT:  Disposition = 3;
pub val BODY_CLOSE:   Disposition = 4;

pub def OutKind: u8;
pub val OUT_NONE:          OutKind = 0;
pub val OUT_REQUEST:       OutKind = 1;
pub val OUT_INFORMATIONAL: OutKind = 2;
pub val OUT_RESPONSE:      OutKind = 3;

pub def EventKind: u8;
pub val EVENT_NONE:                   EventKind = 0;
pub val EVENT_NEED_READ:              EventKind = 1;
pub val EVENT_SATURATED:              EventKind = 2;
pub val EVENT_REQUEST_HEADERS:        EventKind = 3;
pub val EVENT_REQUEST_BODY:           EventKind = 4;
pub val EVENT_REQUEST_COMPLETE:       EventKind = 5;
pub val EVENT_INFORMATIONAL:          EventKind = 6;
pub val EVENT_RESPONSE_HEADERS:       EventKind = 7;
pub val EVENT_RESPONSE_BODY:          EventKind = 8;
pub val EVENT_RESPONSE_COMPLETE:      EventKind = 9;
pub val EVENT_OUTBOUND_INFORMATIONAL: EventKind = 10;
pub val EVENT_OUTBOUND_COMPLETE:      EventKind = 11;
pub val EVENT_TUNNEL:                 EventKind = 12;
pub val EVENT_PEER_CLOSED:            EventKind = 13;
pub val EVENT_CLOSED:                 EventKind = 14;
pub val EVENT_CANCELLED:              EventKind = 15;
pub val EVENT_TIMED_OUT:              EventKind = 16;
pub val EVENT_ERROR:                  EventKind = 17;
pub val EVENT_MEMORY_BLOCKED:         EventKind = 18;

pub def Error: u8;
pub val ERROR_NONE:            Error = 0;
pub val ERROR_STATE:           Error = 1;
pub val ERROR_LIMIT:           Error = 2;
pub val ERROR_PROTOCOL:        Error = 3;
pub val ERROR_PARSER:          Error = 4;
pub val ERROR_SERIALIZER:      Error = 5;
pub val ERROR_TRANSPORT:       Error = 6;
pub val ERROR_NO_PROGRESS:     Error = 7;
pub val ERROR_HEADER_TIMEOUT:  Error = 8;
pub val ERROR_REQUEST_TIMEOUT: Error = 9;
pub val ERROR_IDLE_TIMEOUT:    Error = 10;
pub val ERROR_WRITE_TIMEOUT:   Error = 11;
pub val ERROR_TOTAL_TIMEOUT:   Error = 12;
pub val ERROR_CANCELLED:       Error = 13;
pub val ERROR_MEMORY:          Error = 14;

pub def OfferStatus: u8;
pub val OFFER_OUTPUT:  OfferStatus = 1;
pub val OFFER_BODY:    OfferStatus = 2;
pub val OFFER_DONE:    OfferStatus = 3;
pub val OFFER_BLOCKED: OfferStatus = 4;
pub val OFFER_ERROR:   OfferStatus = 5;

# every buffer is borrowed from the connection's std.memory.buffers account
# ---
# read_bytes:         the read buffer, held from readability until its input is consumed
# write_bytes:        the write buffer, held while output is staged
# slot_storage_bytes: parsed field and trailer bytes per slot
# slot_scratch_bytes: serialized head and trailer bytes per slot
# slot_lane:          the budget lane of per-request slot memory
# connection_lane:    the budget lane of the read and write buffers
pub rec Config {
    parser:             parser.Limits;
    max_pipeline:       usize;
    max_drain_bytes:    u64;
    header_timeout_ns:  u64;
    request_timeout_ns: u64;
    idle_timeout_ns:    u64;
    write_timeout_ns:   u64;
    total_timeout_ns:   u64;
    read_bytes:         usize;
    write_bytes:        usize;
    slot_storage_bytes: usize;
    slot_scratch_bytes: usize;
    slot_lane:          u8;
    connection_lane:    u8;
}

val SLOT_BUFFERS: usize = 5;

# the buffers one live slot borrows, all or nothing, until the slot is swept
pub rec SlotMemory {
    line:             *u8;
    line_capacity:    usize;
    storage:          *u8;
    storage_capacity: usize;
    fields:           *field.Field;
    field_capacity:   usize;
    trailers:         *field.Field;
    trailer_capacity: usize;
    scratch:          *u8;
    scratch_capacity: usize;
    chunks:           [5]buffers.Chunk;
    held:             bool;
}

pub rec Deadline {
    active: bool;
    at:     time.Instant;
}

pub rec Slot {
    state:             SlotState;
    sequence:          u64;
    memory:            SlotMemory;
    parser:            parser.Parser;
    serializer:        serializer.Serializer;
    request_method:    method.Method;
    headers_reported:  bool;
    informational:     bool;
    inbound_complete:  bool;
    inbound_abandoned: bool;
    outbound_complete: bool;
    serializer_active: bool;
    final_prepared:    bool;
    released:          bool;
    disposition:       Disposition;
    drained:           u64;
    close_after:       bool;
    upgrade_requested: bool;
    tunnel_ready:      bool;
    out_kind:          OutKind;
    header_deadline:   Deadline;
    request_deadline:  Deadline;
    write_deadline:    Deadline;
}

pub rec Event {
    kind:        EventKind;
    slot:        usize;
    sequence:    u64;
    body:        *u8;
    body_length: usize;
    body_final:  bool;
    error:       Error;
}

pub rec Offer {
    status:   OfferStatus;
    consumed: usize;
    produced: usize;
    error:    Error;
}

pub rec Engine {
    role:               Role;
    state:              State;
    configured:         Config;
    transport:          *transport.Transport;
    scope:              *cancel.Scope;
    slots:              *Slot;
    capacity:           usize;
    head:               usize;
    count:              usize;
    next_sequence:      u64;
    receiving:          usize;
    source:             *buffers.Source;
    account:            *buffers.Account;
    memory_blocked:     bool;
    read_buffer:        *u8;
    read_capacity:      usize;
    read_chunk:         buffers.Chunk;
    read_held:          bool;
    readable:           bool;
    read_kind:          transport.Kind;
    input_length:       usize;
    input_offset:       usize;
    input_eof:          bool;
    read_pending:       bool;
    read_token:         transport.Token;
    write_buffer:       *u8;
    write_capacity:     usize;
    write_chunk:        buffers.Chunk;
    write_held:         bool;
    write_length:       usize;
    write_offset:       usize;
    write_pending:      bool;
    write_terminal:     bool;
    write_slot:         usize;
    write_kind:         OutKind;
    write_token:        transport.Token;
    held_body:          *u8;
    held_length:        usize;
    held_final:         bool;
    held_slot:          usize;
    shutdown_pending:   bool;
    shutdown_done:      bool;
    shutdown_token:     transport.Token;
    close_pending:      bool;
    close_token:        transport.Token;
    graceful_requested: bool;
    tunnel_slot:        usize;
    tunnel_reported:    bool;
    idle_deadline:      Deadline;
    wait_deadline:      Deadline;
    total_deadline:     Deadline;
    error:              Error;
    initialized:        bool;
}

pub val NO_SLOT: usize = (-1)::usize;

pub fun config_default() Config {
    ret Config{
        parser:             parser.limits_default(),
        max_pipeline:       16,
        max_drain_bytes:    1048576,
        header_timeout_ns:  10000000000,
        request_timeout_ns: 30000000000,
        idle_timeout_ns:    60000000000,
        write_timeout_ns:   30000000000,
        total_timeout_ns:   300000000000,
        read_bytes:         8192,
        write_bytes:        8192,
        slot_storage_bytes: 40960,
        slot_scratch_bytes: 16384,
        slot_lane:          0,
        connection_lane:    0,
    };
}

fun valid_now(now: time.Instant) bool {
    ret now.sec >= 0 && now.nsec >= 0 && now.nsec < 1000000000;
}

fun duration_valid(value: u64) bool {
    ret value != 0 && value <= 0x7fffffffffffffff;
}

fun deadline(now: time.Instant, duration: u64) Deadline {
    var seconds:     u64 = duration / 1000000000;
    var nanoseconds: i64 = now.nsec + (duration % 1000000000)::i64;
    if (nanoseconds >= 1000000000) {
        nanoseconds = nanoseconds - 1000000000;
        seconds     = seconds + 1;
    }
    if (seconds > 0x7fffffffffffffff - now.sec::u64) {
        ret Deadline{active: true, at: time.Instant{sec: 0x7fffffffffffffff, nsec: 999999999}};
    }
    ret Deadline{active: true, at: time.Instant{sec: now.sec + seconds::i64, nsec: nanoseconds}};
}

fun expired(value: Deadline, now: time.Instant) bool {
    ret value.active && !time.instant_before(now, value.at);
}

fun line_bytes(configured: parser.Limits) usize {
    var bytes: usize = configured.max_start_line;
    if (bytes < configured.max_header_line) { bytes = configured.max_header_line; }
    if (bytes < configured.max_chunk_line)  { bytes = configured.max_chunk_line; }
    ret bytes;
}

fun config_valid(configured: Config, capacity: usize) bool {
    ret configured.max_pipeline != 0 && configured.max_pipeline <= capacity
        && configured.read_bytes != 0 && configured.write_bytes != 0
        && configured.slot_storage_bytes != 0 && configured.slot_scratch_bytes != 0
        && configured.parser.max_headers != 0 && configured.parser.max_trailers != 0
        && configured.parser.max_headers <= (-1)::usize / $size_of(field.Field)
        && configured.parser.max_trailers <= (-1)::usize / $size_of(field.Field)
        && line_bytes(configured.parser) != 0
        && configured.max_drain_bytes != 0
        && duration_valid(configured.header_timeout_ns)
        && duration_valid(configured.request_timeout_ns)
        && duration_valid(configured.idle_timeout_ns)
        && duration_valid(configured.write_timeout_ns)
        && duration_valid(configured.total_timeout_ns);
}

fun empty_event(engine: *Engine, kind: EventKind) Event {
    ret Event{kind: kind, slot: NO_SLOT, sequence: 0, body: nil, body_length: 0,
        body_final: false, error: engine.error};
}

fun slot_event(engine: *Engine, kind: EventKind, index: usize) Event {
    val slot: *Slot = ?engine.slots[index];
    ret Event{kind: kind, slot: index, sequence: slot.sequence, body: nil,
        body_length: 0, body_final: false, error: engine.error};
}

fun body_event(engine: *Engine, kind: EventKind, index: usize) Event {
    val slot: *Slot = ?engine.slots[index];
    ret Event{kind: kind, slot: index, sequence: slot.sequence, body: engine.held_body,
        body_length: engine.held_length, body_final: engine.held_final, error: engine.error};
}

fun slot_live(engine: *Engine, index: usize) bool {
    ret engine != nil && engine.initialized && index < engine.capacity
        && engine.slots[index].state == SLOT_LIVE;
}

pub fun parsed(engine: *Engine, index: usize) *parser.Parsed {
    if (!slot_live(engine, index)) { ret nil; }
    ret ?engine.slots[index].parser.parsed;
}

fun buffer_request(bytes: usize, lane: u8) buffers.Request {
    ret buffers.Request{bytes: bytes, align: 0, lane: lane, secret: false};
}

fun granted(got: buffers.Acquired) bool {
    ret sel got.status.ok;
}

# a refusal registers the account, so the host re-drives the connection when the
# source reports the account ready
fun acquire_one(engine: *Engine, bytes: usize, chunk: *buffers.Chunk) bool {
    val got: buffers.Acquired = buffers.source_acquire(engine.source, engine.account,
        buffer_request(bytes, engine.configured.connection_lane), true);
    if (!granted(got)) {
        engine.memory_blocked = true;
        ret false;
    }
    engine.memory_blocked = false;
    @chunk                = got.chunk;
    ret true;
}

fun release_one(engine: *Engine, chunk: buffers.Chunk) {
    buffers.source_release(engine.source, engine.account, chunk);
}

fun acquire_read(engine: *Engine) bool {
    if (engine.read_held)                                                       { ret true; }
    if (!acquire_one(engine, engine.configured.read_bytes, ?engine.read_chunk)) { ret false; }
    engine.read_held     = true;
    engine.read_buffer   = engine.read_chunk.data;
    engine.read_capacity = engine.configured.read_bytes;
    ret true;
}

# callers release only once every input byte is consumed and no event views one
fun release_read(engine: *Engine) {
    if (!engine.read_held || engine.read_pending) { ret; }
    release_one(engine, engine.read_chunk);
    engine.read_held     = false;
    engine.read_buffer   = nil;
    engine.read_capacity = 0;
    engine.input_length  = 0;
    engine.input_offset  = 0;
}

fun acquire_write(engine: *Engine) bool {
    if (engine.write_held)                                                        { ret true; }
    if (!acquire_one(engine, engine.configured.write_bytes, ?engine.write_chunk)) { ret false; }
    engine.write_held     = true;
    engine.write_buffer   = engine.write_chunk.data;
    engine.write_capacity = engine.configured.write_bytes;
    ret true;
}

fun release_write(engine: *Engine) {
    if (!engine.write_held || engine.write_pending) { ret; }
    release_one(engine, engine.write_chunk);
    engine.write_held     = false;
    engine.write_buffer   = nil;
    engine.write_capacity = 0;
    engine.write_length   = 0;
    engine.write_offset   = 0;
}

# the slot's whole set, all or nothing. a refusal registers the account, since
# an http/1 peer does not retry a request the engine leaves unread
fun acquire_slot_memory(engine: *Engine, slot: *Slot) bool {
    val limits:   parser.Limits      = engine.configured.parser;
    val lane:     u8                 = engine.configured.slot_lane;
    var requests: [5]buffers.Request = [5]buffers.Request{
        buffer_request(line_bytes(limits), lane),
        buffer_request(engine.configured.slot_storage_bytes, lane),
        buffer_request(limits.max_headers * $size_of(field.Field), lane),
        buffer_request(limits.max_trailers * $size_of(field.Field), lane),
        buffer_request(engine.configured.slot_scratch_bytes, lane),
    };
    val got: buffers.Acquired = buffers.source_acquire_n(engine.source, engine.account,
        ?requests[0], SLOT_BUFFERS, ?slot.memory.chunks[0], true);
    if (!granted(got)) {
        engine.memory_blocked = true;
        ret false;
    }
    engine.memory_blocked        = false;
    slot.memory.line             = slot.memory.chunks[0].data;
    slot.memory.line_capacity    = line_bytes(limits);
    slot.memory.storage          = slot.memory.chunks[1].data;
    slot.memory.storage_capacity = engine.configured.slot_storage_bytes;
    slot.memory.fields           = slot.memory.chunks[2].data::*field.Field;
    slot.memory.field_capacity   = limits.max_headers;
    slot.memory.trailers         = slot.memory.chunks[3].data::*field.Field;
    slot.memory.trailer_capacity = limits.max_trailers;
    slot.memory.scratch          = slot.memory.chunks[4].data;
    slot.memory.scratch_capacity = engine.configured.slot_scratch_bytes;
    slot.memory.held             = true;
    ret true;
}

fun release_slot_memory(engine: *Engine, slot: *Slot) {
    if (slot.memory.held) {
        var i: usize = SLOT_BUFFERS;
        for (i != 0) {
            i = i - 1;
            release_one(engine, slot.memory.chunks[i]);
        }
    }
    var unbound: SlotMemory;
    slot.memory = unbound;
}

fun reset_slot(engine: *Engine, slot: *Slot) {
    release_slot_memory(engine, slot);
    slot.state                   = SLOT_FREE;
    slot.sequence                = 0;
    slot.request_method          = method.Method{kind: 0, token: view.view(nil, 0)};
    slot.headers_reported        = false;
    slot.informational           = false;
    slot.inbound_complete        = false;
    slot.inbound_abandoned       = false;
    slot.outbound_complete       = false;
    slot.serializer_active       = false;
    slot.final_prepared          = false;
    slot.released                = false;
    slot.disposition             = BODY_DELIVER;
    slot.drained                 = 0;
    slot.close_after             = false;
    slot.upgrade_requested       = false;
    slot.tunnel_ready            = false;
    slot.out_kind                = OUT_NONE;
    slot.header_deadline.active  = false;
    slot.request_deadline.active = false;
    slot.write_deadline.active   = false;
}

# an initialized engine holds no buffer: the read buffer, the write buffer and
# every slot's memory are acquired from `account` through `source` on demand
# ---
# slots:   the pipeline ring, at least max_pipeline records
# source:  the buffer source, which must outlive the engine
# account: the connection's open account on `source`, which must outlive the engine
pub fun init(engine: *Engine, role: Role, connection_transport: *transport.Transport,
    scope: *cancel.Scope, slots: *Slot, capacity: usize, source: *buffers.Source,
    account: *buffers.Account, configured: Config, now: time.Instant) bool {
    if (engine == nil || engine.initialized || (role != SERVER && role != CLIENT)
        || connection_transport == nil || !connection_transport.initialized || scope == nil
        || scope.root != connection_transport.operation_root || !scope_active(scope)
        || slots == nil || capacity == 0 || !config_valid(configured, capacity)
        || source == nil || account == nil || !account.open
        || !valid_now(now)) { ret false; }
    engine.source  = source;
    engine.account = account;
    var i: usize = 0;
    for (i < configured.max_pipeline) {
        var unbound: SlotMemory;
        slots[i].memory = unbound;
        reset_slot(engine, ?slots[i]);
        i = i + 1;
    }
    engine.role               = role;
    engine.state              = OPEN;
    engine.configured         = configured;
    engine.transport          = connection_transport;
    engine.scope              = scope;
    engine.slots              = slots;
    engine.capacity           = configured.max_pipeline;
    engine.head               = 0;
    engine.count              = 0;
    engine.next_sequence      = 1;
    engine.receiving          = NO_SLOT;
    engine.memory_blocked     = false;
    engine.read_buffer        = nil;
    engine.read_capacity      = 0;
    engine.read_held          = false;
    engine.readable           = false;
    engine.read_kind          = transport.READABLE;
    engine.input_length       = 0;
    engine.input_offset       = 0;
    engine.input_eof          = false;
    engine.read_pending       = false;
    engine.write_buffer       = nil;
    engine.write_capacity     = 0;
    engine.write_held         = false;
    engine.write_length       = 0;
    engine.write_offset       = 0;
    engine.write_pending      = false;
    engine.write_terminal     = false;
    engine.write_slot         = NO_SLOT;
    engine.write_kind         = OUT_NONE;
    engine.held_body          = nil;
    engine.held_length        = 0;
    engine.held_final         = false;
    engine.held_slot          = NO_SLOT;
    engine.shutdown_pending   = false;
    engine.shutdown_done      = false;
    engine.close_pending      = false;
    engine.graceful_requested = false;
    engine.tunnel_slot        = NO_SLOT;
    engine.tunnel_reported    = false;
    engine.idle_deadline      = deadline(now, configured.idle_timeout_ns);
    engine.wait_deadline      = Deadline{active: false, at: now};
    engine.total_deadline     = deadline(now, configured.total_timeout_ns);
    engine.error              = ERROR_NONE;
    engine.initialized        = true;
    await_request(engine, now);
    ret true;
}

# a server with no live slot owes its peer a request within the header timeout:
# from init for the first one, and from the peer's next bytes or readability
# after that. a running wait is never rearmed, so a memory refusal cannot extend
# it, and it only ends when a slot starts. the idle deadline keeps running beside it
fun await_request(engine: *Engine, now: time.Instant) {
    if (engine.role != SERVER || engine.count != 0 || engine.wait_deadline.active) { ret; }
    engine.wait_deadline = deadline(now, engine.configured.header_timeout_ns);
}

fun next_sequence(engine: *Engine) u64 {
    val sequence: u64 = engine.next_sequence;
    if (sequence == (-1)::u64) { engine.next_sequence = 0; }
    or {
        if (sequence != 0) { engine.next_sequence = sequence + 1; }
    }
    ret sequence;
}

fun tail_index(engine: *Engine) usize {
    ret (engine.head + engine.count) % engine.capacity;
}

fun start_slot(engine: *Engine, index: usize, now: time.Instant) *Slot {
    engine.memory_blocked = false;
    if (engine.next_sequence == 0) { ret nil; }
    val slot: *Slot = ?engine.slots[index];
    reset_slot(engine, slot);
    if (!acquire_slot_memory(engine, slot)) { ret nil; }
    slot.state                  = SLOT_LIVE;
    slot.sequence               = next_sequence(engine);
    slot.header_deadline        = deadline(now, engine.configured.header_timeout_ns);
    slot.request_deadline       = deadline(now, engine.configured.request_timeout_ns);
    engine.count                = engine.count + 1;
    engine.idle_deadline.active = false;
    engine.wait_deadline.active = false;
    ret slot;
}

fun allocate_server(engine: *Engine, now: time.Instant) usize {
    if ((engine.state != OPEN && !(engine.state == DRAINING
        && engine.graceful_requested && input_available(engine) != 0))
        || engine.count >= engine.capacity) { ret NO_SLOT; }
    val index: usize = tail_index(engine);
    val slot:  *Slot = start_slot(engine, index, now);
    if (slot == nil) { ret NO_SLOT; }
    val memory: SlotMemory = slot.memory;
    if (!parser.init_request(?slot.parser, memory.line, memory.line_capacity,
        memory.storage, memory.storage_capacity, memory.fields, memory.field_capacity,
        memory.trailers, memory.trailer_capacity, engine.configured.parser)) {
        reset_slot(engine, slot);
        engine.count = engine.count - 1;
        ret NO_SLOT;
    }
    engine.receiving = index;
    ret index;
}

fun lower(c: u8) u8 {
    if (c >= 'A' && c <= 'Z') { ret c + 32; }
    ret c;
}

fun token_equal(value: view.View, token: *u8, length: usize) bool {
    if (value.data == nil || token == nil || value.len != length) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (lower(value.data[i]) != lower(token[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun value_has_token(value: view.View, token: *u8, length: usize) bool {
    if (value.data == nil || value.len == 0) { ret false; }
    var i: usize = 0;
    for (true) {
        for (i < value.len && (value.data[i] == ' ' || value.data[i] == '\t')) { i = i + 1; }
        val start: usize = i;
        for (i < value.len && value.data[i] != ',') { i = i + 1; }
        var finish: usize = i;
        for (finish > start && (value.data[finish - 1] == ' ' || value.data[finish - 1] == '\t')) {
            finish = finish - 1;
        }
        if (finish - start == length
            && token_equal(view.view(?value.data[start], length), token, length)) { ret true; }
        if (i == value.len) { ret false; }
        i = i + 1;
    }
    ret false;
}

fun upgrade_requested(fields: *field.Fields) bool {
    var connection: bool  = false;
    var upgrade:    bool  = false;
    var i:          usize = 0;
    for (i < fields.len) {
        val item: *field.Field = ?fields.items[i];
        if (field.name_equal(item.name, view.view("connection", 10))
            && value_has_token(item.value, "upgrade", 7)) { connection = true; }
        if (field.name_equal(item.name, view.view("upgrade", 7)) && item.value.len != 0) {
            upgrade = true;
        }
        i = i + 1;
    }
    ret connection && upgrade;
}

fun current_inbound(engine: *Engine) usize {
    if (engine.role == SERVER) { ret engine.receiving; }
    var offset: usize = 0;
    for (offset < engine.count) {
        val index: usize = (engine.head + offset) % engine.capacity;
        if (engine.slots[index].state == SLOT_LIVE && !engine.slots[index].inbound_complete) {
            ret index;
        }
        offset = offset + 1;
    }
    ret NO_SLOT;
}

fun current_outbound(engine: *Engine) usize {
    var offset: usize = 0;
    for (offset < engine.count) {
        val index: usize = (engine.head + offset) % engine.capacity;
        if (engine.slots[index].state == SLOT_LIVE && !engine.slots[index].outbound_complete) {
            ret index;
        }
        offset = offset + 1;
    }
    ret NO_SLOT;
}

fun close_cause(error: Error) lifecycle.Cause {
    if (error >= ERROR_HEADER_TIMEOUT && error <= ERROR_TOTAL_TIMEOUT) { ret lifecycle.DEADLINE; }
    if (error == ERROR_CANCELLED)                                      { ret lifecycle.CANCELLATION; }
    ret lifecycle.FAILURE;
}

fun submit_abort(engine: *Engine) {
    if (engine.close_pending || engine.state == CLOSED) { ret; }
    val submitted: res[transport.Token, io_error.Error] = transport.close_with_cause(
        engine.transport, close_cause(engine.error), engine.next_sequence::usize);
    if ((sel submitted.ok)) {
        engine.close_token   = submitted.ok;
        engine.close_pending = true;
    }
    or {
        engine.state = CLOSED;
    }
}

fun fail(engine: *Engine, error: Error) Event {
    engine.error = error;
    engine.state = FAILED;
    if (error >= ERROR_HEADER_TIMEOUT && error <= ERROR_TOTAL_TIMEOUT) {
        cancel.timeout(engine.scope);
    }
    or {
        if (error == ERROR_CANCELLED) { transition_ok(cancel.cancel(engine.scope)); }
    }
    submit_abort(engine);
    if (error >= ERROR_HEADER_TIMEOUT && error <= ERROR_TOTAL_TIMEOUT) {
        ret empty_event(engine, EVENT_TIMED_OUT);
    }
    if (error == ERROR_CANCELLED) { ret empty_event(engine, EVENT_CANCELLED); }
    ret empty_event(engine, EVENT_ERROR);
}

# returns the engine to the state `init` accepts so caller-owned storage can
# carry a second connection. zeroing is deliberate: it also drops the transport
# tokens and held-body pointer `init` does not otherwise rewrite, and a field
# added later must not silently survive a reuse.
pub fun destroy(engine: *Engine) bool {
    if (engine == nil || !engine.initialized) { ret false; }
    if (engine.read_pending || engine.write_pending || engine.shutdown_pending
        || engine.close_pending || engine.held_body != nil
        || engine.count != 0) { ret false; }
    release_read(engine);
    release_write(engine);
    var cleared: Engine;
    @engine = cleared;
    ret true;
}

fun earlier(first: Deadline, second: Deadline) Deadline {
    if (!second.active)                           { ret first; }
    if (!first.active)                            { ret second; }
    if (time.instant_before(second.at, first.at)) { ret second; }
    ret first;
}

# the earliest deadline tick would enforce now, inactive when none applies.
# any call that takes now or changes a slot can move it, so query it again after
# each one. the scope's own deadline is the caller's and is not included
pub fun next_deadline(engine: *Engine) Deadline {
    var result: Deadline = Deadline{active: false, at: time.Instant{sec: 0, nsec: 0}};
    if (engine == nil || !engine.initialized || engine.state == CLOSED || engine.state == TUNNEL
        || engine.state == CLOSING || engine.state == FAILED) { ret result; }
    result = earlier(result, engine.total_deadline);
    if (engine.count == 0) {
        result = earlier(result, engine.idle_deadline);
        result = earlier(result, engine.wait_deadline);
    }
    var offset: usize = 0;
    for (offset < engine.count) {
        val slot: *Slot = ?engine.slots[(engine.head + offset) % engine.capacity];
        result = earlier(result, slot.header_deadline);
        result = earlier(result, slot.request_deadline);
        result = earlier(result, slot.write_deadline);
        offset = offset + 1;
    }
    ret result;
}

pub fun tick(engine: *Engine, now: time.Instant) Event {
    if (engine == nil || !engine.initialized || !valid_now(now)) {
        var invalid: Event;
        invalid.kind  = EVENT_ERROR;
        invalid.error = ERROR_STATE;
        ret invalid;
    }
    if (engine.state == CLOSED)  { ret empty_event(engine, EVENT_CLOSED); }
    if (engine.state == TUNNEL)  { ret empty_event(engine, EVENT_NONE); }
    if (engine.state == CLOSING) { ret empty_event(engine, EVENT_NONE); }
    if (engine.state == FAILED) {
        if (engine.error >= ERROR_HEADER_TIMEOUT && engine.error <= ERROR_TOTAL_TIMEOUT) {
            ret empty_event(engine, EVENT_TIMED_OUT);
        }
        if (engine.error == ERROR_CANCELLED) { ret empty_event(engine, EVENT_CANCELLED); }
        ret empty_event(engine, EVENT_ERROR);
    }
    val reason: cancel.Reason = cancel.reason(engine.scope);
    if ((sel reason.timed_out))                                  { ret fail(engine, ERROR_TOTAL_TIMEOUT); }
    if (!(sel reason.active))                                    { ret fail(engine, ERROR_CANCELLED); }
    if (expired(engine.total_deadline, now))                     { ret fail(engine, ERROR_TOTAL_TIMEOUT); }
    if (engine.count == 0 && expired(engine.idle_deadline, now)) { ret fail(engine, ERROR_IDLE_TIMEOUT); }
    if (engine.count == 0 && expired(engine.wait_deadline, now)) { ret fail(engine, ERROR_HEADER_TIMEOUT); }
    var offset: usize = 0;
    for (offset < engine.count) {
        val index: usize = (engine.head + offset) % engine.capacity;
        val slot:  *Slot = ?engine.slots[index];
        if (expired(slot.header_deadline, now))  { ret fail(engine, ERROR_HEADER_TIMEOUT); }
        if (expired(slot.request_deadline, now)) { ret fail(engine, ERROR_REQUEST_TIMEOUT); }
        if (expired(slot.write_deadline, now))   { ret fail(engine, ERROR_WRITE_TIMEOUT); }
        offset = offset + 1;
    }
    ret empty_event(engine, EVENT_NONE);
}

pub fun enqueue_request(engine: *Engine, version: message.Version,
    request_method: method.Method, request_target: target.Target, fields: *field.Fields,
    trailers: *field.Fields, now: time.Instant) usize {
    if (engine == nil || !engine.initialized || engine.role != CLIENT || engine.state != OPEN
        || engine.count >= engine.capacity || !valid_now(now)) { ret NO_SLOT; }
    val index: usize = tail_index(engine);
    val slot:  *Slot = start_slot(engine, index, now);
    if (slot == nil) { ret NO_SLOT; }
    val memory: SlotMemory = slot.memory;
    if (!parser.init_response(?slot.parser, request_method.kind, memory.line, memory.line_capacity,
        memory.storage, memory.storage_capacity, memory.fields, memory.field_capacity,
        memory.trailers, memory.trailer_capacity, engine.configured.parser)
        || !serializer.init_request(?slot.serializer, version, request_method, request_target,
        fields, trailers, memory.scratch, memory.scratch_capacity)) {
        reset_slot(engine, slot);
        engine.count = engine.count - 1;
        ret NO_SLOT;
    }
    slot.request_method    = request_method;
    slot.serializer_active = true;
    slot.out_kind          = OUT_REQUEST;
    slot.upgrade_requested = upgrade_requested(fields);
    slot.close_after       = !slot.serializer.plan.keep_alive;
    slot.write_deadline    = deadline(now, engine.configured.write_timeout_ns);
    ret index;
}

pub fun prepare_informational(engine: *Engine, index: usize, code: status.Status,
    reason: view.View, fields: *field.Fields, now: time.Instant) bool {
    if (!slot_live(engine, index) || engine.role != SERVER || engine.state == TUNNEL
        || code < 100 || code >= 200 || code == status.SWITCHING_PROTOCOLS
        || current_outbound(engine) != index || engine.slots[index].serializer_active
        || engine.slots[index].final_prepared || !valid_now(now)) { ret false; }
    val slot: *Slot = ?engine.slots[index];
    if (!serializer.init_response(?slot.serializer, slot.parser.parsed.version,
        slot.request_method.kind, code, reason, fields, nil,
        slot.memory.scratch, slot.memory.scratch_capacity)) { ret false; }
    slot.serializer_active = true;
    slot.out_kind          = OUT_INFORMATIONAL;
    if (!slot.write_deadline.active) {
        slot.write_deadline = deadline(now, engine.configured.write_timeout_ns);
    }
    ret true;
}

pub fun prepare_response(engine: *Engine, index: usize, code: status.Status,
    reason: view.View, fields: *field.Fields, trailers: *field.Fields,
    now: time.Instant) bool {
    if (!slot_live(engine, index) || engine.role != SERVER || engine.state == TUNNEL
        || (code < 200 && code != status.SWITCHING_PROTOCOLS)
        || engine.slots[index].serializer_active || engine.slots[index].final_prepared
        || !valid_now(now)) { ret false; }
    val slot: *Slot = ?engine.slots[index];
    if (code == status.SWITCHING_PROTOCOLS
        && (!slot.upgrade_requested || !upgrade_requested(fields))) { ret false; }
    if (!serializer.init_response(?slot.serializer, slot.parser.parsed.version,
        slot.request_method.kind, code, reason, fields, trailers,
        slot.memory.scratch, slot.memory.scratch_capacity)) { ret false; }
    slot.serializer_active = true;
    slot.final_prepared    = true;
    slot.out_kind          = OUT_RESPONSE;
    slot.tunnel_ready      = slot.serializer.plan.mode == framing.FRAME_TUNNEL
        || code == status.SWITCHING_PROTOCOLS;
    if (!slot.serializer.plan.keep_alive && !slot.tunnel_ready) { slot.close_after = true; }
    if (!slot.write_deadline.active) {
        slot.write_deadline = deadline(now, engine.configured.write_timeout_ns);
    }
    ret true;
}

pub fun offer(engine: *Engine, index: usize, body: *u8,
    body_length: usize, body_final: bool) Offer {
    if (!slot_live(engine, index) || current_outbound(engine) != index
        || !engine.slots[index].serializer_active || engine.write_pending
        || engine.write_length != 0 || (body == nil && body_length != 0)) {
        ret Offer{status: OFFER_BLOCKED, consumed: 0, produced: 0, error: ERROR_STATE};
    }
    if (!acquire_write(engine)) {
        ret Offer{status: OFFER_BLOCKED, consumed: 0, produced: 0, error: ERROR_MEMORY};
    }
    val slot:   *Slot            = ?engine.slots[index];
    val result: serializer.Write = serializer.write(?slot.serializer,
        engine.write_buffer, engine.write_capacity, body, body_length, body_final);
    if (result.written == 0) { release_write(engine); }
    if (result.status == serializer.WRITE_ERROR) {
        fail(engine, ERROR_SERIALIZER);
        ret Offer{status: OFFER_ERROR, consumed: result.consumed,
            produced: result.written, error: ERROR_SERIALIZER};
    }
    engine.write_length   = result.written;
    engine.write_offset   = 0;
    engine.write_terminal = result.status == serializer.WRITE_DONE;
    engine.write_slot     = index;
    engine.write_kind     = slot.out_kind;
    if (result.written != 0) {
        ret Offer{status: OFFER_OUTPUT, consumed: result.consumed,
            produced: result.written, error: ERROR_NONE};
    }
    if (result.status == serializer.WRITE_DONE) {
        mark_outbound(engine, index, slot.out_kind);
        ret Offer{status: OFFER_DONE, consumed: result.consumed, produced: 0, error: ERROR_NONE};
    }
    ret Offer{status: OFFER_BODY, consumed: result.consumed, produced: 0, error: ERROR_NONE};
}

pub fun submit_read(engine: *Engine) bool {
    if (engine == nil || !engine.initialized || engine.read_pending || engine.input_eof
        || engine.input_offset != engine.input_length || engine.held_length != 0
        || (engine.state != OPEN && engine.state != DRAINING)
        || (engine.state == DRAINING && current_inbound(engine) == NO_SLOT)
        || (engine.role == CLIENT && current_inbound(engine) == NO_SLOT)
        || (engine.role == SERVER && engine.count >= engine.capacity
        && current_inbound(engine) == NO_SLOT)) { ret false; }
    if (!engine.readable) {
        # nothing left to parse, so the idle wait holds no buffer
        release_read(engine);
        val waited: res[transport.Token, io_error.Error] = transport.readable(
            engine.transport, engine.scope, engine.next_sequence::usize);
        if ((sel waited.err)) {
            fail(engine, ERROR_TRANSPORT);
            ret false;
        }
        engine.read_token   = waited.ok;
        engine.read_kind    = transport.READABLE;
        engine.read_pending = true;
        ret true;
    }
    if (!acquire_read(engine)) { ret false; }
    engine.input_length = 0;
    engine.input_offset = 0;
    val submitted: res[transport.Token, io_error.Error] = transport.read(
        engine.transport, engine.scope, engine.read_buffer, engine.read_capacity,
        engine.next_sequence::usize);
    if ((sel submitted.err)) {
        fail(engine, ERROR_TRANSPORT);
        ret false;
    }
    engine.read_token   = submitted.ok;
    engine.read_kind    = transport.READ;
    engine.readable     = false;
    engine.read_pending = true;
    ret true;
}

pub fun submit_write(engine: *Engine) bool {
    if (engine == nil || !engine.initialized || engine.write_pending
        || engine.write_length == 0 || engine.write_offset >= engine.write_length
        || (engine.state != OPEN && engine.state != DRAINING)) { ret false; }
    val submitted: res[transport.Token, io_error.Error] = transport.write(
        engine.transport, engine.scope, ?engine.write_buffer[engine.write_offset],
        engine.write_length - engine.write_offset, engine.slots[engine.write_slot].sequence::usize);
    if ((sel submitted.err)) {
        fail(engine, ERROR_TRANSPORT);
        ret false;
    }
    engine.write_token   = submitted.ok;
    engine.write_pending = true;
    ret true;
}

fun set_input(engine: *Engine, count: usize, eof: bool) {
    engine.input_length = count;
    engine.input_offset = 0;
    engine.input_eof    = eof;
}

fun mark_outbound(engine: *Engine, index: usize, kind: OutKind) Event {
    val slot: *Slot = ?engine.slots[index];
    slot.serializer_active = false;
    slot.out_kind          = OUT_NONE;
    if (kind == OUT_INFORMATIONAL) {
        ret slot_event(engine, EVENT_OUTBOUND_INFORMATIONAL, index);
    }
    slot.outbound_complete     = true;
    slot.write_deadline.active = false;
    if (slot.inbound_complete)                  { slot.request_deadline.active = false; }
    if (slot.close_after && !slot.tunnel_ready) { engine.state = DRAINING; }
    if (slot.tunnel_ready && slot.inbound_complete) {
        engine.state       = TUNNEL;
        engine.tunnel_slot = index;
    }
    if (engine.role == SERVER && engine.state == DRAINING && !engine.graceful_requested
        && !engine.input_eof && !slot.close_after && !slot.inbound_abandoned
        && (slot.upgrade_requested || slot.request_method.kind == method.CONNECT)
        && !slot.tunnel_ready) { engine.state = OPEN; }
    ret slot_event(engine, EVENT_OUTBOUND_COMPLETE, index);
}

pub fun complete_io(engine: *Engine, completion: *transport.Completion,
    now: time.Instant) Event {
    if (engine == nil || !engine.initialized || completion == nil || !valid_now(now)) {
        var invalid: Event;
        invalid.kind  = EVENT_ERROR;
        invalid.error = ERROR_STATE;
        ret invalid;
    }
    if (((completion.kind == transport.READ || completion.kind == transport.READABLE)
        && (!engine.read_pending || completion.kind != engine.read_kind
        || !transport.token_equal(completion.token, engine.read_token)))
        || (completion.kind == transport.WRITE
        && (!engine.write_pending || !transport.token_equal(completion.token, engine.write_token)))
        || (completion.kind == transport.SHUTDOWN_WRITE
        && (!engine.shutdown_pending || !transport.token_equal(completion.token, engine.shutdown_token)))
        || (completion.kind == transport.CLOSE
        && (!engine.close_pending || !transport.token_equal(completion.token, engine.close_token)))) {
        ret fail(engine, ERROR_STATE);
    }
    if (!transport.complete(engine.transport, completion)) { ret fail(engine, ERROR_TRANSPORT); }
    if (completion.kind == transport.READ || completion.kind == transport.READABLE) {
        engine.read_pending = false;
    }
    if (completion.kind == transport.WRITE)          { engine.write_pending = false; }
    if (completion.kind == transport.SHUTDOWN_WRITE) { engine.shutdown_pending = false; }
    if (engine.state == FAILED || engine.state == CLOSING) {
        if (completion.kind == transport.CLOSE) {
            engine.close_pending = false;
            engine.state         = CLOSED;
            ret empty_event(engine, EVENT_CLOSED);
        }
        ret empty_event(engine, EVENT_NONE);
    }
    val checked: Event = tick(engine, now);
    if (checked.kind != EVENT_NONE) { ret checked; }
    if (completion.kind == transport.READABLE) {
        if (completion.status == transport.IO_COMPLETE) {
            engine.readable = true;
            await_request(engine, now);
            ret process(engine, now);
        }
        if (completion.status == transport.IO_END) {
            set_input(engine, 0, true);
            ret process(engine, now);
        }
        if (completion.status == transport.IO_TIMED_OUT) { ret fail(engine, ERROR_REQUEST_TIMEOUT); }
        if (completion.status == transport.IO_CANCELLED) { ret fail(engine, ERROR_CANCELLED); }
        ret fail(engine, ERROR_TRANSPORT);
    }
    if (completion.kind == transport.READ) {
        if (completion.status == transport.IO_COMPLETE) {
            if (completion.count == 0) { ret fail(engine, ERROR_NO_PROGRESS); }
            set_input(engine, completion.count, false);
            ret process(engine, now);
        }
        if (completion.status == transport.IO_END) {
            set_input(engine, completion.count, true);
            ret process(engine, now);
        }
        if (completion.status == transport.IO_TIMED_OUT) { ret fail(engine, ERROR_REQUEST_TIMEOUT); }
        if (completion.status == transport.IO_CANCELLED) { ret fail(engine, ERROR_CANCELLED); }
        ret fail(engine, ERROR_TRANSPORT);
    }
    if (completion.kind == transport.WRITE) {
        if (completion.status == transport.IO_COMPLETE) {
            if (completion.count == 0) { ret fail(engine, ERROR_NO_PROGRESS); }
            engine.write_offset = engine.write_offset + completion.count;
            if (engine.write_offset < engine.write_length) { ret empty_event(engine, EVENT_NONE); }
            val terminal: bool    = engine.write_terminal;
            val index:    usize   = engine.write_slot;
            val kind:     OutKind = engine.write_kind;
            engine.write_length   = 0;
            engine.write_offset   = 0;
            engine.write_terminal = false;
            engine.write_slot     = NO_SLOT;
            engine.write_kind     = OUT_NONE;
            release_write(engine);
            if (terminal) { ret mark_outbound(engine, index, kind); }
            ret empty_event(engine, EVENT_NONE);
        }
        if (completion.status == transport.IO_TIMED_OUT) { ret fail(engine, ERROR_WRITE_TIMEOUT); }
        if (completion.status == transport.IO_CANCELLED) { ret fail(engine, ERROR_CANCELLED); }
        ret fail(engine, ERROR_TRANSPORT);
    }
    if (completion.kind == transport.SHUTDOWN_WRITE) {
        if (completion.status != transport.IO_COMPLETE) { ret fail(engine, ERROR_TRANSPORT); }
        engine.shutdown_done = true;
        ret empty_event(engine, EVENT_NONE);
    }
    engine.close_pending = false;
    engine.state         = CLOSED;
    ret empty_event(engine, EVENT_CLOSED);
}

fun input_available(engine: *Engine) usize {
    ret engine.input_length - engine.input_offset;
}

fun hold_body(engine: *Engine, index: usize, result: parser.Feed) Event {
    engine.held_body   = result.body;
    engine.held_length = result.body_length;
    engine.held_final  = result.body_final;
    engine.held_slot   = index;
    if (engine.role == SERVER) { ret body_event(engine, EVENT_REQUEST_BODY, index); }
    ret body_event(engine, EVENT_RESPONSE_BODY, index);
}

fun finish_inbound(engine: *Engine, index: usize) Event {
    val slot: *Slot = ?engine.slots[index];
    if (engine.role == CLIENT && slot.informational) {
        slot.informational    = false;
        slot.headers_reported = false;
        parser.reset(?slot.parser);
        ret empty_event(engine, EVENT_NONE);
    }
    slot.inbound_complete       = true;
    slot.header_deadline.active = false;
    if (slot.outbound_complete) { slot.request_deadline.active = false; }
    if (!slot.parser.parsed.plan.keep_alive && !slot.tunnel_ready) {
        slot.close_after = true;
        engine.state     = DRAINING;
    }
    if (engine.role == SERVER) { engine.receiving = NO_SLOT; }
    if (slot.tunnel_ready && slot.outbound_complete) {
        engine.state       = TUNNEL;
        engine.tunnel_slot = index;
    }
    if (engine.role == SERVER && (slot.upgrade_requested
        || slot.request_method.kind == method.CONNECT)) { engine.state = DRAINING; }
    if (engine.role == SERVER) { ret slot_event(engine, EVENT_REQUEST_COMPLETE, index); }
    ret slot_event(engine, EVENT_RESPONSE_COMPLETE, index);
}

fun eof_event(engine: *Engine, now: time.Instant) Event {
    val index: usize = current_inbound(engine);
    if (index == NO_SLOT) {
        engine.state = DRAINING;
        ret empty_event(engine, EVENT_PEER_CLOSED);
    }
    val result: parser.Feed = parser.finish_eof(?engine.slots[index].parser, true);
    if (result.status == parser.PARSE_MESSAGE) { ret finish_inbound(engine, index); }
    ret fail(engine, ERROR_PROTOCOL);
}

# a readable connection takes its read buffer before the host submits the read
fun need_read(engine: *Engine) Event {
    if (engine.readable && !acquire_read(engine)) {
        ret empty_event(engine, EVENT_MEMORY_BLOCKED);
    }
    ret empty_event(engine, EVENT_NEED_READ);
}

pub fun process(engine: *Engine, now: time.Instant) Event {
    if (engine == nil || !engine.initialized || !valid_now(now)) {
        var invalid: Event;
        invalid.kind  = EVENT_ERROR;
        invalid.error = ERROR_STATE;
        ret invalid;
    }
    val checked: Event = tick(engine, now);
    if (checked.kind != EVENT_NONE) { ret checked; }
    if (engine.state == TUNNEL) {
        if (engine.tunnel_reported) { ret empty_event(engine, EVENT_NONE); }
        engine.tunnel_reported = true;
        var event: Event = empty_event(engine, EVENT_TUNNEL);
        event.slot = engine.tunnel_slot;
        if (engine.tunnel_slot != NO_SLOT) {
            event.sequence = engine.slots[engine.tunnel_slot].sequence;
        }
        event.body        = nil;
        event.body_length = input_available(engine);
        if (event.body_length != 0) { event.body = ?engine.read_buffer[engine.input_offset]; }
        ret event;
    }
    if (engine.held_length != 0) {
        var kind: EventKind = EVENT_RESPONSE_BODY;
        if (engine.role == SERVER) { kind = EVENT_REQUEST_BODY; }
        ret body_event(engine, kind, engine.held_slot);
    }
    for (true) {
        val ready_index: usize = current_inbound(engine);
        if (input_available(engine) == 0) {
            if (ready_index == NO_SLOT
                || engine.slots[ready_index].parser.phase != parser.MESSAGE_COMPLETE) {
                if (engine.input_eof) { ret eof_event(engine, now); }
                if (ready_index == NO_SLOT && engine.state == DRAINING) {
                    ret empty_event(engine, EVENT_NONE);
                }
                if (ready_index == NO_SLOT && engine.role == CLIENT) {
                    ret empty_event(engine, EVENT_NONE);
                }
                if (ready_index == NO_SLOT && engine.role == SERVER
                    && engine.count >= engine.capacity) {
                    ret empty_event(engine, EVENT_SATURATED);
                }
                ret need_read(engine);
            }
        }
        var index: usize = ready_index;
        if (index == NO_SLOT && engine.role == SERVER) {
            if (engine.state != OPEN && !(engine.state == DRAINING
                && engine.graceful_requested && input_available(engine) != 0)) {
                ret empty_event(engine, EVENT_NONE);
            }
            index = allocate_server(engine, now);
            if (index == NO_SLOT) {
                if (engine.count >= engine.capacity) { ret empty_event(engine, EVENT_SATURATED); }
                # the request stays unread in the buffer until memory frees
                if (engine.memory_blocked) { ret empty_event(engine, EVENT_MEMORY_BLOCKED); }
                ret fail(engine, ERROR_STATE);
            }
        }
        if (index == NO_SLOT) { ret fail(engine, ERROR_PROTOCOL); }
        val slot: *Slot = ?engine.slots[index];
        if (slot.disposition == BODY_REJECT || slot.disposition == BODY_CLOSE) {
            ret empty_event(engine, EVENT_NONE);
        }
        var input: *u8 = nil;
        if (input_available(engine) != 0) { input = ?engine.read_buffer[engine.input_offset]; }
        val result: parser.Feed = parser.feed(?slot.parser, input, input_available(engine));
        engine.input_offset = engine.input_offset + result.consumed;
        if (result.status == parser.PARSE_ERROR) { ret fail(engine, ERROR_PARSER); }
        if (result.status == parser.PARSE_NEED_INPUT) {
            if (input_available(engine) != 0 || result.consumed == 0) {
                ret fail(engine, ERROR_NO_PROGRESS);
            }
            if (engine.input_eof) { ret eof_event(engine, now); }
            ret need_read(engine);
        }
        if (result.status == parser.PARSE_HEADERS) {
            if (engine.role == SERVER) {
                slot.request_method         = slot.parser.parsed.method;
                slot.upgrade_requested      = upgrade_requested(?slot.parser.parsed.fields);
                slot.headers_reported       = true;
                slot.header_deadline.active = false;
                if (!slot.parser.parsed.plan.keep_alive) {
                    slot.close_after = true;
                    engine.state     = DRAINING;
                }
                ret slot_event(engine, EVENT_REQUEST_HEADERS, index);
            }
            val informational: bool = status.is_informational(slot.parser.parsed.status)
                && !(slot.parser.parsed.status == status.SWITCHING_PROTOCOLS
                && slot.upgrade_requested);
            if (informational) {
                slot.informational = true;
                ret slot_event(engine, EVENT_INFORMATIONAL, index);
            }
            if (slot.parser.parsed.status == status.SWITCHING_PROTOCOLS
                && !upgrade_requested(?slot.parser.parsed.fields)) {
                ret fail(engine, ERROR_PROTOCOL);
            }
            slot.headers_reported       = true;
            slot.header_deadline.active = false;
            slot.tunnel_ready           = slot.parser.parsed.plan.mode == framing.FRAME_TUNNEL
                || (slot.parser.parsed.status == status.SWITCHING_PROTOCOLS
                && slot.upgrade_requested);
            ret slot_event(engine, EVENT_RESPONSE_HEADERS, index);
        }
        if (result.status == parser.PARSE_BODY) {
            if (slot.disposition == BODY_DRAIN) {
                if (result.body_length::u64 > engine.configured.max_drain_bytes - slot.drained) {
                    ret fail(engine, ERROR_LIMIT);
                }
                slot.drained = slot.drained + result.body_length::u64;
                cnt;
            }
            ret hold_body(engine, index, result);
        }
        if (result.status == parser.PARSE_MESSAGE) {
            val finished: Event = finish_inbound(engine, index);
            if (finished.kind == EVENT_NONE) { cnt; }
            ret finished;
        }
        ret fail(engine, ERROR_STATE);
    }
    ret empty_event(engine, EVENT_NONE);
}

pub fun consume_body(engine: *Engine, index: usize, count: usize) bool {
    if (!slot_live(engine, index) || engine.held_slot != index || count > engine.held_length) {
        ret false;
    }
    if (count != 0) {
        engine.held_body   = (engine.held_body::usize + count)::ptr::*u8;
        engine.held_length = engine.held_length - count;
    }
    if (engine.held_length == 0) {
        engine.held_body  = nil;
        engine.held_final = false;
        engine.held_slot  = NO_SLOT;
    }
    ret true;
}

pub fun set_disposition(engine: *Engine, index: usize, disposition: Disposition) bool {
    if (!slot_live(engine, index) || engine.role != SERVER
        || disposition < BODY_DELIVER || disposition > BODY_CLOSE
        || engine.slots[index].inbound_complete) { ret false; }
    val slot: *Slot = ?engine.slots[index];
    slot.disposition = disposition;
    if (disposition == BODY_DRAIN && engine.held_slot == index) {
        if (engine.held_length::u64 > engine.configured.max_drain_bytes - slot.drained) {
            fail(engine, ERROR_LIMIT);
            ret false;
        }
        slot.drained       = slot.drained + engine.held_length::u64;
        engine.held_body   = nil;
        engine.held_length = 0;
        engine.held_final  = false;
        engine.held_slot   = NO_SLOT;
    }
    if (disposition == BODY_REJECT) {
        engine.held_body            = nil;
        engine.held_length          = 0;
        engine.held_final           = false;
        engine.held_slot            = NO_SLOT;
        slot.inbound_abandoned      = true;
        slot.inbound_complete       = true;
        slot.close_after            = true;
        slot.header_deadline.active = false;
        engine.receiving            = NO_SLOT;
        engine.state                = DRAINING;
    }
    if (disposition == BODY_CLOSE) {
        fail(engine, ERROR_PROTOCOL);
    }
    ret true;
}

fun slot_done(engine: *Engine, slot: *Slot) bool {
    ret slot.inbound_complete && slot.outbound_complete && slot.released;
}

fun sweep_done(engine: *Engine) {
    for (engine.count != 0 && slot_done(engine, ?engine.slots[engine.head])) {
        reset_slot(engine, ?engine.slots[engine.head]);
        engine.head  = (engine.head + 1) % engine.capacity;
        engine.count = engine.count - 1;
    }
}

fun sweep(engine: *Engine, now: time.Instant) {
    sweep_done(engine);
    if (engine.count == 0 && engine.state == OPEN) {
        engine.idle_deadline = deadline(now, engine.configured.idle_timeout_ns);
    }
    # pipelined bytes or a readable wait already mean the next request is owed
    if (engine.count == 0 && (input_available(engine) != 0 || engine.readable)) {
        await_request(engine, now);
    }
}

pub fun release(engine: *Engine, index: usize, now: time.Instant) bool {
    if (!slot_live(engine, index) || !valid_now(now)
        || !engine.slots[index].inbound_complete || !engine.slots[index].outbound_complete) {
        ret false;
    }
    engine.slots[index].released = true;
    sweep(engine, now);
    ret true;
}

pub fun abandon(engine: *Engine, index: usize, sequence: u64) bool {
    if (!slot_live(engine, index) || sequence == 0
        || engine.slots[index].sequence != sequence || engine.slots[index].released
        || (engine.state != FAILED && engine.state != CLOSED)) { ret false; }
    val slot: *Slot = ?engine.slots[index];
    if (engine.receiving == index) { engine.receiving = NO_SLOT; }
    if (engine.held_slot == index) {
        engine.held_body   = nil;
        engine.held_length = 0;
        engine.held_final  = false;
        engine.held_slot   = NO_SLOT;
    }
    slot.inbound_complete        = true;
    slot.inbound_abandoned       = true;
    slot.outbound_complete       = true;
    slot.serializer_active       = false;
    slot.released                = true;
    slot.header_deadline.active  = false;
    slot.request_deadline.active = false;
    slot.write_deadline.active   = false;
    sweep_done(engine);
    ret true;
}

pub fun begin_graceful(engine: *Engine) bool {
    if (engine == nil || !engine.initialized || engine.state != OPEN) { ret false; }
    engine.state              = DRAINING;
    engine.graceful_requested = true;
    ret true;
}

fun protocol_done(engine: *Engine) bool {
    if (engine.write_pending || engine.write_length != 0 || engine.held_length != 0) { ret false; }
    var offset: usize = 0;
    for (offset < engine.count) {
        val index: usize = (engine.head + offset) % engine.capacity;
        if (!engine.slots[index].inbound_complete || !engine.slots[index].outbound_complete) {
            ret false;
        }
        offset = offset + 1;
    }
    ret true;
}

pub fun progress_close(engine: *Engine) bool {
    if (engine == nil || !engine.initialized || engine.state != DRAINING
        || !protocol_done(engine)) { ret false; }
    if (!engine.shutdown_done && !engine.shutdown_pending) {
        val submitted: res[transport.Token, io_error.Error] = transport.shutdown_write(
            engine.transport, engine.scope, engine.next_sequence::usize);
        if ((sel submitted.err)) {
            fail(engine, ERROR_TRANSPORT);
            ret false;
        }
        engine.shutdown_token   = submitted.ok;
        engine.shutdown_pending = true;
        ret true;
    }
    if (engine.shutdown_done && !engine.close_pending) {
        engine.state = CLOSING;
        engine.error = ERROR_NONE;
        val submitted: res[transport.Token, io_error.Error] = transport.close(
            engine.transport, engine.next_sequence::usize);
        if ((sel submitted.err)) {
            engine.state = CLOSED;
            ret false;
        }
        engine.close_token   = submitted.ok;
        engine.close_pending = true;
        ret true;
    }
    ret false;
}

pub fun cancel_connection(engine: *Engine) bool {
    if (engine == nil || !engine.initialized || engine.state == CLOSED) { ret false; }
    cancel.cancel(engine.scope);
    fail(engine, ERROR_CANCELLED);
    ret true;
}

rec TestIO {
    read_token:     transport.Token;
    read_buffer:    *u8;
    read_length:    usize;
    read_calls:     usize;
    readable_token: transport.Token;
    readable_calls: usize;
    write_token:    transport.Token;
    write_buffer:   *u8;
    write_length:   usize;
    write_calls:    usize;
    shutdown_token: transport.Token;
    shutdown_calls: usize;
    close_token:    transport.Token;
    close_calls:    usize;
}

fun test_read(context: ptr, token: transport.Token, scope: *cancel.Scope,
    buffer: *u8, length: usize) res[bool, io_error.Error] {
    val state: *TestIO = context::*TestIO;
    state.read_token  = token;
    state.read_buffer = buffer;
    state.read_length = length;
    state.read_calls  = state.read_calls + 1;
    ret res[bool, io_error.Error].ok{true};
}

fun test_readable(context: ptr, token: transport.Token,
    scope: *cancel.Scope) res[bool, io_error.Error] {
    val state: *TestIO = context::*TestIO;
    state.readable_token = token;
    state.readable_calls = state.readable_calls + 1;
    ret res[bool, io_error.Error].ok{true};
}

fun test_write(context: ptr, token: transport.Token, scope: *cancel.Scope,
    buffer: *u8, length: usize) res[bool, io_error.Error] {
    val state: *TestIO = context::*TestIO;
    state.write_token  = token;
    state.write_buffer = buffer;
    state.write_length = length;
    state.write_calls  = state.write_calls + 1;
    ret res[bool, io_error.Error].ok{true};
}

fun test_shutdown(context: ptr, token: transport.Token,
    scope: *cancel.Scope) res[bool, io_error.Error] {
    val state: *TestIO = context::*TestIO;
    state.shutdown_token = token;
    state.shutdown_calls = state.shutdown_calls + 1;
    ret res[bool, io_error.Error].ok{true};
}

fun test_close(context: ptr, token: transport.Token,
    scope: *cancel.Scope) res[bool, io_error.Error] {
    val state: *TestIO = context::*TestIO;
    state.close_token = token;
    state.close_calls = state.close_calls + 1;
    ret res[bool, io_error.Error].ok{true};
}

rec Fixture {
    runtime:               io_runtime.Runtime;
    operation_root:        cancel.Scope;
    control_root:          cancel.Scope;
    io:                    TestIO;
    adapter:               transport.Adapter;
    transport_slots:       [3]transport.Slot;
    transport:             transport.Transport;
    pooled_operation_root: cancel.Scope;
    pooled_control_root:   cancel.Scope;
    pooled_slots:          [3]transport.Slot;
    pooled_transport:      transport.Transport;
    slots:                 [3]Slot;
    backing:               allocator.Allocator;
    pool:                  buffers.Pool;
    source:                buffers.Source;
    account:               buffers.Account;
    engine:                Engine;
}

# a std pool with no size classes, so every chunk is exactly its request rounded
# to 16 bytes and the account's `held` counts bytes exactly
fun make_buffers(fixture: *Fixture, slot_budget: usize, connection_budget: usize) bool {
    val backed: err[allocator.Error] = page.make(?fixture.backing);
    if (sel backed.err) { ret false; }
    var config: buffers.Config;
    config.class_count   = 0;
    config.lanes         = 2;
    config.global_budget = 1 << 24;
    config.initial_slots = 16;
    if (!buffers.make(?fixture.pool, config, ?fixture.backing)) { ret false; }
    fixture.source = buffers.source(?fixture.pool);
    var budgets: [2]usize       = [2]usize{slot_budget, connection_budget};
    val opened:  buffers.Reason = buffers.source_open_account(?fixture.source,
        ?fixture.account, 1, ?budgets[0], 0);
    ret sel opened.none;
}

rec PendingBody {
    scope:          cancel.Scope;
    trailers:       field.Fields;
    reader:         body.Reader;
    token:          u64;
    finish_calls:   usize;
    complete_calls: usize;
    release_calls:  usize;
}

fun application_body_read(context: ptr, output: *u8, capacity: usize,
    trailers: *field.Fields) body.Progress {
    ret body.complete(body.REUSE_FORBIDDEN);
}

fun application_body_finish(context: ptr, mode: body.Mode,
    trailers: *field.Fields) body.Progress {
    val pending: *PendingBody = context::*PendingBody;
    pending.finish_calls = pending.finish_calls + 1;
    if (mode != body.CANCEL) {
        ret body.failed("unexpected body finish mode", body.REUSE_FORBIDDEN);
    }
    ret body.pending(pending.token);
}

fun application_body_complete(context: ptr, token: u64,
    trailers: *field.Fields) body.Progress {
    val pending: *PendingBody = context::*PendingBody;
    pending.complete_calls = pending.complete_calls + 1;
    if (token != pending.token) {
        ret body.failed("unexpected body completion token", body.REUSE_FORBIDDEN);
    }
    ret body.cancelled(body.REUSE_FORBIDDEN);
}

fun application_body_release(context: ptr) {
    val pending: *PendingBody = context::*PendingBody;
    pending.release_calls = pending.release_calls + 1;
}

fun make_pending_body(pending: *PendingBody, generation: u64,
    token: u64) bool {
    val none: time.Instant = test_now(0);
    if (!operation_ok(cancel.make_root(?pending.scope, opt[time.Instant].none{}))) { ret false; }
    pending.trailers = field.init(nil, 0, field.limits(0, 0, 0, 0));
    pending.token    = token;
    pending.reader   = body.init_reader(pending, application_body_read,
        application_body_finish, application_body_complete,
        application_body_release, body.OWNER_APPLICATION, generation, false, 0,
        message.limits_default().request_body, ?pending.trailers, ?pending.scope);
    ret pending.reader.valid;
}

fun test_config(pipeline: usize) Config {
    var configured: Config = config_default();
    configured.max_pipeline             = pipeline;
    configured.max_drain_bytes          = 64;
    configured.parser.max_start_line    = 256;
    configured.parser.max_method_bytes  = 32;
    configured.parser.max_target_bytes  = 192;
    configured.parser.max_header_line   = 256;
    configured.parser.max_header_bytes  = 1024;
    configured.parser.max_headers       = 8;
    configured.parser.max_trailer_bytes = 256;
    configured.parser.max_trailers      = 4;
    configured.parser.max_chunk_line    = 64;
    configured.parser.max_body_bytes    = 1024;
    configured.read_bytes               = 512;
    configured.write_bytes              = 128;
    configured.slot_storage_bytes       = 1024;
    configured.slot_scratch_bytes       = 512;
    configured.slot_lane                = 0;
    configured.connection_lane          = 1;
    ret configured;
}

fun test_now(seconds: i64) time.Instant {
    ret time.Instant{sec: seconds, nsec: 0};
}

fun make_fixture(fixture: *Fixture, role: Role, pipeline: usize) bool {
    val none: time.Instant = test_now(0);
    if (!operation_ok(cancel.make_root(?fixture.operation_root, opt[time.Instant].none{}))
        || !operation_ok(cancel.make_root(?fixture.control_root, opt[time.Instant].none{}))) { ret false; }
    fixture.adapter.runtime               = ?fixture.runtime;
    fixture.adapter.context               = (?fixture.io)::ptr;
    fixture.adapter.security              = transport.PLAINTEXT;
    fixture.adapter.submit_read           = test_read;
    fixture.adapter.submit_write          = test_write;
    fixture.adapter.submit_readable       = test_readable;
    fixture.adapter.submit_shutdown_write = test_shutdown;
    fixture.adapter.submit_close          = test_close;
    if (!transport.init(?fixture.transport, fixture.adapter, ?fixture.operation_root,
        ?fixture.control_root, ?fixture.transport_slots[0], 3)) { ret false; }
    if (!make_buffers(fixture, 1 << 20, 1 << 20)) { ret false; }
    ret start_engine(fixture, ?fixture.transport, ?fixture.operation_root, role,
        pipeline);
}

# every argument but the connection is the fixture's own storage, so calling
# this a second time is exactly what a pool does with a recycled engine
fun start_engine(fixture: *Fixture, connection: *transport.Transport,
    scope: *cancel.Scope, role: Role, pipeline: usize) bool {
    ret init(?fixture.engine, role, connection, scope,
        ?fixture.slots[0], pipeline, ?fixture.source, ?fixture.account,
        test_config(pipeline), test_now(100));
}

# a real read follows a completed readable wait, as a host loop does it
fun ready_read(fixture: *Fixture, now: time.Instant) bool {
    if (!fixture.engine.readable) {
        if (!submit_read(?fixture.engine)) { ret false; }
        var ready: transport.Completion = transport.completed(
            fixture.io.readable_token, transport.READABLE, 0);
        if (complete_io(?fixture.engine, ?ready, now).kind != EVENT_NEED_READ) { ret false; }
    }
    ret submit_read(?fixture.engine);
}

fun complete_read(fixture: *Fixture, wire: str, eof: bool, now: time.Instant) Event {
    val length: usize = str_len(wire);
    if (!ready_read(fixture, now) || length > fixture.io.read_length) {
        ret empty_event(?fixture.engine, EVENT_ERROR);
    }
    memory.raw_copy(fixture.io.read_buffer, wire, length);
    var completion: transport.Completion;
    if (eof) { completion = transport.end(fixture.io.read_token, length); }
    or       { completion = transport.completed(fixture.io.read_token, transport.READ, length); }
    ret complete_io(?fixture.engine, ?completion, now);
}

fun complete_write(fixture: *Fixture, count: usize, now: time.Instant) Event {
    var completion: transport.Completion = transport.completed(
        fixture.io.write_token, transport.WRITE, count);
    ret complete_io(?fixture.engine, ?completion, now);
}

fun flush_offer(fixture: *Fixture, index: usize, body: *u8,
    length: usize, final: bool, now: time.Instant, partial: bool) bool {
    var offset: usize = 0;
    var done:   bool  = false;
    for (!done) {
        val offered: Offer = offer(?fixture.engine, index,
            (body::usize + offset)::ptr::*u8, length - offset, final);
        if (offered.status == OFFER_ERROR || offered.status == OFFER_BLOCKED) { ret false; }
        offset = offset + offered.consumed;
        if (offered.status == OFFER_DONE)                               { done = true; }
        if (offered.status == OFFER_BODY && offset == length && !final) { ret true; }
        if (offered.produced != 0) {
            if (!submit_write(?fixture.engine)) { ret false; }
            var first: usize = fixture.io.write_length;
            if (partial && first > 1) { first = first / 2; }
            val event: Event = complete_write(fixture, first, now);
            if (event.kind == EVENT_ERROR || event.kind == EVENT_TIMED_OUT) { ret false; }
            if (first < fixture.engine.write_length - fixture.engine.write_offset + first) {
                if (!submit_write(?fixture.engine)) { ret false; }
                val rest:    usize = fixture.io.write_length;
                val settled: Event = complete_write(fixture, rest, now);
                if (settled.kind == EVENT_ERROR || settled.kind == EVENT_TIMED_OUT) { ret false; }
            }
            if (fixture.slots[index].outbound_complete
                || (!fixture.slots[index].serializer_active && final)) { done = true; }
        }
    }
    ret offset == length;
}

# one complete server exchange, returning the sequence the engine assigned it
fun pooled_exchange(fixture: *Fixture, now: time.Instant) u64 {
    val headers: Event = complete_read(fixture,
        "GET /1 HTTP/1.1\r\nHost: x\r\n\r\n", false, now);
    if (headers.kind != EVENT_REQUEST_HEADERS || headers.slot != 0
        || process(?fixture.engine, now).kind != EVENT_REQUEST_COMPLETE) { ret 0; }
    # a slot still carrying a request refuses teardown
    if (fixture.engine.count == 0 || destroy(?fixture.engine)) { ret 0; }
    var no_fields: field.Fields = field.init(nil, 0, field.limits(0, 0, 0, 0));
    if (!prepare_response(?fixture.engine, headers.slot, status.NO_CONTENT,
        view.view("No Content", 10), ?no_fields, nil, now)
        || !flush_offer(fixture, headers.slot, nil, 0, true, now, false)
        || !release(?fixture.engine, headers.slot, now)
        || fixture.engine.count != 0) { ret 0; }
    ret headers.sequence;
}

test "http.h1.connection: destroy returns pooled storage for a second connection" {
    var fixture: Fixture;
    val now:     time.Instant = test_now(100);
    if (!make_fixture(?fixture, SERVER, 1)) { ret 1; }
    val first_sequence: u64 = pooled_exchange(?fixture, now);
    if (first_sequence == 0) { ret 2; }
    if (!begin_graceful(?fixture.engine)
        || !progress_close(?fixture.engine)
        || fixture.io.shutdown_calls != 1) { ret 4; }
    if (destroy(?fixture.engine)) { ret 5; }
    var shutdown: transport.Completion = transport.completed(
        fixture.io.shutdown_token, transport.SHUTDOWN_WRITE, 0);
    if (complete_io(?fixture.engine, ?shutdown, now).kind == EVENT_ERROR
        || !progress_close(?fixture.engine) || fixture.io.close_calls != 1) { ret 6; }
    if (destroy(?fixture.engine)) { ret 7; }
    var closed: transport.Completion = transport.completed(
        fixture.io.close_token, transport.CLOSE, 0);
    if (complete_io(?fixture.engine, ?closed, now).kind != EVENT_CLOSED) { ret 8; }
    if (!destroy(?fixture.engine))                                       { ret 9; }
    if (fixture.engine.initialized || fixture.engine.next_sequence != 0
        || fixture.engine.count != 0 || fixture.engine.slots != nil) { ret 10; }
    if (destroy(?fixture.engine)) { ret 11; }
    val none: time.Instant = test_now(0);
    if (!operation_ok(cancel.make_root(?fixture.pooled_operation_root, opt[time.Instant].none{}))
        || !operation_ok(cancel.make_root(?fixture.pooled_control_root, opt[time.Instant].none{}))
        || !transport.init(?fixture.pooled_transport, fixture.adapter,
        ?fixture.pooled_operation_root, ?fixture.pooled_control_root,
        ?fixture.pooled_slots[0], 3)) { ret 12; }
    if (!start_engine(?fixture, ?fixture.pooled_transport,
        ?fixture.pooled_operation_root, SERVER, 1)) { ret 13; }
    if (fixture.engine.state != OPEN || fixture.engine.count != 0
        || fixture.engine.next_sequence != 1) { ret 14; }
    val second_sequence: u64 = pooled_exchange(?fixture, now);
    if (second_sequence == 0 || second_sequence != first_sequence) { ret 15; }
    if (!destroy(?fixture.engine))                                 { ret 16; }
    ret 0;
}

test "http.h1.connection: teardown abandons an incomplete held request exactly once" {
    var fixture: Fixture;
    val now:     time.Instant = test_now(100);
    if (!make_fixture(?fixture, SERVER, 1)) { ret 1; }
    val headers: Event = complete_read(?fixture,
        "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello", false, now);
    val held: Event = process(?fixture.engine, now);
    if (headers.kind != EVENT_REQUEST_HEADERS || held.kind != EVENT_REQUEST_BODY
        || held.slot != headers.slot || held.sequence != headers.sequence
        || fixture.engine.held_slot != headers.slot || fixture.engine.held_length != 5
        || abandon(?fixture.engine, headers.slot, headers.sequence)) { ret 2; }
    if (!cancel_connection(?fixture.engine) || fixture.engine.state != FAILED
        || !fixture.engine.close_pending || fixture.io.close_calls != 1) { ret 3; }
    if (abandon(?fixture.engine, headers.slot, headers.sequence + 1)
        || !abandon(?fixture.engine, headers.slot, headers.sequence)
        || fixture.engine.count != 0 || fixture.engine.held_body != nil
        || fixture.engine.held_length != 0 || fixture.engine.held_slot != NO_SLOT
        || abandon(?fixture.engine, headers.slot, headers.sequence)
        || destroy(?fixture.engine)) { ret 4; }
    var closed: transport.Completion = transport.completed(
        fixture.io.close_token, transport.CLOSE, 0);
    if (complete_io(?fixture.engine, ?closed, now).kind != EVENT_CLOSED
        || !destroy(?fixture.engine)) { ret 5; }
    ret 0;
}

test "http.h1.connection: late body completion is isolated from a reused slot" {
    var fixture: Fixture;
    val now:     time.Instant = test_now(100);
    if (!make_fixture(?fixture, SERVER, 1)) { ret 1; }
    val first: Event = complete_read(?fixture,
        "GET /first HTTP/1.1\r\nHost: x\r\n\r\n", false, now);
    if (first.kind != EVENT_REQUEST_HEADERS
        || process(?fixture.engine, now).kind != EVENT_REQUEST_COMPLETE) { ret 2; }
    var old_body: PendingBody;
    if (!make_pending_body(?old_body, first.sequence, 701)
        || body.cancel_reader(?old_body.reader).status != body.PENDING
        || old_body.reader.pending_kind != body.OP_FINISH
        || old_body.reader.pending_token != 701 || old_body.finish_calls != 1) { ret 3; }
    var no_fields: field.Fields = field.init(nil, 0, field.limits(0, 0, 0, 0));
    if (!prepare_response(?fixture.engine, first.slot, status.NO_CONTENT,
        view.view("No Content", 10), ?no_fields, nil, now)
        || !flush_offer(?fixture, first.slot, nil, 0, true, now, false)
        || !release(?fixture.engine, first.slot, now)) { ret 4; }
    val second: Event = complete_read(?fixture,
        "POST /second HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello", false, now);
    val held: Event = process(?fixture.engine, now);
    if (second.kind != EVENT_REQUEST_HEADERS || second.slot != first.slot
        || second.sequence == first.sequence || held.kind != EVENT_REQUEST_BODY
        || body.complete_reader(?old_body.reader, 701).status != body.CANCELLED
        || old_body.complete_calls != 1 || old_body.release_calls != 1
        || fixture.slots[second.slot].sequence != second.sequence
        || fixture.slots[second.slot].state != SLOT_LIVE
        || fixture.engine.held_slot != second.slot) { ret 5; }
    var active_body: PendingBody;
    if (!make_pending_body(?active_body, second.sequence, 702)
        || body.cancel_reader(?active_body.reader).status != body.PENDING
        || !cancel_connection(?fixture.engine)
        || abandon(?fixture.engine, second.slot, first.sequence)
        || !abandon(?fixture.engine, second.slot, second.sequence)) { ret 6; }
    var closed: transport.Completion = transport.completed(
        fixture.io.close_token, transport.CLOSE, 0);
    if (complete_io(?fixture.engine, ?closed, now).kind != EVENT_CLOSED
        || !destroy(?fixture.engine)
        || body.complete_reader(?active_body.reader, 702).status != body.CANCELLED
        || active_body.complete_calls != 1 || active_body.release_calls != 1) { ret 7; }
    if (!operation_ok(cancel.destroy(?old_body.scope)) || !operation_ok(cancel.destroy(?active_body.scope))) { ret 8; }
    ret 0;
}

test "http.h1.connection: server pipeline is bounded and responses stay ordered" {
    var fixture: Fixture;
    val now:     time.Instant = test_now(100);
    if (!make_fixture(?fixture, SERVER, 2)) { ret 1; }
    val wire:  str   = "GET /1 HTTP/1.1\r\nHost: x\r\n\r\nGET /2 HTTP/1.1\r\nHost: x\r\n\r\nGET /3 HTTP/1.1\r\nHost: x\r\n\r\n";
    val first: Event = complete_read(?fixture, wire, false, now);
    if (first.kind != EVENT_REQUEST_HEADERS || first.slot != 0)       { ret 2; }
    if (process(?fixture.engine, now).kind != EVENT_REQUEST_COMPLETE) { ret 3; }
    val second: Event = process(?fixture.engine, now);
    if (second.kind != EVENT_REQUEST_HEADERS || second.slot != 1) { ret 4; }
    if (process(?fixture.engine, now).kind != EVENT_REQUEST_COMPLETE
        || process(?fixture.engine, now).kind != EVENT_SATURATED) { ret 5; }
    var no_fields: field.Fields = field.init(nil, 0, field.limits(0, 0, 0, 0));
    if (!prepare_response(?fixture.engine, 1, status.NO_CONTENT,
        view.view("No Content", 10), ?no_fields, nil, now)) { ret 6; }
    if (offer(?fixture.engine, 1, nil, 0, true).status != OFFER_BLOCKED) { ret 7; }
    var length_item:   field.Field;
    var length_fields: field.Fields = field.init(?length_item, 1,
        field.limits(1, 32, 16, 16));
    field.append(?length_fields, field.Field{name: view.view("Content-Length", 14),
        value: view.view("5", 1), sensitive: false});
    if (!prepare_response(?fixture.engine, 0, status.OK, view.view("OK", 2),
        ?length_fields, nil, now)
        || !flush_offer(?fixture, 0, "hello", 5, true, now, true)
        || !fixture.slots[0].outbound_complete) { ret 8; }
    if (!release(?fixture.engine, 0, now) || fixture.engine.count != 1
        || fixture.engine.head != 1) { ret 9; }
    val third: Event = process(?fixture.engine, now);
    if (third.kind != EVENT_REQUEST_HEADERS || third.slot != 0
        || third.sequence <= second.sequence) { ret 10; }
    ret 0;
}

test "http.h1.connection: body backpressure supports consume drain and reject" {
    var fixture: Fixture;
    val now:     time.Instant = test_now(100);
    if (!make_fixture(?fixture, SERVER, 1)) { ret 1; }
    val wire:    str   = "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello";
    val headers: Event = complete_read(?fixture, wire, false, now);
    if (headers.kind != EVENT_REQUEST_HEADERS) { ret 2; }
    val body_part: Event = process(?fixture.engine, now);
    if (body_part.kind != EVENT_REQUEST_BODY || body_part.body_length != 5
        || submit_read(?fixture.engine)) { ret 3; }
    if (!consume_body(?fixture.engine, body_part.slot, 2)) { ret 4; }
    val remaining: Event = process(?fixture.engine, now);
    if (remaining.kind != EVENT_REQUEST_BODY || remaining.body_length != 3) { ret 5; }
    if (!set_disposition(?fixture.engine, remaining.slot, BODY_DRAIN)
        || fixture.engine.held_length != 0
        || process(?fixture.engine, now).kind != EVENT_REQUEST_COMPLETE
        || fixture.slots[remaining.slot].drained != 3) { ret 6; }
    var no_fields: field.Fields = field.init(nil, 0, field.limits(0, 0, 0, 0));
    if (!prepare_response(?fixture.engine, remaining.slot, status.NO_CONTENT,
        view.view("No Content", 10), ?no_fields, nil, now)
        || !flush_offer(?fixture, remaining.slot, nil, 0, true, now, false)
        || !release(?fixture.engine, remaining.slot, now)) { ret 7; }
    val rejected_wire:    str   = "POST /reject HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello";
    val rejected_headers: Event = complete_read(?fixture, rejected_wire, false, now);
    if (rejected_headers.kind != EVENT_REQUEST_HEADERS
        || !set_disposition(?fixture.engine, rejected_headers.slot, BODY_REJECT)
        || fixture.engine.state != DRAINING || !fixture.slots[rejected_headers.slot].inbound_abandoned) {
        ret 8;
    }
    var zero_item:   field.Field;
    var zero_fields: field.Fields = field.init(?zero_item, 1, field.limits(1, 32, 16, 16));
    field.append(?zero_fields, field.Field{name: view.view("Content-Length", 14),
        value: view.view("0", 1), sensitive: false});
    if (!prepare_response(?fixture.engine, rejected_headers.slot, status.CONTENT_TOO_LARGE,
        view.view("Content Too Large", 17), ?zero_fields, nil, now)
        || !flush_offer(?fixture, rejected_headers.slot, nil, 0, true, now, false)
        || !progress_close(?fixture.engine) || fixture.io.shutdown_calls != 1) { ret 9; }
    var shutdown: transport.Completion = transport.completed(
        fixture.io.shutdown_token, transport.SHUTDOWN_WRITE, 0);
    if (complete_io(?fixture.engine, ?shutdown, now).kind != EVENT_NONE
        || !progress_close(?fixture.engine) || fixture.io.close_calls != 1) { ret 10; }
    var closed: transport.Completion = transport.completed(
        fixture.io.close_token, transport.CLOSE, 0);
    if (complete_io(?fixture.engine, ?closed, now).kind != EVENT_CLOSED) { ret 11; }
    ret 0;
}

test "http.h1.connection: client handles informationals and close delimited eof" {
    var fixture: Fixture;
    val now:     time.Instant = test_now(100);
    if (!make_fixture(?fixture, CLIENT, 2)) { ret 1; }
    var host_item:   field.Field;
    var host_fields: field.Fields = field.init(?host_item, 1, field.limits(1, 32, 16, 16));
    field.append(?host_fields, field.Field{name: view.view("Host", 4),
        value: view.view("x", 1), sensitive: false});
    val request_target: target.Target = target.origin(view.view("/", 1),
        view.view("/", 1), view.view(nil, 0));
    val first_slot: usize = enqueue_request(?fixture.engine, message.version_h1(1, 1),
        method.from_kind(method.GET), request_target, ?host_fields, nil, now);
    if (first_slot == NO_SLOT || !flush_offer(?fixture, first_slot, nil, 0, true, now, true)) { ret 2; }
    val replies: str = "HTTP/1.1 103 Early Hints\r\nLink: </x>\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n";
    if (complete_read(?fixture, replies, false, now).kind != EVENT_INFORMATIONAL) { ret 3; }
    val final_headers: Event = process(?fixture.engine, now);
    if (final_headers.kind != EVENT_RESPONSE_HEADERS
        || fixture.slots[first_slot].parser.parsed.status != status.OK) { ret 4; }
    if (process(?fixture.engine, now).kind != EVENT_RESPONSE_COMPLETE
        || !release(?fixture.engine, first_slot, now)) { ret 5; }
    val second_slot: usize = enqueue_request(?fixture.engine, message.version_h1(1, 1),
        method.from_kind(method.GET), request_target, ?host_fields, nil, now);
    if (second_slot == NO_SLOT || !flush_offer(?fixture, second_slot, nil, 0, true, now, false)) { ret 6; }
    val close_reply: str = "HTTP/1.1 200 OK\r\n\r\nclose-body";
    if (complete_read(?fixture, close_reply, true, now).kind != EVENT_RESPONSE_HEADERS) { ret 7; }
    val content: Event = process(?fixture.engine, now);
    if (content.kind != EVENT_RESPONSE_BODY || content.body_length != 10
        || !memory.raw_equal(content.body, "close-body", 10)
        || !consume_body(?fixture.engine, second_slot, 10)) { ret 8; }
    if (process(?fixture.engine, now).kind != EVENT_RESPONSE_COMPLETE
        || fixture.engine.state != DRAINING) { ret 9; }
    ret 0;
}

test "http.h1.connection: connect switches protocols without consuming tunnel bytes" {
    var fixture: Fixture;
    val now:     time.Instant = test_now(100);
    if (!make_fixture(?fixture, CLIENT, 1)) { ret 1; }
    var host_item:   field.Field;
    var host_fields: field.Fields = field.init(?host_item, 1, field.limits(1, 32, 16, 16));
    field.append(?host_fields, field.Field{name: view.view("Host", 4),
        value: view.view("x:443", 5), sensitive: false});
    val authority: target.Target = target.authority(view.view("x:443", 5));
    val index:     usize         = enqueue_request(?fixture.engine, message.version_h1(1, 1),
        method.from_kind(method.CONNECT), authority, ?host_fields, nil, now);
    if (index == NO_SLOT || !flush_offer(?fixture, index, nil, 0, true, now, false)) { ret 2; }
    val reply: str = "HTTP/1.1 200 Connection Established\r\n\r\nabc";
    if (complete_read(?fixture, reply, false, now).kind != EVENT_RESPONSE_HEADERS
        || process(?fixture.engine, now).kind != EVENT_RESPONSE_COMPLETE) { ret 3; }
    val tunnel: Event = process(?fixture.engine, now);
    if (tunnel.kind != EVENT_TUNNEL || tunnel.slot != index || tunnel.body_length != 3
        || !memory.raw_equal(tunnel.body, "abc", 3)) { ret 4; }
    ret 0;
}

test "http.h1.connection: absolute deadlines and hostile completions close once" {
    var header_fixture: Fixture;
    if (!make_fixture(?header_fixture, SERVER, 1))                                         { ret 1; }
    if (complete_read(?header_fixture, "G", false, test_now(100)).kind != EVENT_NEED_READ) { ret 2; }
    val expired_header: Event = tick(?header_fixture.engine, test_now(110));
    if (expired_header.kind != EVENT_TIMED_OUT || expired_header.error != ERROR_HEADER_TIMEOUT
        || header_fixture.io.close_calls != 1) { ret 3; }
    var progress_fixture: Fixture;
    if (!make_fixture(?progress_fixture, SERVER, 1)
        || !ready_read(?progress_fixture, test_now(100))) { ret 4; }
    var empty: transport.Completion = transport.completed(
        progress_fixture.io.read_token, transport.READ, 0);
    val stalled: Event = complete_io(?progress_fixture.engine, ?empty, test_now(100));
    if (stalled.kind != EVENT_ERROR || stalled.error != ERROR_NO_PROGRESS
        || progress_fixture.io.close_calls != 1) { ret 5; }
    var cancel_fixture: Fixture;
    if (!make_fixture(?cancel_fixture, SERVER, 1)
        || !transition_ok(cancel.cancel(?cancel_fixture.operation_root))) { ret 6; }
    val cancelled: Event = tick(?cancel_fixture.engine, test_now(100));
    if (cancelled.kind != EVENT_CANCELLED || cancelled.error != ERROR_CANCELLED
        || cancel_fixture.io.close_calls != 1) { ret 7; }
    ret 0;
}

test "http.h1.connection: sustained keep alive and graceful close reuse bounded storage" {
    var fixture: Fixture;
    val now:     time.Instant = test_now(100);
    if (!make_fixture(?fixture, SERVER, 1)) { ret 1; }
    var no_fields:      field.Fields = field.init(nil, 0, field.limits(0, 0, 0, 0));
    var i:              usize        = 0;
    var prior_sequence: u64          = 0;
    for (i < 64) {
        val headers: Event = complete_read(?fixture,
            "GET / HTTP/1.1\r\nHost: x\r\n\r\n", false, now);
        if (headers.kind != EVENT_REQUEST_HEADERS || headers.sequence <= prior_sequence) { ret 2; }
        prior_sequence = headers.sequence;
        if (process(?fixture.engine, now).kind != EVENT_REQUEST_COMPLETE
            || !prepare_response(?fixture.engine, headers.slot, status.NO_CONTENT,
            view.view("No Content", 10), ?no_fields, nil, now)
            || !flush_offer(?fixture, headers.slot, nil, 0, true, now, i % 2 == 0)
            || !release(?fixture.engine, headers.slot, now)) { ret 3; }
        i = i + 1;
    }
    if (fixture.engine.count != 0 || fixture.engine.state != OPEN
        || fixture.io.read_calls != 64) { ret 4; }
    if (!begin_graceful(?fixture.engine) || !progress_close(?fixture.engine)
        || fixture.io.shutdown_calls != 1) { ret 5; }
    var shutdown: transport.Completion = transport.completed(
        fixture.io.shutdown_token, transport.SHUTDOWN_WRITE, 0);
    if (complete_io(?fixture.engine, ?shutdown, now).kind != EVENT_NONE
        || !progress_close(?fixture.engine) || fixture.io.close_calls != 1) { ret 6; }
    var closed: transport.Completion = transport.completed(
        fixture.io.close_token, transport.CLOSE, 0);
    if (complete_io(?fixture.engine, ?closed, now).kind != EVENT_CLOSED
        || fixture.engine.state != CLOSED) { ret 7; }
    ret 0;
}

test "http.h1.connection: server informationals and upgrade barriers preserve wire order" {
    var fixture: Fixture;
    val now:     time.Instant = test_now(100);
    if (!make_fixture(?fixture, SERVER, 1)) { ret 1; }
    val request: str   = "GET /chat HTTP/1.1\r\nHost: x\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n\r\nxyz";
    val headers: Event = complete_read(?fixture, request, false, now);
    if (headers.kind != EVENT_REQUEST_HEADERS || !fixture.slots[headers.slot].upgrade_requested
        || process(?fixture.engine, now).kind != EVENT_REQUEST_COMPLETE
        || fixture.engine.state != DRAINING || process(?fixture.engine, now).kind != EVENT_NONE) { ret 2; }
    var hint_item: field.Field;
    var hints:     field.Fields = field.init(?hint_item, 1, field.limits(1, 32, 16, 16));
    field.append(?hints, field.Field{name: view.view("Link", 4),
        value: view.view("</chat>", 7), sensitive: false});
    if (!prepare_informational(?fixture.engine, headers.slot, status.EARLY_HINTS,
        view.view("Early Hints", 11), ?hints, now)
        || !flush_offer(?fixture, headers.slot, nil, 0, true, now, true)
        || fixture.slots[headers.slot].outbound_complete
        || fixture.slots[headers.slot].serializer_active) { ret 3; }
    var upgrade_items:  [2]field.Field;
    var upgrade_fields: field.Fields = field.init(?upgrade_items[0], 2,
        field.limits(2, 64, 16, 16));
    field.append(?upgrade_fields, field.Field{name: view.view("Connection", 10),
        value: view.view("Upgrade", 7), sensitive: false});
    field.append(?upgrade_fields, field.Field{name: view.view("Upgrade", 7),
        value: view.view("websocket", 9), sensitive: false});
    if (!prepare_response(?fixture.engine, headers.slot, status.SWITCHING_PROTOCOLS,
        view.view("Switching Protocols", 19), ?upgrade_fields, nil, now)
        || !flush_offer(?fixture, headers.slot, nil, 0, true, now, true)) { ret 4; }
    val tunnel: Event = process(?fixture.engine, now);
    if (tunnel.kind != EVENT_TUNNEL || tunnel.slot != headers.slot || tunnel.body_length != 3
        || !memory.raw_equal(tunnel.body, "xyz", 3)) { ret 5; }
    ret 0;
}

test "http.h1.connection: client validates switching protocol response fields" {
    var fixture: Fixture;
    val now:     time.Instant = test_now(100);
    if (!make_fixture(?fixture, CLIENT, 1)) { ret 1; }
    var items:  [3]field.Field;
    var fields: field.Fields = field.init(?items[0], 3, field.limits(3, 96, 16, 16));
    field.append(?fields, field.Field{name: view.view("Host", 4),
        value: view.view("x", 1), sensitive: false});
    field.append(?fields, field.Field{name: view.view("Connection", 10),
        value: view.view("Upgrade", 7), sensitive: false});
    field.append(?fields, field.Field{name: view.view("Upgrade", 7),
        value: view.view("websocket", 9), sensitive: false});
    val request_target: target.Target = target.origin(view.view("/chat", 5),
        view.view("/chat", 5), view.view(nil, 0));
    val index: usize = enqueue_request(?fixture.engine, message.version_h1(1, 1),
        method.from_kind(method.GET), request_target, ?fields, nil, now);
    if (index == NO_SLOT || !flush_offer(?fixture, index, nil, 0, true, now, false)) { ret 2; }
    val response: str = "HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n\r\nframe";
    if (complete_read(?fixture, response, false, now).kind != EVENT_RESPONSE_HEADERS
        || process(?fixture.engine, now).kind != EVENT_RESPONSE_COMPLETE) { ret 3; }
    val tunnel: Event = process(?fixture.engine, now);
    if (tunnel.kind != EVENT_TUNNEL || tunnel.body_length != 5
        || !memory.raw_equal(tunnel.body, "frame", 5)) { ret 4; }
    var invalid_fixture: Fixture;
    if (!make_fixture(?invalid_fixture, CLIENT, 1)) { ret 5; }
    val invalid_index: usize = enqueue_request(?invalid_fixture.engine, message.version_h1(1, 1),
        method.from_kind(method.GET), request_target, ?fields, nil, now);
    if (invalid_index == NO_SLOT
        || !flush_offer(?invalid_fixture, invalid_index, nil, 0, true, now, false)) { ret 6; }
    val invalid_response: str   = "HTTP/1.1 101 Switching Protocols\r\n\r\n";
    val rejected:         Event = complete_read(?invalid_fixture, invalid_response, false, now);
    if (rejected.kind != EVENT_ERROR || rejected.error != ERROR_PROTOCOL) { ret 7; }
    ret 0;
}

test "http.h1.connection: each deadline is absolute and never refreshed by progress" {
    var slow_header: Fixture;
    if (!make_fixture(?slow_header, SERVER, 1)) { ret 1; }
    if (complete_read(?slow_header, "G", false, test_now(100)).kind != EVENT_NEED_READ
        || complete_read(?slow_header, "E", false, test_now(105)).kind != EVENT_NEED_READ) { ret 2; }
    val header_timeout: Event = tick(?slow_header.engine, test_now(110));
    if (header_timeout.error != ERROR_HEADER_TIMEOUT) { ret 3; }
    var request_fixture: Fixture;
    if (!make_fixture(?request_fixture, SERVER, 1)) { ret 4; }
    val request_headers: Event = complete_read(?request_fixture,
        "GET / HTTP/1.1\r\nHost: x\r\n\r\n", false, test_now(100));
    if (request_headers.kind != EVENT_REQUEST_HEADERS
        || process(?request_fixture.engine, test_now(100)).kind != EVENT_REQUEST_COMPLETE) { ret 5; }
    val request_timeout: Event = tick(?request_fixture.engine, test_now(130));
    if (request_timeout.error != ERROR_REQUEST_TIMEOUT) { ret 6; }
    var write_fixture: Fixture;
    if (!make_fixture(?write_fixture, SERVER, 1)) { ret 7; }
    val write_headers: Event = complete_read(?write_fixture,
        "GET / HTTP/1.1\r\nHost: x\r\n\r\n", false, test_now(100));
    if (write_headers.kind != EVENT_REQUEST_HEADERS
        || process(?write_fixture.engine, test_now(100)).kind != EVENT_REQUEST_COMPLETE) { ret 8; }
    var no_fields: field.Fields = field.init(nil, 0, field.limits(0, 0, 0, 0));
    if (!prepare_response(?write_fixture.engine, write_headers.slot, status.NO_CONTENT,
        view.view("No Content", 10), ?no_fields, nil, test_now(100))) { ret 9; }
    write_fixture.slots[write_headers.slot].request_deadline.at = test_now(200);
    write_fixture.slots[write_headers.slot].write_deadline.at   = test_now(105);
    if (tick(?write_fixture.engine, test_now(105)).error != ERROR_WRITE_TIMEOUT) { ret 10; }
    var idle_fixture: Fixture;
    if (!served_once(?idle_fixture, test_now(100))
        || tick(?idle_fixture.engine, test_now(160)).error != ERROR_IDLE_TIMEOUT) { ret 11; }
    var total_fixture: Fixture;
    if (!make_fixture(?total_fixture, SERVER, 1)) { ret 12; }
    total_fixture.engine.wait_deadline.active = false;
    if (tick(?total_fixture.engine, test_now(400)).error != ERROR_TOTAL_TIMEOUT) { ret 13; }
    ret 0;
}

# a server connection that has completed one request and waits idle
fun served_once(fixture: *Fixture, now: time.Instant) bool {
    if (!make_fixture(fixture, SERVER, 1)) { ret false; }
    val headers: Event = complete_read(fixture, "GET / HTTP/1.1\r\nHost: x\r\n\r\n", false, now);
    ret headers.kind == EVENT_REQUEST_HEADERS
        && process(?fixture.engine, now).kind == EVENT_REQUEST_COMPLETE
        && serve_no_content(fixture, headers.slot, now)
        && release(?fixture.engine, headers.slot, now)
        && fixture.engine.count == 0 && !fixture.engine.wait_deadline.active;
}

fun deadline_at(value: Deadline, seconds: i64) bool {
    ret value.active && time.instant_equal(value.at, test_now(seconds));
}

# ticking just before the reported deadline is quiet and ticking at it fails
fun fires_at(fixture: *Fixture, seconds: i64, error: Error) bool {
    if (!deadline_at(next_deadline(?fixture.engine), seconds)) { ret false; }
    if (tick(?fixture.engine, time.Instant{sec: seconds - 1, nsec: 999999999}).kind != EVENT_NONE) {
        ret false;
    }
    ret tick(?fixture.engine, test_now(seconds)).error == error;
}

test "http.h1.connection: next deadline is the one tick enforces first" {
    var idle_fixture: Fixture;
    if (!served_once(?idle_fixture, test_now(100))
        || !fires_at(?idle_fixture, 160, ERROR_IDLE_TIMEOUT)) { ret 1; }
    var first_fixture: Fixture;
    if (!make_fixture(?first_fixture, SERVER, 1)
        || !fires_at(?first_fixture, 110, ERROR_HEADER_TIMEOUT)) { ret 14; }
    var total_fixture: Fixture;
    if (!make_fixture(?total_fixture, SERVER, 1)) { ret 2; }
    total_fixture.engine.idle_deadline.active = false;
    total_fixture.engine.wait_deadline.active = false;
    if (!fires_at(?total_fixture, 400, ERROR_TOTAL_TIMEOUT)) { ret 3; }
    var header_fixture: Fixture;
    if (!make_fixture(?header_fixture, SERVER, 1)
        || complete_read(?header_fixture, "G", false, test_now(100)).kind != EVENT_NEED_READ) { ret 4; }
    # a live slot suppresses the earlier idle deadline, as tick does
    header_fixture.engine.idle_deadline = Deadline{active: true, at: test_now(101)};
    if (!fires_at(?header_fixture, 110, ERROR_HEADER_TIMEOUT)) { ret 5; }
    var request_fixture: Fixture;
    if (!make_fixture(?request_fixture, SERVER, 1)) { ret 6; }
    val request_headers: Event = complete_read(?request_fixture,
        "GET / HTTP/1.1\r\nHost: x\r\n\r\n", false, test_now(100));
    if (request_headers.kind != EVENT_REQUEST_HEADERS
        || request_fixture.slots[request_headers.slot].header_deadline.active
        || !fires_at(?request_fixture, 130, ERROR_REQUEST_TIMEOUT)) { ret 7; }
    var write_fixture: Fixture;
    if (!make_fixture(?write_fixture, SERVER, 1)) { ret 8; }
    val write_headers: Event = complete_read(?write_fixture,
        "GET / HTTP/1.1\r\nHost: x\r\n\r\n", false, test_now(100));
    var no_fields: field.Fields = field.init(nil, 0, field.limits(0, 0, 0, 0));
    if (write_headers.kind != EVENT_REQUEST_HEADERS
        || process(?write_fixture.engine, test_now(100)).kind != EVENT_REQUEST_COMPLETE
        || !prepare_response(?write_fixture.engine, write_headers.slot, status.NO_CONTENT,
        view.view("No Content", 10), ?no_fields, nil, test_now(120))) { ret 9; }
    if (!fires_at(?write_fixture, 130, ERROR_REQUEST_TIMEOUT)) { ret 10; }
    var late_write: Fixture;
    if (!make_fixture(?late_write, SERVER, 1)) { ret 11; }
    val late_headers: Event = complete_read(?late_write,
        "GET / HTTP/1.1\r\nHost: x\r\n\r\n", false, test_now(100));
    if (late_headers.kind != EVENT_REQUEST_HEADERS
        || process(?late_write.engine, test_now(100)).kind != EVENT_REQUEST_COMPLETE
        || !prepare_response(?late_write.engine, late_headers.slot, status.NO_CONTENT,
        view.view("No Content", 10), ?no_fields, nil, test_now(100))) { ret 12; }
    late_write.slots[late_headers.slot].request_deadline.at = test_now(200);
    late_write.slots[late_headers.slot].write_deadline.at   = test_now(125);
    if (!fires_at(?late_write, 125, ERROR_WRITE_TIMEOUT)) { ret 13; }
    ret 0;
}

test "http.h1.connection: no next deadline outside an open engine" {
    var uninitialized: Engine;
    uninitialized.initialized = false;
    if (next_deadline(nil).active || next_deadline(?uninitialized).active) { ret 1; }
    var failed: Fixture;
    if (!make_fixture(?failed, SERVER, 1)
        || tick(?failed.engine, test_now(160)).error != ERROR_IDLE_TIMEOUT
        || failed.engine.state != FAILED || next_deadline(?failed.engine).active) { ret 2; }
    var draining: Fixture;
    if (!make_fixture(?draining, SERVER, 1) || !begin_graceful(?draining.engine)
        || !deadline_at(next_deadline(?draining.engine), 110)) { ret 3; }
    # tick skips these states without looking at any deadline
    var states: [3]State = [3]State{TUNNEL, CLOSING, CLOSED};
    var i:      usize    = 0;
    for (i < 3) {
        var fixture: Fixture;
        if (!make_fixture(?fixture, SERVER, 1)) { ret 4; }
        fixture.engine.state = states[i];
        if (next_deadline(?fixture.engine).active
            || tick(?fixture.engine, test_now(1000)).error != ERROR_NONE) { ret 5; }
        i = i + 1;
    }
    ret 0;
}

test "http.h1.connection: close disposition and stale completions are terminal" {
    var close_fixture: Fixture;
    val now:           time.Instant = test_now(100);
    if (!make_fixture(?close_fixture, SERVER, 1)) { ret 1; }
    val headers: Event = complete_read(?close_fixture,
        "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 1\r\n\r\nx", false, now);
    if (headers.kind != EVENT_REQUEST_HEADERS
        || !set_disposition(?close_fixture.engine, headers.slot, BODY_CLOSE)
        || close_fixture.engine.state != FAILED || close_fixture.io.close_calls != 1) { ret 2; }
    var stale_fixture: Fixture;
    if (!make_fixture(?stale_fixture, SERVER, 1) || !ready_read(?stale_fixture, now)) { ret 3; }
    var stale_token: transport.Token = stale_fixture.io.read_token;
    stale_token.generation = stale_token.generation + 1;
    var stale:    transport.Completion = transport.completed(stale_token, transport.READ, 1);
    val rejected: Event                = complete_io(?stale_fixture.engine, ?stale, now);
    if (rejected.kind != EVENT_ERROR || rejected.error != ERROR_STATE
        || stale_fixture.io.close_calls != 1) { ret 4; }
    var reset_fixture: Fixture;
    if (!make_fixture(?reset_fixture, SERVER, 1) || !ready_read(?reset_fixture, now)) { ret 5; }
    var reset: transport.Completion = transport.failed(reset_fixture.io.read_token,
        transport.READ, 0, io_error.Error{kind: io_error.RESET, code: 0,
        operation: io_error.OP_READ});
    val terminated: Event = complete_io(?reset_fixture.engine, ?reset, now);
    if (terminated.kind != EVENT_ERROR || terminated.error != ERROR_TRANSPORT
        || reset_fixture.engine.state != FAILED || reset_fixture.io.close_calls != 1) { ret 6; }
    ret 0;
}

test "http.h1.connection: client pipeline is bounded and responses stay ordered" {
    var fixture: Fixture;
    val now:     time.Instant = test_now(100);
    if (!make_fixture(?fixture, CLIENT, 2)) { ret 1; }
    var host_item:   field.Field;
    var host_fields: field.Fields = field.init(?host_item, 1, field.limits(1, 32, 16, 16));
    field.append(?host_fields, field.Field{name: view.view("Host", 4),
        value: view.view("x", 1), sensitive: false});
    val first_target: target.Target = target.origin(view.view("/1", 2),
        view.view("/1", 2), view.view(nil, 0));
    val second_target: target.Target = target.origin(view.view("/2", 2),
        view.view("/2", 2), view.view(nil, 0));
    val first: usize = enqueue_request(?fixture.engine, message.version_h1(1, 1),
        method.from_kind(method.GET), first_target, ?host_fields, nil, now);
    val second: usize = enqueue_request(?fixture.engine, message.version_h1(1, 1),
        method.from_kind(method.GET), second_target, ?host_fields, nil, now);
    if (first == NO_SLOT || second == NO_SLOT
        || enqueue_request(?fixture.engine, message.version_h1(1, 1),
        method.from_kind(method.GET), first_target, ?host_fields, nil, now) != NO_SLOT
        || offer(?fixture.engine, second, nil, 0, true).status != OFFER_BLOCKED) { ret 2; }
    if (!flush_offer(?fixture, first, nil, 0, true, now, true)
        || !flush_offer(?fixture, second, nil, 0, true, now, false)) { ret 3; }
    val replies:       str   = "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\nHTTP/1.1 201 Created\r\nContent-Length: 0\r\n\r\n";
    val first_headers: Event = complete_read(?fixture, replies, false, now);
    if (first_headers.kind != EVENT_RESPONSE_HEADERS || first_headers.slot != first
        || fixture.slots[first].parser.parsed.status != status.OK
        || process(?fixture.engine, now).kind != EVENT_RESPONSE_COMPLETE) { ret 4; }
    val second_headers: Event = process(?fixture.engine, now);
    if (second_headers.kind != EVENT_RESPONSE_HEADERS || second_headers.slot != second
        || fixture.slots[first].parser.parsed.status != status.OK
        || fixture.slots[second].parser.parsed.status != status.CREATED
        || process(?fixture.engine, now).kind != EVENT_RESPONSE_COMPLETE) { ret 5; }
    if (submit_read(?fixture.engine) || !release(?fixture.engine, second, now)
        || fixture.engine.count != 2 || !release(?fixture.engine, first, now)
        || fixture.engine.count != 0) { ret 6; }
    ret 0;
}

test "http.h1.connection: graceful close finishes already buffered requests" {
    var fixture: Fixture;
    val now:     time.Instant = test_now(100);
    if (!make_fixture(?fixture, SERVER, 2)) { ret 1; }
    val requests: str   = "GET /1 HTTP/1.1\r\nHost: x\r\n\r\nGET /2 HTTP/1.1\r\nHost: x\r\n\r\n";
    val first:    Event = complete_read(?fixture, requests, false, now);
    if (first.kind != EVENT_REQUEST_HEADERS
        || process(?fixture.engine, now).kind != EVENT_REQUEST_COMPLETE
        || !begin_graceful(?fixture.engine)) { ret 2; }
    val second: Event = process(?fixture.engine, now);
    if (second.kind != EVENT_REQUEST_HEADERS || second.sequence <= first.sequence
        || process(?fixture.engine, now).kind != EVENT_REQUEST_COMPLETE
        || process(?fixture.engine, now).kind != EVENT_NONE
        || submit_read(?fixture.engine)) { ret 3; }
    var no_fields: field.Fields = field.init(nil, 0, field.limits(0, 0, 0, 0));
    if (!prepare_response(?fixture.engine, first.slot, status.NO_CONTENT,
        view.view("No Content", 10), ?no_fields, nil, now)
        || !prepare_response(?fixture.engine, second.slot, status.NO_CONTENT,
        view.view("No Content", 10), ?no_fields, nil, now)
        || !flush_offer(?fixture, first.slot, nil, 0, true, now, true)
        || !flush_offer(?fixture, second.slot, nil, 0, true, now, false)
        || !release(?fixture.engine, first.slot, now)
        || !release(?fixture.engine, second.slot, now)
        || !progress_close(?fixture.engine) || fixture.io.shutdown_calls != 1) { ret 4; }
    ret 0;
}

fun round16(bytes: usize) usize {
    ret (bytes + 15) & ~(15::usize);
}

# the exact set one live slot borrows at the test configuration
fun slot_set_bytes() usize {
    ret round16(256) + round16(1024) + round16(8 * $size_of(field.Field))
        + round16(4 * $size_of(field.Field)) + round16(512);
}

fun serve_no_content(fixture: *Fixture, index: usize, now: time.Instant) bool {
    var no_fields: field.Fields = field.init(nil, 0, field.limits(0, 0, 0, 0));
    ret prepare_response(?fixture.engine, index, status.NO_CONTENT,
        view.view("No Content", 10), ?no_fields, nil, now)
        && flush_offer(fixture, index, nil, 0, true, now, false);
}

test "http.h1.connection: an idle engine borrows nothing and a request borrows exactly its set" {
    var fixture: Fixture;
    val now:     time.Instant = test_now(100);
    if (!make_fixture(?fixture, SERVER, 2))                       { ret 1; }
    if (fixture.account.held != 0 || fixture.account.chunks != 0) { ret 2; }
    # the idle wait holds no read buffer
    if (!submit_read(?fixture.engine) || fixture.io.readable_calls != 1
        || fixture.io.read_calls != 0 || fixture.account.held != 0) { ret 3; }
    var ready: transport.Completion = transport.completed(
        fixture.io.readable_token, transport.READABLE, 0);
    if (complete_io(?fixture.engine, ?ready, now).kind != EVENT_NEED_READ
        || fixture.account.held != round16(512) || fixture.account.used[1] != round16(512)
        || fixture.account.used[0] != 0) { ret 4; }
    if (!submit_read(?fixture.engine) || fixture.io.read_calls != 1) { ret 5; }
    val wire:   str   = "GET / HTTP/1.1\r\nHost: x\r\n\r\n";
    val length: usize = str_len(wire);
    memory.raw_copy(fixture.io.read_buffer, wire, length);
    var completion: transport.Completion = transport.completed(
        fixture.io.read_token, transport.READ, length);
    val headers: Event = complete_io(?fixture.engine, ?completion, now);
    if (headers.kind != EVENT_REQUEST_HEADERS || fixture.account.used[0] != slot_set_bytes()
        || fixture.account.chunks != 1 + SLOT_BUFFERS) { ret 6; }
    if (process(?fixture.engine, now).kind != EVENT_REQUEST_COMPLETE) { ret 7; }
    var no_fields: field.Fields = field.init(nil, 0, field.limits(0, 0, 0, 0));
    if (!prepare_response(?fixture.engine, headers.slot, status.NO_CONTENT,
        view.view("No Content", 10), ?no_fields, nil, now)) { ret 8; }
    val staged: Offer = offer(?fixture.engine, headers.slot, nil, 0, true);
    if (staged.status != OFFER_OUTPUT
        || fixture.account.used[1] != round16(512) + round16(128)) { ret 9; }
    if (!submit_write(?fixture.engine)
        || complete_write(?fixture, fixture.io.write_length, now).kind != EVENT_OUTBOUND_COMPLETE
        || fixture.account.used[1] != round16(512)) { ret 10; }
    if (!release(?fixture.engine, headers.slot, now) || fixture.account.used[0] != 0) { ret 11; }
    # consumed input goes back when the connection waits again
    if (!submit_read(?fixture.engine) || fixture.account.held != 0
        || fixture.account.chunks != 0 || fixture.engine.read_held) { ret 12; }
    ret 0;
}

test "http.h1.connection: a refused slot leaves the request unread and the connection open" {
    var fixture: Fixture;
    val now:     time.Instant = test_now(100);
    if (!make_fixture(?fixture, SERVER, 1)) { ret 1; }
    fixture.account.budgets[0] = slot_set_bytes() - 1;
    val wire:    str   = "GET / HTTP/1.1\r\nHost: x\r\n\r\n";
    val refused: Event = complete_read(?fixture, wire, false, now);
    if (refused.kind != EVENT_MEMORY_BLOCKED || fixture.engine.state != OPEN
        || fixture.engine.count != 0 || fixture.engine.input_offset != 0
        || fixture.account.used[0] != 0 || submit_read(?fixture.engine)) { ret 2; }
    if (process(?fixture.engine, now).kind != EVENT_MEMORY_BLOCKED) { ret 3; }
    fixture.account.budgets[0] = 1 << 20;
    val headers: Event = process(?fixture.engine, now);
    if (headers.kind != EVENT_REQUEST_HEADERS || fixture.account.used[0] != slot_set_bytes()
        || process(?fixture.engine, now).kind != EVENT_REQUEST_COMPLETE
        || !serve_no_content(?fixture, headers.slot, now)
        || !release(?fixture.engine, headers.slot, now)) { ret 4; }
    ret 0;
}

test "http.h1.connection: an exhausted pool registers the connection for a wake up" {
    var fixture: Fixture;
    val now:     time.Instant = test_now(100);
    if (!make_fixture(?fixture, SERVER, 1)) { ret 1; }
    var other:        buffers.Account;
    var budgets:      [2]usize       = [2]usize{1 << 20, 1 << 20};
    val other_opened: buffers.Reason = buffers.source_open_account(?fixture.source, ?other,
        2, ?budgets[0], 0);
    if (!(sel other_opened.none)) { ret 2; }
    val parked: buffers.Acquired = buffers.source_acquire(?fixture.source, ?other,
        buffers.Request{bytes: 4096, align: 0, lane: 0, secret: false}, false);
    if (!(sel parked.status.ok))       { ret 3; }
    if (!submit_read(?fixture.engine)) { ret 4; }
    # the shared remainder is gone, so the read buffer is refused as exhausted
    fixture.pool.global_budget = fixture.pool.overflow_used;
    var ready: transport.Completion = transport.completed(
        fixture.io.readable_token, transport.READABLE, 0);
    var woken: [4]u64;
    if (complete_io(?fixture.engine, ?ready, now).kind != EVENT_MEMORY_BLOCKED
        || !fixture.engine.memory_blocked || !fixture.account.waiting
        || submit_read(?fixture.engine)
        || buffers.source_ready(?fixture.source, ?woken[0], 4) != 0) { ret 5; }
    val returned: buffers.Reason = buffers.source_release(?fixture.source, ?other, parked.chunk);
    if (!(sel returned.none) || buffers.source_ready(?fixture.source, ?woken[0], 4) != 1 || woken[0] != 1) { ret 6; }
    if (process(?fixture.engine, now).kind != EVENT_NEED_READ
        || fixture.engine.memory_blocked || !submit_read(?fixture.engine)
        || fixture.io.read_calls != 1) { ret 7; }
    ret 0;
}

test "http.h1.connection: a refused client slot or write buffer refuses only that step" {
    var fixture: Fixture;
    val now:     time.Instant = test_now(100);
    if (!make_fixture(?fixture, CLIENT, 1)) { ret 1; }
    var host_item:   field.Field;
    var host_fields: field.Fields = field.init(?host_item, 1, field.limits(1, 32, 16, 16));
    field.append(?host_fields, field.Field{name: view.view("Host", 4),
        value: view.view("x", 1), sensitive: false});
    val request_target: target.Target = target.origin(view.view("/", 1),
        view.view("/", 1), view.view(nil, 0));
    fixture.account.budgets[0] = 0;
    if (enqueue_request(?fixture.engine, message.version_h1(1, 1),
        method.from_kind(method.GET), request_target, ?host_fields, nil, now) != NO_SLOT
        || fixture.engine.count != 0 || fixture.engine.state != OPEN
        || fixture.account.held != 0) { ret 2; }
    fixture.account.budgets[0] = 1 << 20;
    fixture.account.budgets[1] = 0;
    val index: usize = enqueue_request(?fixture.engine, message.version_h1(1, 1),
        method.from_kind(method.GET), request_target, ?host_fields, nil, now);
    if (index == NO_SLOT || fixture.account.used[0] != slot_set_bytes()) { ret 3; }
    val blocked: Offer = offer(?fixture.engine, index, nil, 0, true);
    if (blocked.status != OFFER_BLOCKED || blocked.error != ERROR_MEMORY
        || fixture.engine.state != OPEN || fixture.engine.write_held) { ret 4; }
    fixture.account.budgets[1] = 1 << 20;
    if (!flush_offer(?fixture, index, nil, 0, true, now, false)
        || fixture.account.used[1] != 0) { ret 5; }
    ret 0;
}

fun at_time(seconds: i64, nsec: i64) time.Instant {
    ret time.Instant{sec: seconds, nsec: nsec};
}

test "http.h1.connection: a memory refusal never extends the request wait" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, 1)) { ret 1; }
    fixture.account.budgets[0] = slot_set_bytes() - 1;
    # the whole request is buffered, yet no slot can parse it
    if (complete_read(?fixture, "GET / HTTP/1.1\r\nHost: x\r\n\r\n", false, test_now(101)).kind
        != EVENT_MEMORY_BLOCKED) { ret 2; }
    var second: i64 = 102;
    for (second < 110) {
        if (process(?fixture.engine, test_now(second)).kind != EVENT_MEMORY_BLOCKED
            || !deadline_at(next_deadline(?fixture.engine), 110)
            || tick(?fixture.engine, test_now(second)).kind != EVENT_NONE) { ret 3; }
        second = second + 1;
    }
    if (tick(?fixture.engine, at_time(109, 999999999)).kind != EVENT_NONE) { ret 4; }
    val expired: Event = tick(?fixture.engine, test_now(110));
    if (expired.kind != EVENT_TIMED_OUT || expired.error != ERROR_HEADER_TIMEOUT
        || !fixture.engine.memory_blocked || fixture.engine.count != 0) { ret 5; }
    ret 0;
}

test "http.h1.connection: a refused read buffer after keep-alive waits only the header timeout" {
    var fixture: Fixture;
    if (!served_once(?fixture, test_now(100)) || !submit_read(?fixture.engine)) { ret 1; }
    fixture.account.budgets[1] = fixture.account.used[1];
    var ready: transport.Completion = transport.completed(
        fixture.io.readable_token, transport.READABLE, 0);
    if (complete_io(?fixture.engine, ?ready, test_now(130)).kind != EVENT_MEMORY_BLOCKED
        || !deadline_at(next_deadline(?fixture.engine), 140)) { ret 2; }
    var second: i64 = 131;
    for (second < 140) {
        if (process(?fixture.engine, test_now(second)).kind != EVENT_MEMORY_BLOCKED
            || tick(?fixture.engine, test_now(second)).kind != EVENT_NONE) { ret 3; }
        second = second + 1;
    }
    val expired: Event = tick(?fixture.engine, test_now(140));
    if (expired.error != ERROR_HEADER_TIMEOUT || !fixture.engine.memory_blocked) { ret 4; }
    ret 0;
}

test "http.h1.connection: a slot that starts just before the wait expires owns the deadline" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, 1)) { ret 1; }
    fixture.account.budgets[0] = slot_set_bytes() - 1;
    if (complete_read(?fixture, "GE", false, test_now(105)).kind != EVENT_MEMORY_BLOCKED) { ret 2; }
    fixture.account.budgets[0] = 1 << 20;
    val started: Event = process(?fixture.engine, test_now(109));
    if (started.kind != EVENT_NEED_READ || fixture.engine.count != 1
        || fixture.engine.wait_deadline.active) { ret 3; }
    # the slot's own header deadline runs from its start, and nothing else fires at 110
    if (!deadline_at(fixture.slots[fixture.engine.head].header_deadline, 119)
        || tick(?fixture.engine, test_now(110)).kind != EVENT_NONE
        || !fires_at(?fixture, 119, ERROR_HEADER_TIMEOUT)) { ret 4; }
    ret 0;
}

test "http.h1.connection: a keep-alive connection lives its full idle timeout" {
    var fixture: Fixture;
    if (!served_once(?fixture, test_now(100))) { ret 1; }
    # the host's readable wait is pending, but no byte and no readiness has arrived
    if (!submit_read(?fixture.engine) || fixture.engine.wait_deadline.active
        || tick(?fixture.engine, test_now(150)).kind != EVENT_NONE
        || !fires_at(?fixture, 160, ERROR_IDLE_TIMEOUT)) { ret 2; }
    ret 0;
}

test "http.h1.connection: a silent new connection owes its first request within the header timeout" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, 1) || !submit_read(?fixture.engine)
        || !fires_at(?fixture, 110, ERROR_HEADER_TIMEOUT)) { ret 1; }
    var client: Fixture;
    if (!make_fixture(?client, CLIENT, 1) || client.engine.wait_deadline.active
        || !deadline_at(next_deadline(?client.engine), 160)) { ret 2; }
    ret 0;
}
