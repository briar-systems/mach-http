use http.core.method;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.view;

pub def Form: u8;

pub val ORIGIN:    Form = 1;
pub val ABSOLUTE:  Form = 2;
pub val AUTHORITY: Form = 3;
pub val ASTERISK:  Form = 4;

pub rec Limits {
    max_raw_bytes:       usize;
    max_scheme_bytes:    usize;
    max_authority_bytes: usize;
    max_path_bytes:      usize;
    max_query_bytes:     usize;
}

pub rec Target {
    form:      Form;
    raw:       view.View;
    scheme:    view.View;
    authority: view.View;
    path:      view.View;
    query:     view.View;
}

fun present(value: view.View) bool {
    ret value.len != 0 && value.data != nil;
}

fun bounded(value: view.View, max_bytes: usize) bool {
    ret (value.len == 0 || value.data != nil) && value.len <= max_bytes;
}

fun hex_digit(c: u8) bool {
    ret (c >= '0' && c <= '9') || (c >= 'A' && c <= 'F') || (c >= 'a' && c <= 'f');
}

# the RFC 3986 grammar of a path (pchar and "/") or, when `query` is set, a query
# (pchar, "/" and "?"): unreserved, sub-delims, ":", "@" and complete
# percent escapes. an empty component is well formed
pub fun component_valid(value: view.View, query: bool) bool {
    if (value.len == 0)    { ret true; }
    if (value.data == nil) { ret false; }
    var i: usize = 0;
    for (i < value.len) {
        val c:        u8   = value.data[i];
        val ordinary: bool = (c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z')
            || (c >= 'a' && c <= 'z') || c == '-' || c == '.' || c == '_'
            || c == '~' || c == '!' || c == '$' || c == '&' || c == 39
            || c == '(' || c == ')' || c == '*' || c == '+' || c == ','
            || c == ';' || c == '=' || c == ':' || c == '@' || c == '/'
            || (query && c == '?');
        if (ordinary) {
            i = i + 1;
        }
        or {
            if (c != '%' || value.len - i < 3 || !hex_digit(value.data[i + 1])
                || !hex_digit(value.data[i + 2])) { ret false; }
            i = i + 3;
        }
    }
    ret true;
}

# whether the path and query of a target follow the URI grammar. the h1 parser
# holds a request line to it, and a host that builds a target from an HTTP/2 or
# HTTP/3 `:path` checks the result with it. authority and asterisk forms carry
# neither component
pub fun well_formed(parsed: Target) bool {
    if (parsed.form != ORIGIN && parsed.form != ABSOLUTE) { ret true; }
    ret component_valid(parsed.path, false) && component_valid(parsed.query, true);
}

pub fun limits(max_raw_bytes: usize, max_scheme_bytes: usize, max_authority_bytes: usize,
    max_path_bytes: usize, max_query_bytes: usize) Limits {
    ret Limits{
        max_raw_bytes:       max_raw_bytes,
        max_scheme_bytes:    max_scheme_bytes,
        max_authority_bytes: max_authority_bytes,
        max_path_bytes:      max_path_bytes,
        max_query_bytes:     max_query_bytes,
    };
}

pub fun valid(target: Target, configured: Limits) bool {
    if (!present(target.raw) || !bounded(target.raw, configured.max_raw_bytes)
        || !bounded(target.scheme, configured.max_scheme_bytes)
        || !bounded(target.authority, configured.max_authority_bytes)
        || !bounded(target.path, configured.max_path_bytes)
        || !bounded(target.query, configured.max_query_bytes)) { ret false; }
    if (target.form == ORIGIN) {
        ret !present(target.scheme) && !present(target.authority) && present(target.path)
            && target.path.data[0] == '/';
    }
    if (target.form == ABSOLUTE) {
        ret present(target.scheme) && present(target.authority);
    }
    if (target.form == AUTHORITY) {
        ret present(target.authority) && !present(target.scheme) && !present(target.path) && !present(target.query);
    }
    if (target.form == ASTERISK) {
        ret target.raw.len == 1 && target.raw.data[0] == '*'
            && !present(target.scheme) && !present(target.authority) && !present(target.path) && !present(target.query);
    }
    ret false;
}

pub fun valid_for_method(target: Target, method_kind: method.Kind, configured: Limits) bool {
    if (!valid(target, configured))    { ret false; }
    if (method_kind == method.CONNECT) { ret target.form == AUTHORITY; }
    if (target.form == AUTHORITY)      { ret false; }
    if (target.form == ASTERISK)       { ret method_kind == method.OPTIONS; }
    ret true;
}

pub fun origin(raw: view.View, path: view.View, query: view.View) Target {
    ret Target{
        form:      ORIGIN,
        raw:       raw,
        scheme:    view.view(nil, 0),
        authority: view.view(nil, 0),
        path:      path,
        query:     query,
    };
}

pub fun absolute(raw: view.View, scheme: view.View, authority: view.View, path: view.View, query: view.View) Target {
    ret Target{form: ABSOLUTE, raw: raw, scheme: scheme, authority: authority, path: path, query: query};
}

pub fun authority(raw: view.View) Target {
    ret Target{
        form:      AUTHORITY,
        raw:       raw,
        scheme:    view.view(nil, 0),
        authority: raw,
        path:      view.view(nil, 0),
        query:     view.view(nil, 0),
    };
}

pub fun asterisk() Target {
    ret Target{
        form:      ASTERISK,
        raw:       view.view("*", 1),
        scheme:    view.view(nil, 0),
        authority: view.view(nil, 0),
        path:      view.view(nil, 0),
        query:     view.view(nil, 0),
    };
}

test "http.core.target: all request-target forms are represented" {
    val configured: Limits = limits(128, 8, 64, 64, 32);
    if (!valid_for_method(origin(view.view("/a?q", 4), view.view("/a", 2), view.view("q", 1)), method.GET, configured))                                                     { ret 1; }
    if (!valid_for_method(absolute(view.view("https://x/a", 11), view.view("https", 5), view.view("x", 1), view.view("/a", 2), view.view(nil, 0)), method.GET, configured)) { ret 2; }
    if (!valid_for_method(authority(view.view("x:443", 5)), method.CONNECT, configured))                                                                                    { ret 3; }
    if (!valid_for_method(asterisk(), method.OPTIONS, configured))                                                                                                          { ret 4; }
    ret 0;
}

test "http.core.target: forms and dimensions fail independently" {
    val configured: Limits = limits(8, 5, 4, 3, 2);
    if (valid_for_method(authority(view.view("x:1", 3)), method.GET, configured))                                                               { ret 1; }
    if (valid_for_method(asterisk(), method.GET, configured))                                                                                   { ret 2; }
    if (valid(origin(view.view("long-path", 9), view.view("/a", 2), view.view(nil, 0)), configured))                                            { ret 3; }
    if (valid(origin(view.view("/abcd", 5), view.view("/abcd", 5), view.view(nil, 0)), configured))                                             { ret 4; }
    if (valid(absolute(view.view("s://abcde", 9), view.view("s", 1), view.view("abcde", 5), view.view(nil, 0), view.view(nil, 0)), configured)) { ret 5; }
    ret 0;
}

test "http.core.target: a path or query with a broken percent escape is not well formed" {
    if (!component_valid(view.view("/a%20b/c", 8), false))                                         { ret 1; }
    if (!component_valid(view.view("q=%7e&r=?/", 10), true))                                       { ret 2; }
    if (!component_valid(view.view(nil, 0), true))                                                 { ret 3; }
    if (component_valid(view.view("/a%ZZ", 5), false))                                             { ret 4; }
    if (component_valid(view.view("/a%4", 4), false))                                              { ret 5; }
    if (component_valid(view.view("q=%", 3), true))                                                { ret 6; }
    if (component_valid(view.view("/a?b", 4), false))                                              { ret 7; }
    if (component_valid(view.view("/a b", 4), false))                                              { ret 8; }
    if (!well_formed(origin(view.view("/a?q=%41", 8), view.view("/a", 2), view.view("q=%41", 5)))) { ret 9; }
    if (well_formed(origin(view.view("/a?q=%ZZ", 8), view.view("/a", 2), view.view("q=%ZZ", 5))))  { ret 10; }
    if (well_formed(origin(view.view("/%ZZ", 4), view.view("/%ZZ", 4), view.view(nil, 0))))        { ret 11; }
    if (well_formed(absolute(view.view("http://x/?%G0", 13), view.view("http", 4), view.view("x", 1),
        view.view("/", 1), view.view("%G0", 3)))) { ret 12; }
    if (!well_formed(asterisk())) { ret 13; }
    ret 0;
}
