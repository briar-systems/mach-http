# bounded http/2 connection and stream engine

use http.core.body;
use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.method;
use http.core.records;
use http.core.status;
use http.core.target;
use http.core.transport;
use http.h2.frame;
use http.h2.hpack;
use std.allocator;
use std.allocator.page;
use std.chrono.time;
use io_error: std.io.error;
use std.io.lifecycle;
use io_runtime: std.io.runtime;
use std.memory;
use std.memory.buffers;
use std.sync.cancel;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view;

fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

fun scope_active(scope: *cancel.Scope) bool {
    val reason: cancel.Reason = cancel.reason(scope);
    ret sel reason.active;
}

fun scope_cancelled(scope: *cancel.Scope) bool {
    val reason: cancel.Reason = cancel.reason(scope);
    ret sel reason.cancelled;
}

pub def Role: u8;
pub val SERVER: Role = 1;
pub val CLIENT: Role = 2;

pub def State: u8;
pub val PREFACE:  State = 1;
pub val OPEN:     State = 2;
pub val DRAINING: State = 3;
pub val CLOSING:  State = 4;
pub val CLOSED:   State = 5;
pub val FAILED:   State = 6;

pub def StreamState: u8;
pub val STREAM_IDLE:               StreamState = 1;
pub val STREAM_RESERVED_LOCAL:     StreamState = 2;
pub val STREAM_RESERVED_REMOTE:    StreamState = 3;
pub val STREAM_OPEN:               StreamState = 4;
pub val STREAM_HALF_CLOSED_LOCAL:  StreamState = 5;
pub val STREAM_HALF_CLOSED_REMOTE: StreamState = 6;
pub val STREAM_CLOSED:             StreamState = 7;

pub val H2_NO_ERROR:            u32 = 0;
pub val H2_PROTOCOL_ERROR:      u32 = 1;
pub val H2_INTERNAL_ERROR:      u32 = 2;
pub val H2_FLOW_CONTROL_ERROR:  u32 = 3;
pub val H2_SETTINGS_TIMEOUT:    u32 = 4;
pub val H2_STREAM_CLOSED:       u32 = 5;
pub val H2_FRAME_SIZE_ERROR:    u32 = 6;
pub val H2_REFUSED_STREAM:      u32 = 7;
pub val H2_CANCEL:              u32 = 8;
pub val H2_COMPRESSION_ERROR:   u32 = 9;
pub val H2_CONNECT_ERROR:       u32 = 10;
pub val H2_ENHANCE_YOUR_CALM:   u32 = 11;
pub val H2_INADEQUATE_SECURITY: u32 = 12;
pub val H2_HTTP_1_1_REQUIRED:   u32 = 13;

pub def Error: u8;
pub val ERROR_NONE:         Error = 0;
pub val ERROR_STATE:        Error = 1;
pub val ERROR_LIMIT:        Error = 2;
pub val ERROR_PROTOCOL:     Error = 3;
pub val ERROR_FRAME:        Error = 4;
pub val ERROR_COMPRESSION:  Error = 5;
pub val ERROR_FLOW_CONTROL: Error = 6;
pub val ERROR_TRANSPORT:    Error = 7;
pub val ERROR_NO_PROGRESS:  Error = 8;
pub val ERROR_CANCELLED:    Error = 9;
pub val ERROR_MEMORY:       Error = 10;

pub def EventKind: u8;
pub val EVENT_NONE:             EventKind = 0;
pub val EVENT_NEED_READ:        EventKind = 1;
pub val EVENT_SETTINGS:         EventKind = 2;
pub val EVENT_PING:             EventKind = 3;
pub val EVENT_REQUEST_HEADERS:  EventKind = 4;
pub val EVENT_RESPONSE_HEADERS: EventKind = 5;
pub val EVENT_INFORMATIONAL:    EventKind = 6;
pub val EVENT_TRAILERS:         EventKind = 7;
pub val EVENT_PUSH_PROMISE:     EventKind = 8;
pub val EVENT_DATA:             EventKind = 9;
pub val EVENT_STREAM_END:       EventKind = 10;
pub val EVENT_STREAM_RESET:     EventKind = 11;
pub val EVENT_STREAM_RETRY:     EventKind = 12;
pub val EVENT_PRIORITY:         EventKind = 13;
pub val EVENT_GOAWAY:           EventKind = 14;
pub val EVENT_PEER_CLOSED:      EventKind = 15;
pub val EVENT_CLOSED:           EventKind = 16;
pub val EVENT_CANCELLED:        EventKind = 17;
pub val EVENT_STREAM_ERROR:     EventKind = 18;
pub val EVENT_ERROR:            EventKind = 19;
pub val EVENT_PENDING:          EventKind = 20;
pub val EVENT_MEMORY_BLOCKED:   EventKind = 21;

pub def OfferStatus: u8;
pub val OFFER_OUTPUT:  OfferStatus = 1;
pub val OFFER_PARTIAL: OfferStatus = 2;
pub val OFFER_DONE:    OfferStatus = 3;
pub val OFFER_BLOCKED: OfferStatus = 4;
pub val OFFER_ERROR:   OfferStatus = 5;

val OUTPUT_NONE:    u8 = 0;
val OUTPUT_PREFACE: u8 = 1;
val OUTPUT_CONTROL: u8 = 2;
val OUTPUT_HEADERS: u8 = 3;
val OUTPUT_DATA:    u8 = 4;

val HEADER_REQUEST:       u8 = 1;
val HEADER_RESPONSE:      u8 = 2;
val HEADER_INFORMATIONAL: u8 = 3;
val HEADER_TRAILERS:      u8 = 4;
val HEADER_PUSH:          u8 = 5;

pub val NO_STREAM: u32   = 0;
pub val NO_SLOT:   usize = (-1)::usize;

val INDEX_EMPTY:     usize = (-1)::usize;
val INDEX_TOMBSTONE: usize = (-2)::usize;

# the slot of the inline stream that decodes refused header blocks
val RESERVE_SLOT: usize = (-3)::usize;

val STREAM_BUFFERS: usize = 4;

# ready-queue entries serviced and inbound frames handled per `process` call
val SERVICE_BUDGET: usize = 64;

val LIST_WINDOW:   usize = 0;
val LIST_WRITABLE: usize = 1;
val LIST_EXCHANGE: usize = 2;
val LIST_COUNT:    usize = 3;

pub rec Settings {
    header_table_size:       u32;
    enable_push:             u32;
    max_concurrent_streams:  u32;
    initial_window_size:     u32;
    max_frame_size:          u32;
    max_header_list_size:    u32;
    enable_connect_protocol: u32;
}

# every stream record and buffer but the refused-stream set is borrowed from the
# connection's std.memory.buffers account
# ---
# write_bytes:         the write buffer, held while a frame is staged or in flight
# frame_payload_bytes: the inbound payload copy, at least every advertised max_frame_size
# initial_streams:     stream records in the first chunk, taken at init
# stream_lane:         the budget lane of per-stream decoder sets
# connection_lane:     the budget lane of records, the index and transient buffers
pub rec Config {
    local:                   Settings;
    hpack:                   hpack.Limits;
    max_streams:             usize;
    max_frame_payload:       usize;
    connection_window_size:  u32;
    window_update_threshold: u32;
    write_bytes:             usize;
    frame_payload_bytes:     usize;
    initial_streams:         usize;
    stream_lane:             u8;
    connection_lane:         u8;
}

# the buffers a decoding stream holds. a borrowed set is acquired all or nothing
# and `held` is set; the refused-stream set is caller storage and is never held
pub rec StreamMemory {
    encoded:          *u8;
    encoded_capacity: usize;
    fields:           *field.Field;
    field_capacity:   usize;
    strings:          *u8;
    string_capacity:  usize;
    pending:          *hpack.Entry;
    pending_capacity: usize;
    chunks:           [4]buffers.Chunk;
    held:             bool;
}

pub rec StreamIndexEntry {
    id:   u64;
    slot: usize;
}

pub rec StreamLink {
    prev:   usize;
    next:   usize;
    linked: bool;
}

pub rec StreamList {
    head:  usize;
    tail:  usize;
    count: usize;
}

pub rec Stream {
    id:                       u32;
    generation:               u64;
    state:                    StreamState;
    initiated_local:          bool;
    initial_headers_received: bool;
    initial_headers_sent:     bool;
    trailers_received:        bool;
    trailers_sent:            bool;
    push_promise_sent:        bool;
    inbound_has_length:       bool;
    inbound_declared_length:  u64;
    inbound_body_bytes:       u64;
    inbound_body_forbidden:   bool;
    outbound_has_length:      bool;
    outbound_declared_length: u64;
    outbound_body_bytes:      u64;
    outbound_body_forbidden:  bool;
    send_window:              i64;
    recv_window:              i64;
    consumed_pending:         u32;
    weight:                   u16;
    writable:                 bool;
    schedule_credit:          i64;
    exchange:                 *exchange.Exchange;
    decoder:                  hpack.Decoder;
    memory:                   StreamMemory;
    retry_pending:            bool;
    pending_reset:            u32;
    reset_code:               u32;
    live:                     bool;
    slot:                     usize;
    index_position:           usize;
    next_free:                usize;
    ready_next:               usize;
    queued:                   bool;
    links:                    [LIST_COUNT]StreamLink;
}

pub rec Control {
    header:  frame.Header;
    payload: [48]u8;
    length:  usize;
}

pub rec HeaderBlock {
    fields:             *field.Field;
    count:              usize;
    regular_offset:     usize;
    method:             view.View;
    scheme:             view.View;
    path:               view.View;
    authority:          view.View;
    protocol:           view.View;
    status:             u16;
    has_content_length: bool;
    content_length:     u64;
}

pub rec Event {
    kind:           EventKind;
    stream_id:      u32;
    generation:     u64;
    headers:        HeaderBlock;
    data:           *u8;
    data_length:    usize;
    end_stream:     bool;
    code:           u32;
    last_stream_id: u32;
    opaque:         [8]u8;
    error:          Error;
}

pub rec Offer {
    status:    OfferStatus;
    consumed:  usize;
    produced:  usize;
    stream_id: u32;
    error:     Error;
}

pub rec Engine {
    role:                      Role;
    state:                     State;
    configured:                Config;
    transport:                 *transport.Transport;
    scope:                     *cancel.Scope;
    source:                    *buffers.Source;
    account:                   *buffers.Account;
    memory_blocked:            bool;
    records:                   records.Records;
    stream_capacity:           usize;
    reserve:                   Stream;
    refused_memory:            StreamMemory;
    index:                     *StreamIndexEntry;
    index_capacity:            usize;
    index_chunk:               buffers.Chunk;
    index_tombstones:          usize;
    free_head:                 usize;
    ready_head:                usize;
    ready_tail:                usize;
    ready_count:               usize;
    lists:                     [LIST_COUNT]StreamList;
    slot_visits:               u64;
    index_rebuilds:            u64;
    active_streams:            usize;
    active_local:              usize;
    active_remote:             usize;
    next_local_stream:         u32;
    last_remote_stream:        u32;
    next_generation:           u64;
    peer:                      Settings;
    peer_settings_received:    bool;
    local_settings_pending:    bool;
    local_settings_applied:    bool;
    local_initial_window:      u32;
    preface_offset:            usize;
    preface_received:          bool;
    parser:                    frame.Parser;
    writer:                    frame.Writer;
    current_header:            frame.Header;
    frame_payload:             *u8;
    frame_payload_capacity:    usize;
    frame_payload_length:      usize;
    payload_chunk:             buffers.Chunk;
    payload_held:              bool;
    payload_wanted:            bool;
    header_slot:               usize;
    header_wire_stream:        u32;
    header_kind:               u8;
    header_end_stream:         bool;
    inbound_table:             hpack.DynamicTable;
    outbound_table:            hpack.DynamicTable;
    encoder:                   hpack.Encoder;
    encoder_pending:           *hpack.Entry;
    encoder_pending_capacity:  usize;
    header_output:             *u8;
    header_output_capacity:    usize;
    encode_chunks:             [2]buffers.Chunk;
    header_output_held:        bool;
    header_output_active:      bool;
    header_output_length:      usize;
    header_output_offset:      usize;
    header_output_stream:      u32;
    header_output_wire_stream: u32;
    header_output_end_stream:  bool;
    header_output_first:       bool;
    header_output_push:        bool;
    controls:                  *Control;
    control_capacity:          usize;
    control_head:              usize;
    control_count:             usize;
    read_buffer:               *u8;
    read_capacity:             usize;
    input_length:              usize;
    input_offset:              usize;
    input_eof:                 bool;
    read_pending:              bool;
    read_token:                transport.Token;
    write_buffer:              *u8;
    write_capacity:            usize;
    write_chunk:               buffers.Chunk;
    write_held:                bool;
    write_length:              usize;
    write_offset:              usize;
    write_pending:             bool;
    write_token:               transport.Token;
    write_kind:                u8;
    write_stream:              u32;
    write_end_stream:          bool;
    write_header_bytes:        usize;
    held:                      bool;
    held_kind:                 EventKind;
    held_stream:               u32;
    held_headers:              HeaderBlock;
    held_data:                 *u8;
    held_length:               usize;
    held_end_stream:           bool;
    pending_end_stream:        u32;
    remote_goaway_last:        u32;
    local_goaway_last:         u32;
    goaway_received:           bool;
    goaway_sent:               bool;
    final_goaway_sent:         bool;
    graceful:                  bool;
    send_window:               i64;
    recv_window:               i64;
    consumed_pending:          u32;
    scheduled_stream:          u32;
    close_pending:             bool;
    close_token:               transport.Token;
    error:                     Error;
    h2_error:                  u32;
    initialized:               bool;
}

val CLIENT_PREFACE:        *u8   = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n";
val CLIENT_PREFACE_LENGTH: usize = 24;

pub fun settings_default() Settings {
    ret Settings{
        header_table_size:       4096,
        enable_push:             1,
        max_concurrent_streams:  0xffffffff,
        initial_window_size:     65535,
        max_frame_size:          frame.DEFAULT_MAX_FRAME_SIZE,
        max_header_list_size:    0xffffffff,
        enable_connect_protocol: 0,
    };
}

pub fun config_default() Config {
    ret Config{
        local:                   settings_default(),
        hpack:                   hpack.limits_default(),
        max_streams:             100,
        max_frame_payload:       frame.DEFAULT_MAX_FRAME_SIZE::usize,
        connection_window_size:  1048576,
        window_update_threshold: 32768,
        write_bytes:             frame.DEFAULT_MAX_FRAME_SIZE::usize + 9,
        frame_payload_bytes:     frame.DEFAULT_MAX_FRAME_SIZE::usize,
        initial_streams:         4,
        stream_lane:             0,
        connection_lane:         0,
    };
}

fun settings_valid(settings: Settings) bool {
    ret settings.enable_push <= 1 && settings.enable_connect_protocol <= 1
        && settings.initial_window_size <= 0x7fffffff
        && settings.max_frame_size >= frame.DEFAULT_MAX_FRAME_SIZE
        && settings.max_frame_size <= frame.MAX_FRAME_SIZE;
}

# the first chunk never holds more records than max_streams admits
fun first_streams(configured: Config) usize {
    if (configured.initial_streams > configured.max_streams) { ret configured.max_streams; }
    ret configured.initial_streams;
}

fun config_valid(configured: Config) bool {
    ret settings_valid(configured.local) && configured.max_streams != 0
        && configured.initial_streams != 0
        && configured.max_streams <= records.limit(first_streams(configured))
        && configured.max_streams < (-1)::usize / 4
        && configured.write_bytes >= 57
        && configured.frame_payload_bytes >= configured.local.max_frame_size::usize
        && configured.hpack.max_header_count <= (-1)::usize / $size_of(hpack.Entry)
        && configured.hpack.max_header_count <= (-1)::usize / $size_of(field.Field)
        && configured.max_frame_payload != 0
        && configured.max_frame_payload <= configured.local.max_frame_size::usize
        && configured.connection_window_size >= 65535
        && configured.connection_window_size <= 0x7fffffff
        && configured.window_update_threshold != 0
        && configured.window_update_threshold <= configured.local.initial_window_size
        && configured.hpack.max_dynamic_table_bytes >= 4096
        && configured.hpack.max_dynamic_table_bytes >= configured.local.header_table_size::usize
        && configured.hpack.max_header_list_bytes != 0
        && configured.hpack.max_header_count != 0
        && configured.hpack.max_string_bytes != 0
        && configured.hpack.max_encoded_block_bytes != 0;
}

fun memory_valid(memory_value: StreamMemory, configured: Config) bool {
    ret memory_value.encoded != nil
        && memory_value.encoded_capacity >= configured.hpack.max_encoded_block_bytes
        && memory_value.fields != nil
        && memory_value.field_capacity >= configured.hpack.max_header_count
        && memory_value.strings != nil
        && memory_value.string_capacity >= configured.hpack.max_header_list_bytes
        && memory_value.pending != nil
        && memory_value.pending_capacity >= configured.hpack.max_header_count;
}

fun empty_headers() HeaderBlock {
    ret HeaderBlock{fields: nil, count: 0, regular_offset: 0,
        method:             view.view(nil, 0), scheme: view.view(nil, 0), path: view.view(nil, 0),
        authority:          view.view(nil, 0), protocol: view.view(nil, 0), status: 0,
        has_content_length: false, content_length: 0};
}

fun event(engine: *Engine, kind: EventKind) Event {
    var opaque: [8]u8;
    ret Event{kind: kind, stream_id: 0, generation: 0, headers: empty_headers(),
        data:           nil, data_length: 0, end_stream: false, code: 0,
        last_stream_id: 0, opaque: opaque, error: engine.error};
}

fun stream_event(engine: *Engine, kind: EventKind, stream: *Stream) Event {
    var result: Event = event(engine, kind);
    if (stream != nil) {
        result.stream_id  = stream.id;
        result.generation = stream.generation;
    }
    ret result;
}

# clears protocol state only. the slot's table links are owned by their lists and
# its memory by allocation and release
fun reset_stream(stream: *Stream) {
    var decoder: hpack.Decoder;
    stream.id                       = 0;
    stream.generation               = 0;
    stream.state                    = STREAM_IDLE;
    stream.initiated_local          = false;
    stream.initial_headers_received = false;
    stream.initial_headers_sent     = false;
    stream.trailers_received        = false;
    stream.trailers_sent            = false;
    stream.push_promise_sent        = false;
    stream.inbound_has_length       = false;
    stream.inbound_declared_length  = 0;
    stream.inbound_body_bytes       = 0;
    stream.inbound_body_forbidden   = false;
    stream.outbound_has_length      = false;
    stream.outbound_declared_length = 0;
    stream.outbound_body_bytes      = 0;
    stream.outbound_body_forbidden  = false;
    stream.send_window              = 0;
    stream.recv_window              = 0;
    stream.consumed_pending         = 0;
    stream.weight                   = 16;
    stream.writable                 = false;
    stream.schedule_credit          = 0;
    stream.exchange                 = nil;
    stream.decoder                  = decoder;
    stream.retry_pending            = false;
    stream.pending_reset            = H2_NO_ERROR;
    stream.reset_code               = H2_NO_ERROR;
    stream.live                     = false;
}

fun next_generation(engine: *Engine) u64 {
    val result: u64 = engine.next_generation;
    if (result == (-1)::u64) { engine.next_generation = 0; }
    or                       { engine.next_generation = result + 1; }
    ret result;
}

fun slot_stream(engine: *Engine, slot: usize) *Stream {
    if (slot == RESERVE_SLOT) { ret ?engine.reserve; }
    ret records.at(?engine.records, slot)::*Stream;
}

fun visit(engine: *Engine, slot: usize) *Stream {
    engine.slot_visits = engine.slot_visits + 1;
    ret slot_stream(engine, slot);
}

# linear passes cover every table slot and then the reserve
fun sweep_count(engine: *Engine) usize {
    ret engine.stream_capacity + 1;
}

fun sweep_at(engine: *Engine, i: usize) *Stream {
    engine.slot_visits = engine.slot_visits + 1;
    if (i == engine.stream_capacity) { ret ?engine.reserve; }
    ret records.at(?engine.records, i)::*Stream;
}

fun granted(got: buffers.Acquired) bool {
    ret sel got.status.ok;
}

fun buffer_request(bytes: usize, align: usize, lane: u8) buffers.Request {
    ret buffers.Request{bytes: bytes, align: align, lane: lane, secret: false};
}

# a transient refusal registers the account, so the host re-drives the
# connection when the source reports the account ready
fun acquire_transient(engine: *Engine, bytes: usize, chunk: *buffers.Chunk) bool {
    val got: buffers.Acquired = buffers.source_acquire(engine.source, engine.account,
        buffer_request(bytes, 0, engine.configured.connection_lane), true);
    engine.memory_blocked = !granted(got);
    if (engine.memory_blocked) { ret false; }
    @chunk = got.chunk;
    ret true;
}

fun release_chunk(engine: *Engine, chunk: buffers.Chunk) {
    buffers.source_release(engine.source, engine.account, chunk);
}

fun acquire_write(engine: *Engine) bool {
    if (engine.write_held) { ret true; }
    if (!acquire_transient(engine, engine.configured.write_bytes, ?engine.write_chunk)) {
        ret false;
    }
    engine.write_held     = true;
    engine.write_buffer   = engine.write_chunk.data;
    engine.write_capacity = engine.configured.write_bytes;
    ret true;
}

fun release_write(engine: *Engine) {
    if (!engine.write_held || engine.write_pending || engine.write_length != 0) { ret; }
    release_chunk(engine, engine.write_chunk);
    engine.write_held     = false;
    engine.write_buffer   = nil;
    engine.write_capacity = 0;
}

fun acquire_payload(engine: *Engine) bool {
    if (engine.payload_held) { ret true; }
    if (!acquire_transient(engine, engine.configured.frame_payload_bytes,
        ?engine.payload_chunk)) { ret false; }
    engine.payload_held           = true;
    engine.frame_payload          = engine.payload_chunk.data;
    engine.frame_payload_capacity = engine.configured.frame_payload_bytes;
    ret true;
}

# a held DATA event still views the payload, so it waits for that event
fun settle_payload(engine: *Engine) {
    if (!engine.payload_held || (engine.held && engine.held_kind == EVENT_DATA)) { ret; }
    release_chunk(engine, engine.payload_chunk);
    engine.payload_held           = false;
    engine.frame_payload          = nil;
    engine.frame_payload_capacity = 0;
}

# the encoder output and its pending entries, all or nothing, for one encode
fun acquire_encoder(engine: *Engine) bool {
    if (engine.header_output_held) { ret true; }
    var requests: [2]buffers.Request = [2]buffers.Request{
        buffer_request(engine.configured.hpack.max_encoded_block_bytes, 0,
            engine.configured.connection_lane),
        buffer_request(engine.configured.hpack.max_header_count * $size_of(hpack.Entry), 0,
            engine.configured.connection_lane),
    };
    val got: buffers.Acquired = buffers.source_acquire_n(engine.source, engine.account,
        ?requests[0], 2, ?engine.encode_chunks[0], true);
    engine.memory_blocked = !granted(got);
    if (engine.memory_blocked) { ret false; }
    engine.header_output_held       = true;
    engine.header_output            = engine.encode_chunks[0].data;
    engine.header_output_capacity   = engine.configured.hpack.max_encoded_block_bytes;
    engine.encoder_pending          = engine.encode_chunks[1].data::*hpack.Entry;
    engine.encoder_pending_capacity = engine.configured.hpack.max_header_count;
    ret true;
}

fun release_encoder(engine: *Engine) {
    if (!engine.header_output_held || engine.header_output_active) { ret; }
    release_chunk(engine, engine.encode_chunks[1]);
    release_chunk(engine, engine.encode_chunks[0]);
    engine.header_output_held       = false;
    engine.header_output            = nil;
    engine.header_output_capacity   = 0;
    engine.encoder_pending          = nil;
    engine.encoder_pending_capacity = 0;
}

# a stream's decoder set, all or nothing. a refusal refuses only the stream and
# registers nothing, since the peer retries a refused stream on its own
fun acquire_stream_memory(engine: *Engine, stream: *Stream) bool {
    val limits:   hpack.Limits       = engine.configured.hpack;
    val lane:     u8                 = engine.configured.stream_lane;
    var requests: [4]buffers.Request = [4]buffers.Request{
        buffer_request(limits.max_encoded_block_bytes, 0, lane),
        buffer_request(limits.max_header_count * $size_of(field.Field), 0, lane),
        buffer_request(limits.max_header_list_bytes, 0, lane),
        buffer_request(limits.max_header_count * $size_of(hpack.Entry), 0, lane),
    };
    var set: StreamMemory;
    val got: buffers.Acquired = buffers.source_acquire_n(engine.source, engine.account,
        ?requests[0], STREAM_BUFFERS, ?set.chunks[0], false);
    if (!granted(got)) { ret false; }
    set.encoded          = set.chunks[0].data;
    set.encoded_capacity = limits.max_encoded_block_bytes;
    set.fields           = set.chunks[1].data::*field.Field;
    set.field_capacity   = limits.max_header_count;
    set.strings          = set.chunks[2].data;
    set.string_capacity  = limits.max_header_list_bytes;
    set.pending          = set.chunks[3].data::*hpack.Entry;
    set.pending_capacity = limits.max_header_count;
    set.held             = true;
    stream.memory        = set;
    ret true;
}

fun release_stream_memory(engine: *Engine, stream: *Stream) {
    if (stream.memory.held) {
        var i: usize = STREAM_BUFFERS;
        for (i != 0) {
            i = i - 1;
            release_chunk(engine, stream.memory.chunks[i]);
        }
    }
    var unbound: StreamMemory;
    stream.memory = unbound;
}

fun index_bytes(capacity: usize) usize {
    ret capacity * $size_of(StreamIndexEntry);
}

# the index holds every table slot and the reserve at most half full
fun index_size(slots: usize) usize {
    var size: usize = 8;
    for (size < 2 * (slots + 1)) { size = size * 2; }
    ret size;
}

fun prepare_slot(engine: *Engine, slot: usize) {
    val stream:  *Stream = slot_stream(engine, slot);
    var unbound: StreamMemory;
    stream.memory = unbound;
    reset_stream(stream);
    stream.slot           = slot;
    stream.index_position = NO_SLOT;
    stream.next_free      = NO_SLOT;
    stream.ready_next     = NO_SLOT;
    stream.queued         = false;
    var kind: usize = 0;
    for (kind < LIST_COUNT) {
        stream.links[kind] = StreamLink{prev: NO_SLOT, next: NO_SLOT, linked: false};
        kind               = kind + 1;
    }
}

# one more record chunk and a larger index, all or nothing. the table never
# shrinks while the connection lives and grows no further than max_streams
fun grow_streams(engine: *Engine) bool {
    if (engine.stream_capacity >= engine.configured.max_streams) { ret false; }
    val request: buffers.Request = records.next_request(?engine.records,
        engine.configured.connection_lane);
    if (request.bytes == 0) { ret false; }
    val capacity: usize              = engine.stream_capacity + request.bytes / engine.records.element_size;
    val size:     usize              = index_size(capacity);
    var requests: [2]buffers.Request = [2]buffers.Request{
        request,
        buffer_request(index_bytes(size), 0, engine.configured.connection_lane),
    };
    var chunks: [2]buffers.Chunk;
    val got:    buffers.Acquired = buffers.source_acquire_n(engine.source, engine.account,
        ?requests[0], 2, ?chunks[0], false);
    if (!granted(got)) { ret false; }
    val previous: usize = engine.stream_capacity;
    records.attach(?engine.records, chunks[0]);
    engine.stream_capacity = engine.records.capacity;
    var slot: usize = engine.stream_capacity;
    for (slot > previous) {
        slot = slot - 1;
        prepare_slot(engine, slot);
        slot_stream(engine, slot).next_free = engine.free_head;
        engine.free_head                    = slot;
    }
    val old: buffers.Chunk = engine.index_chunk;
    engine.index_chunk    = chunks[1];
    engine.index          = chunks[1].data::*StreamIndexEntry;
    engine.index_capacity = size;
    index_rebuild(engine);
    release_chunk(engine, old);
    ret true;
}

fun fmix64(value: u64) u64 {
    var x: u64 = value;
    x = x ^ (x >> 33);
    x = x * 0xff51afd7ed558ccd;
    x = x ^ (x >> 33);
    x = x * 0xc4ceb9fe1a85ec53;
    x = x ^ (x >> 33);
    ret x;
}

fun index_home(engine: *Engine, id: u32) usize {
    ret fmix64(id::u64)::usize & (engine.index_capacity - 1);
}

# the index always keeps an empty entry, so every probe sequence terminates
fun index_find(engine: *Engine, id: u32) usize {
    var position: usize = index_home(engine, id);
    for (true) {
        val entry: *StreamIndexEntry = ?engine.index[position];
        if (entry.slot == INDEX_EMPTY)                            { ret NO_SLOT; }
        if (entry.slot != INDEX_TOMBSTONE && entry.id == id::u64) { ret entry.slot; }
        position = (position + 1) & (engine.index_capacity - 1);
    }
    ret NO_SLOT;
}

fun index_insert(engine: *Engine, stream: *Stream) {
    var position: usize = index_home(engine, stream.id);
    for (true) {
        val entry: *StreamIndexEntry = ?engine.index[position];
        if (entry.slot == INDEX_EMPTY || entry.slot == INDEX_TOMBSTONE) {
            if (entry.slot == INDEX_TOMBSTONE) {
                engine.index_tombstones = engine.index_tombstones - 1;
            }
            entry.id              = stream.id::u64;
            entry.slot            = stream.slot;
            stream.index_position = position;
            ret;
        }
        position = (position + 1) & (engine.index_capacity - 1);
    }
}

fun index_clear(engine: *Engine) {
    var i: usize = 0;
    for (i < engine.index_capacity) {
        engine.index[i] = StreamIndexEntry{id: 0, slot: INDEX_EMPTY};
        i               = i + 1;
    }
    engine.index_tombstones = 0;
}

# runs after more than capacity / 4 removals, so its linear cost is amortized O(1)
fun index_rebuild(engine: *Engine) {
    engine.index_rebuilds = engine.index_rebuilds + 1;
    index_clear(engine);
    var i: usize = 0;
    for (i < sweep_count(engine)) {
        val stream: *Stream = sweep_at(engine, i);
        if (stream.live) { index_insert(engine, stream); }
        i = i + 1;
    }
}

fun index_remove(engine: *Engine, stream: *Stream) {
    engine.index[stream.index_position].slot = INDEX_TOMBSTONE;
    engine.index_tombstones                  = engine.index_tombstones + 1;
    stream.index_position                    = NO_SLOT;
    if (engine.index_tombstones > engine.index_capacity / 4) { index_rebuild(engine); }
}

pub fun stream_for(engine: *Engine, id: u32) *Stream {
    if (engine == nil || !engine.initialized || id == 0) { ret nil; }
    val slot: usize = index_find(engine, id);
    if (slot == NO_SLOT) { ret nil; }
    ret visit(engine, slot);
}

fun local_id(engine: *Engine, id: u32) bool {
    if (engine.role == CLIENT) { ret (id & 1) == 1; }
    ret (id & 1) == 0;
}

fun remote_id(engine: *Engine, id: u32) bool {
    ret !local_id(engine, id);
}

# table slots never exceed max_streams, and the reserve is the one spare
fun acquire_slot(engine: *Engine) usize {
    if (engine.free_head == NO_SLOT && !grow_streams(engine)) { ret NO_SLOT; }
    val slot:   usize   = engine.free_head;
    val stream: *Stream = slot_stream(engine, slot);
    engine.free_head = stream.next_free;
    stream.next_free = NO_SLOT;
    ret slot;
}

fun release_slot(engine: *Engine, stream: *Stream) {
    stream.next_free = engine.free_head;
    engine.free_head = stream.slot;
}

fun list_push(engine: *Engine, kind: usize, stream: *Stream) {
    val link: *StreamLink = ?stream.links[kind];
    if (link.linked) { ret; }
    val list: *StreamList = ?engine.lists[kind];
    link.prev   = list.tail;
    link.next   = NO_SLOT;
    link.linked = true;
    if (list.tail == NO_SLOT) { list.head = stream.slot; }
    or                        { slot_stream(engine, list.tail).links[kind].next = stream.slot; }
    list.tail  = stream.slot;
    list.count = list.count + 1;
}

fun list_remove(engine: *Engine, kind: usize, stream: *Stream) {
    val link: *StreamLink = ?stream.links[kind];
    if (!link.linked) { ret; }
    val list: *StreamList = ?engine.lists[kind];
    if (link.prev == NO_SLOT) { list.head = link.next; }
    or                        { slot_stream(engine, link.prev).links[kind].next = link.next; }
    if (link.next == NO_SLOT) { list.tail = link.prev; }
    or                        { slot_stream(engine, link.next).links[kind].prev = link.prev; }
    link.prev   = NO_SLOT;
    link.next   = NO_SLOT;
    link.linked = false;
    list.count  = list.count - 1;
}

fun list_set(engine: *Engine, kind: usize, stream: *Stream, member: bool) {
    if (member) { list_push(engine, kind, stream); }
    or          { list_remove(engine, kind, stream); }
}

fun window_owed(engine: *Engine, stream: *Stream) bool {
    ret stream.live && stream.state != STREAM_CLOSED
        && (stream.consumed_pending >= engine.configured.window_update_threshold
        || (stream.recv_window == 0 && stream.consumed_pending != 0));
}

fun schedulable(stream: *Stream) bool {
    ret stream.live && stream.writable && stream.initial_headers_sent
        && stream.send_window > 0 && stream_writable(stream);
}

fun exchange_tracked(stream: *Stream) bool {
    ret stream.live && stream.state != STREAM_CLOSED && stream.exchange != nil;
}

# every stream mutation that can change a set membership ends here
fun refresh_stream(engine: *Engine, stream: *Stream) {
    list_set(engine, LIST_WINDOW, stream, window_owed(engine, stream));
    list_set(engine, LIST_WRITABLE, stream, schedulable(stream));
    list_set(engine, LIST_EXCHANGE, stream, exchange_tracked(stream));
}

fun stream_has_work(stream: *Stream) bool {
    ret stream.retry_pending;
}

fun ready_push(engine: *Engine, stream: *Stream) {
    if (stream.queued) { ret; }
    stream.queued     = true;
    stream.ready_next = NO_SLOT;
    if (engine.ready_tail == NO_SLOT) { engine.ready_head = stream.slot; }
    or                                { slot_stream(engine, engine.ready_tail).ready_next = stream.slot; }
    engine.ready_tail  = stream.slot;
    engine.ready_count = engine.ready_count + 1;
}

fun ready_pop(engine: *Engine) *Stream {
    val stream: *Stream = visit(engine, engine.ready_head);
    engine.ready_head = stream.ready_next;
    if (engine.ready_head == NO_SLOT) { engine.ready_tail = NO_SLOT; }
    stream.ready_next  = NO_SLOT;
    stream.queued      = false;
    engine.ready_count = engine.ready_count - 1;
    ret stream;
}

# services one unit of queued work and requeues at the tail if more remains
fun service_ready(engine: *Engine, stream: *Stream) Event {
    var result: Event = event(engine, EVENT_NONE);
    if (stream.retry_pending) {
        stream.retry_pending = false;
        result               = stream_event(engine, EVENT_STREAM_RETRY, stream);
        result.code          = H2_REFUSED_STREAM;
    }
    if (stream_has_work(stream)) { ready_push(engine, stream); }
    ret result;
}

fun table_streams(engine: *Engine) usize {
    if (engine.reserve.live) { ret engine.active_streams - 1; }
    ret engine.active_streams;
}

# a stream that decodes header blocks takes its set here, all or nothing
fun allocate_stream(engine: *Engine, id: u32, initiated_local: bool,
    initial_state: StreamState, decodes: bool) *Stream {
    if (engine.next_generation == 0
        || table_streams(engine) >= engine.configured.max_streams) { ret nil; }
    val slot: usize = acquire_slot(engine);
    if (slot == NO_SLOT) { ret nil; }
    val stream: *Stream = visit(engine, slot);
    reset_stream(stream);
    if (decodes && !acquire_stream_memory(engine, stream)) {
        release_slot(engine, stream);
        ret nil;
    }
    ret start_stream(engine, stream, id, initiated_local, initial_state);
}

# the inline reserve decodes one refused header block with the caller's set
fun allocate_reserve(engine: *Engine, id: u32, initial_state: StreamState) *Stream {
    if (engine.next_generation == 0 || engine.reserve.live) { ret nil; }
    val stream: *Stream = visit(engine, RESERVE_SLOT);
    reset_stream(stream);
    stream.memory = engine.refused_memory;
    ret start_stream(engine, stream, id, false, initial_state);
}

fun start_stream(engine: *Engine, stream: *Stream, id: u32, initiated_local: bool,
    initial_state: StreamState) *Stream {
    stream.id              = id;
    stream.generation      = next_generation(engine);
    stream.state           = initial_state;
    stream.initiated_local = initiated_local;
    stream.send_window     = engine.peer.initial_window_size::i64;
    stream.recv_window     = engine.local_initial_window::i64;
    stream.live            = true;
    engine.active_streams  = engine.active_streams + 1;
    if (active_state(initial_state)) {
        if (initiated_local) { engine.active_local = engine.active_local + 1; }
        or                   { engine.active_remote = engine.active_remote + 1; }
    }
    index_insert(engine, stream);
    ret stream;
}

fun active_state(state: StreamState) bool {
    ret state == STREAM_OPEN || state == STREAM_HALF_CLOSED_LOCAL
        || state == STREAM_HALF_CLOSED_REMOTE;
}

fun mark_closed(engine: *Engine, stream: *Stream) {
    if (stream == nil || stream.state == STREAM_CLOSED) { ret; }
    if (active_state(stream.state)) {
        if (stream.initiated_local && engine.active_local != 0) {
            engine.active_local = engine.active_local - 1;
        }
        if (!stream.initiated_local && engine.active_remote != 0) {
            engine.active_remote = engine.active_remote - 1;
        }
    }
    stream.state    = STREAM_CLOSED;
    stream.writable = false;
    refresh_stream(engine, stream);
}

fun close_local_side(engine: *Engine, stream: *Stream) {
    if (stream.state == STREAM_OPEN)               { stream.state = STREAM_HALF_CLOSED_LOCAL; }
    or (stream.state == STREAM_HALF_CLOSED_REMOTE) { mark_closed(engine, stream); }
    or (stream.state == STREAM_RESERVED_LOCAL)     { stream.state = STREAM_HALF_CLOSED_REMOTE; }
    refresh_stream(engine, stream);
}

fun close_remote_side(engine: *Engine, stream: *Stream) {
    if (stream.state == STREAM_OPEN)              { stream.state = STREAM_HALF_CLOSED_REMOTE; }
    or (stream.state == STREAM_HALF_CLOSED_LOCAL) { mark_closed(engine, stream); }
    or (stream.state == STREAM_RESERVED_REMOTE)   { stream.state = STREAM_HALF_CLOSED_LOCAL; }
    refresh_stream(engine, stream);
}

fun stream_writable(stream: *Stream) bool {
    ret stream != nil && (stream.state == STREAM_OPEN
        || stream.state == STREAM_HALF_CLOSED_REMOTE);
}

fun stream_readable(stream: *Stream) bool {
    ret stream != nil && (stream.state == STREAM_OPEN
        || stream.state == STREAM_HALF_CLOSED_LOCAL);
}

fun control_tail(engine: *Engine) usize {
    ret (engine.control_head + engine.control_count) % engine.control_capacity;
}

fun queue_control(engine: *Engine, header: frame.Header,
    payload: *u8, length: usize) bool {
    if (engine.control_count >= engine.control_capacity || length > 48
        || header.length::usize != length || (payload == nil && length != 0)) { ret false; }
    val item: *Control = ?engine.controls[control_tail(engine)];
    item.header = header;
    item.length = length;
    if (length != 0) { memory.raw_copy(?item.payload[0], payload, length); }
    engine.control_count = engine.control_count + 1;
    ret true;
}

fun queue_empty_control(engine: *Engine, typ: u8, flags: u8) bool {
    ret queue_control(engine, frame.Header{length: 0, typ: typ,
        flags: flags, stream_id: 0}, nil, 0);
}

fun put_u32(output: *u8, value: u32) {
    output[0] = (value >> 24)::u8;
    output[1] = (value >> 16)::u8;
    output[2] = (value >> 8)::u8;
    output[3] = value::u8;
}

fun read_u32(input: *u8) u32 {
    ret (input[0]::u32 << 24) | (input[1]::u32 << 16)
        | (input[2]::u32 << 8) | input[3]::u32;
}

fun read_u31(input: *u8) u32 {
    ret read_u32(input) & 0x7fffffff;
}

fun queue_reset(engine: *Engine, id: u32, code: u32) bool {
    var payload: [4]u8;
    put_u32(?payload[0], code);
    ret queue_control(engine, frame.Header{length: 4,
        typ: frame.FRAME_RESET_STREAM, flags: 0, stream_id: id}, ?payload[0], 4);
}

fun queue_window(engine: *Engine, id: u32, increment: u32) bool {
    var payload: [4]u8;
    if (!frame.encode_window_update(increment, ?payload[0], 4)) { ret false; }
    ret queue_control(engine, frame.Header{length: 4,
        typ: frame.FRAME_WINDOW_UPDATE, flags: 0, stream_id: id}, ?payload[0], 4);
}

fun queue_goaway(engine: *Engine, last: u32, code: u32) bool {
    var payload: [8]u8;
    put_u32(?payload[0], last & 0x7fffffff);
    put_u32(?payload[4], code);
    if (!queue_control(engine, frame.Header{length: 8,
        typ: frame.FRAME_GOAWAY, flags: 0, stream_id: 0}, ?payload[0], 8)) {
        ret false;
    }
    engine.goaway_sent       = true;
    engine.local_goaway_last = last;
    ret true;
}

fun queue_initial_settings(engine: *Engine) bool {
    var payload: [42]u8;
    var offset:  usize = 0;
    if (!frame.encode_setting(frame.SETTINGS_HEADER_TABLE_SIZE,
        engine.configured.local.header_table_size, ?payload[offset], 42 - offset)) { ret false; }
    offset = offset + 6;
    if (engine.role == CLIENT) {
        if (!frame.encode_setting(frame.SETTINGS_ENABLE_PUSH,
            engine.configured.local.enable_push, ?payload[offset], 42 - offset)) { ret false; }
        offset = offset + 6;
    }
    if (!frame.encode_setting(frame.SETTINGS_MAX_CONCURRENT_STREAMS,
        engine.configured.local.max_concurrent_streams, ?payload[offset], 42 - offset)) { ret false; }
    offset = offset + 6;
    if (!frame.encode_setting(frame.SETTINGS_INITIAL_WINDOW_SIZE,
        engine.configured.local.initial_window_size, ?payload[offset], 42 - offset)) { ret false; }
    offset = offset + 6;
    if (!frame.encode_setting(frame.SETTINGS_MAX_FRAME_SIZE,
        engine.configured.local.max_frame_size, ?payload[offset], 42 - offset)) { ret false; }
    offset = offset + 6;
    if (!frame.encode_setting(frame.SETTINGS_MAX_HEADER_LIST_SIZE,
        engine.configured.local.max_header_list_size, ?payload[offset], 42 - offset)) { ret false; }
    offset = offset + 6;
    if (!frame.encode_setting(frame.SETTINGS_ENABLE_CONNECT_PROTOCOL,
        engine.configured.local.enable_connect_protocol, ?payload[offset], 42 - offset)) { ret false; }
    offset = offset + 6;
    if (!queue_control(engine, frame.Header{length: offset::u32,
        typ: frame.FRAME_SETTINGS, flags: 0, stream_id: 0}, ?payload[0], offset)) {
        ret false;
    }
    engine.local_settings_pending = true;
    ret true;
}

# the first record chunk and the index are taken at init, and a refusal fails init.
# every other stream record and buffer is borrowed on demand
# ---
# source:  the buffer source, which must outlive the engine
# account: the connection's open account on `source`, which must outlive the engine
# refused: caller storage that decodes a refused header block, never borrowed
pub fun init(engine: *Engine, role: Role, connection_transport: *transport.Transport,
    scope: *cancel.Scope, source: *buffers.Source, account: *buffers.Account,
    read_buffer: *u8, read_capacity: usize,
    controls: *Control, control_capacity: usize,
    inbound_entries: *hpack.Entry, inbound_entry_capacity: usize,
    inbound_storage: *u8, inbound_storage_capacity: usize,
    outbound_entries: *hpack.Entry, outbound_entry_capacity: usize,
    outbound_storage: *u8, outbound_storage_capacity: usize,
    refused: StreamMemory, configured: Config) bool {
    if (engine == nil || engine.initialized || (role != SERVER && role != CLIENT)
        || connection_transport == nil || !connection_transport.initialized
        || scope == nil || scope.root != connection_transport.operation_root
        || !scope_active(scope) || source == nil || account == nil || !account.open
        || !config_valid(configured) || !memory_valid(refused, configured)
        || read_buffer == nil || read_capacity == 0
        || controls == nil || control_capacity < 4) { ret false; }
    if (!hpack.table_init(?engine.inbound_table, inbound_entries,
        inbound_entry_capacity, inbound_storage, inbound_storage_capacity,
        configured.hpack.max_dynamic_table_bytes, 4096)
        || !hpack.table_init(?engine.outbound_table, outbound_entries,
        outbound_entry_capacity, outbound_storage, outbound_storage_capacity,
        configured.hpack.max_dynamic_table_bytes,
        configured.hpack.max_dynamic_table_bytes)
        || !frame.parser_init(?engine.parser,
        frame.Limits{max_frame_size: configured.local.max_frame_size})
        || !frame.writer_init(?engine.writer,
        frame.Limits{max_frame_size: frame.MAX_FRAME_SIZE})) { ret false; }
    engine.role                = role;
    engine.state               = PREFACE;
    engine.configured          = configured;
    engine.transport           = connection_transport;
    engine.scope               = scope;
    engine.source              = source;
    engine.account             = account;
    engine.memory_blocked      = false;
    engine.refused_memory      = refused;
    engine.refused_memory.held = false;
    if (!records.make(?engine.records, $size_of(Stream), first_streams(configured))) {
        ret false;
    }
    val first: buffers.Request = records.next_request(?engine.records,
        configured.connection_lane);
    val first_capacity: usize              = first.bytes / engine.records.element_size;
    val first_index:    usize              = index_size(first_capacity);
    var requests:       [2]buffers.Request = [2]buffers.Request{
        first,
        buffer_request(index_bytes(first_index), 0, configured.connection_lane),
    };
    var chunks: [2]buffers.Chunk;
    val taken:  buffers.Acquired = buffers.source_acquire_n(source, account,
        ?requests[0], 2, ?chunks[0], false);
    if (!granted(taken)) { ret false; }
    records.attach(?engine.records, chunks[0]);
    engine.stream_capacity = engine.records.capacity;
    engine.index_chunk     = chunks[1];
    engine.index           = chunks[1].data::*StreamIndexEntry;
    engine.index_capacity  = first_index;
    index_clear(engine);
    prepare_slot(engine, RESERVE_SLOT);
    engine.free_head = NO_SLOT;
    var slot: usize = engine.stream_capacity;
    for (slot != 0) {
        slot = slot - 1;
        prepare_slot(engine, slot);
        slot_stream(engine, slot).next_free = engine.free_head;
        engine.free_head                    = slot;
    }
    engine.ready_head  = NO_SLOT;
    engine.ready_tail  = NO_SLOT;
    engine.ready_count = 0;
    var list: usize = 0;
    for (list < LIST_COUNT) {
        engine.lists[list] = StreamList{head: NO_SLOT, tail: NO_SLOT, count: 0};
        list               = list + 1;
    }
    engine.slot_visits    = 0;
    engine.index_rebuilds = 0;
    engine.active_streams = 0;
    engine.active_local   = 0;
    engine.active_remote  = 0;
    if (role == CLIENT) { engine.next_local_stream = 1; }
    or                  { engine.next_local_stream = 2; }
    engine.last_remote_stream        = 0;
    engine.next_generation           = 1;
    engine.peer                      = settings_default();
    engine.peer_settings_received    = false;
    engine.local_settings_pending    = false;
    engine.local_settings_applied    = false;
    engine.local_initial_window      = 65535;
    engine.preface_offset            = 0;
    engine.preface_received          = role == CLIENT;
    engine.current_header            = frame.Header{length: 0, typ: 0, flags: 0, stream_id: 0};
    engine.frame_payload             = nil;
    engine.frame_payload_capacity    = 0;
    engine.frame_payload_length      = 0;
    engine.payload_held              = false;
    engine.payload_wanted            = false;
    engine.header_slot               = NO_SLOT;
    engine.header_wire_stream        = 0;
    engine.header_kind               = 0;
    engine.header_end_stream         = false;
    engine.encoder_pending           = nil;
    engine.encoder_pending_capacity  = 0;
    engine.header_output             = nil;
    engine.header_output_capacity    = 0;
    engine.header_output_held        = false;
    engine.header_output_active      = false;
    engine.header_output_length      = 0;
    engine.header_output_offset      = 0;
    engine.header_output_stream      = 0;
    engine.header_output_wire_stream = 0;
    engine.header_output_end_stream  = false;
    engine.header_output_first       = false;
    engine.header_output_push        = false;
    engine.controls                  = controls;
    engine.control_capacity          = control_capacity;
    engine.control_head              = 0;
    engine.control_count             = 0;
    engine.read_buffer               = read_buffer;
    engine.read_capacity             = read_capacity;
    engine.input_length              = 0;
    engine.input_offset              = 0;
    engine.input_eof                 = false;
    engine.read_pending              = false;
    engine.write_buffer              = nil;
    engine.write_capacity            = 0;
    engine.write_held                = false;
    engine.write_length              = 0;
    engine.write_offset              = 0;
    engine.write_pending             = false;
    engine.write_kind                = OUTPUT_NONE;
    engine.write_stream              = 0;
    engine.write_end_stream          = false;
    engine.write_header_bytes        = 0;
    engine.held                      = false;
    engine.held_kind                 = EVENT_NONE;
    engine.held_stream               = 0;
    engine.held_headers              = empty_headers();
    engine.held_data                 = nil;
    engine.held_length               = 0;
    engine.held_end_stream           = false;
    engine.pending_end_stream        = 0;
    engine.remote_goaway_last        = 0x7fffffff;
    engine.local_goaway_last         = 0x7fffffff;
    engine.goaway_received           = false;
    engine.goaway_sent               = false;
    engine.final_goaway_sent         = false;
    engine.graceful                  = false;
    engine.send_window               = 65535;
    engine.recv_window               = configured.connection_window_size::i64;
    engine.consumed_pending          = 0;
    engine.scheduled_stream          = 0;
    engine.close_pending             = false;
    engine.error                     = ERROR_NONE;
    engine.h2_error                  = H2_NO_ERROR;
    engine.initialized               = true;
    if (!queue_initial_settings(engine)
        || (configured.connection_window_size > 65535
        && !queue_window(engine, 0, configured.connection_window_size - 65535))) {
        release_all(engine);
        engine.initialized = false;
        ret false;
    }
    ret true;
}

fun release_all(engine: *Engine) {
    # linear once per connection
    var i: usize = 0;
    for (i < engine.stream_capacity) {
        release_stream_memory(engine, slot_stream(engine, i));
        i = i + 1;
    }
    settle_payload(engine);
    release_encoder(engine);
    release_write(engine);
    records.destroy(?engine.records, engine.source, engine.account);
    release_chunk(engine, engine.index_chunk);
    engine.stream_capacity = 0;
    engine.index           = nil;
    engine.index_capacity  = 0;
}

# returns every borrowed record and buffer to the account and the engine to the
# state `init` accepts, so caller-owned storage can carry a second connection.
# once the transport close has completed, streams the host never released, or
# never learned of, are dropped here, since none of them can progress again.
# zeroing is deliberate: the initialization guards on the two HPACK tables, the
# parser, and the writer all live inside this record, as do the transport tokens
# `init` does not otherwise rewrite, and a field added later must not silently
# survive a reuse.
pub fun destroy(engine: *Engine) bool {
    if (engine == nil || !engine.initialized) { ret false; }
    if (engine.read_pending || engine.write_pending || engine.close_pending
        || engine.held || (engine.state != CLOSED && engine.active_streams != 0)) { ret false; }
    engine.header_output_active = false;
    engine.write_length         = 0;
    release_all(engine);
    var cleared: Engine;
    @engine = cleared;
    ret true;
}

pub fun send_settings(engine: *Engine, settings: Settings) bool {
    if (engine == nil || !engine.initialized || engine.local_settings_pending
        || !settings_valid(settings)
        || settings.header_table_size::usize
        > engine.configured.hpack.max_dynamic_table_bytes
        || settings.max_frame_size::usize > engine.configured.frame_payload_bytes
        || engine.configured.window_update_threshold > settings.initial_window_size) {
        ret false;
    }
    val prior: Settings = engine.configured.local;
    engine.configured.local       = settings;
    engine.local_settings_applied = false;
    if (!queue_initial_settings(engine)) {
        engine.configured.local       = prior;
        engine.local_settings_applied = true;
        ret false;
    }
    ret true;
}

pub fun exchange_for(engine: *Engine, id: u32) *exchange.Exchange {
    val stream: *Stream = stream_for(engine, id);
    if (stream == nil) { ret nil; }
    ret stream.exchange;
}

pub fun bind_exchange(engine: *Engine, id: u32,
    bound: *exchange.Exchange) bool {
    val stream: *Stream = stream_for(engine, id);
    if (stream == nil || bound == nil || !bound.valid || stream.exchange != nil
        || bound.generation != stream.generation
        || bound.request.metadata.version.wire != message.WIRE_H2
        || bound.request.metadata.request_index != id::u64
        || bound.scope == nil || !scope_active(bound.scope)) { ret false; }
    stream.exchange = bound;
    refresh_stream(engine, stream);
    ret true;
}

pub fun dispatch(engine: *Engine, id: u32,
    service: *exchange.Service) exchange.ServiceStatus {
    val stream: *Stream = stream_for(engine, id);
    if (stream == nil || stream.exchange == nil || !exchange.begin(stream.exchange)) {
        ret exchange.SERVICE_FAILED;
    }
    ret exchange.dispatch(service, stream.exchange);
}

pub fun open_local(engine: *Engine, bound: *exchange.Exchange) u32 {
    if (engine == nil || !engine.initialized
        || engine.role != CLIENT
        || (engine.state != OPEN && !(engine.role == CLIENT && engine.state == PREFACE))
        || engine.goaway_received || engine.graceful
        || engine.active_streams >= engine.configured.max_streams
        || engine.active_local >= engine.peer.max_concurrent_streams::usize
        || engine.next_local_stream == 0 || engine.next_local_stream > 0x7fffffff) { ret 0; }
    val id:     u32     = engine.next_local_stream;
    val stream: *Stream = allocate_stream(engine, id, true, STREAM_OPEN, true);
    if (stream == nil)   { ret 0; }
    if (id > 0x7ffffffd) { engine.next_local_stream = 0; }
    or                   { engine.next_local_stream = id + 2; }
    if (bound != nil && !bind_exchange(engine, id, bound)) {
        mark_closed(engine, stream);
        ret 0;
    }
    ret id;
}

pub fun release_stream(engine: *Engine, id: u32, generation: u64) bool {
    val stream: *Stream = stream_for(engine, id);
    if (stream == nil || stream.generation != generation || stream.state != STREAM_CLOSED
        || engine.held_stream == id || stream.retry_pending
        || (stream.exchange != nil && stream.exchange.state != exchange.COMPLETE_STATE
        && stream.exchange.state != exchange.CANCELLED_STATE
        && stream.exchange.state != exchange.TIMED_OUT_STATE
        && stream.exchange.state != exchange.FAILED_STATE)) { ret false; }
    if (engine.active_streams != 0) { engine.active_streams = engine.active_streams - 1; }
    # a rebuild triggered by the removal must not see this stream as live
    reset_stream(stream);
    release_stream_memory(engine, stream);
    index_remove(engine, stream);
    refresh_stream(engine, stream);
    if (stream.slot != RESERVE_SLOT) { release_slot(engine, stream); }
    ret true;
}

pub fun detach_exchange(engine: *Engine, id: u32,
    generation: u64) *exchange.Exchange {
    val stream: *Stream = stream_for(engine, id);
    if (stream == nil || stream.generation != generation
        || stream.state != STREAM_CLOSED || stream.reset_code != H2_REFUSED_STREAM) {
        ret nil;
    }
    val detached: *exchange.Exchange = stream.exchange;
    stream.exchange = nil;
    refresh_stream(engine, stream);
    ret detached;
}

pub fun abandon_exchange(engine: *Engine, id: u32,
    generation: u64) *exchange.Exchange {
    val stream: *Stream = stream_for(engine, id);
    if (stream == nil || stream.generation != generation
        || stream.state != STREAM_CLOSED || stream.exchange == nil) { ret nil; }
    val abandoned: *exchange.Exchange = stream.exchange;
    if (abandoned.state != exchange.COMPLETE_STATE
        && abandoned.state != exchange.CANCELLED_STATE
        && abandoned.state != exchange.TIMED_OUT_STATE
        && abandoned.state != exchange.FAILED_STATE
        && scope_active(abandoned.scope)) {
        exchange.cancel_exchange(abandoned);
    }
    stream.exchange = nil;
    refresh_stream(engine, stream);
    ret abandoned;
}

fun close_cause(error: Error) lifecycle.Cause {
    if (error == ERROR_CANCELLED) { ret lifecycle.CANCELLATION; }
    ret lifecycle.FAILURE;
}

fun submit_close(engine: *Engine) {
    if (engine.close_pending || engine.state == CLOSED) { ret; }
    val submitted: res[transport.Token, io_error.Error] = transport.close_with_cause(
        engine.transport, close_cause(engine.error), engine.next_generation::usize);
    if (sel submitted.ok) {
        engine.close_token   = submitted.ok;
        engine.close_pending = true;
    }
    or {
        engine.state = CLOSED;
    }
}

fun fail_connection(engine: *Engine, error: Error, h2_error: u32) Event {
    if (engine.state != FAILED && engine.state != CLOSED) {
        engine.error    = error;
        engine.h2_error = h2_error;
        engine.state    = FAILED;
        if (scope_active(engine.scope) && error == ERROR_CANCELLED) {
            cancel.cancel(engine.scope);
        }
        # linear once per connection
        var i: usize = 0;
        for (i < sweep_count(engine)) {
            val stream: *Stream = sweep_at(engine, i);
            if (stream.live && stream.state != STREAM_CLOSED) {
                if (stream.exchange != nil) { exchange.cancel_exchange(stream.exchange); }
                mark_closed(engine, stream);
            }
            i = i + 1;
        }
        if (engine.preface_received && !engine.goaway_sent) {
            queue_goaway(engine, engine.last_remote_stream, h2_error);
        }
        settle_payload(engine);
    }
    var result: Event = event(engine, EVENT_ERROR);
    result.code           = h2_error;
    result.last_stream_id = engine.last_remote_stream;
    if (error == ERROR_CANCELLED) { result.kind = EVENT_CANCELLED; }
    ret result;
}

fun stream_error(engine: *Engine, stream: *Stream, code: u32) Event {
    if (stream == nil) { ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR); }
    if (stream.state != STREAM_CLOSED) {
        if (!queue_reset(engine, stream.id, code)) {
            ret fail_connection(engine, ERROR_LIMIT, H2_ENHANCE_YOUR_CALM);
        }
        if (stream.exchange != nil) { exchange.cancel_exchange(stream.exchange); }
        mark_closed(engine, stream);
    }
    stream.reset_code = code;
    var result: Event = stream_event(engine, EVENT_STREAM_ERROR, stream);
    result.code = code;
    ret result;
}

# the frame is written straight into the write buffer, a PUSH_PROMISE's promised
# stream id as `prefix` ahead of the block fragment
fun build_frame(engine: *Engine, header: frame.Header, prefix: *u8, prefix_length: usize,
    payload: *u8, length: usize, kind: u8, stream_id: u32,
    end_stream: bool) bool {
    if (engine.write_length != 0 || engine.write_pending
        || length > (-1)::usize - 9 - prefix_length
        || header.length::usize != prefix_length + length) {
        ret false;
    }
    if (!acquire_write(engine)) { ret false; }
    if (prefix_length + length + 9 > engine.write_capacity) {
        release_write(engine);
        ret false;
    }
    val started: frame.Write = frame.begin(?engine.writer, header,
        engine.write_buffer, engine.write_capacity);
    if (started.status != frame.WRITE_OUTPUT || started.written != 9) {
        release_write(engine);
        ret false;
    }
    if (prefix_length != 0) {
        val prefixed: frame.Write = frame.write(?engine.writer, ?engine.write_buffer[9],
            engine.write_capacity - 9, prefix, prefix_length);
        if (prefixed.consumed != prefix_length || prefixed.written != prefix_length
            || (prefixed.status != frame.WRITE_OUTPUT
            && !(prefixed.status == frame.WRITE_DONE && length == 0))) {
            release_write(engine);
            ret false;
        }
    }
    if (length != 0 || prefix_length == 0) {
        val finished: frame.Write = frame.write(?engine.writer,
            ?engine.write_buffer[9 + prefix_length],
            engine.write_capacity - 9 - prefix_length, payload, length);
        if (finished.status != frame.WRITE_DONE || finished.consumed != length
            || finished.written != length) {
            release_write(engine);
            ret false;
        }
    }
    engine.write_length     = 9 + prefix_length + length;
    engine.write_offset     = 0;
    engine.write_kind       = kind;
    engine.write_stream     = stream_id;
    engine.write_end_stream = end_stream;
    ret true;
}

fun prepare_header_output(engine: *Engine) bool {
    if (!engine.header_output_active) { ret false; }
    var available: usize = engine.header_output_length - engine.header_output_offset;
    var maximum:   usize = engine.peer.max_frame_size::usize;
    if (maximum > engine.configured.max_frame_payload) {
        maximum = engine.configured.max_frame_payload;
    }
    if (maximum > engine.configured.write_bytes - 9) { maximum = engine.configured.write_bytes - 9; }
    var prefix: usize = 0;
    if (engine.header_output_first && engine.header_output_push) { prefix = 4; }
    if (maximum < prefix)                                        { ret false; }
    if (available > maximum - prefix)                            { available = maximum - prefix; }
    var typ:   u8 = frame.FRAME_CONTINUATION;
    var flags: u8 = 0;
    if (engine.header_output_first) {
        typ = frame.FRAME_HEADERS;
        if (engine.header_output_push)       { typ = frame.FRAME_PUSH_PROMISE; }
        if (engine.header_output_end_stream) { flags = flags | frame.FLAG_END_STREAM; }
    }
    if (engine.header_output_offset + available == engine.header_output_length) {
        flags = flags | frame.FLAG_END_HEADERS;
    }
    val payload:  *u8 = (?engine.header_output[engine.header_output_offset]);
    var promised: [4]u8;
    put_u32(?promised[0], engine.header_output_stream);
    if (!build_frame(engine, frame.Header{length: (available + prefix)::u32, typ: typ,
        flags: flags, stream_id: engine.header_output_wire_stream},
        ?promised[0], prefix, payload, available,
        OUTPUT_HEADERS, engine.header_output_stream,
        engine.header_output_end_stream)) { ret false; }
    engine.write_header_bytes = available;
    ret true;
}

fun prepare_output(engine: *Engine) bool {
    if (engine.write_pending || engine.write_length != 0) { ret false; }
    if (engine.role == CLIENT && engine.preface_offset < CLIENT_PREFACE_LENGTH) {
        if (!acquire_write(engine)) { ret false; }
        val length: usize = CLIENT_PREFACE_LENGTH - engine.preface_offset;
        memory.raw_copy(engine.write_buffer, ?CLIENT_PREFACE[engine.preface_offset], length);
        engine.write_length     = length;
        engine.write_offset     = 0;
        engine.write_kind       = OUTPUT_PREFACE;
        engine.write_stream     = 0;
        engine.write_end_stream = false;
        ret true;
    }
    if (!engine.preface_received) { ret false; }
    flush_window_update(engine);
    if (engine.header_output_active && !engine.header_output_first) {
        ret prepare_header_output(engine);
    }
    if (engine.control_count != 0) {
        val item: *Control = ?engine.controls[engine.control_head];
        ret build_frame(engine, item.header, nil, 0, ?item.payload[0], item.length,
            OUTPUT_CONTROL, item.header.stream_id, false);
    }
    if (engine.header_output_active) { ret prepare_header_output(engine); }
    ret false;
}

pub fun submit_read(engine: *Engine) bool {
    if (engine == nil || !engine.initialized || engine.read_pending || engine.input_eof
        || engine.input_offset != engine.input_length || engine.held
        || engine.state == CLOSED || engine.state == CLOSING || engine.state == FAILED) {
        ret false;
    }
    engine.input_length = 0;
    engine.input_offset = 0;
    val submitted: res[transport.Token, io_error.Error] = transport.read(
        engine.transport, engine.scope, engine.read_buffer, engine.read_capacity,
        engine.next_generation::usize);
    if ((sel submitted.err)) {
        fail_connection(engine, ERROR_TRANSPORT, H2_INTERNAL_ERROR);
        ret false;
    }
    engine.read_token   = submitted.ok;
    engine.read_pending = true;
    ret true;
}

pub fun submit_write(engine: *Engine) bool {
    if (engine == nil || !engine.initialized || engine.write_pending
        || engine.state == CLOSED || engine.state == CLOSING) { ret false; }
    if (engine.write_length == 0 && !prepare_output(engine)) { ret false; }
    val submitted: res[transport.Token, io_error.Error] = transport.write(
        engine.transport, engine.scope, ?engine.write_buffer[engine.write_offset],
        engine.write_length - engine.write_offset, engine.write_stream::usize);
    if ((sel submitted.err)) {
        fail_connection(engine, ERROR_TRANSPORT, H2_INTERNAL_ERROR);
        ret false;
    }
    engine.write_token   = submitted.ok;
    engine.write_pending = true;
    ret true;
}

fun complete_output(engine: *Engine) {
    if (engine.write_kind == OUTPUT_PREFACE) {
        engine.preface_offset = engine.preface_offset + engine.write_length;
    }
    if (engine.write_kind == OUTPUT_CONTROL) {
        val control: *Control = ?engine.controls[engine.control_head];
        if (control.header.typ == frame.FRAME_SETTINGS
            && (control.header.flags & frame.FLAG_ACK) == 0
            && !engine.local_settings_applied) {
            if (!hpack.table_set_allowed_max(?engine.inbound_table,
                engine.configured.local.header_table_size::usize)) {
                engine.error    = ERROR_COMPRESSION;
                engine.h2_error = H2_COMPRESSION_ERROR;
                engine.state    = FAILED;
            }
            val delta: i64 = engine.configured.local.initial_window_size::i64
                - engine.local_initial_window::i64;
            # linear once per acknowledged local settings change
            var i: usize = 0;
            for (i < sweep_count(engine)) {
                val stream: *Stream = sweep_at(engine, i);
                if (stream.live && stream.state != STREAM_CLOSED) {
                    stream.recv_window = stream.recv_window + delta;
                    refresh_stream(engine, stream);
                }
                i = i + 1;
            }
            engine.local_initial_window         = engine.configured.local.initial_window_size;
            engine.parser.limits.max_frame_size = engine.configured.local.max_frame_size;
            engine.local_settings_applied       = true;
        }
        engine.control_head  = (engine.control_head + 1) % engine.control_capacity;
        engine.control_count = engine.control_count - 1;
    }
    if (engine.write_kind == OUTPUT_HEADERS) {
        engine.header_output_offset = engine.header_output_offset + engine.write_header_bytes;
        engine.header_output_first  = false;
        if (engine.header_output_offset == engine.header_output_length) {
            val stream: *Stream = stream_for(engine, engine.header_output_stream);
            if (stream != nil) {
                if (engine.header_output_push) {
                    stream.push_promise_sent = true;
                }
                or {
                    if (!stream.initial_headers_sent) { stream.initial_headers_sent = true; }
                    or                                { stream.trailers_sent = true; }
                    if (stream.state == STREAM_RESERVED_LOCAL) {
                        stream.state        = STREAM_HALF_CLOSED_REMOTE;
                        engine.active_local = engine.active_local + 1;
                    }
                    if (engine.header_output_end_stream) { close_local_side(engine, stream); }
                }
                refresh_stream(engine, stream);
            }
            engine.header_output_active      = false;
            engine.header_output_length      = 0;
            engine.header_output_offset      = 0;
            engine.header_output_stream      = 0;
            engine.header_output_wire_stream = 0;
            engine.header_output_push        = false;
            release_encoder(engine);
        }
    }
    if (engine.write_kind == OUTPUT_DATA && engine.write_end_stream) {
        val stream: *Stream = stream_for(engine, engine.write_stream);
        if (stream != nil) { close_local_side(engine, stream); }
    }
    engine.write_length       = 0;
    engine.write_offset       = 0;
    engine.write_kind         = OUTPUT_NONE;
    engine.write_stream       = 0;
    engine.write_end_stream   = false;
    engine.write_header_bytes = 0;
    release_write(engine);
}

fun setting_id(input: *u8) u16 {
    ret (input[0]::u16 << 8) | input[1]::u16;
}

fun setting_value(input: *u8) u32 {
    ret read_u32(?input[2]);
}

fun apply_setting(engine: *Engine, identifier: u16, value: u32) bool {
    if (identifier == frame.SETTINGS_HEADER_TABLE_SIZE) {
        var effective: usize = value::usize;
        if (effective > engine.configured.hpack.max_dynamic_table_bytes) {
            effective = engine.configured.hpack.max_dynamic_table_bytes;
        }
        if (!hpack.table_set_allowed_max(?engine.outbound_table, effective)) { ret false; }
        engine.peer.header_table_size = value;
    }
    or (identifier == frame.SETTINGS_ENABLE_PUSH) {
        if (engine.role == CLIENT || value > 1) { ret false; }
        engine.peer.enable_push = value;
    }
    or (identifier == frame.SETTINGS_MAX_CONCURRENT_STREAMS) {
        engine.peer.max_concurrent_streams = value;
    }
    or (identifier == frame.SETTINGS_INITIAL_WINDOW_SIZE) {
        if (value > 0x7fffffff) { ret false; }
        val delta: i64   = value::i64 - engine.peer.initial_window_size::i64;
        var i:     usize = 0;
        # linear once per peer initial-window change
        for (i < sweep_count(engine)) {
            val stream: *Stream = sweep_at(engine, i);
            if (stream.live && stream.state != STREAM_CLOSED) {
                val adjusted: i64 = stream.send_window + delta;
                if (adjusted > 0x7fffffff || adjusted < -2147483648) { ret false; }
                stream.send_window = adjusted;
                refresh_stream(engine, stream);
            }
            i = i + 1;
        }
        engine.peer.initial_window_size = value;
    }
    or (identifier == frame.SETTINGS_MAX_FRAME_SIZE) {
        if (value < frame.DEFAULT_MAX_FRAME_SIZE || value > frame.MAX_FRAME_SIZE) {
            ret false;
        }
        engine.peer.max_frame_size = value;
    }
    or (identifier == frame.SETTINGS_MAX_HEADER_LIST_SIZE) {
        engine.peer.max_header_list_size = value;
    }
    or (identifier == frame.SETTINGS_ENABLE_CONNECT_PROTOCOL) {
        if (value > 1) { ret false; }
        engine.peer.enable_connect_protocol = value;
    }
    ret true;
}

fun handle_settings(engine: *Engine, header: frame.Header) Event {
    if ((header.flags & frame.FLAG_ACK) != 0) {
        if (!engine.local_settings_pending) {
            ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
        }
        engine.local_settings_pending = false;
        ret event(engine, EVENT_SETTINGS);
    }
    var offset: usize = 0;
    for (offset < engine.frame_payload_length) {
        if (!apply_setting(engine, setting_id(?engine.frame_payload[offset]),
            setting_value(?engine.frame_payload[offset]))) {
            ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
        }
        offset = offset + 6;
    }
    if (!queue_empty_control(engine, frame.FRAME_SETTINGS, frame.FLAG_ACK)) {
        ret fail_connection(engine, ERROR_LIMIT, H2_ENHANCE_YOUR_CALM);
    }
    engine.peer_settings_received = true;
    engine.state                  = OPEN;
    ret event(engine, EVENT_SETTINGS);
}

fun handle_ping(engine: *Engine, header: frame.Header) Event {
    if ((header.flags & frame.FLAG_ACK) == 0
        && !queue_control(engine, frame.Header{length: 8, typ: frame.FRAME_PING,
        flags: frame.FLAG_ACK, stream_id: 0}, engine.frame_payload, 8)) {
        ret fail_connection(engine, ERROR_LIMIT, H2_ENHANCE_YOUR_CALM);
    }
    var result: Event = event(engine, EVENT_PING);
    memory.raw_copy(?result.opaque[0], engine.frame_payload, 8);
    ret result;
}

fun handle_window(engine: *Engine, header: frame.Header) Event {
    val increment: u32 = read_u31(engine.frame_payload);
    if (header.stream_id == 0) {
        if (engine.send_window > 0x7fffffff - increment::i64) {
            ret fail_connection(engine, ERROR_FLOW_CONTROL, H2_FLOW_CONTROL_ERROR);
        }
        engine.send_window = engine.send_window + increment::i64;
        ret event(engine, EVENT_NONE);
    }
    val stream: *Stream = stream_for(engine, header.stream_id);
    if (stream == nil) {
        if ((remote_id(engine, header.stream_id) && header.stream_id > engine.last_remote_stream)
            || (local_id(engine, header.stream_id)
            && engine.next_local_stream != 0
            && header.stream_id >= engine.next_local_stream)) {
            ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
        }
        ret event(engine, EVENT_NONE);
    }
    if (stream.state == STREAM_CLOSED) { ret event(engine, EVENT_NONE); }
    if (stream.state == STREAM_RESERVED_LOCAL
        || stream.state == STREAM_RESERVED_REMOTE) {
        ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
    }
    if (stream.send_window > 0x7fffffff - increment::i64) {
        ret stream_error(engine, stream, H2_FLOW_CONTROL_ERROR);
    }
    stream.send_window = stream.send_window + increment::i64;
    refresh_stream(engine, stream);
    ret event(engine, EVENT_NONE);
}

# dependencies and exclusivity are validated and ignored, only the weight schedules
pub fun set_priority(engine: *Engine, id: u32, dependency: u32,
    weight: u16, exclusive: bool) bool {
    val stream: *Stream = stream_for(engine, id);
    if (stream == nil || dependency == id || weight == 0 || weight > 256) { ret false; }
    stream.weight = weight;
    ret true;
}

fun handle_priority(engine: *Engine, header: frame.Header) Event {
    val dependency: u32     = read_u31(engine.frame_payload);
    val weight:     u16     = engine.frame_payload[4]::u16 + 1;
    val exclusive:  bool    = (engine.frame_payload[0] & 0x80) != 0;
    val stream:     *Stream = stream_for(engine, header.stream_id);
    if (stream != nil && !set_priority(engine, stream.id, dependency, weight, exclusive)) {
        ret stream_error(engine, stream, H2_PROTOCOL_ERROR);
    }
    var result: Event = stream_event(engine, EVENT_PRIORITY, stream);
    result.stream_id = header.stream_id;
    ret result;
}

fun handle_reset(engine: *Engine, header: frame.Header) Event {
    val stream: *Stream = stream_for(engine, header.stream_id);
    if (stream == nil) {
        if ((remote_id(engine, header.stream_id) && header.stream_id > engine.last_remote_stream)
            || (local_id(engine, header.stream_id)
            && engine.next_local_stream != 0
            && header.stream_id >= engine.next_local_stream)) {
            ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
        }
        ret event(engine, EVENT_NONE);
    }
    val code: u32 = read_u32(engine.frame_payload);
    if (stream.exchange != nil) { exchange.cancel_exchange(stream.exchange); }
    mark_closed(engine, stream);
    stream.reset_code = code;
    var result: Event = stream_event(engine, EVENT_STREAM_RESET, stream);
    result.code = code;
    ret result;
}

fun handle_goaway(engine: *Engine) Event {
    val last: u32 = read_u31(engine.frame_payload);
    val code: u32 = read_u32(?engine.frame_payload[4]);
    if (last != 0 && last != 0x7fffffff && !local_id(engine, last)) {
        ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
    }
    if (engine.goaway_received && last > engine.remote_goaway_last) {
        ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
    }
    engine.goaway_received    = true;
    engine.remote_goaway_last = last;
    engine.state              = DRAINING;
    # linear once per received goaway
    var i: usize = 0;
    for (i < engine.stream_capacity) {
        val stream: *Stream = sweep_at(engine, i);
        if (stream.live && stream.initiated_local && stream.id > last
            && stream.state != STREAM_CLOSED) {
            stream.retry_pending = true;
            stream.reset_code    = H2_REFUSED_STREAM;
            mark_closed(engine, stream);
            ready_push(engine, stream);
        }
        i = i + 1;
    }
    var result: Event = event(engine, EVENT_GOAWAY);
    result.last_stream_id = last;
    result.code           = code;
    ret result;
}

fun same_view(left: view.View, right: view.View) bool {
    ret left.len == right.len && (left.len == 0
        || (left.data != nil && right.data != nil
        && memory.raw_equal(left.data, right.data, left.len)));
}

fun is_name(name: view.View, literal: *u8, length: usize) bool {
    ret same_view(name, view.view(literal, length));
}

fun lowercase(name: view.View) bool {
    if (name.data == nil || name.len == 0) { ret false; }
    var i: usize = 0;
    for (i < name.len) {
        if (name.data[i] >= 'A' && name.data[i] <= 'Z') { ret false; }
        i = i + 1;
    }
    ret true;
}

fun trailers_value(value: view.View) bool {
    ret value.len == 8 && value.data != nil
        && memory.raw_equal(value.data, "trailers", 8);
}

fun scheme_valid(value: view.View) bool {
    if (value.data == nil || value.len == 0
        || !((value.data[0] >= 'a' && value.data[0] <= 'z')
        || (value.data[0] >= 'A' && value.data[0] <= 'Z'))) { ret false; }
    var i: usize = 1;
    for (i < value.len) {
        val byte: u8 = value.data[i];
        if (!((byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z')
            || (byte >= '0' && byte <= '9') || byte == '+' || byte == '-'
            || byte == '.')) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun authority_valid(value: view.View) bool {
    if (value.data == nil || value.len == 0) { ret false; }
    var i: usize = 0;
    for (i < value.len) {
        val byte: u8 = value.data[i];
        if (byte <= ' ' || byte == 127 || byte == '/' || byte == '?' || byte == '#'
            || byte == '@') { ret false; }
        i = i + 1;
    }
    ret true;
}

fun regular_field_valid(item: field.Field) bool {
    if (!lowercase(item.name) || !field.valid_name(item.name)
        || !field.valid_value(item.value)) { ret false; }
    if (is_name(item.name, "connection", 10)
        || is_name(item.name, "proxy-connection", 16)
        || is_name(item.name, "keep-alive", 10)
        || is_name(item.name, "transfer-encoding", 17)
        || is_name(item.name, "upgrade", 7)) { ret false; }
    if (is_name(item.name, "te", 2) && !trailers_value(item.value)) { ret false; }
    ret true;
}

fun parse_status(value: view.View) u16 {
    if (value.data == nil || value.len != 3
        || value.data[0] < '1' || value.data[0] > '9'
        || value.data[1] < '0' || value.data[1] > '9'
        || value.data[2] < '0' || value.data[2] > '9') { ret 0; }
    ret (value.data[0] - '0')::u16 * 100
        + (value.data[1] - '0')::u16 * 10
        + (value.data[2] - '0')::u16;
}

fun parse_length(value: view.View, length: *u64) bool {
    if (value.data == nil || value.len == 0 || length == nil) { ret false; }
    var result: u64   = 0;
    var i:      usize = 0;
    for (i < value.len) {
        val byte: u8 = value.data[i];
        if (byte < '0' || byte > '9' || result > (-1)::u64 / 10
            || (result == (-1)::u64 / 10
            && (byte - '0')::u64 > (-1)::u64 % 10)) {
            ret false;
        }
        result = result * 10 + (byte - '0')::u64;
        i      = i + 1;
    }
    @length = result;
    ret true;
}

fun validate_header_block(items: *field.Field, count: usize, kind: u8,
    connect_enabled: bool, maximum_bytes: usize, block: *HeaderBlock) bool {
    if (block == nil || (items == nil && count != 0)) { ret false; }
    @block               = empty_headers();
    block.fields         = items;
    block.count          = count;
    block.regular_offset = count;
    var saw_regular:   bool      = false;
    var saw_method:    bool      = false;
    var saw_scheme:    bool      = false;
    var saw_path:      bool      = false;
    var saw_authority: bool      = false;
    var saw_protocol:  bool      = false;
    var saw_status:    bool      = false;
    var saw_host:      bool      = false;
    var host:          view.View = view.view(nil, 0);
    var bytes:         usize     = 0;
    var i:             usize     = 0;
    for (i < count) {
        val item: field.Field = items[i];
        if (item.name.data == nil || item.name.len == 0 || !lowercase(item.name)
            || !field.valid_value(item.value) || item.name.len > maximum_bytes
            || item.value.len > maximum_bytes - item.name.len
            || item.name.len + item.value.len > maximum_bytes - bytes
            || 32 > maximum_bytes - bytes - item.name.len - item.value.len) { ret false; }
        bytes = bytes + item.name.len + item.value.len + 32;
        if (item.name.data[0] == ':') {
            if (saw_regular || kind == HEADER_TRAILERS) { ret false; }
            if (is_name(item.name, ":method", 7) && !saw_method) {
                block.method = item.value;
                saw_method   = true;
            }
            or (is_name(item.name, ":scheme", 7) && !saw_scheme) {
                block.scheme = item.value;
                saw_scheme   = true;
            }
            or (is_name(item.name, ":path", 5) && !saw_path) {
                block.path = item.value;
                saw_path   = true;
            }
            or (is_name(item.name, ":authority", 10) && !saw_authority) {
                block.authority = item.value;
                saw_authority   = true;
            }
            or (is_name(item.name, ":protocol", 9) && !saw_protocol) {
                block.protocol = item.value;
                saw_protocol   = true;
            }
            or (is_name(item.name, ":status", 7) && !saw_status) {
                block.status = parse_status(item.value);
                if (block.status == 0) { ret false; }
                saw_status = true;
            }
            or { ret false; }
        }
        or {
            if (!saw_regular) {
                block.regular_offset = i;
                saw_regular          = true;
            }
            if (!regular_field_valid(item)
                || (kind == HEADER_TRAILERS && !field.allowed_trailer_name(item.name))) {
                ret false;
            }
            if (is_name(item.name, "host", 4)) {
                if (saw_host && !same_view(host, item.value)) { ret false; }
                host     = item.value;
                saw_host = true;
            }
            if (is_name(item.name, "content-length", 14)) {
                var parsed_length: u64 = 0;
                if (!parse_length(item.value, ?parsed_length)
                    || (block.has_content_length
                    && block.content_length != parsed_length)) { ret false; }
                block.has_content_length = true;
                block.content_length     = parsed_length;
            }
        }
        i = i + 1;
    }
    if (kind == HEADER_REQUEST || kind == HEADER_PUSH) {
        if (!saw_method || saw_status
            || !method.valid_token(block.method, maximum_bytes)) { ret false; }
        val connect: bool = is_name(block.method, "CONNECT", 7);
        if (connect && saw_protocol) {
            if (!connect_enabled || !saw_scheme || !saw_path || !saw_authority
                || !method.valid_token(block.protocol, maximum_bytes)
                || !scheme_valid(block.scheme) || block.path.len == 0
                || !authority_valid(block.authority)) { ret false; }
        }
        or (connect) {
            if (!saw_authority || saw_scheme || saw_path || saw_protocol
                || !authority_valid(block.authority)) { ret false; }
        }
        or {
            if (!saw_scheme || !saw_path || saw_protocol
                || !scheme_valid(block.scheme) || block.path.len == 0
                || (block.path.data[0] != '/'
                && !(is_name(block.method, "OPTIONS", 7)
                && is_name(block.path, "*", 1)))) { ret false; }
        }
        if (saw_authority && !authority_valid(block.authority))             { ret false; }
        if (saw_authority && saw_host && !same_view(block.authority, host)) { ret false; }
        if (!saw_authority && saw_host)                                     { block.authority = host; }
        ret true;
    }
    if (kind == HEADER_RESPONSE || kind == HEADER_INFORMATIONAL) {
        if (!saw_status || saw_method || saw_scheme || saw_path
            || saw_authority || saw_protocol || block.status == 101) { ret false; }
        if (kind == HEADER_INFORMATIONAL) {
            ret block.status < 200 && !block.has_content_length;
        }
        if (block.status == status.NO_CONTENT && block.has_content_length) { ret false; }
        ret block.status >= 200;
    }
    ret !saw_method && !saw_scheme && !saw_path
        && !saw_authority && !saw_protocol && !saw_status;
}

# a remote stream the budget admits but memory refuses is refused like one over
# budget. `refuse` takes the table first and the inline reserve after, so the
# block is still decoded and the shared hpack context stays in step
fun new_remote_stream(engine: *Engine, id: u32, state: StreamState, refuse: bool) *Stream {
    var stream:  *Stream = allocate_stream(engine, id, false, state, true);
    var refused: bool    = refuse || stream == nil;
    if (stream == nil) { stream = allocate_reserve(engine, id, state); }
    if (stream == nil) { ret nil; }
    engine.last_remote_stream = id;
    if (refused) { stream.pending_reset = H2_REFUSED_STREAM; }
    ret stream;
}

fun start_decoder(engine: *Engine, stream: *Stream) bool {
    var decoder: hpack.Decoder;
    stream.decoder = decoder;
    var limits: hpack.Limits = engine.configured.hpack;
    if (engine.configured.local.max_header_list_size != 0xffffffff
        && limits.max_header_list_bytes
        > engine.configured.local.max_header_list_size::usize) {
        limits.max_header_list_bytes = engine.configured.local.max_header_list_size::usize;
    }
    var encoded_capacity: usize = stream.memory.encoded_capacity;
    if (encoded_capacity > limits.max_encoded_block_bytes) {
        encoded_capacity = limits.max_encoded_block_bytes;
    }
    ret hpack.decoder_init(?stream.decoder, ?engine.inbound_table,
        stream.memory.encoded, encoded_capacity,
        stream.memory.fields, stream.memory.field_capacity,
        stream.memory.strings, stream.memory.string_capacity,
        stream.memory.pending, stream.memory.pending_capacity, limits);
}

fun start_headers(engine: *Engine, header: frame.Header) Event {
    var stream: *Stream = stream_for(engine, header.stream_id);
    if (stream == nil) {
        if (engine.role == CLIENT) {
            ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
        }
        if (!remote_id(engine, header.stream_id)) {
            ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
        }
        if (header.stream_id <= engine.last_remote_stream) {
            if (!queue_reset(engine, header.stream_id, H2_STREAM_CLOSED)) {
                ret fail_connection(engine, ERROR_LIMIT, H2_ENHANCE_YOUR_CALM);
            }
            var closed_event: Event = event(engine, EVENT_STREAM_ERROR);
            closed_event.stream_id = header.stream_id;
            closed_event.code      = H2_STREAM_CLOSED;
            ret closed_event;
        }
        val refuse: bool = engine.final_goaway_sent
            || engine.active_streams >= engine.configured.max_streams
            || engine.active_remote
            >= engine.configured.local.max_concurrent_streams::usize;
        stream = new_remote_stream(engine, header.stream_id, STREAM_OPEN, refuse);
        if (stream == nil) {
            ret fail_connection(engine, ERROR_LIMIT, H2_ENHANCE_YOUR_CALM);
        }
    }
    if (!stream_readable(stream) && stream.state != STREAM_RESERVED_REMOTE) {
        if (stream.state == STREAM_CLOSED) { ret stream_error(engine, stream, H2_STREAM_CLOSED); }
        ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
    }
    if (stream.initial_headers_received && (header.flags & frame.FLAG_END_STREAM) == 0) {
        ret stream_error(engine, stream, H2_PROTOCOL_ERROR);
    }
    if (!start_decoder(engine, stream)) {
        ret fail_connection(engine, ERROR_LIMIT, H2_INTERNAL_ERROR);
    }
    engine.header_slot        = stream.slot;
    engine.header_wire_stream = header.stream_id;
    engine.header_end_stream  = (header.flags & frame.FLAG_END_STREAM) != 0;
    if (stream.initial_headers_received) { engine.header_kind = HEADER_TRAILERS; }
    or (engine.role == SERVER && !stream.initiated_local) {
        engine.header_kind = HEADER_REQUEST;
    }
    or { engine.header_kind = HEADER_RESPONSE; }
    ret event(engine, EVENT_NONE);
}

fun finish_headers(engine: *Engine, stream: *Stream, decoded: hpack.Decode) Event {
    var kind:       u8   = engine.header_kind;
    val end_stream: bool = engine.header_end_stream;
    engine.header_slot        = NO_SLOT;
    engine.header_wire_stream = 0;
    engine.header_kind        = 0;
    engine.header_end_stream  = false;
    if (stream.pending_reset != H2_NO_ERROR) {
        val code: u32 = stream.pending_reset;
        stream.pending_reset = H2_NO_ERROR;
        ret stream_error(engine, stream, code);
    }
    var block: HeaderBlock;
    if (kind == HEADER_RESPONSE && decoded.count != 0) {
        var status_value: u16   = 0;
        var i:            usize = 0;
        for (i < decoded.count) {
            if (is_name(stream.memory.fields[i].name, ":status", 7)) {
                status_value = parse_status(stream.memory.fields[i].value);
            }
            i = i + 1;
        }
        if (status_value >= 100 && status_value < 200) { kind = HEADER_INFORMATIONAL; }
    }
    val connect_enabled: bool = engine.configured.local.enable_connect_protocol == 1;
    if (!validate_header_block(stream.memory.fields, decoded.count, kind,
        connect_enabled, engine.configured.hpack.max_header_list_bytes, ?block)) {
        ret stream_error(engine, stream, H2_PROTOCOL_ERROR);
    }
    var event_kind: EventKind = EVENT_TRAILERS;
    if (kind == HEADER_REQUEST)       { event_kind = EVENT_REQUEST_HEADERS; }
    or (kind == HEADER_RESPONSE)      { event_kind = EVENT_RESPONSE_HEADERS; }
    or (kind == HEADER_INFORMATIONAL) { event_kind = EVENT_INFORMATIONAL; }
    or (kind == HEADER_PUSH)          { event_kind = EVENT_PUSH_PROMISE; }
    if (kind == HEADER_INFORMATIONAL && end_stream) {
        ret stream_error(engine, stream, H2_PROTOCOL_ERROR);
    }
    if (kind == HEADER_TRAILERS) {
        if (stream.inbound_has_length
            && stream.inbound_body_bytes != stream.inbound_declared_length) {
            ret stream_error(engine, stream, H2_PROTOCOL_ERROR);
        }
        stream.trailers_received = true;
    }
    or (kind != HEADER_INFORMATIONAL && kind != HEADER_PUSH) {
        stream.initial_headers_received = true;
        stream.inbound_has_length       = block.has_content_length;
        stream.inbound_declared_length  = block.content_length;
        stream.inbound_body_forbidden   = kind == HEADER_RESPONSE
            && (block.status == status.NO_CONTENT || block.status == status.NOT_MODIFIED
            || (stream.exchange != nil
            && stream.exchange.request.method.kind == method.HEAD));
        if (end_stream && stream.inbound_has_length
            && stream.inbound_declared_length != 0
            && !(kind == HEADER_RESPONSE && stream.exchange != nil
            && stream.exchange.request.method.kind == method.HEAD)
            && !(kind == HEADER_RESPONSE && block.status == status.NOT_MODIFIED)) {
            ret stream_error(engine, stream, H2_PROTOCOL_ERROR);
        }
    }
    if (stream.state == STREAM_RESERVED_REMOTE && kind == HEADER_RESPONSE) {
        stream.state         = STREAM_HALF_CLOSED_LOCAL;
        engine.active_remote = engine.active_remote + 1;
        refresh_stream(engine, stream);
    }
    if (end_stream) { close_remote_side(engine, stream); }
    var result: Event = stream_event(engine, event_kind, stream);
    result.headers         = block;
    result.end_stream      = end_stream;
    engine.held            = true;
    engine.held_kind       = event_kind;
    engine.held_stream     = stream.id;
    engine.held_headers    = block;
    engine.held_end_stream = result.end_stream;
    ret result;
}

fun header_fragment(engine: *Engine, header: frame.Header,
    input: *u8, length: usize) Event {
    if (engine.header_slot == NO_SLOT) {
        val started: Event = start_headers(engine, header);
        if (started.kind != EVENT_NONE) { ret started; }
    }
    val stream: *Stream = slot_stream(engine, engine.header_slot);
    var offset: usize   = 0;
    var finish: usize   = length;
    if (header.typ == frame.FRAME_HEADERS) {
        if ((header.flags & frame.FLAG_PADDED) != 0) {
            val padding: usize = input[0]::usize;
            offset = 1;
            finish = length - padding;
        }
        if ((header.flags & frame.FLAG_PRIORITY) != 0) {
            val dependency: u32  = read_u31(?input[offset]);
            val exclusive:  bool = (input[offset] & 0x80) != 0;
            val weight:     u16  = input[offset + 4]::u16 + 1;
            # the block is still decoded so the shared hpack context stays in step
            if (!set_priority(engine, stream.id, dependency, weight, exclusive)
                && stream.pending_reset == H2_NO_ERROR) {
                stream.pending_reset = H2_PROTOCOL_ERROR;
            }
            offset = offset + 5;
        }
    }
    val final:   bool         = (header.flags & frame.FLAG_END_HEADERS) != 0;
    val decoded: hpack.Decode = hpack.decoder_feed(?stream.decoder,
        (?input[offset]), finish - offset, final);
    if ((!final && decoded.status != hpack.DECODE_NEED_INPUT)
        || (final && decoded.status != hpack.DECODE_COMPLETE)) {
        ret fail_connection(engine, ERROR_COMPRESSION, H2_COMPRESSION_ERROR);
    }
    if (!final) { ret event(engine, EVENT_NONE); }
    ret finish_headers(engine, stream, decoded);
}

fun start_push(engine: *Engine, header: frame.Header) Event {
    if (engine.role != CLIENT || engine.configured.local.enable_push == 0) {
        ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
    }
    val parent: *Stream = stream_for(engine, header.stream_id);
    if (parent == nil || !stream_readable(parent)) {
        ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
    }
    var offset: usize = 0;
    var finish: usize = engine.frame_payload_length;
    if ((header.flags & frame.FLAG_PADDED) != 0) {
        val padding: usize = engine.frame_payload[0]::usize;
        offset = 1;
        finish = finish - padding;
    }
    val promised_id: u32 = read_u31(?engine.frame_payload[offset]);
    offset = offset + 4;
    if (!remote_id(engine, promised_id) || promised_id <= engine.last_remote_stream) {
        ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
    }
    val refuse: bool = engine.final_goaway_sent
        || engine.active_streams >= engine.configured.max_streams;
    val promised: *Stream = new_remote_stream(engine, promised_id,
        STREAM_RESERVED_REMOTE, refuse);
    if (promised == nil) {
        ret fail_connection(engine, ERROR_LIMIT, H2_ENHANCE_YOUR_CALM);
    }
    if (!start_decoder(engine, promised)) {
        ret fail_connection(engine, ERROR_LIMIT, H2_INTERNAL_ERROR);
    }
    engine.header_slot        = promised.slot;
    engine.header_wire_stream = header.stream_id;
    engine.header_kind        = HEADER_PUSH;
    engine.header_end_stream  = false;
    val final:   bool         = (header.flags & frame.FLAG_END_HEADERS) != 0;
    val decoded: hpack.Decode = hpack.decoder_feed(?promised.decoder,
        ?engine.frame_payload[offset], finish - offset, final);
    if ((!final && decoded.status != hpack.DECODE_NEED_INPUT)
        || (final && decoded.status != hpack.DECODE_COMPLETE)) {
        ret fail_connection(engine, ERROR_COMPRESSION, H2_COMPRESSION_ERROR);
    }
    if (!final) { ret event(engine, EVENT_NONE); }
    ret finish_headers(engine, promised, decoded);
}

fun continuation(engine: *Engine, header: frame.Header) Event {
    if (engine.header_slot == NO_SLOT || header.stream_id != engine.header_wire_stream) {
        ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
    }
    val stream:  *Stream      = slot_stream(engine, engine.header_slot);
    val final:   bool         = (header.flags & frame.FLAG_END_HEADERS) != 0;
    val decoded: hpack.Decode = hpack.decoder_feed(?stream.decoder,
        engine.frame_payload, engine.frame_payload_length, final);
    if ((!final && decoded.status != hpack.DECODE_NEED_INPUT)
        || (final && decoded.status != hpack.DECODE_COMPLETE)) {
        ret fail_connection(engine, ERROR_COMPRESSION, H2_COMPRESSION_ERROR);
    }
    if (!final) { ret event(engine, EVENT_NONE); }
    ret finish_headers(engine, stream, decoded);
}

fun account_consumed(engine: *Engine, stream: *Stream, count: usize) bool {
    if (count > 0x7fffffff || stream.consumed_pending::u64 + count::u64 > 0x7fffffff
        || engine.consumed_pending::u64 + count::u64 > 0x7fffffff) { ret false; }
    stream.consumed_pending = stream.consumed_pending + count::u32;
    engine.consumed_pending = engine.consumed_pending + count::u32;
    refresh_stream(engine, stream);
    ret true;
}

fun handle_data(engine: *Engine, header: frame.Header) Event {
    val stream: *Stream = stream_for(engine, header.stream_id);
    if (stream == nil) {
        if ((remote_id(engine, header.stream_id) && header.stream_id > engine.last_remote_stream)
            || (local_id(engine, header.stream_id)
            && engine.next_local_stream != 0
            && header.stream_id >= engine.next_local_stream)) {
            ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
        }
        var closed_event: Event = event(engine, EVENT_STREAM_ERROR);
        closed_event.stream_id = header.stream_id;
        closed_event.code      = H2_STREAM_CLOSED;
        if (!queue_reset(engine, header.stream_id, H2_STREAM_CLOSED)) {
            ret fail_connection(engine, ERROR_LIMIT, H2_ENHANCE_YOUR_CALM);
        }
        ret closed_event;
    }
    if (!stream_readable(stream) || !stream.initial_headers_received) {
        ret stream_error(engine, stream, H2_STREAM_CLOSED);
    }
    val charged: i64 = header.length::i64;
    engine.recv_window = engine.recv_window - charged;
    if (engine.recv_window < 0) {
        ret fail_connection(engine, ERROR_FLOW_CONTROL, H2_FLOW_CONTROL_ERROR);
    }
    stream.recv_window = stream.recv_window - charged;
    refresh_stream(engine, stream);
    if (stream.recv_window < 0) { ret stream_error(engine, stream, H2_FLOW_CONTROL_ERROR); }
    var offset:        usize = 0;
    var finish:        usize = engine.frame_payload_length;
    var padding_bytes: usize = 0;
    if ((header.flags & frame.FLAG_PADDED) != 0) {
        padding_bytes = engine.frame_payload[0]::usize + 1;
        offset        = 1;
        finish        = finish - engine.frame_payload[0]::usize;
    }
    if (padding_bytes != 0 && !account_consumed(engine, stream, padding_bytes)) {
        ret fail_connection(engine, ERROR_FLOW_CONTROL, H2_FLOW_CONTROL_ERROR);
    }
    val length:     usize = finish - offset;
    val end_stream: bool  = (header.flags & frame.FLAG_END_STREAM) != 0;
    if (stream.inbound_body_forbidden && length != 0) {
        ret stream_error(engine, stream, H2_PROTOCOL_ERROR);
    }
    if (stream.inbound_body_bytes > (-1)::u64 - length::u64) {
        ret stream_error(engine, stream, H2_PROTOCOL_ERROR);
    }
    stream.inbound_body_bytes = stream.inbound_body_bytes + length::u64;
    if (stream.inbound_has_length
        && (stream.inbound_body_bytes > stream.inbound_declared_length
        || (end_stream && stream.inbound_body_bytes != stream.inbound_declared_length))) {
        ret stream_error(engine, stream, H2_PROTOCOL_ERROR);
    }
    if (end_stream) { close_remote_side(engine, stream); }
    if (length == 0) {
        if (end_stream) {
            var ended: Event = stream_event(engine, EVENT_STREAM_END, stream);
            ended.end_stream = true;
            ret ended;
        }
        ret event(engine, EVENT_NONE);
    }
    engine.held            = true;
    engine.held_kind       = EVENT_DATA;
    engine.held_stream     = stream.id;
    engine.held_data       = ?engine.frame_payload[offset];
    engine.held_length     = length;
    engine.held_end_stream = end_stream;
    var result: Event = stream_event(engine, EVENT_DATA, stream);
    result.data        = engine.held_data;
    result.data_length = length;
    result.end_stream  = end_stream;
    ret result;
}

fun handle_frame(engine: *Engine, header: frame.Header) Event {
    if (!engine.peer_settings_received
        && (header.typ != frame.FRAME_SETTINGS || (header.flags & frame.FLAG_ACK) != 0)) {
        ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
    }
    if (header.typ == frame.FRAME_SETTINGS)      { ret handle_settings(engine, header); }
    if (header.typ == frame.FRAME_PING)          { ret handle_ping(engine, header); }
    if (header.typ == frame.FRAME_WINDOW_UPDATE) { ret handle_window(engine, header); }
    if (header.typ == frame.FRAME_PRIORITY)      { ret handle_priority(engine, header); }
    if (header.typ == frame.FRAME_RESET_STREAM)  { ret handle_reset(engine, header); }
    if (header.typ == frame.FRAME_GOAWAY)        { ret handle_goaway(engine); }
    if (header.typ == frame.FRAME_DATA)          { ret handle_data(engine, header); }
    if (header.typ == frame.FRAME_HEADERS) {
        ret header_fragment(engine, header, engine.frame_payload, engine.frame_payload_length);
    }
    if (header.typ == frame.FRAME_PUSH_PROMISE) { ret start_push(engine, header); }
    if (header.typ == frame.FRAME_CONTINUATION) { ret continuation(engine, header); }
    ret event(engine, EVENT_NONE);
}

fun frame_error(engine: *Engine, error: frame.Error) Event {
    if (error == frame.ERROR_FLOW_CONTROL) {
        ret fail_connection(engine, ERROR_FLOW_CONTROL, H2_FLOW_CONTROL_ERROR);
    }
    if (error == frame.ERROR_FRAME_SIZE) {
        ret fail_connection(engine, ERROR_FRAME, H2_FRAME_SIZE_ERROR);
    }
    ret fail_connection(engine, ERROR_FRAME, H2_PROTOCOL_ERROR);
}

fun input_available(engine: *Engine) usize {
    ret engine.input_length - engine.input_offset;
}

fun process_preface(engine: *Engine) Event {
    for (engine.preface_offset < CLIENT_PREFACE_LENGTH && input_available(engine) != 0) {
        if (engine.read_buffer[engine.input_offset]
            != CLIENT_PREFACE[engine.preface_offset]) {
            ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
        }
        engine.preface_offset = engine.preface_offset + 1;
        engine.input_offset   = engine.input_offset + 1;
    }
    if (engine.preface_offset == CLIENT_PREFACE_LENGTH) {
        engine.preface_received = true;
    }
    ret event(engine, EVENT_NONE);
}

pub fun process(engine: *Engine) Event {
    if (engine == nil || !engine.initialized) {
        var invalid: Event;
        invalid.kind  = EVENT_ERROR;
        invalid.error = ERROR_STATE;
        ret invalid;
    }
    if (engine.state == CLOSED) { ret event(engine, EVENT_CLOSED); }
    if (engine.state == FAILED) { ret event(engine, EVENT_ERROR); }
    if (engine.held) {
        val stream:     *Stream = stream_for(engine, engine.held_stream);
        var held_event: Event   = stream_event(engine, engine.held_kind, stream);
        held_event.data        = engine.held_data;
        held_event.data_length = engine.held_length;
        held_event.end_stream  = engine.held_end_stream;
        if (engine.held_kind != EVENT_DATA) { held_event.headers = engine.held_headers; }
        ret held_event;
    }
    var budget: usize = SERVICE_BUDGET;
    for (engine.ready_head != NO_SLOT) {
        if (budget == 0) { ret event(engine, EVENT_PENDING); }
        budget = budget - 1;
        val serviced: Event = service_ready(engine, ready_pop(engine));
        if (serviced.kind != EVENT_NONE) { ret serviced; }
    }
    if (engine.role == SERVER && !engine.preface_received) {
        val preface: Event = process_preface(engine);
        if (preface.kind != EVENT_NONE) { ret preface; }
        if (!engine.preface_received) {
            if (engine.input_eof) {
                ret fail_connection(engine, ERROR_PROTOCOL, H2_PROTOCOL_ERROR);
            }
            ret event(engine, EVENT_NEED_READ);
        }
    }
    for (true) {
        if (engine.payload_wanted) {
            if (!acquire_payload(engine)) { ret event(engine, EVENT_MEMORY_BLOCKED); }
            engine.payload_wanted = false;
        }
        if (budget == 0 && (input_available(engine) != 0 || engine.input_eof)) {
            ret event(engine, EVENT_PENDING);
        }
        if (input_available(engine) == 0 && engine.input_eof) {
            if (engine.parser.header_length != 0 || engine.parser.remaining != 0) {
                val eof_event: frame.Event = frame.feed(?engine.parser, nil, 0, true);
                if (eof_event.kind == frame.EVENT_ERROR) {
                    ret frame_error(engine, eof_event.error);
                }
            }
            engine.state = DRAINING;
            ret event(engine, EVENT_PEER_CLOSED);
        }
        var input: *u8 = nil;
        if (input_available(engine) != 0) {
            input = (?engine.read_buffer[engine.input_offset]);
        }
        val parsed: frame.Event = frame.feed(?engine.parser, input,
            input_available(engine), engine.input_eof);
        engine.input_offset = engine.input_offset + parsed.consumed;
        if (parsed.kind == frame.EVENT_ERROR)      { ret frame_error(engine, parsed.error); }
        if (parsed.kind == frame.EVENT_NEED_INPUT) { ret event(engine, EVENT_NEED_READ); }
        if (parsed.kind == frame.EVENT_HEADER) {
            engine.current_header       = parsed.header;
            engine.frame_payload_length = 0;
            # the header is consumed, so a refused copy buffer is retried first next call
            if (parsed.header.length != 0 && !acquire_payload(engine)) {
                engine.payload_wanted = true;
                ret event(engine, EVENT_MEMORY_BLOCKED);
            }
        }
        or (parsed.kind == frame.EVENT_PAYLOAD) {
            if (!engine.payload_held
                || parsed.data_length > engine.frame_payload_capacity - engine.frame_payload_length) {
                frame.release(?engine.parser);
                ret fail_connection(engine, ERROR_LIMIT, H2_FRAME_SIZE_ERROR);
            }
            memory.raw_copy(?engine.frame_payload[engine.frame_payload_length],
                parsed.data, parsed.data_length);
            engine.frame_payload_length = engine.frame_payload_length + parsed.data_length;
            frame.release(?engine.parser);
        }
        or (parsed.kind == frame.EVENT_FRAME_END) {
            val handled: Event = handle_frame(engine, parsed.header);
            settle_payload(engine);
            if (handled.kind != EVENT_NONE) { ret handled; }
            budget = budget - 1;
        }
    }
    ret event(engine, EVENT_NONE);
}

pub fun consume_data(engine: *Engine, id: u32, count: usize) bool {
    if (engine == nil || !engine.initialized || !engine.held
        || engine.held_kind != EVENT_DATA || engine.held_stream != id
        || count == 0 || count > engine.held_length) { ret false; }
    val stream: *Stream = stream_for(engine, id);
    if (stream == nil || !account_consumed(engine, stream, count)) { ret false; }
    engine.held_data   = (?engine.held_data[count]);
    engine.held_length = engine.held_length - count;
    if (engine.held_length == 0) {
        engine.held            = false;
        engine.held_kind       = EVENT_NONE;
        engine.held_stream     = 0;
        engine.held_headers    = empty_headers();
        engine.held_data       = nil;
        engine.held_end_stream = false;
        settle_payload(engine);
    }
    ret true;
}

pub fun release_event(engine: *Engine, id: u32, generation: u64) bool {
    if (engine == nil || !engine.initialized || !engine.held
        || engine.held_kind == EVENT_DATA || engine.held_stream != id) { ret false; }
    val stream: *Stream = stream_for(engine, id);
    # a closed stream is never served, so it needs no exchange to end the borrow
    if (stream == nil || stream.generation != generation
        || (engine.held_kind == EVENT_REQUEST_HEADERS && stream.exchange == nil
        && stream.state != STREAM_CLOSED)) {
        ret false;
    }
    engine.held            = false;
    engine.held_kind       = EVENT_NONE;
    engine.held_stream     = 0;
    engine.held_headers    = empty_headers();
    engine.held_end_stream = false;
    ret true;
}

fun flush_window_update(engine: *Engine) {
    if (engine.control_count >= engine.control_capacity) { ret; }
    if (engine.consumed_pending >= engine.configured.window_update_threshold
        || (engine.recv_window == 0 && engine.consumed_pending != 0)) {
        val increment: u32 = engine.consumed_pending;
        if (queue_window(engine, 0, increment)) {
            engine.recv_window      = engine.recv_window + increment::i64;
            engine.consumed_pending = 0;
        }
        ret;
    }
    val owed: usize = engine.lists[LIST_WINDOW].head;
    if (owed == NO_SLOT) { ret; }
    val stream:    *Stream = visit(engine, owed);
    val increment: u32     = stream.consumed_pending;
    if (queue_window(engine, stream.id, increment)) {
        stream.recv_window      = stream.recv_window + increment::i64;
        stream.consumed_pending = 0;
        refresh_stream(engine, stream);
    }
}

pub fun complete_io(engine: *Engine, completion: *transport.Completion) Event {
    if (engine == nil || !engine.initialized || completion == nil) {
        var invalid: Event;
        invalid.kind  = EVENT_ERROR;
        invalid.error = ERROR_STATE;
        ret invalid;
    }
    if ((completion.kind == transport.READ
        && (!engine.read_pending || !transport.token_equal(completion.token, engine.read_token)))
        || (completion.kind == transport.WRITE
        && (!engine.write_pending || !transport.token_equal(completion.token, engine.write_token)))
        || (completion.kind == transport.CLOSE
        && (!engine.close_pending || !transport.token_equal(completion.token, engine.close_token)))) {
        ret fail_connection(engine, ERROR_STATE, H2_INTERNAL_ERROR);
    }
    if (!transport.complete(engine.transport, completion)) {
        ret fail_connection(engine, ERROR_TRANSPORT, H2_INTERNAL_ERROR);
    }
    if (completion.kind == transport.READ) {
        engine.read_pending = false;
        if (completion.status == transport.IO_COMPLETE
            || completion.status == transport.IO_END) {
            if (completion.status == transport.IO_COMPLETE && completion.count == 0) {
                ret fail_connection(engine, ERROR_NO_PROGRESS, H2_INTERNAL_ERROR);
            }
            engine.input_length = completion.count;
            engine.input_offset = 0;
            engine.input_eof    = completion.status == transport.IO_END;
            ret process(engine);
        }
        if (completion.status == transport.IO_CANCELLED) {
            ret fail_connection(engine, ERROR_CANCELLED, H2_CANCEL);
        }
        ret fail_connection(engine, ERROR_TRANSPORT, H2_INTERNAL_ERROR);
    }
    if (completion.kind == transport.WRITE) {
        engine.write_pending = false;
        if (completion.status != transport.IO_COMPLETE || completion.count == 0) {
            if (completion.status == transport.IO_CANCELLED) {
                ret fail_connection(engine, ERROR_CANCELLED, H2_CANCEL);
            }
            ret fail_connection(engine, ERROR_TRANSPORT, H2_INTERNAL_ERROR);
        }
        engine.write_offset = engine.write_offset + completion.count;
        if (engine.write_offset == engine.write_length) { complete_output(engine); }
        flush_window_update(engine);
        ret event(engine, EVENT_NONE);
    }
    engine.close_pending = false;
    engine.state         = CLOSED;
    ret event(engine, EVENT_CLOSED);
}

fun outbound_header_kind(engine: *Engine, stream: *Stream) u8 {
    if (stream.initial_headers_sent)                     { ret HEADER_TRAILERS; }
    if (engine.role == CLIENT && stream.initiated_local) { ret HEADER_REQUEST; }
    ret HEADER_RESPONSE;
}

fun encoder_start(engine: *Engine) bool {
    if (!acquire_encoder(engine)) { ret false; }
    var encoder: hpack.Encoder;
    engine.encoder = encoder;
    var limits: hpack.Limits = engine.configured.hpack;
    if (engine.peer.max_header_list_size != 0xffffffff
        && limits.max_header_list_bytes > engine.peer.max_header_list_size::usize) {
        limits.max_header_list_bytes = engine.peer.max_header_list_size::usize;
    }
    if (!hpack.encoder_init(?engine.encoder, ?engine.outbound_table,
        engine.header_output, engine.header_output_capacity,
        engine.encoder_pending, engine.encoder_pending_capacity, limits)) { ret false; }
    if (engine.outbound_table.requires_update) {
        if (!hpack.encoder_table_size(?engine.encoder,
            engine.outbound_table.required_min_bytes).ok) { ret false; }
        if (engine.outbound_table.allowed_max_bytes
            != engine.outbound_table.required_min_bytes
            && !hpack.encoder_table_size(?engine.encoder,
            engine.outbound_table.allowed_max_bytes).ok) { ret false; }
    }
    ret true;
}

# the encoder buffers are held from here until the block's last frame is written
fun encode_headers(engine: *Engine, items: *field.Field,
    count: usize, huffman_strings: bool) bool {
    if (!encoder_start(engine)) {
        release_encoder(engine);
        ret false;
    }
    var i: usize = 0;
    for (i < count) {
        if (!hpack.encoder_field(?engine.encoder, items[i], hpack.REPRESENT_AUTO,
            huffman_strings).ok) {
            hpack.encoder_abort(?engine.encoder);
            release_encoder(engine);
            ret false;
        }
        i = i + 1;
    }
    val encoded: hpack.Encode = hpack.encoder_finish(?engine.encoder);
    if (!encoded.ok) {
        release_encoder(engine);
        ret false;
    }
    engine.header_output_length = encoded.written;
    engine.header_output_offset = 0;
    engine.header_output_first  = true;
    engine.header_output_active = true;
    ret true;
}

fun encode_refused(engine: *Engine, id: u32) Offer {
    if (engine.memory_blocked) {
        ret Offer{status: OFFER_BLOCKED, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_MEMORY};
    }
    ret Offer{status: OFFER_ERROR, consumed: 0, produced: 0,
        stream_id: id, error: ERROR_PROTOCOL};
}

pub fun send_headers(engine: *Engine, id: u32, items: *field.Field,
    count: usize, end_stream: bool, huffman_strings: bool) Offer {
    val stream: *Stream = stream_for(engine, id);
    if (engine == nil || !engine.initialized || stream == nil
        || (!stream_writable(stream)
        && !(stream.state == STREAM_RESERVED_LOCAL && stream.push_promise_sent))
        || engine.header_output_active
        || (items == nil && count != 0) || stream.trailers_sent
        || (stream.initial_headers_sent && !end_stream)) {
        ret Offer{status: OFFER_BLOCKED, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_STATE};
    }
    val kind:    u8    = outbound_header_kind(engine, stream);
    var checked: HeaderBlock;
    var maximum: usize = engine.configured.hpack.max_header_list_bytes;
    if (engine.peer.max_header_list_size != 0xffffffff
        && maximum > engine.peer.max_header_list_size::usize) {
        maximum = engine.peer.max_header_list_size::usize;
    }
    if (!validate_header_block(items, count, kind,
        engine.peer.enable_connect_protocol == 1, maximum, ?checked)
        || (end_stream && checked.has_content_length && checked.content_length != 0
        && !(kind == HEADER_RESPONSE && stream.exchange != nil
        && stream.exchange.request.method.kind == method.HEAD)
        && !(kind == HEADER_RESPONSE && checked.status == status.NOT_MODIFIED))
        || (kind == HEADER_TRAILERS && stream.outbound_has_length
        && stream.outbound_body_bytes != stream.outbound_declared_length)) {
        ret Offer{status: OFFER_ERROR, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_PROTOCOL};
    }
    if (!encode_headers(engine, items, count, huffman_strings)) {
        ret encode_refused(engine, id);
    }
    engine.header_output_stream      = id;
    engine.header_output_wire_stream = id;
    engine.header_output_end_stream  = end_stream;
    engine.header_output_push        = false;
    if (kind != HEADER_TRAILERS) {
        stream.outbound_has_length      = checked.has_content_length;
        stream.outbound_declared_length = checked.content_length;
        stream.outbound_body_forbidden  = kind == HEADER_RESPONSE
            && (checked.status == status.NO_CONTENT
            || checked.status == status.NOT_MODIFIED
            || (stream.exchange != nil
            && stream.exchange.request.method.kind == method.HEAD));
    }
    var produced: usize = 0;
    if (engine.write_length == 0 && !engine.write_pending && engine.control_count == 0
        && prepare_header_output(engine)) { produced = engine.write_length; }
    var status_value: OfferStatus = OFFER_DONE;
    if (produced != 0) { status_value = OFFER_OUTPUT; }
    ret Offer{status: status_value, consumed: count, produced: produced,
        stream_id: id, error: ERROR_NONE};
}

pub fun reserve_push(engine: *Engine, parent_id: u32,
    bound: *exchange.Exchange) u32 {
    val parent: *Stream = stream_for(engine, parent_id);
    if (engine == nil || !engine.initialized || engine.role != SERVER
        || engine.state != OPEN || engine.peer.enable_push == 0 || engine.goaway_received
        || parent == nil || !stream_writable(parent)
        || engine.active_streams >= engine.configured.max_streams
        || engine.active_local >= engine.peer.max_concurrent_streams::usize
        || engine.next_local_stream == 0 || engine.next_local_stream > 0x7fffffff) { ret 0; }
    val id:     u32     = engine.next_local_stream;
    val stream: *Stream = allocate_stream(engine, id, true, STREAM_RESERVED_LOCAL, false);
    if (stream == nil)   { ret 0; }
    if (id > 0x7ffffffd) { engine.next_local_stream = 0; }
    or                   { engine.next_local_stream = id + 2; }
    if (bound != nil && !bind_exchange(engine, id, bound)) {
        mark_closed(engine, stream);
        ret 0;
    }
    ret id;
}

pub fun send_push_promise(engine: *Engine, parent_id: u32, promised_id: u32,
    items: *field.Field, count: usize, huffman_strings: bool) Offer {
    if (engine == nil || !engine.initialized) {
        ret Offer{status: OFFER_ERROR, consumed: 0, produced: 0,
            stream_id: promised_id, error: ERROR_STATE};
    }
    val parent:   *Stream = stream_for(engine, parent_id);
    val promised: *Stream = stream_for(engine, promised_id);
    var checked:  HeaderBlock;
    var maximum:  usize   = engine.configured.hpack.max_header_list_bytes;
    if (engine.peer.max_header_list_size != 0xffffffff
        && maximum > engine.peer.max_header_list_size::usize) {
        maximum = engine.peer.max_header_list_size::usize;
    }
    if (engine.role != SERVER
        || parent == nil || promised == nil || promised.state != STREAM_RESERVED_LOCAL
        || engine.header_output_active || !stream_writable(parent)
        || !validate_header_block(items, count, HEADER_PUSH,
        engine.peer.enable_connect_protocol == 1,
        maximum, ?checked)) {
        ret Offer{status: OFFER_ERROR, consumed: 0, produced: 0,
            stream_id: promised_id, error: ERROR_STATE};
    }
    if (!encode_headers(engine, items, count, huffman_strings)) {
        var refused: Offer = encode_refused(engine, promised_id);
        if (refused.status == OFFER_ERROR) { refused.error = ERROR_STATE; }
        ret refused;
    }
    engine.header_output_stream      = promised_id;
    engine.header_output_wire_stream = parent_id;
    engine.header_output_end_stream  = false;
    engine.header_output_push        = true;
    var produced: usize = 0;
    if (engine.write_length == 0 && !engine.write_pending && engine.control_count == 0
        && prepare_header_output(engine)) { produced = engine.write_length; }
    var status_value: OfferStatus = OFFER_DONE;
    if (produced != 0) { status_value = OFFER_OUTPUT; }
    ret Offer{status: status_value, consumed: count, produced: produced,
        stream_id: promised_id, error: ERROR_NONE};
}

pub fun set_writable(engine: *Engine, id: u32, ready: bool) bool {
    val stream: *Stream = stream_for(engine, id);
    if (stream == nil || !stream_writable(stream)) { ret false; }
    stream.writable = ready;
    refresh_stream(engine, stream);
    if (!ready && engine.scheduled_stream == id) { engine.scheduled_stream = 0; }
    ret true;
}

# smooth weighted round robin over the writable set only: every call adds each
# member's weight to its credit, picks the highest credit (lowest id on a tie),
# and charges the winner the set's total weight

pub fun writable_stream(engine: *Engine) u32 {
    if (engine == nil || !engine.initialized || engine.send_window <= 0
        || engine.header_output_active || engine.write_length != 0
        || engine.write_pending || engine.control_count != 0) { ret 0; }
    if (engine.scheduled_stream != 0) {
        val scheduled: *Stream = stream_for(engine, engine.scheduled_stream);
        if (scheduled != nil && schedulable(scheduled)) { ret scheduled.id; }
        engine.scheduled_stream = 0;
    }
    var total:    i64     = 0;
    var selected: *Stream = nil;
    var slot:     usize   = engine.lists[LIST_WRITABLE].head;
    for (slot != NO_SLOT) {
        val stream: *Stream = visit(engine, slot);
        total                  = total + stream.weight::i64;
        stream.schedule_credit = stream.schedule_credit + stream.weight::i64;
        if (selected == nil || stream.schedule_credit > selected.schedule_credit
            || (stream.schedule_credit == selected.schedule_credit
            && stream.id < selected.id)) { selected = stream; }
        slot = stream.links[LIST_WRITABLE].next;
    }
    if (selected == nil) { ret 0; }
    selected.schedule_credit = selected.schedule_credit - total;
    engine.scheduled_stream  = selected.id;
    ret selected.id;
}

pub fun offer_data(engine: *Engine, id: u32, input: *u8,
    length: usize, end_stream: bool) Offer {
    if (engine == nil || !engine.initialized || (input == nil && length != 0)
        || (length == 0 && !end_stream)
        || engine.write_length != 0 || engine.write_pending || engine.header_output_active
        || engine.control_count != 0) {
        ret Offer{status: OFFER_BLOCKED, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_STATE};
    }
    val stream:    *Stream = stream_for(engine, id);
    val scheduled: u32     = writable_stream(engine);
    if (stream == nil || !stream_writable(stream) || !stream.initial_headers_sent
        || scheduled != id
        || engine.send_window <= 0 || stream.send_window <= 0) {
        ret Offer{status: OFFER_BLOCKED, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_STATE};
    }
    var take: usize = length;
    if (take > engine.peer.max_frame_size::usize)   { take = engine.peer.max_frame_size::usize; }
    if (take > engine.configured.max_frame_payload) { take = engine.configured.max_frame_payload; }
    if (take > engine.configured.write_bytes - 9)   { take = engine.configured.write_bytes - 9; }
    if (take::i64 > engine.send_window)             { take = engine.send_window::usize; }
    if (take::i64 > stream.send_window)             { take = stream.send_window::usize; }
    if (take == 0 && length != 0) {
        ret Offer{status: OFFER_BLOCKED, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_FLOW_CONTROL};
    }
    val final: bool = end_stream && take == length;
    if ((stream.outbound_body_forbidden && take != 0)
        || stream.outbound_body_bytes > (-1)::u64 - take::u64
        || (stream.outbound_has_length
        && (stream.outbound_body_bytes + take::u64 > stream.outbound_declared_length
        || (final && stream.outbound_body_bytes + take::u64
        != stream.outbound_declared_length)))) {
        engine.scheduled_stream = 0;
        ret Offer{status: OFFER_ERROR, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_PROTOCOL};
    }
    var flags: u8 = 0;
    if (final) { flags = frame.FLAG_END_STREAM; }
    if (!build_frame(engine, frame.Header{length: take::u32, typ: frame.FRAME_DATA,
        flags: flags, stream_id: id}, nil, 0, input, take, OUTPUT_DATA, id, final)) {
        if (engine.memory_blocked) {
            ret Offer{status: OFFER_BLOCKED, consumed: 0, produced: 0,
                stream_id: id, error: ERROR_MEMORY};
        }
        ret Offer{status: OFFER_ERROR, consumed: 0, produced: 0,
            stream_id: id, error: ERROR_FRAME};
    }
    engine.send_window         = engine.send_window - take::i64;
    stream.send_window         = stream.send_window - take::i64;
    stream.outbound_body_bytes = stream.outbound_body_bytes + take::u64;
    engine.scheduled_stream    = 0;
    if (take == length) { stream.writable = false; }
    refresh_stream(engine, stream);
    var status_value: OfferStatus = OFFER_PARTIAL;
    if (take == length && final) { status_value = OFFER_DONE; }
    or (take == length)          { status_value = OFFER_OUTPUT; }
    ret Offer{status: status_value, consumed: take,
        produced: engine.write_length, stream_id: id, error: ERROR_NONE};
}

pub fun send_priority(engine: *Engine, id: u32, dependency: u32,
    weight: u16, exclusive: bool) bool {
    if (!set_priority(engine, id, dependency, weight, exclusive)) { ret false; }
    var payload: [5]u8;
    put_u32(?payload[0], dependency);
    if (exclusive) { payload[0] = payload[0] | 0x80; }
    payload[4] = (weight - 1)::u8;
    ret queue_control(engine, frame.Header{length: 5, typ: frame.FRAME_PRIORITY,
        flags: 0, stream_id: id}, ?payload[0], 5);
}

pub fun cancel_stream(engine: *Engine, id: u32, code: u32) bool {
    val stream: *Stream = stream_for(engine, id);
    if (stream == nil || stream.state == STREAM_CLOSED || code == H2_NO_ERROR
        || !queue_reset(engine, id, code)) { ret false; }
    if (stream.exchange != nil) { exchange.cancel_exchange(stream.exchange); }
    mark_closed(engine, stream);
    stream.reset_code = code;
    ret true;
}

# fallback sweep of exchange-bound open streams for scopes cancelled elsewhere,
# costing O(active exchanges). a host that cancels a scope it owns calls
# `cancel_stream` instead
pub fun tick(engine: *Engine) Event {
    if (engine == nil || !engine.initialized) {
        var invalid: Event;
        invalid.kind  = EVENT_ERROR;
        invalid.error = ERROR_STATE;
        ret invalid;
    }
    val reason: cancel.Reason = cancel.reason(engine.scope);
    if (!(sel reason.active)) {
        ret fail_connection(engine, ERROR_CANCELLED, H2_CANCEL);
    }
    var slot: usize = engine.lists[LIST_EXCHANGE].head;
    for (slot != NO_SLOT) {
        val stream: *Stream = visit(engine, slot);
        slot = stream.links[LIST_EXCHANGE].next;
        if (!scope_active(stream.exchange.scope)) {
            if (!queue_reset(engine, stream.id, H2_CANCEL)) {
                ret fail_connection(engine, ERROR_LIMIT, H2_ENHANCE_YOUR_CALM);
            }
            exchange.settle_cancellation(stream.exchange);
            mark_closed(engine, stream);
            var result: Event = stream_event(engine, EVENT_STREAM_RESET, stream);
            result.code = H2_CANCEL;
            ret result;
        }
    }
    ret event(engine, EVENT_NONE);
}

pub fun begin_graceful(engine: *Engine) bool {
    if (engine == nil || !engine.initialized || engine.graceful
        || engine.state != OPEN || !queue_goaway(engine, 0x7fffffff, H2_NO_ERROR)) {
        ret false;
    }
    engine.graceful = true;
    engine.state    = DRAINING;
    ret true;
}

pub fun finish_graceful(engine: *Engine) bool {
    if (engine == nil || !engine.initialized || !engine.graceful
        || engine.final_goaway_sent
        || !queue_goaway(engine, engine.last_remote_stream, H2_NO_ERROR)) { ret false; }
    engine.final_goaway_sent = true;
    ret true;
}

pub fun progress_close(engine: *Engine) bool {
    if (engine == nil || !engine.initialized || engine.close_pending
        || engine.state == CLOSED || engine.write_pending || engine.write_length != 0
        || engine.control_count != 0 || engine.header_output_active
        || (engine.state != FAILED && (!engine.final_goaway_sent
        || engine.active_local != 0 || engine.active_remote != 0))) { ret false; }
    engine.state = CLOSING;
    submit_close(engine);
    ret engine.close_pending || engine.state == CLOSED;
}

rec TestIO {
    read_token:   transport.Token;
    read_buffer:  *u8;
    read_length:  usize;
    write_token:  transport.Token;
    write_buffer: *u8;
    write_length: usize;
    read_calls:   usize;
    write_calls:  usize;
    close_token:  transport.Token;
    close_calls:  usize;
}

fun test_read(context: ptr, token: transport.Token, scope: *cancel.Scope,
    buffer: *u8, length: usize) res[bool, io_error.Error] {
    val io: *TestIO = context::*TestIO;
    io.read_token  = token;
    io.read_buffer = buffer;
    io.read_length = length;
    io.read_calls  = io.read_calls + 1;
    ret res[bool, io_error.Error].ok{true};
}

fun test_write(context: ptr, token: transport.Token, scope: *cancel.Scope,
    buffer: *u8, length: usize) res[bool, io_error.Error] {
    val io: *TestIO = context::*TestIO;
    io.write_token  = token;
    io.write_buffer = buffer;
    io.write_length = length;
    io.write_calls  = io.write_calls + 1;
    ret res[bool, io_error.Error].ok{true};
}

fun test_shutdown(context: ptr, token: transport.Token,
    scope: *cancel.Scope) res[bool, io_error.Error] {
    ret res[bool, io_error.Error].ok{true};
}

fun test_close(context: ptr, token: transport.Token,
    scope: *cancel.Scope) res[bool, io_error.Error] {
    val io: *TestIO = context::*TestIO;
    io.close_token = token;
    io.close_calls = io.close_calls + 1;
    ret res[bool, io_error.Error].ok{true};
}

rec Fixture {
    runtime:               io_runtime.Runtime;
    operation_root:        cancel.Scope;
    control_root:          cancel.Scope;
    io:                    TestIO;
    adapter:               transport.Adapter;
    transport_slots:       [3]transport.Slot;
    wire:                  transport.Transport;
    pooled_operation_root: cancel.Scope;
    pooled_control_root:   cancel.Scope;
    pooled_slots:          [3]transport.Slot;
    pooled_wire:           transport.Transport;
    backing:               allocator.Allocator;
    pool:                  buffers.Pool;
    source:                buffers.Source;
    account:               buffers.Account;
    refused_encoded:       [512]u8;
    refused_fields:        [16]field.Field;
    refused_strings:       [512]u8;
    refused_pending:       [16]hpack.Entry;
    read_buffer:           [2048]u8;
    controls:              [16]Control;
    inbound_entries:       [16]hpack.Entry;
    inbound_storage:       [4096]u8;
    outbound_entries:      [16]hpack.Entry;
    outbound_storage:      [4096]u8;
    engine:                Engine;
}

# a std pool with no size classes, so every chunk is exactly its request rounded
# to 16 bytes and the account's `held` counts bytes exactly
fun make_buffers(fixture: *Fixture) bool {
    val backed: err[allocator.Error] = page.make(?fixture.backing);
    if (sel backed.err) { ret false; }
    var config: buffers.Config;
    config.class_count   = 0;
    config.lanes         = 2;
    config.global_budget = 1 << 26;
    config.initial_slots = 16;
    if (!buffers.make(?fixture.pool, config, ?fixture.backing)) { ret false; }
    fixture.source = buffers.source(?fixture.pool);
    var budgets: [2]usize       = [2]usize{1 << 25, 1 << 25};
    val opened:  buffers.Reason = buffers.source_open_account(?fixture.source,
        ?fixture.account, 1, ?budgets[0], 0);
    ret sel opened.none;
}

fun test_config() Config {
    var configured: Config = config_default();
    configured.max_streams                   = 4;
    configured.local.header_table_size       = 4096;
    configured.local.max_concurrent_streams  = 4;
    configured.local.initial_window_size     = 16;
    configured.hpack.max_dynamic_table_bytes = 4096;
    configured.hpack.max_header_list_bytes   = 512;
    configured.hpack.max_header_count        = 16;
    configured.hpack.max_string_bytes        = 128;
    configured.hpack.max_encoded_block_bytes = 512;
    configured.max_frame_payload             = 1024;
    configured.connection_window_size        = 65535;
    configured.window_update_threshold       = 8;
    configured.write_bytes                   = 1024;
    configured.frame_payload_bytes           = 16384;
    configured.initial_streams               = 4;
    configured.stream_lane                   = 0;
    configured.connection_lane               = 1;
    ret configured;
}

fun make_fixture(fixture: *Fixture, role: Role, configured: Config) bool {
    if (!operation_ok(cancel.make_root(?fixture.operation_root, opt[time.Instant].none{}))
        || !operation_ok(cancel.make_root(?fixture.control_root, opt[time.Instant].none{}))) { ret false; }
    fixture.adapter.runtime               = ?fixture.runtime;
    fixture.adapter.context               = (?fixture.io)::ptr;
    fixture.adapter.security              = transport.PLAINTEXT;
    fixture.adapter.submit_read           = test_read;
    fixture.adapter.submit_write          = test_write;
    fixture.adapter.submit_readable       = test_shutdown;
    fixture.adapter.submit_shutdown_write = test_shutdown;
    fixture.adapter.submit_close          = test_close;
    if (!transport.init(?fixture.wire, fixture.adapter, ?fixture.operation_root,
        ?fixture.control_root, ?fixture.transport_slots[0], 3)
        || !make_buffers(fixture)) { ret false; }
    ret start_engine(fixture, ?fixture.wire, ?fixture.operation_root, role,
        configured);
}

# every argument but the connection is the fixture's own storage, so calling
# this a second time is exactly what a pool does with a recycled engine
fun start_engine(fixture: *Fixture, connection: *transport.Transport,
    scope: *cancel.Scope, role: Role, configured: Config) bool {
    var refused: StreamMemory;
    refused.encoded          = ?fixture.refused_encoded[0];
    refused.encoded_capacity = 512;
    refused.fields           = ?fixture.refused_fields[0];
    refused.field_capacity   = 16;
    refused.strings          = ?fixture.refused_strings[0];
    refused.string_capacity  = 512;
    refused.pending          = ?fixture.refused_pending[0];
    refused.pending_capacity = 16;
    ret init(?fixture.engine, role, connection, scope, ?fixture.source, ?fixture.account,
        ?fixture.read_buffer[0], 2048, ?fixture.controls[0], 16,
        ?fixture.inbound_entries[0], 16, ?fixture.inbound_storage[0], 4096,
        ?fixture.outbound_entries[0], 16, ?fixture.outbound_storage[0], 4096,
        refused, configured);
}

fun test_frame(output: *u8, capacity: usize, typ: u8, flags: u8,
    stream_id: u32, payload: *u8, length: usize) usize {
    if (output == nil || capacity < length + 9 || length > 0xffffff
        || (payload == nil && length != 0)) { ret 0; }
    output[0] = (length >> 16)::u8;
    output[1] = (length >> 8)::u8;
    output[2] = length::u8;
    output[3] = typ;
    output[4] = flags;
    put_u32(?output[5], stream_id & 0x7fffffff);
    if (length != 0) { memory.raw_copy(?output[9], payload, length); }
    ret length + 9;
}

fun receive_bytes(fixture: *Fixture, input: *u8,
    length: usize, eof: bool) Event {
    if (!submit_read(?fixture.engine) || length > fixture.io.read_length) {
        ret event(?fixture.engine, EVENT_ERROR);
    }
    if (length != 0) { memory.raw_copy(fixture.io.read_buffer, input, length); }
    var completion: transport.Completion;
    if (eof) { completion = transport.end(fixture.io.read_token, length); }
    or       { completion = transport.completed(fixture.io.read_token, transport.READ, length); }
    ret complete_io(?fixture.engine, ?completion);
}

fun receive_frame(fixture: *Fixture, typ: u8, flags: u8,
    stream_id: u32, payload: *u8, length: usize) Event {
    var wire:  [1024]u8;
    val total: usize = test_frame(?wire[0], 1024, typ, flags, stream_id,
        payload, length);
    if (total == 0) { ret event(?fixture.engine, EVENT_ERROR); }
    ret receive_bytes(fixture, ?wire[0], total, false);
}

fun finish_write(fixture: *Fixture, partial: bool) bool {
    if (!submit_write(?fixture.engine)) { ret false; }
    var count: usize = fixture.io.write_length;
    if (partial && count > 1) { count = count / 2; }
    var completion: transport.Completion = transport.completed(
        fixture.io.write_token, transport.WRITE, count);
    if (complete_io(?fixture.engine, ?completion).kind == EVENT_ERROR) { ret false; }
    if (partial && fixture.engine.write_length != 0) {
        if (!submit_write(?fixture.engine)) { ret false; }
        completion = transport.completed(fixture.io.write_token,
            transport.WRITE, fixture.io.write_length);
        if (complete_io(?fixture.engine, ?completion).kind == EVENT_ERROR) { ret false; }
    }
    ret true;
}

fun drain_output(fixture: *Fixture) bool {
    var count: usize = 0;
    for (submit_write(?fixture.engine)) {
        val length:     usize                = fixture.io.write_length;
        var completion: transport.Completion = transport.completed(
            fixture.io.write_token, transport.WRITE, length);
        if (complete_io(?fixture.engine, ?completion).kind == EVENT_ERROR) { ret false; }
        count = count + 1;
        if (count > 64) { ret false; }
    }
    ret true;
}

fun server_handshake(fixture: *Fixture) Event {
    var wire: [33]u8;
    memory.raw_copy(?wire[0], CLIENT_PREFACE, CLIENT_PREFACE_LENGTH);
    test_frame(?wire[24], 9, frame.FRAME_SETTINGS, 0, 0, nil, 0);
    ret receive_bytes(fixture, ?wire[0], 33, false);
}

fun client_handshake(fixture: *Fixture) Event {
    if (!drain_output(fixture)) { ret event(?fixture.engine, EVENT_ERROR); }
    ret receive_frame(fixture, frame.FRAME_SETTINGS, 0, 0, nil, 0);
}

rec ExchangeMemory {
    scope:             cancel.Scope;
    request:           message.Request;
    response:          message.Response;
    reader:            body.Reader;
    response_fields:   [16]field.Field;
    response_trailers: [8]field.Field;
    informationals:    [4]message.Informational;
    exchange:          exchange.Exchange;
}

rec PendingCancellation {
    finish_calls:   usize;
    complete_calls: usize;
    release_calls:  usize;
}

fun pending_body_read(context: ptr, output: *u8, capacity: usize,
    trailers: *field.Fields) body.Progress {
    ret body.complete(body.REUSE_FORBIDDEN);
}

fun pending_body_finish(context: ptr, mode: body.Mode,
    trailers: *field.Fields) body.Progress {
    val pending: *PendingCancellation = context::*PendingCancellation;
    pending.finish_calls = pending.finish_calls + 1;
    if (mode != body.CANCEL) {
        ret body.failed("unexpected body finish mode", body.REUSE_FORBIDDEN);
    }
    ret body.pending(701);
}

fun pending_body_complete(context: ptr, token: u64,
    trailers: *field.Fields) body.Progress {
    val pending: *PendingCancellation = context::*PendingCancellation;
    pending.complete_calls = pending.complete_calls + 1;
    if (token != 701) {
        ret body.failed("unexpected body completion token", body.REUSE_FORBIDDEN);
    }
    ret body.cancelled(body.REUSE_FORBIDDEN);
}

fun pending_body_release(context: ptr) {
    val pending: *PendingCancellation = context::*PendingCancellation;
    pending.release_calls = pending.release_calls + 1;
}

fun make_exchange(storage: *ExchangeMemory, generation: u64,
    stream_id: u32) bool {
    val configured: message.Limits = message.limits_default();
    val none:       time.Instant   = time.Instant{sec: 0, nsec: 0};
    if (!operation_ok(cancel.make_root(?storage.scope, opt[time.Instant].none{}))) { ret false; }
    var fields:   field.Fields = field.init(nil, 0, field.limits(0, 0, 0, 0));
    var trailers: field.Fields = field.init(nil, 0, field.limits(0, 0, 0, 0));
    storage.reader = body.empty_reader(generation);
    val metadata: message.Metadata = message.Metadata{
        version:     message.version_h2(), secure: true, early_data: false,
        peer:        message.unspecified_endpoint(), local: message.unspecified_endpoint(),
        received_at: time.Time{sec: 1, nsec: 0},
        deadline:    opt[time.Instant].none{}, request_index: stream_id::u64,
    };
    if (!message.init_request(?storage.request, method.from_kind(method.GET),
        target.origin(view.view("/", 1), view.view("/", 1), view.view(nil, 0)),
        metadata, fields, trailers, ?storage.reader, generation, configured)
        || !message.init_response(?storage.response, ?storage.response_fields[0], 16,
        ?storage.response_trailers[0], 8, generation, configured)
        || !exchange.init(?storage.exchange, ?storage.request, ?storage.response,
        ?storage.informationals[0], 4, ?storage.scope, generation, configured)) {
        ret false;
    }
    ret true;
}

fun make_pending_exchange(storage: *ExchangeMemory,
    pending: *PendingCancellation, generation: u64, stream_id: u32) bool {
    if (!make_exchange(storage, generation, stream_id)) { ret false; }
    val configured: message.Limits = message.limits_default();
    storage.reader = body.init_reader(pending, pending_body_read,
        pending_body_finish, pending_body_complete, pending_body_release,
        body.OWNER_ENGINE, generation, false, 0, configured.request_body,
        ?storage.request.trailers, ?storage.scope);
    ret storage.reader.valid;
}

fun test_service(context: ptr, served: *exchange.Exchange) exchange.ServiceStatus {
    val configured: message.Limits = message.limits_default();
    if (message.set_status(served.response, status.NO_CONTENT) != message.RESPONSE_OK
        || exchange.commit(served, configured) != message.RESPONSE_OK
        || exchange.finish(served) != exchange.FINISH_OK) {
        ret exchange.SERVICE_FAILED;
    }
    ret exchange.SERVICE_COMPLETE;
}

# one complete server-side exchange whose request block inserts a field into the
# inbound dynamic table, so a surviving table would decode the second connection
# against state the peer does not share
fun pooled_exchange(fixture: *Fixture, storage: *ExchangeMemory) bool {
    var block: [6]u8;
    block[0] = 0x82;
    block[1] = 0x86;
    block[2] = 0x84;
    block[3] = 0x41;
    block[4] = 0x01;
    block[5] = 'x';
    val request: Event = receive_frame(fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS | frame.FLAG_END_STREAM, 1, ?block[0], 6);
    if (request.kind != EVENT_REQUEST_HEADERS || request.stream_id != 1
        || request.headers.count != 4 || request.headers.regular_offset != 4
        || !request.end_stream || fixture.engine.inbound_table.count != 1) {
        ret false;
    }
    if (!make_exchange(storage, request.generation, 1)
        || !bind_exchange(?fixture.engine, 1, ?storage.exchange)) { ret false; }
    val service: exchange.Service = exchange.Service{ctx: nil, serve: test_service};
    if (dispatch(?fixture.engine, 1, ?service) != exchange.SERVICE_COMPLETE
        || !release_event(?fixture.engine, 1, request.generation)) { ret false; }
    var response: [1]field.Field;
    response[0] = field.Field{name: view.view(":status", 7),
        value: view.view("204", 3), sensitive: false};
    if (send_headers(?fixture.engine, 1, ?response[0], 1, true,
        true).status != OFFER_OUTPUT || !drain_output(fixture)
        || stream_for(?fixture.engine, 1).state != STREAM_CLOSED) { ret false; }
    ret release_stream(?fixture.engine, 1, request.generation);
}

test "http.h2.connection: destroy returns pooled storage for a second connection" {
    var fixture: Fixture;
    var first:   ExchangeMemory;
    var second:  ExchangeMemory;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    if (!pooled_exchange(?fixture, ?first)) { ret 2; }
    val inbound_bytes: usize = fixture.engine.inbound_table.bytes;
    if (inbound_bytes == 0 || fixture.engine.active_streams != 0) { ret 3; }
    if (!begin_graceful(?fixture.engine) || !finish_graceful(?fixture.engine)
        || !drain_output(?fixture) || !progress_close(?fixture.engine)) { ret 4; }
    if (destroy(?fixture.engine)) { ret 5; }
    var closed: transport.Completion = transport.completed(
        fixture.io.close_token, transport.CLOSE, 0);
    if (complete_io(?fixture.engine, ?closed).kind != EVENT_CLOSED
        || fixture.engine.state != CLOSED) { ret 6; }
    if (!destroy(?fixture.engine)) { ret 7; }
    if (fixture.engine.initialized || fixture.engine.inbound_table.valid
        || fixture.engine.outbound_table.valid || fixture.engine.parser.initialized
        || fixture.engine.writer.initialized
        || fixture.engine.inbound_table.count != 0
        || fixture.engine.inbound_table.bytes != 0
        || fixture.engine.outbound_table.count != 0) { ret 8; }
    if (destroy(?fixture.engine)) { ret 9; }
    val none: time.Instant = time.Instant{sec: 0, nsec: 0};
    if (!operation_ok(cancel.make_root(?fixture.pooled_operation_root, opt[time.Instant].none{}))
        || !operation_ok(cancel.make_root(?fixture.pooled_control_root, opt[time.Instant].none{}))
        || !transport.init(?fixture.pooled_wire, fixture.adapter,
        ?fixture.pooled_operation_root, ?fixture.pooled_control_root,
        ?fixture.pooled_slots[0], 3)) { ret 10; }
    if (!start_engine(?fixture, ?fixture.pooled_wire,
        ?fixture.pooled_operation_root, SERVER, test_config())) { ret 11; }
    if (fixture.engine.state != PREFACE || fixture.engine.active_streams != 0
        || fixture.engine.inbound_table.count != 0
        || fixture.engine.outbound_table.count != 0
        || fixture.engine.peer_settings_received) { ret 12; }
    if (server_handshake(?fixture).kind != EVENT_SETTINGS
        || fixture.engine.state != OPEN || !drain_output(?fixture)) { ret 13; }
    if (!pooled_exchange(?fixture, ?second)) { ret 14; }
    if (fixture.engine.inbound_table.count != 1
        || fixture.engine.inbound_table.bytes != inbound_bytes
        || fixture.engine.active_streams != 0) { ret 15; }
    ret 0;
}

test "http.h2.connection: preface settings and ping interoperate incrementally" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || submit_write(?fixture.engine)) { ret 1; }
    val accepted: Event = server_handshake(?fixture);
    if (accepted.kind != EVENT_SETTINGS || fixture.engine.state != OPEN
        || !fixture.engine.peer_settings_received || !drain_output(?fixture)) { ret 2; }
    var opaque: [8]u8;
    var i:      usize = 0;
    for (i < 8) {
        opaque[i] = (i + 1)::u8;
        i         = i + 1;
    }
    val ping: Event = receive_frame(?fixture, frame.FRAME_PING, 0, 0, ?opaque[0], 8);
    if (ping.kind != EVENT_PING || !memory.raw_equal(?ping.opaque[0], ?opaque[0], 8)
        || !submit_write(?fixture.engine) || fixture.io.write_buffer[3] != frame.FRAME_PING
        || (fixture.io.write_buffer[4] & frame.FLAG_ACK) == 0) { ret 3; }
    var completion: transport.Completion = transport.completed(
        fixture.io.write_token, transport.WRITE, fixture.io.write_length);
    if (complete_io(?fixture.engine, ?completion).kind == EVENT_ERROR) { ret 4; }
    ret 0;
}

test "http.h2.connection: acknowledged settings change decoder and stream windows atomically" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)
        || receive_frame(?fixture, frame.FRAME_SETTINGS, frame.FLAG_ACK,
        0, nil, 0).kind != EVENT_SETTINGS) { ret 1; }
    var settings: Settings = fixture.engine.configured.local;
    settings.header_table_size   = 256;
    settings.initial_window_size = 8;
    if (!send_settings(?fixture.engine, settings) || !drain_output(?fixture)
        || fixture.engine.local_initial_window != 8
        || fixture.engine.inbound_table.allowed_max_bytes != 256
        || !fixture.engine.inbound_table.requires_update) { ret 2; }
    var block: [9]u8;
    block[0] = 0x3f;
    block[1] = 0xe1;
    block[2] = 0x01;
    block[3] = 0x82;
    block[4] = 0x86;
    block[5] = 0x84;
    block[6] = 0x01;
    block[7] = 0x01;
    block[8] = 'x';
    val request: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS, 1, ?block[0], 9);
    if (request.kind != EVENT_REQUEST_HEADERS
        || stream_for(?fixture.engine, 1).recv_window != 8
        || fixture.engine.inbound_table.requires_update) { ret 3; }
    ret 0;
}

test "http.h2.connection: request stream binds and dispatches one common exchange" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    var block: [6]u8;
    block[0] = 0x82;
    block[1] = 0x86;
    block[2] = 0x84;
    block[3] = 0x01;
    block[4] = 0x01;
    block[5] = 'x';
    val request: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS | frame.FLAG_END_STREAM, 1, ?block[0], 6);
    if (request.kind != EVENT_REQUEST_HEADERS || request.stream_id != 1
        || request.headers.count != 4 || request.headers.regular_offset != 4
        || !request.end_stream) { ret 2; }
    var storage: ExchangeMemory;
    if (!make_exchange(?storage, request.generation, 1)
        || !bind_exchange(?fixture.engine, 1, ?storage.exchange)
        || exchange_for(?fixture.engine, 1) != ?storage.exchange) { ret 3; }
    val service: exchange.Service = exchange.Service{ctx: nil, serve: test_service};
    if (dispatch(?fixture.engine, 1, ?service) != exchange.SERVICE_COMPLETE
        || storage.exchange.state != exchange.COMPLETE_STATE
        || !release_event(?fixture.engine, 1, request.generation)) { ret 4; }
    var response: [1]field.Field;
    response[0] = field.Field{name: view.view(":status", 7),
        value: view.view("204", 3), sensitive: false};
    val offered: Offer = send_headers(?fixture.engine, 1, ?response[0], 1,
        true, true);
    if (offered.status != OFFER_OUTPUT || !finish_write(?fixture, true)
        || stream_for(?fixture.engine, 1).state != STREAM_CLOSED
        || !release_stream(?fixture.engine, 1, request.generation)) { ret 5; }
    ret 0;
}

test "http.h2.connection: teardown abandonment initiates cancellation" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    var block: [6]u8;
    block[0] = 0x82;
    block[1] = 0x86;
    block[2] = 0x84;
    block[3] = 0x01;
    block[4] = 0x01;
    block[5] = 'x';
    val request: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS | frame.FLAG_END_STREAM, 1, ?block[0], 6);
    var storage: ExchangeMemory;
    if (request.kind != EVENT_REQUEST_HEADERS
        || !make_exchange(?storage, request.generation, 1)
        || !bind_exchange(?fixture.engine, 1, ?storage.exchange)
        || !release_event(?fixture.engine, 1, request.generation)) { ret 2; }
    var response: [1]field.Field;
    response[0] = field.Field{name: view.view(":status", 7),
        value: view.view("204", 3), sensitive: false};
    if (send_headers(?fixture.engine, 1, ?response[0], 1,
        true, true).status != OFFER_OUTPUT || !drain_output(?fixture)
        || stream_for(?fixture.engine, 1).state != STREAM_CLOSED
        || !scope_active(?storage.scope)) { ret 3; }
    if (abandon_exchange(?fixture.engine, 1,
        request.generation) != ?storage.exchange
        || !scope_cancelled(?storage.scope)
        || storage.exchange.state != exchange.CANCELLED_STATE
        || exchange_for(?fixture.engine, 1) != nil
        || !release_stream(?fixture.engine, 1, request.generation)) { ret 4; }
    if (!operation_ok(cancel.destroy(?storage.scope))) { ret 5; }
    ret 0;
}

test "http.h2.connection: teardown detaches pending exchange generation safely" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    var block: [6]u8;
    block[0] = 0x82;
    block[1] = 0x86;
    block[2] = 0x84;
    block[3] = 0x01;
    block[4] = 0x01;
    block[5] = 'x';
    val first_request: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS, 1, ?block[0], 6);
    var first:   ExchangeMemory;
    var pending: PendingCancellation;
    if (first_request.kind != EVENT_REQUEST_HEADERS
        || !make_pending_exchange(?first, ?pending, first_request.generation, 1)
        || !bind_exchange(?fixture.engine, 1, ?first.exchange)
        || !release_event(?fixture.engine, 1, first_request.generation)) { ret 2; }
    val first_slot: *Stream = stream_for(?fixture.engine, 1);
    if (first_slot == nil
        || !cancel_stream(?fixture.engine, 1, H2_CANCEL)
        || first_slot.state != STREAM_CLOSED
        || first.exchange.state == exchange.CANCELLED_STATE
        || first.reader.pending_kind != body.OP_FINISH
        || first.reader.pending_token != 701 || pending.finish_calls != 1
        || release_stream(?fixture.engine, 1, first_request.generation)) { ret 3; }
    if (abandon_exchange(?fixture.engine, 1,
        first_request.generation + 1) != nil
        || exchange_for(?fixture.engine, 1) != ?first.exchange) { ret 4; }
    val detached: *exchange.Exchange = abandon_exchange(?fixture.engine, 1,
        first_request.generation);
    if (detached != ?first.exchange || exchange_for(?fixture.engine, 1) != nil
        || pending.finish_calls != 1
        || !release_stream(?fixture.engine, 1, first_request.generation)) { ret 5; }

    val second_request: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS, 3, ?block[0], 6);
    var second: ExchangeMemory;
    if (second_request.kind != EVENT_REQUEST_HEADERS
        || !make_exchange(?second, second_request.generation, 3)
        || !bind_exchange(?fixture.engine, 3, ?second.exchange)
        || !release_event(?fixture.engine, 3, second_request.generation)
        || stream_for(?fixture.engine, 3) != first_slot
        || second_request.generation == first_request.generation
        || !cancel_stream(?fixture.engine, 3, H2_CANCEL)) { ret 6; }
    if (abandon_exchange(?fixture.engine, 3, first_request.generation) != nil
        || exchange_for(?fixture.engine, 3) != ?second.exchange) { ret 7; }

    if (body.complete_reader(first.request.body, 701).status != body.CANCELLED
        || exchange.settle_cancellation(?first.exchange) != exchange.FINISH_OK
        || first.exchange.state != exchange.CANCELLED_STATE
        || pending.complete_calls != 1 || pending.release_calls != 1
        || exchange_for(?fixture.engine, 3) != ?second.exchange) { ret 8; }
    if (abandon_exchange(?fixture.engine, 3,
        second_request.generation) != ?second.exchange
        || !release_stream(?fixture.engine, 3, second_request.generation)) { ret 9; }
    if (!operation_ok(cancel.destroy(?first.scope)) || !operation_ok(cancel.destroy(?second.scope))) { ret 10; }
    ret 0;
}

test "http.h2.connection: data backpressure replenishes both windows without deadlock" {
    var fixture:    Fixture;
    var configured: Config = test_config();
    configured.local.initial_window_size = 8;
    configured.window_update_threshold   = 4;
    if (!make_fixture(?fixture, SERVER, configured)
        || server_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    var block: [6]u8;
    block[0] = 0x82;
    block[1] = 0x86;
    block[2] = 0x84;
    block[3] = 0x01;
    block[4] = 0x01;
    block[5] = 'x';
    val headers: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS, 1, ?block[0], 6);
    var storage: ExchangeMemory;
    if (headers.kind != EVENT_REQUEST_HEADERS
        || !make_exchange(?storage, headers.generation, 1)
        || !bind_exchange(?fixture.engine, 1, ?storage.exchange)
        || !release_event(?fixture.engine, 1, headers.generation)) { ret 2; }
    var bytes:      [6]u8;
    val data_event: Event = receive_frame(?fixture, frame.FRAME_DATA, 0, 1,
        ?bytes[0], 6);
    if (data_event.kind != EVENT_DATA || data_event.data_length != 6
        || stream_for(?fixture.engine, 1).recv_window != 2
        || !consume_data(?fixture.engine, 1, 2)
        || process(?fixture.engine).data_length != 4
        || !consume_data(?fixture.engine, 1, 4)) { ret 3; }
    if (!submit_write(?fixture.engine) || fixture.io.write_buffer[3] != frame.FRAME_WINDOW_UPDATE
        || read_u31(?fixture.io.write_buffer[9]) != 6) { ret 4; }
    var completion: transport.Completion = transport.completed(
        fixture.io.write_token, transport.WRITE, fixture.io.write_length);
    complete_io(?fixture.engine, ?completion);
    if (!submit_write(?fixture.engine) || fixture.io.write_buffer[3] != frame.FRAME_WINDOW_UPDATE
        || read_u31(?fixture.io.write_buffer[9]) != 6) { ret 5; }
    completion = transport.completed(fixture.io.write_token,
        transport.WRITE, fixture.io.write_length);
    complete_io(?fixture.engine, ?completion);
    if (fixture.engine.recv_window != 65535
        || stream_for(?fixture.engine, 1).recv_window != 8) { ret 6; }
    ret 0;
}

fun request_fields(items: *field.Field) {
    items[0] = field.Field{name: view.view(":method", 7),
        value: view.view("GET", 3), sensitive: false};
    items[1] = field.Field{name: view.view(":scheme", 7),
        value: view.view("https", 5), sensitive: false};
    items[2] = field.Field{name: view.view(":path", 5),
        value: view.view("/", 1), sensitive: false};
    items[3] = field.Field{name: view.view(":authority", 10),
        value: view.view("x", 1), sensitive: false};
}

test "http.h2.connection: weighted scheduling is fair and priority signals only set weights" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, CLIENT, test_config())
        || client_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    val first:   u32 = open_local(?fixture.engine, nil);
    val second:  u32 = open_local(?fixture.engine, nil);
    var headers: [4]field.Field;
    request_fields(?headers[0]);
    if (first != 1 || second != 3
        || send_headers(?fixture.engine, first, ?headers[0], 4, false, true).status
        != OFFER_OUTPUT
        || !finish_write(?fixture, true)
        || send_headers(?fixture.engine, second, ?headers[0], 4, false, true).status
        != OFFER_OUTPUT
        || !finish_write(?fixture, false)) { ret 2; }
    if (!set_priority(?fixture.engine, first, 0, 4, false)
        || !set_priority(?fixture.engine, second, first, 1, false)
        || !set_priority(?fixture.engine, first, second, 4, true)
        || set_priority(?fixture.engine, first, first, 8, false)
        || stream_for(?fixture.engine, first).weight != 4
        || stream_for(?fixture.engine, second).weight != 1) { ret 3; }
    var high: usize = 0;
    var low:  usize = 0;
    var byte: [1]u8;
    var i:    usize = 0;
    for (i < 20) {
        set_writable(?fixture.engine, first, true);
        set_writable(?fixture.engine, second, true);
        val selected: u32 = writable_stream(?fixture.engine);
        if (selected == first)  { high = high + 1; }
        or (selected == second) { low = low + 1; }
        or                      { ret 4; }
        if (offer_data(?fixture.engine, selected, ?byte[0], 1, false).consumed != 1
            || !finish_write(?fixture, i % 2 == 0)) { ret 5; }
        i = i + 1;
    }
    if (high <= low || low == 0 || high + low != 20) { ret 6; }
    ret 0;
}

test "http.h2.connection: goaway retry cancellation and graceful drain preserve lifetimes" {
    var client: Fixture;
    if (!make_fixture(?client, CLIENT, test_config())
        || client_handshake(?client).kind != EVENT_SETTINGS
        || !drain_output(?client)) { ret 1; }
    var first_exchange: ExchangeMemory;
    if (!make_exchange(?first_exchange, 1, 1)) { ret 2; }
    val first:  u32 = open_local(?client.engine, ?first_exchange.exchange);
    val second: u32 = open_local(?client.engine, nil);
    var goaway: [8]u8;
    put_u32(?goaway[0], first);
    put_u32(?goaway[4], H2_NO_ERROR);
    val draining: Event = receive_frame(?client, frame.FRAME_GOAWAY, 0, 0,
        ?goaway[0], 8);
    if (first != 1 || second != 3 || draining.kind != EVENT_GOAWAY
        || draining.last_stream_id != 1 || client.engine.state != DRAINING) { ret 3; }
    val retry:         Event   = process(?client.engine);
    val second_stream: *Stream = stream_for(?client.engine, second);
    if (retry.kind != EVENT_STREAM_RETRY || retry.stream_id != second
        || second_stream.state != STREAM_CLOSED
        || !release_stream(?client.engine, second, second_stream.generation)) { ret 4; }
    if (!cancel_stream(?client.engine, first, H2_CANCEL)
        || !scope_cancelled(?first_exchange.scope)
        || stream_for(?client.engine, first).state != STREAM_CLOSED) { ret 5; }
    var server: Fixture;
    if (!make_fixture(?server, SERVER, test_config())
        || server_handshake(?server).kind != EVENT_SETTINGS
        || !drain_output(?server) || !begin_graceful(?server.engine)
        || !finish_graceful(?server.engine) || !drain_output(?server)
        || !progress_close(?server.engine) || server.io.close_calls != 1) { ret 6; }
    var closed: transport.Completion = transport.completed(
        server.io.close_token, transport.CLOSE, 0);
    if (complete_io(?server.engine, ?closed).kind != EVENT_CLOSED) { ret 7; }
    ret 0;
}

test "http.h2.connection: malformed headers reset one stream and compression errors fail closed" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    var invalid: [11]u8;
    invalid[0]  = 0x82;
    invalid[1]  = 0x86;
    invalid[2]  = 0x84;
    invalid[3]  = 0x01;
    invalid[4]  = 0x01;
    invalid[5]  = 'x';
    invalid[6]  = 0x00;
    invalid[7]  = 0x01;
    invalid[8]  = 'X';
    invalid[9]  = 0x01;
    invalid[10] = 'y';
    val rejected: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS, 1, ?invalid[0], 11);
    if (rejected.kind != EVENT_STREAM_ERROR || rejected.code != H2_PROTOCOL_ERROR
        || fixture.engine.state != OPEN || stream_for(?fixture.engine, 1).state
        != STREAM_CLOSED || !drain_output(?fixture)) { ret 2; }
    var length_block: [24]u8;
    length_block[0] = 0x82;
    length_block[1] = 0x86;
    length_block[2] = 0x84;
    length_block[3] = 0x01;
    length_block[4] = 0x01;
    length_block[5] = 'x';
    length_block[6] = 0x00;
    length_block[7] = 0x0e;
    memory.raw_copy(?length_block[8], "content-length", 14);
    length_block[22] = 0x01;
    length_block[23] = '2';
    val length_headers: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS, 3, ?length_block[0], 24);
    var storage: ExchangeMemory;
    if (length_headers.kind != EVENT_REQUEST_HEADERS)                  { ret 3; }
    if (!make_exchange(?storage, length_headers.generation, 3))        { ret 32; }
    if (!bind_exchange(?fixture.engine, 3, ?storage.exchange))         { ret 33; }
    if (!release_event(?fixture.engine, 3, length_headers.generation)) { ret 34; }
    var one:        [1]u8;
    val short_body: Event = receive_frame(?fixture, frame.FRAME_DATA,
        frame.FLAG_END_STREAM, 3, ?one[0], 1);
    if (short_body.kind != EVENT_STREAM_ERROR || short_body.code != H2_PROTOCOL_ERROR
        || !drain_output(?fixture)) { ret 4; }
    var bad_index: [1]u8;
    bad_index[0] = 0x80;
    val compression: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS, 5, ?bad_index[0], 1);
    if (compression.kind != EVENT_ERROR || compression.error != ERROR_COMPRESSION
        || compression.code != H2_COMPRESSION_ERROR
        || fixture.engine.h2_error != H2_COMPRESSION_ERROR
        || fixture.engine.state != FAILED) { ret 5; }
    ret 0;
}

test "http.h2.connection: refused streams still advance shared compression state" {
    var fixture:    Fixture;
    var configured: Config = test_config();
    configured.max_streams = 1;
    if (!make_fixture(?fixture, SERVER, configured)
        || server_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    var request: [6]u8;
    request[0] = 0x82;
    request[1] = 0x86;
    request[2] = 0x84;
    request[3] = 0x01;
    request[4] = 0x01;
    request[5] = 'x';
    val first: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS, 1, ?request[0], 6);
    var storage: ExchangeMemory;
    if (first.kind != EVENT_REQUEST_HEADERS
        || !make_exchange(?storage, first.generation, 1)
        || !bind_exchange(?fixture.engine, 1, ?storage.exchange)
        || !release_event(?fixture.engine, 1, first.generation)) { ret 2; }
    var inserted: [6]u8;
    inserted[0] = 0x82;
    inserted[1] = 0x86;
    inserted[2] = 0x84;
    inserted[3] = 0x41;
    inserted[4] = 0x01;
    inserted[5] = 'y';
    val refused: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS, 3, ?inserted[0], 6);
    if (refused.kind != EVENT_STREAM_ERROR || refused.code != H2_REFUSED_STREAM
        || fixture.engine.inbound_table.count != 1 || !drain_output(?fixture)) { ret 3; }
    val refused_stream: *Stream = stream_for(?fixture.engine, 3);
    if (!release_stream(?fixture.engine, 3, refused_stream.generation)) { ret 4; }
    var indexed: [1]u8;
    indexed[0] = 0xbe;
    val second_refusal: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS, 5, ?indexed[0], 1);
    if (second_refusal.kind != EVENT_STREAM_ERROR
        || second_refusal.code != H2_REFUSED_STREAM
        || fixture.engine.state != OPEN) { ret 5; }
    ret 0;
}

test "http.h2.connection: every byte fragmentation and continuation preserve one block" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())) { ret 1; }
    var preface_and_settings: [33]u8;
    memory.raw_copy(?preface_and_settings[0], CLIENT_PREFACE, 24);
    test_frame(?preface_and_settings[24], 9, frame.FRAME_SETTINGS, 0, 0, nil, 0);
    var i: usize = 0;
    for (i < 33) {
        val fragment: Event = receive_bytes(?fixture, ?preface_and_settings[i], 1, false);
        if (i < 32 && fragment.kind != EVENT_NEED_READ) { ret 2; }
        if (i == 32 && fragment.kind != EVENT_SETTINGS) { ret 3; }
        i = i + 1;
    }
    if (!drain_output(?fixture)) { ret 4; }
    var first: [2]u8;
    first[0] = 0x82;
    first[1] = 0x86;
    if (receive_frame(?fixture, frame.FRAME_HEADERS, frame.FLAG_END_STREAM, 1,
        ?first[0], 2).kind != EVENT_NEED_READ) { ret 5; }
    var rest: [4]u8;
    rest[0] = 0x84;
    rest[1] = 0x01;
    rest[2] = 0x01;
    rest[3] = 'x';
    val completed: Event = receive_frame(?fixture, frame.FRAME_CONTINUATION,
        frame.FLAG_END_HEADERS, 1, ?rest[0], 4);
    if (completed.kind != EVENT_REQUEST_HEADERS || completed.headers.count != 4) {
        ret 6;
    }
    ret 0;
}

test "http.h2.connection: outbound continuation is atomic across queued control work" {
    var fixture:    Fixture;
    var configured: Config = test_config();
    configured.max_frame_payload = 5;
    if (!make_fixture(?fixture, CLIENT, configured)
        || client_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    val id:      u32 = open_local(?fixture.engine, nil);
    var request: [4]field.Field;
    request_fields(?request[0]);
    if (send_headers(?fixture.engine, id, ?request[0], 4, true, true).status
        != OFFER_OUTPUT || fixture.engine.write_buffer[3] != frame.FRAME_HEADERS
        || !finish_write(?fixture, true) || !fixture.engine.header_output_active
        || !send_priority(?fixture.engine, id, 0, 16, false)) { ret 2; }
    var continuations: usize = 0;
    for (fixture.engine.header_output_active) {
        if (!submit_write(?fixture.engine)
            || fixture.io.write_buffer[3] != frame.FRAME_CONTINUATION) { ret 3; }
        var completion: transport.Completion = transport.completed(
            fixture.io.write_token, transport.WRITE, fixture.io.write_length);
        if (complete_io(?fixture.engine, ?completion).kind == EVENT_ERROR) { ret 4; }
        continuations = continuations + 1;
        if (continuations > 16) { ret 5; }
    }
    if (continuations == 0 || !submit_write(?fixture.engine)
        || fixture.io.write_buffer[3] != frame.FRAME_PRIORITY) { ret 6; }
    ret 0;
}

test "http.h2.connection: push promise uses reserved state and bounded hpack context" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, CLIENT, test_config())
        || client_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    val parent:  u32 = open_local(?fixture.engine, nil);
    var request: [4]field.Field;
    request_fields(?request[0]);
    if (send_headers(?fixture.engine, parent, ?request[0], 4, false, true).status
        != OFFER_OUTPUT || !finish_write(?fixture, false)) { ret 2; }
    var payload: [10]u8;
    put_u32(?payload[0], 2);
    payload[4] = 0x82;
    payload[5] = 0x86;
    payload[6] = 0x84;
    payload[7] = 0x01;
    payload[8] = 0x01;
    payload[9] = 'x';
    val promised: Event = receive_frame(?fixture, frame.FRAME_PUSH_PROMISE,
        frame.FLAG_END_HEADERS, parent, ?payload[0], 10);
    val pushed: *Stream = stream_for(?fixture.engine, 2);
    if (promised.kind != EVENT_PUSH_PROMISE || promised.stream_id != 2
        || pushed == nil || pushed.state != STREAM_RESERVED_REMOTE) { ret 3; }
    var storage: ExchangeMemory;
    if (!make_exchange(?storage, promised.generation, 2)
        || !bind_exchange(?fixture.engine, 2, ?storage.exchange)
        || !release_event(?fixture.engine, 2, promised.generation)) { ret 4; }
    var response: [1]u8;
    response[0] = 0x89;
    val completed: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS | frame.FLAG_END_STREAM, 2, ?response[0], 1);
    if (completed.kind != EVENT_RESPONSE_HEADERS
        || stream_for(?fixture.engine, 2).state != STREAM_CLOSED) { ret 5; }
    var server: Fixture;
    if (!make_fixture(?server, SERVER, test_config())
        || server_handshake(?server).kind != EVENT_SETTINGS
        || !drain_output(?server)) { ret 6; }
    var inbound: [6]u8;
    inbound[0] = 0x82;
    inbound[1] = 0x86;
    inbound[2] = 0x84;
    inbound[3] = 0x01;
    inbound[4] = 0x01;
    inbound[5] = 'x';
    val parent_headers: Event = receive_frame(?server, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS, 1, ?inbound[0], 6);
    var parent_exchange: ExchangeMemory;
    if (parent_headers.kind != EVENT_REQUEST_HEADERS
        || !make_exchange(?parent_exchange, parent_headers.generation, 1)
        || !bind_exchange(?server.engine, 1, ?parent_exchange.exchange)
        || !release_event(?server.engine, 1, parent_headers.generation)) { ret 7; }
    val promised_id: u32 = reserve_push(?server.engine, 1, nil);
    if (promised_id != 2
        || send_push_promise(?server.engine, 1, promised_id, ?request[0], 4,
        true).status != OFFER_OUTPUT || !finish_write(?server, true)
        || !stream_for(?server.engine, promised_id).push_promise_sent) { ret 8; }
    var pushed_response: [1]field.Field;
    pushed_response[0] = field.Field{name: view.view(":status", 7),
        value: view.view("204", 3), sensitive: false};
    if (send_headers(?server.engine, promised_id, ?pushed_response[0], 1,
        true, true).status != OFFER_OUTPUT || !finish_write(?server, false)
        || stream_for(?server.engine, promised_id).state != STREAM_CLOSED) { ret 9; }
    ret 0;
}

test "http.h2.connection: sustained multiplexing reuses bounded slots generation safely" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, CLIENT, test_config())
        || client_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    var request: [4]field.Field;
    request_fields(?request[0]);
    var response: [1]u8;
    response[0] = 0x89;
    var prior_generation: u64   = 0;
    var i:                usize = 0;
    for (i < 64) {
        val id: u32 = open_local(?fixture.engine, nil);
        if (id == 0 || send_headers(?fixture.engine, id, ?request[0], 4,
            true, true).status != OFFER_OUTPUT || !finish_write(?fixture, i % 2 == 0)) {
            ret 2;
        }
        val headers: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
            frame.FLAG_END_HEADERS | frame.FLAG_END_STREAM, id, ?response[0], 1);
        if (headers.kind != EVENT_RESPONSE_HEADERS
            || headers.generation <= prior_generation
            || !release_event(?fixture.engine, id, headers.generation)
            || !release_stream(?fixture.engine, id, headers.generation)) { ret 3; }
        prior_generation = headers.generation;
        i                = i + 1;
    }
    if (fixture.engine.active_streams != 0 || fixture.engine.active_local != 0) { ret 4; }
    ret 0;
}

test "http.h2.connection: stale transport completion is terminal and closes once" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture) || !submit_read(?fixture.engine)) { ret 1; }
    var stale: transport.Token = fixture.io.read_token;
    stale.generation = stale.generation + 1;
    var completion: transport.Completion = transport.completed(stale,
        transport.READ, 1);
    val failed: Event = complete_io(?fixture.engine, ?completion);
    if (failed.kind != EVENT_ERROR || failed.error != ERROR_STATE
        || fixture.engine.state != FAILED) { ret 2; }
    if (progress_close(?fixture.engine) || fixture.io.close_calls != 0) { ret 3; }
    if (!drain_output(?fixture) || !progress_close(?fixture.engine)
        || fixture.io.close_calls != 1) { ret 4; }
    ret 0;
}

fun sized_config(max_streams: usize) Config {
    var configured: Config = test_config();
    configured.max_streams                  = max_streams;
    configured.local.max_concurrent_streams = max_streams::u32;
    ret configured;
}

# opens client streams and completes their request header blocks
fun open_requests(fixture: *Fixture, count: usize, ids: *u32) bool {
    var request: [4]field.Field;
    request_fields(?request[0]);
    var i: usize = 0;
    for (i < count) {
        val id: u32 = open_local(?fixture.engine, nil);
        if (id == 0 || send_headers(?fixture.engine, id, ?request[0], 4, false,
            true).status != OFFER_OUTPUT || !finish_write(fixture, false)) { ret false; }
        if (ids != nil) { ids[i] = id; }
        i = i + 1;
    }
    ret true;
}

fun receive_window(fixture: *Fixture, id: u32, increment: u32) Event {
    var payload: [4]u8;
    put_u32(?payload[0], increment);
    ret receive_frame(fixture, frame.FRAME_WINDOW_UPDATE, 0, id, ?payload[0], 4);
}

val VISITS_FAILED: u64 = (-1)::u64;

# slot visits across reads, a ping reply, write completions, tick and the
# scheduler while count open streams sit idle
fun idle_visits(fixture: *Fixture, count: usize) u64 {
    if (!make_fixture(fixture, CLIENT, sized_config(120))
        || client_handshake(fixture).kind != EVENT_SETTINGS
        || !drain_output(fixture) || !open_requests(fixture, count, nil)
        || fixture.engine.active_streams != count) { ret VISITS_FAILED; }
    val before: u64 = fixture.engine.slot_visits;
    var opaque: [8]u8;
    if (process(?fixture.engine).kind != EVENT_NEED_READ
        || tick(?fixture.engine).kind != EVENT_NONE
        || writable_stream(?fixture.engine) != 0
        || receive_frame(fixture, frame.FRAME_PING, 0, 0, ?opaque[0], 8).kind != EVENT_PING
        || !drain_output(fixture)
        || process(?fixture.engine).kind != EVENT_NEED_READ
        || tick(?fixture.engine).kind != EVENT_NONE) { ret VISITS_FAILED; }
    ret fixture.engine.slot_visits - before;
}

test "http.h2.connection: idle streams cost no slot visits on routine paths" {
    var small: Fixture;
    var large: Fixture;
    val few:   u64 = idle_visits(?small, 3);
    val many:  u64 = idle_visits(?large, 100);
    if (few == VISITS_FAILED || many == VISITS_FAILED) { ret 1; }
    if (few != 0 || many != 0)                         { ret 2; }
    ret 0;
}

fun index_consistent(engine: *Engine) bool {
    var entries: usize = 0;
    var i:       usize = 0;
    for (i < engine.index_capacity) {
        val entry: StreamIndexEntry = engine.index[i];
        if (entry.slot != INDEX_EMPTY && entry.slot != INDEX_TOMBSTONE) {
            val stream: *Stream = slot_stream(engine, entry.slot);
            if (!stream.live || stream.id::u64 != entry.id || stream.index_position != i) {
                ret false;
            }
            entries = entries + 1;
        }
        i = i + 1;
    }
    ret entries == engine.active_streams
        && engine.index_tombstones <= engine.index_capacity / 4;
}

test "http.h2.connection: stream index survives tombstone churn and rebuilds" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, CLIENT, test_config())
        || client_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    val kept:     u32   = open_local(?fixture.engine, nil);
    var removals: u64   = 0;
    var i:        usize = 0;
    for (i < 64) {
        val first:  u32 = open_local(?fixture.engine, nil);
        val second: u32 = open_local(?fixture.engine, nil);
        if (kept == 0 || first == 0 || second == 0
            || stream_for(?fixture.engine, first).id != first
            || stream_for(?fixture.engine, second).id != second
            || stream_for(?fixture.engine, kept).id != kept
            || !index_consistent(?fixture.engine)) { ret 2; }
        val first_generation:  u64 = stream_for(?fixture.engine, first).generation;
        val second_generation: u64 = stream_for(?fixture.engine, second).generation;
        if (!cancel_stream(?fixture.engine, second, H2_CANCEL)
            || !cancel_stream(?fixture.engine, first, H2_CANCEL)
            || !drain_output(?fixture)
            || !release_stream(?fixture.engine, first, first_generation)
            || !release_stream(?fixture.engine, second, second_generation)) { ret 3; }
        removals = removals + 2;
        if (stream_for(?fixture.engine, first) != nil
            || stream_for(?fixture.engine, second) != nil
            || stream_for(?fixture.engine, kept) == nil
            || stream_for(?fixture.engine, kept).id != kept
            || !index_consistent(?fixture.engine)) { ret 4; }
        i = i + 1;
    }
    val rebuilds: u64 = fixture.engine.index_rebuilds;
    if (rebuilds == 0
        || rebuilds * (fixture.engine.index_capacity / 4 + 1)::u64 > removals) { ret 5; }
    if (fixture.engine.active_streams != 1 || fixture.engine.free_head == NO_SLOT) { ret 6; }
    ret 0;
}

test "http.h2.connection: window updates visit only the streams that owe one" {
    var fixture: Fixture;
    var ids:     [20]u32;
    if (!make_fixture(?fixture, CLIENT, sized_config(24))
        || client_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture) || !open_requests(?fixture, 20, ?ids[0])) { ret 1; }
    var status_ok: [1]u8;
    status_ok[0] = 0x88;
    var bytes: [8]u8;
    var owing: [2]u32;
    owing[0] = ids[11];
    owing[1] = ids[4];
    var i: usize = 0;
    for (i < 2) {
        val headers: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
            frame.FLAG_END_HEADERS, owing[i], ?status_ok[0], 1);
        if (headers.kind != EVENT_RESPONSE_HEADERS
            || !release_event(?fixture.engine, owing[i], headers.generation)) { ret 2; }
        val data: Event = receive_frame(?fixture, frame.FRAME_DATA, 0, owing[i],
            ?bytes[0], 8);
        if (data.kind != EVENT_DATA || !consume_data(?fixture.engine, owing[i], 8)) { ret 3; }
        i = i + 1;
    }
    if (fixture.engine.lists[LIST_WINDOW].count != 2) { ret 4; }
    val before:  u64   = fixture.engine.slot_visits;
    var updates: [3]u32;
    var count:   usize = 0;
    for (submit_write(?fixture.engine)) {
        if (fixture.io.write_buffer[3] == frame.FRAME_WINDOW_UPDATE) {
            if (count == 3) { ret 5; }
            updates[count] = read_u31(?fixture.io.write_buffer[5]);
            count          = count + 1;
        }
        var completion: transport.Completion = transport.completed(
            fixture.io.write_token, transport.WRITE, fixture.io.write_length);
        if (complete_io(?fixture.engine, ?completion).kind == EVENT_ERROR) { ret 6; }
    }
    if (fixture.engine.slot_visits - before != 2) { ret 7; }
    if (count != 3 || updates[0] != 0 || updates[1] != owing[0]
        || updates[2] != owing[1]) { ret 8; }
    if (fixture.engine.lists[LIST_WINDOW].count != 0
        || stream_for(?fixture.engine, owing[0]).recv_window != 16
        || stream_for(?fixture.engine, owing[1]).recv_window != 16) { ret 9; }
    ret 0;
}

test "http.h2.connection: weighted scheduling visits only the writable set" {
    var fixture: Fixture;
    var ids:     [6]u32;
    var zero:    [6]u8;
    zero[1] = frame.SETTINGS_INITIAL_WINDOW_SIZE::u8;
    if (!make_fixture(?fixture, CLIENT, sized_config(8))
        || !drain_output(?fixture)
        || receive_frame(?fixture, frame.FRAME_SETTINGS, 0, 0, ?zero[0], 6).kind
        != EVENT_SETTINGS
        || !drain_output(?fixture) || !open_requests(?fixture, 6, ?ids[0])) { ret 1; }
    var weights: [3]u16;
    weights[0] = 1;
    weights[1] = 2;
    weights[2] = 4;
    var i: usize = 0;
    for (i < 4) {
        if (i < 3 && !set_priority(?fixture.engine, ids[i], 0, weights[i], false)) { ret 2; }
        if (receive_window(?fixture, ids[i], 1000).kind != EVENT_NEED_READ)        { ret 3; }
        i = i + 1;
    }
    if (!set_writable(?fixture.engine, ids[4], true)
        || fixture.engine.lists[LIST_WRITABLE].count != 0) { ret 4; }
    var counts: [3]usize;
    var byte:   [1]u8;
    var round:  usize = 0;
    for (round < 70) {
        i = 0;
        for (i < 3) {
            if (!set_writable(?fixture.engine, ids[i], true)) { ret 5; }
            i = i + 1;
        }
        val before:   u64 = fixture.engine.slot_visits;
        val selected: u32 = writable_stream(?fixture.engine);
        if (fixture.engine.slot_visits - before != 3) { ret 6; }
        var found: bool = false;
        i = 0;
        for (i < 3) {
            if (selected == ids[i]) {
                counts[i] = counts[i] + 1;
                found     = true;
            }
            i = i + 1;
        }
        if (!found
            || offer_data(?fixture.engine, selected, ?byte[0], 1, false).consumed != 1
            || !finish_write(?fixture, false)) { ret 7; }
        round = round + 1;
    }
    if (counts[0] != 10 || counts[1] != 20 || counts[2] != 40) { ret 8; }
    if (stream_for(?fixture.engine, ids[3]).schedule_credit != 0
        || stream_for(?fixture.engine, ids[4]).schedule_credit != 0
        || stream_for(?fixture.engine, ids[5]).schedule_credit != 0) { ret 9; }
    ret 0;
}

test "http.h2.connection: pending reports budgeted work until it drains" {
    var fixture: Fixture;
    var ids:     [70]u32;
    if (!make_fixture(?fixture, CLIENT, sized_config(80))
        || client_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture) || !open_requests(?fixture, 70, ?ids[0])) { ret 1; }
    var wire:    [1024]u8;
    var payload: [4]u8;
    put_u32(?payload[0], 1);
    var length: usize = 0;
    var i:      usize = 0;
    for (i < 70) {
        length = length + test_frame(?wire[length], 1024 - length,
            frame.FRAME_WINDOW_UPDATE, 0, ids[i], ?payload[0], 4);
        i = i + 1;
    }
    if (length != 910
        || receive_bytes(?fixture, ?wire[0], length, false).kind != EVENT_PENDING
        || submit_read(?fixture.engine)
        || process(?fixture.engine).kind != EVENT_NEED_READ) { ret 2; }
    i = 0;
    for (i < 70) {
        if (stream_for(?fixture.engine, ids[i]).send_window != 65536) { ret 3; }
        i = i + 1;
    }
    var goaway: [8]u8;
    if (receive_frame(?fixture, frame.FRAME_GOAWAY, 0, 0, ?goaway[0], 8).kind
        != EVENT_GOAWAY || fixture.engine.ready_count != 70) { ret 4; }
    i = 0;
    for (i < 70) {
        val retry: Event = process(?fixture.engine);
        if (retry.kind != EVENT_STREAM_RETRY || retry.stream_id != ids[i]) { ret 5; }
        i = i + 1;
    }
    if (process(?fixture.engine).kind != EVENT_NEED_READ
        || fixture.engine.ready_count != 0) { ret 6; }
    ret 0;
}

fun priority_payload(output: *u8, dependency: u32, weight: u16, exclusive: bool) {
    put_u32(output, dependency);
    if (exclusive) { output[0] = output[0] | 0x80; }
    output[4] = (weight - 1)::u8;
}

test "http.h2.connection: exclusive priority visits only the named stream" {
    var fixture: Fixture;
    var ids:     [100]u32;
    if (!make_fixture(?fixture, CLIENT, sized_config(120))
        || client_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    var i: usize = 0;
    for (i < 100) {
        ids[i] = open_local(?fixture.engine, nil);
        if (ids[i] == 0) { ret 2; }
        i = i + 1;
    }
    var payload: [5]u8;
    priority_payload(?payload[0], ids[10], 32, true);
    val before:   u64   = fixture.engine.slot_visits;
    val received: Event = receive_frame(?fixture, frame.FRAME_PRIORITY, 0, ids[50],
        ?payload[0], 5);
    if (received.kind != EVENT_PRIORITY || received.stream_id != ids[50]
        || fixture.engine.slot_visits - before != 2
        || stream_for(?fixture.engine, ids[50]).weight != 32) { ret 3; }
    val sent: u64 = fixture.engine.slot_visits;
    if (!send_priority(?fixture.engine, ids[20], ids[70], 200, true)
        || fixture.engine.slot_visits - sent != 1
        || stream_for(?fixture.engine, ids[20]).weight != 200
        || !submit_write(?fixture.engine)
        || fixture.io.write_buffer[3] != frame.FRAME_PRIORITY
        || read_u32(?fixture.io.write_buffer[5]) != ids[20]
        || read_u32(?fixture.io.write_buffer[9]) != (ids[70] | 0x80000000)
        || fixture.io.write_buffer[13] != 199) { ret 4; }
    ret 0;
}

test "http.h2.connection: self dependency is a stream error that keeps hpack in step" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    var request: [6]u8;
    request[0] = 0x82;
    request[1] = 0x86;
    request[2] = 0x84;
    request[3] = 0x01;
    request[4] = 0x01;
    request[5] = 'x';
    val first: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS, 1, ?request[0], 6);
    var storage: ExchangeMemory;
    if (first.kind != EVENT_REQUEST_HEADERS
        || !make_exchange(?storage, first.generation, 1)
        || !bind_exchange(?fixture.engine, 1, ?storage.exchange)
        || !release_event(?fixture.engine, 1, first.generation)) { ret 2; }
    var payload: [5]u8;
    priority_payload(?payload[0], 1, 16, false);
    val looped: Event = receive_frame(?fixture, frame.FRAME_PRIORITY, 0, 1,
        ?payload[0], 5);
    if (looped.kind != EVENT_STREAM_ERROR || looped.code != H2_PROTOCOL_ERROR
        || looped.stream_id != 1 || fixture.engine.state != OPEN
        || stream_for(?fixture.engine, 1).state != STREAM_CLOSED
        || !scope_cancelled(?storage.scope)
        || !submit_write(?fixture.engine)
        || fixture.io.write_buffer[3] != frame.FRAME_RESET_STREAM
        || read_u32(?fixture.io.write_buffer[9]) != H2_PROTOCOL_ERROR
        || !drain_output(?fixture)) { ret 3; }
    var prioritized: [11]u8;
    priority_payload(?prioritized[0], 3, 16, true);
    prioritized[5]  = 0x82;
    prioritized[6]  = 0x86;
    prioritized[7]  = 0x84;
    prioritized[8]  = 0x41;
    prioritized[9]  = 0x01;
    prioritized[10] = 'y';
    val headers: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS | frame.FLAG_PRIORITY, 3, ?prioritized[0], 11);
    if (headers.kind != EVENT_STREAM_ERROR || headers.code != H2_PROTOCOL_ERROR
        || headers.stream_id != 3 || fixture.engine.state != OPEN
        || fixture.engine.inbound_table.count != 1
        || stream_for(?fixture.engine, 3).state != STREAM_CLOSED
        || !drain_output(?fixture)) { ret 4; }
    var indexed: [4]u8;
    indexed[0] = 0x82;
    indexed[1] = 0x86;
    indexed[2] = 0x84;
    indexed[3] = 0xbe;
    val next: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS | frame.FLAG_END_STREAM, 5, ?indexed[0], 4);
    if (next.kind != EVENT_REQUEST_HEADERS || next.headers.count != 4
        || next.headers.authority.len != 1 || next.headers.authority.data[0] != 'y') {
        ret 5;
    }
    if (!operation_ok(cancel.destroy(?storage.scope))) { ret 6; }
    ret 0;
}

fun round16(bytes: usize) usize {
    ret (bytes + 15) & ~(15::usize);
}

# the exact decoder set one stream borrows at the test configuration
fun stream_set_bytes() usize {
    ret round16(512) + round16(16 * $size_of(field.Field)) + round16(512)
        + round16(16 * $size_of(hpack.Entry));
}

# the first record chunk and the index an initialized engine holds
fun idle_bytes() usize {
    ret round16(4 * $size_of(Stream)) + round16(16 * $size_of(StreamIndexEntry));
}

fun request_block(output: *u8) {
    output[0] = 0x82;
    output[1] = 0x86;
    output[2] = 0x84;
    output[3] = 0x01;
    output[4] = 0x01;
    output[5] = 'x';
}

test "http.h2.connection: an idle engine holds only its first records and a stream exactly its set" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, CLIENT, test_config())
        || fixture.account.held != idle_bytes() || fixture.account.used[0] != 0) { ret 1; }
    if (client_handshake(?fixture).kind != EVENT_SETTINGS || !drain_output(?fixture)
        || fixture.account.held != idle_bytes() || fixture.engine.payload_held
        || fixture.engine.write_held) { ret 2; }
    var request: [4]field.Field;
    request_fields(?request[0]);
    val id: u32 = open_local(?fixture.engine, nil);
    if (id == 0 || fixture.account.used[0] != stream_set_bytes()
        || fixture.account.used[1] != idle_bytes()) { ret 3; }
    if (send_headers(?fixture.engine, id, ?request[0], 4, true, true).status != OFFER_OUTPUT
        || !fixture.engine.header_output_held || !fixture.engine.write_held) { ret 4; }
    if (!finish_write(?fixture, false) || fixture.engine.header_output_held
        || fixture.engine.write_held || fixture.account.used[1] != idle_bytes()) { ret 5; }
    var status_ok: [1]u8;
    status_ok[0] = 0x88;
    val headers: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS | frame.FLAG_END_STREAM, id, ?status_ok[0], 1);
    if (headers.kind != EVENT_RESPONSE_HEADERS || fixture.engine.payload_held
        || !release_event(?fixture.engine, id, headers.generation)) { ret 6; }
    if (!release_stream(?fixture.engine, id, headers.generation)
        || fixture.account.held != idle_bytes() || fixture.account.used[0] != 0) { ret 7; }
    if (!destroy(?fixture.engine) || fixture.account.held != 0
        || fixture.account.chunks != 0) { ret 8; }
    ret 0;
}

test "http.h2.connection: held data keeps its payload until consumed" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    var request: [6]u8;
    request_block(?request[0]);
    val headers: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS, 1, ?request[0], 6);
    var storage: ExchangeMemory;
    if (headers.kind != EVENT_REQUEST_HEADERS
        || !make_exchange(?storage, headers.generation, 1)
        || !bind_exchange(?fixture.engine, 1, ?storage.exchange)
        || !release_event(?fixture.engine, 1, headers.generation)) { ret 2; }
    var body_bytes: [4]u8;
    val data:       Event = receive_frame(?fixture, frame.FRAME_DATA, 0, 1, ?body_bytes[0], 4);
    if (data.kind != EVENT_DATA || !fixture.engine.payload_held
        || fixture.account.used[1] != idle_bytes() + round16(16384)) { ret 3; }
    if (!consume_data(?fixture.engine, 1, 3) || !fixture.engine.payload_held
        || !consume_data(?fixture.engine, 1, 1) || fixture.engine.payload_held
        || fixture.account.used[1] != idle_bytes()) { ret 4; }
    ret 0;
}

test "http.h2.connection: a refused stream set refuses only that stream" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    fixture.account.budgets[0] = stream_set_bytes() - 1;
    var inserted: [6]u8;
    request_block(?inserted[0]);
    inserted[3] = 0x41;
    val refused: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS, 1, ?inserted[0], 6);
    if (refused.kind != EVENT_STREAM_ERROR || refused.code != H2_REFUSED_STREAM
        || fixture.engine.state != OPEN || !fixture.engine.reserve.live
        || fixture.engine.inbound_table.count != 1 || fixture.account.used[0] != 0) { ret 2; }
    if (!submit_write(?fixture.engine) || fixture.io.write_buffer[3] != frame.FRAME_RESET_STREAM
        || read_u32(?fixture.io.write_buffer[9]) != H2_REFUSED_STREAM) { ret 3; }
    var completion: transport.Completion = transport.completed(fixture.io.write_token,
        transport.WRITE, fixture.io.write_length);
    if (complete_io(?fixture.engine, ?completion).kind != EVENT_NONE
        || !release_stream(?fixture.engine, 1, refused.generation)
        || fixture.engine.reserve.live) { ret 4; }
    fixture.account.budgets[0] = 1 << 25;
    # the refused block's insertion is indexed by the next block
    var indexed: [4]u8;
    indexed[0] = 0x82;
    indexed[1] = 0x86;
    indexed[2] = 0x84;
    indexed[3] = 0xbe;
    val admitted: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS, 3, ?indexed[0], 4);
    if (admitted.kind != EVENT_REQUEST_HEADERS
        || fixture.account.used[0] != stream_set_bytes()) { ret 5; }
    ret 0;
}

test "http.h2.connection: a refused local stream or transient buffer blocks only that call" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, CLIENT, test_config())
        || client_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    fixture.account.budgets[0] = 0;
    if (open_local(?fixture.engine, nil) != 0 || fixture.engine.active_streams != 0
        || fixture.engine.state != OPEN) { ret 2; }
    fixture.account.budgets[0] = 1 << 25;
    val id: u32 = open_local(?fixture.engine, nil);
    if (id == 0) { ret 3; }
    fixture.account.budgets[1] = idle_bytes();
    var request: [4]field.Field;
    request_fields(?request[0]);
    val blocked: Offer = send_headers(?fixture.engine, id, ?request[0], 4, true, true);
    if (blocked.status != OFFER_BLOCKED || blocked.error != ERROR_MEMORY
        || !fixture.engine.memory_blocked || fixture.engine.header_output_active
        || fixture.engine.outbound_table.count != 0) { ret 4; }
    var opaque: [8]u8;
    if (receive_frame(?fixture, frame.FRAME_PING, 0, 0, ?opaque[0], 8).kind
        != EVENT_MEMORY_BLOCKED || fixture.engine.state != OPEN
        || process(?fixture.engine).kind != EVENT_MEMORY_BLOCKED) { ret 5; }
    fixture.account.budgets[1] = idle_bytes() + round16(16384);
    if (process(?fixture.engine).kind != EVENT_PING || fixture.engine.payload_held) { ret 6; }
    fixture.account.budgets[1] = idle_bytes();
    if (submit_write(?fixture.engine) || !fixture.engine.memory_blocked
        || fixture.engine.write_held) { ret 8; }
    fixture.account.budgets[1] = 1 << 25;
    if (!drain_output(?fixture)
        || send_headers(?fixture.engine, id, ?request[0], 4, true, true).status != OFFER_OUTPUT
        || !finish_write(?fixture, false)) { ret 7; }
    ret 0;
}

test "http.h2.connection: stream records grow in place and the index follows them" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, CLIENT, sized_config(40))
        || client_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    var ids:   [40]u32;
    var first: [4]*Stream;
    var i:     usize = 0;
    for (i < 40) {
        ids[i] = open_local(?fixture.engine, nil);
        if (ids[i] == 0) { ret 2; }
        if (i < 4)       { first[i] = stream_for(?fixture.engine, ids[i]); }
        i = i + 1;
    }
    if (fixture.engine.stream_capacity < 40 || fixture.engine.records.chunk_count < 2
        || fixture.engine.index_capacity < 2 * (fixture.engine.stream_capacity + 1)
        || open_local(?fixture.engine, nil) != 0 || !index_consistent(?fixture.engine)) { ret 3; }
    val grown: usize = fixture.account.used[1];
    i = 0;
    for (i < 4) {
        if (stream_for(?fixture.engine, ids[i]) != first[i] || first[i].id != ids[i]) { ret 4; }
        i = i + 1;
    }
    var round: usize = 0;
    for (round < 3) {
        i = round;
        for (i < 40) {
            val stream:     *Stream = stream_for(?fixture.engine, ids[i]);
            val generation: u64     = stream.generation;
            if (!cancel_stream(?fixture.engine, ids[i], H2_CANCEL)
                || !drain_output(?fixture)
                || !release_stream(?fixture.engine, ids[i], generation)) { ret 5; }
            i = i + 3;
        }
        i = round;
        for (i < 40) {
            ids[i] = open_local(?fixture.engine, nil);
            if (ids[i] == 0 || stream_for(?fixture.engine, ids[i]).id != ids[i]) { ret 6; }
            i = i + 3;
        }
        if (!index_consistent(?fixture.engine) || fixture.account.used[1] != grown) { ret 7; }
        round = round + 1;
    }
    i = 0;
    for (i < 4) {
        if (first[i].live && stream_for(?fixture.engine, first[i].id) != first[i]) { ret 8; }
        i = i + 1;
    }
    ret 0;
}

test "http.h2.connection: an unbound request borrow ends once its stream closes" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    var request: [6]u8;
    request_block(?request[0]);
    val reported: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS, 1, ?request[0], 6);
    if (reported.kind != EVENT_REQUEST_HEADERS
        || release_event(?fixture.engine, 1, reported.generation)) { ret 2; }
    if (!cancel_stream(?fixture.engine, 1, H2_CANCEL)
        || !release_event(?fixture.engine, 1, reported.generation)
        || fixture.engine.held) { ret 3; }
    ret 0;
}

test "http.h2.connection: a failed connection destroys with streams the host never released" {
    var fixture: Fixture;
    if (!make_fixture(?fixture, SERVER, test_config())
        || server_handshake(?fixture).kind != EVENT_SETTINGS
        || !drain_output(?fixture)) { ret 1; }
    var request: [6]u8;
    request_block(?request[0]);
    val reported: Event = receive_frame(?fixture, frame.FRAME_HEADERS,
        frame.FLAG_END_HEADERS, 1, ?request[0], 6);
    var storage: ExchangeMemory;
    if (reported.kind != EVENT_REQUEST_HEADERS
        || !make_exchange(?storage, reported.generation, 1)
        || !bind_exchange(?fixture.engine, 1, ?storage.exchange)
        || !release_event(?fixture.engine, 1, reported.generation)) { ret 2; }
    # a header block the host never hears of, then a frame that breaks it off
    if (receive_frame(?fixture, frame.FRAME_HEADERS, 0, 3, ?request[0], 3).kind == EVENT_ERROR
        || fixture.engine.active_streams != 2) { ret 3; }
    var opaque: [8]u8;
    if (receive_frame(?fixture, frame.FRAME_PING, 0, 0, ?opaque[0], 8).kind != EVENT_ERROR
        || fixture.engine.state != FAILED || destroy(?fixture.engine)) { ret 4; }
    if (!drain_output(?fixture) || !progress_close(?fixture.engine)) { ret 5; }
    var closed: transport.Completion = transport.completed(
        fixture.io.close_token, transport.CLOSE, 0);
    if (complete_io(?fixture.engine, ?closed).kind != EVENT_CLOSED
        || fixture.engine.active_streams != 2) { ret 6; }
    if (!destroy(?fixture.engine))   { ret 7; }
    if (fixture.account.held != 0)   { ret 8; }
    if (fixture.account.chunks != 0) { ret 9; }
    ret 0;
}
